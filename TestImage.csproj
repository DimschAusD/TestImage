<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.18362.0</TargetFramework>
	
<!-- Optional, wenn du C#-Features brauchst -->
    <LangVersion>latest</LangVersion>
	
	
<!-- Empfohlen für saubere Nullability-/Binding-Hinweise -->
    <Nullable>enable</Nullable>

    <UseWPF>true</UseWPF>
	 <!-- Optional: disable problematic analyzers -->
    <EnableRoslynAnalyzers>true</EnableRoslynAnalyzers>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <ApplicationIcon>Sternchen.ico</ApplicationIcon>

    <!--
      Eigenes Win32-Manifest statt des SDK-Standards, nur wegen longPathAware.
      Der bisherige Inhalt (asInvoker) steht unverändert darin — Begründung in der
      Datei selbst.
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      AnyCPU. Die frühere Festlegung auf x64 stammte von
      emgu.cv.runtime.windows (OpenCV mit nativen 64-Bit-Teilen); das Paket ist raus.

      Übrig ist als native Abhängigkeit nur Microsoft.ML.OnnxRuntime in
      ImageMatching.Cnn. Das Paket bringt Teile für x64, x86 und arm64 mit und wählt
      zur Laufzeit aus — es verlangt keine feste Plattform. Auf 64-Bit-Windows läuft
      eine AnyCPU-Anwendung ohnehin als 64-Bit-Prozess, an der Bitbreite ändert sich
      also nichts.

      Wichtiger als die Bitbreite war der Nebeneffekt: <Platforms>AnyCPU;x64</Platforms>
      erzeugte ZWEI Ausgabeordner, bin\Debug\… und bin\x64\Debug\…. Wer aus dem einen
      startete, während in den anderen gebaut wurde, testete eine veraltete Datei.
    -->
  </PropertyGroup>

  <!--
    Symbole.xaml braucht keinen eigenen Eintrag: Die Standardregeln des SDK nehmen
    .xaml-Dateien als Page auf, und genau darüber findet App.xaml sie.
  -->
  <ItemGroup>
    <None Remove="Images\HeavyO.jpg" />
    <None Remove="Images\KIFehler.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\HeavyO.jpg" />
    <Resource Include="Images\KIFehler.png" />
    <Resource Include="Sternchen.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <!--
    WebcamMikroMonitor.Common ist hier entfallen. Die drei benutzten Klassen liegen jetzt
    als Geraete\GeraeteWaechter, GeraeteNutzung und AnwendungsNameHelper im Projekt selbst.

    Grund: Das Projekt lag ausserhalb dieses Repos und in gar keinem — wer TestImage klonte,
    bekam einen Verweis ins Leere.
  -->
  <!--
    Die beiden Matching-Projekte liegen in Unterordnern dieses Projekts. Sie dürfen nicht
    zusätzlich über die Standard-Globs in TestImage selbst kompiliert werden — sonst gäbe
    es jeden Typ zweimal. Gleiches Muster wie in BildKonturBerechnen.csproj.
  -->
  <ItemGroup>
    <Compile Remove="ImageMatching.Core\**;ImageMatching.Cnn\**" />
    <EmbeddedResource Remove="ImageMatching.Core\**;ImageMatching.Cnn\**" />
    <None Remove="ImageMatching.Core\**;ImageMatching.Cnn\**" />
    <Page Remove="ImageMatching.Core\**;ImageMatching.Cnn\**" />
    <Resource Remove="ImageMatching.Core\**;ImageMatching.Cnn\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="ImageMatching.Core\ImageMatching.Core.csproj" />
    <ProjectReference Include="ImageMatching.Cnn\ImageMatching.Cnn.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!--
      Kein DotNetProjects.SVGImage nötig: Die Symbole liegen als Zeichnungen in
      Images\Symbole.xaml.
    -->
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
  </ItemGroup>

  <!--
    Die Begleitdateien liegen im Repo (zusammen 1,3 MB) und sind immer da.
  -->
  <ItemGroup>
    <ClipModel Include="models\clip-vocab.json" />
    <ClipModel Include="models\clip-merges.txt" />
  </ItemGroup>

  <!--
    Die beiden Gewichtsdateien nur aufnehmen, wenn sie tatsaechlich vorliegen.

    Sie stehen in der .gitignore, weil GitHub Dateien ueber 100 MB ablehnt — 335 MB und
    242 MB. Ohne die Bedingung braeche der Build bei einem frischen Klon mit einem
    Kopierfehler ab, statt mit einem Satz zu sagen, was fehlt.
  -->
  <ItemGroup>
    <ClipModel Include="models\clip-vit-b32-vision.onnx" Condition="Exists('models\clip-vit-b32-vision.onnx')" />
    <ClipModel Include="models\clip-text.onnx" Condition="Exists('models\clip-text.onnx')" />
  </ItemGroup>

  <!--
    Ohne die Gewichtsdateien laeuft alles ausser der Bildersuche ueber CLIP. Deshalb eine
    Warnung und kein Fehler: Wer nur den Betrachter bauen will, soll das koennen.
  -->
  <Target Name="PruefeClipModelle" BeforeTargets="Build">
    <Warning
      Condition="!Exists('models\clip-vit-b32-vision.onnx') Or !Exists('models\clip-text.onnx')"
      Text="CLIP-Modelle fehlen in models\. Die Begriffssuche bleibt aus, alles Uebrige laeuft. Woher man sie bekommt: models\LIESMICH.md" />
  </Target>

  <Target Name="CopyClipModels" AfterTargets="Build">
    <Copy SourceFiles="@(ClipModel)" DestinationFolder="$(OutputPath)models" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyClipModelsPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(ClipModel)" DestinationFolder="$(PublishDir)models" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Nutzerdaten gehoeren nicht ins Verteilpaket.

    Die Anwendung legt diese Dateien neben der Exe an: die gelernten Wasserzeichen-Muster,
    das Verzeichnis der indexierten Ordner, das gemeinsame FS-Profil und das
    Fehlerprotokoll. Startet man die Anwendung einmal aus dem Veroeffentlichungsordner —
    etwa um das Paket zu pruefen —, liegen sie anschliessend dort und wandern mit ins ZIP.
    Beim Entpacken ueber eine vorhandene Installation ueberschrieben sie dann genau das,
    was der Nutzer sich erarbeitet hat: seine gelernten Muster und seine Ordnerliste.

    dotnet publish raeumt den Zielordner nicht auf, weggeloescht wird hier also
    ausdruecklich. Nicht vorhandene Dateien sind fuer Delete kein Fehler.
  -->
  <Target Name="EntferneNutzerdatenAusPublish" AfterTargets="Publish">
    <ItemGroup>
      <NutzerDatei Include="$(PublishDir)wasserzeichen.masken.json" />
      <NutzerDatei Include="$(PublishDir)wasserzeichen.maske.json" />
      <NutzerDatei Include="$(PublishDir)index.ordner.json" />
      <NutzerDatei Include="$(PublishDir)fav.profile.json" />
      <NutzerDatei Include="$(PublishDir)TestImage-Fehler.log" />
    </ItemGroup>

    <Delete Files="@(NutzerDatei)" />
  </Target>

</Project>
