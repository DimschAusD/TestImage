<?xml version="1.0" encoding="utf-8"?>
<!--
  Dieses Manifest ersetzt das Standard-Manifest des .NET-SDK. Der trustInfo-Block ist
  Zeichen für Zeichen der bisherige Inhalt (asInvoker, kein uiAccess) — er muss hier
  stehen bleiben, sonst fiele er mit dem Standard-Manifest weg.

  Neu ist ausschliesslich longPathAware.

  Warum überhaupt: Verwaltete Dateizugriffe (Directory.EnumerateFiles, FileStream,
  FileInfo) kommen in .NET auch ohne dieses Manifest mit Pfaden über 260 Zeichen
  zurecht — die Laufzeit setzt intern das Präfix \\?\ davor. Nicht davon erfasst sind
  Aufrufe, die über die Windows-Shell laufen; hier betrifft das den Papierkorb
  (Microsoft.VisualBasic.FileIO.FileSystem.DeleteFile/DeleteDirectory, darunter
  SHFileOperation). Die Shell nimmt kein \\?\ entgegen und richtet sich stattdessen
  danach, ob der Prozess als longPathAware angemeldet ist.

  Zweite Voraussetzung ist die Windows-Einstellung
  HKLM\SYSTEM\CurrentControlSet\Control\FileSystem\LongPathsEnabled = 1
  (Gruppenrichtlinie „Lange Win32-Pfade aktivieren"). Sie gilt für den ganzen Rechner
  und lässt sich aus der Anwendung heraus nicht setzen. Steht sie auf 0, bleibt der
  Papierkorb bei über 260 Zeichen aussen vor; das Suchen und Vergleichen läuft
  trotzdem, weil es ohne die Shell auskommt.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="MyApplication.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
