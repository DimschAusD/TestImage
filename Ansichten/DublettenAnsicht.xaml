<UserControl
    x:Class="TestImage.Ansichten.DublettenAnsicht"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ansichten="clr-namespace:TestImage.Ansichten"
    xmlns:bildersuche="clr-namespace:TestImage.Bildersuche"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TestImage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="760"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--  Modern, hell, neutral — kein Blau.  -->
        <Style x:Key="ButtonBasis" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Foreground" Value="#FF1F2937" />
            <Setter Property="Background" Value="#FFF3F4F6" />
            <Setter Property="BorderBrush" Value="#FFCBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="BRD_Fläche"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BRD_Fläche" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BRD_Fläche" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BRD_Fläche" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Sekundär: heller, dezenter.  -->
        <Style
            x:Key="ButtonSekundär"
            BasedOn="{StaticResource ButtonBasis}"
            TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!--  Destruktiv: dezent rot abgesetzt, nicht schreiend.  -->
        <Style
            x:Key="ButtonLöschen"
            BasedOn="{StaticResource ButtonBasis}"
            TargetType="Button">
            <Setter Property="Background" Value="#FFFDF2F2" />
            <Setter Property="BorderBrush" Value="#FFE7B7B7" />
            <Setter Property="Foreground" Value="#FF9B1C1C" />
        </Style>

        <!--
            Karte: weiss, feiner Rand, abgerundet.
            
            Bewusst OHNE DropShadowEffect: Ein Effect zwingt WPF, den ganzen Teilbaum
            samt Text als Bitmap durch die Effekt-Pipeline zu rendern. Dabei geht die
            ClearType-Darstellung verloren und die Schrift wirkt weich – genau der
            „WinForms-Eindruck". Die Tiefe kommt stattdessen über einen etwas
            kräftigeren Rand.
        -->
        <Style x:Key="Karte" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFC3CEDC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10,12,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="KartenTitel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FF1F2937" />
        </Style>

        <Style x:Key="KartenUntertitel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!--
            Pfadfeld: bewusst beschreibbar. Ein Pfad soll sich löschen, tippen oder
            aus der Zwischenablage einfügen lassen – nicht nur über „Wählen …".
        -->
        <Style x:Key="PfadFeld" TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FFF8FAFC" />
            <Setter Property="BorderBrush" Value="#FFCBD5E1" />
            <Setter Property="Foreground" Value="#FF1F2937" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

    </UserControl.Resources>

    <!--  Byte-Dubletten-Ansicht: aus dem Dubletten-Ordner löschen, Referenzbestand behalten.  -->
    <Grid x:Name="GRD_DublettenWurzel" Background="#FFF6F7F9">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ROW_Kopf" Height="Auto" />
            <RowDefinition x:Name="ROW_Ordner" Height="Auto" />
            <RowDefinition x:Name="ROW_Suche" Height="Auto" />
            <RowDefinition x:Name="ROW_Treffer" Height="*" />
            <RowDefinition x:Name="ROW_Aktionen" Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ===== Kopfzeile =====  -->
        <Grid x:Name="GRD_Kopf" Margin="14,12,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="COL_KopfText" Width="*" />
                <ColumnDefinition x:Name="COL_KopfIndikatoren" Width="Auto" />
                <ColumnDefinition x:Name="COL_KopfZurück" Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="STP_KopfText" Grid.Column="0">
                <TextBlock
                    x:Name="TXT_KopfTitel"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#FF111827"
                    Text="Byte-Duplikate aufräumen" />
                <TextBlock
                    x:Name="TXT_KopfUntertitel"
                    Style="{StaticResource KartenUntertitel}"
                    Text="Sucht im Dubletten-Ordner alle Dateien, die byte-identisch auch im Referenzbestand liegen. Gelöscht wird erst nach Auswahl und Rückfrage – und nur in den Papierkorb. Der Referenzbestand bleibt unangetastet." />
            </StackPanel>

            <!--
                Aufnahme-Anzeigen. Sie lagen bis hierher im MainWindow und schwebten über
                allen drei Ansichten. Damit sie hier nicht verschwinden, steht dasselbe
                Steuerelement auch in dieser Kopfzeile.
            -->
            <ansichten:IndikatorLeiste
                x:Name="CTL_Indikatoren"
                Grid.Column="1"
                Margin="12,0,10,0"
                VerticalAlignment="Top" />

            <Button
                x:Name="BTN_DublettenZurueck"
                Grid.Column="2"
                VerticalAlignment="Top"
                Command="{Binding CommandExecuteDublettenAnsichtSchliessenCommand}"
                Style="{StaticResource ButtonSekundär}"
                ToolTip="Zurück zur Bildansicht">
                <StackPanel x:Name="STP_ZurueckInhalt" Orientation="Horizontal">
                    <TextBlock
                        x:Name="IC_Zurueck"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="11"
                        Text="&#xE72B;" />
                    <TextBlock x:Name="TXT_Zurueck" Text="Zurück" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  ===== Karte: Ordner =====  -->
        <Border
            x:Name="BRD_OrdnerKarte"
            Grid.Row="1"
            Margin="14,0,14,10"
            Style="{StaticResource Karte}">
            <Grid x:Name="GRD_Ordner">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ROW_OrdnerTitel" Height="Auto" />
                    <RowDefinition x:Name="ROW_Dubletten" Height="Auto" />
                    <RowDefinition x:Name="ROW_Referenz" Height="Auto" />
                    <RowDefinition x:Name="ROW_Optionen" Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="STP_OrdnerTitel" Grid.Row="0">
                    <StackPanel x:Name="STP_OrdnerTitelZeile" Orientation="Horizontal">
                        <TextBlock
                            x:Name="IC_Ordner"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="13"
                            Foreground="#FF64748B"
                            Text="&#xE8B7;" />
                        <TextBlock
                            x:Name="TXT_OrdnerTitel"
                            VerticalAlignment="Center"
                            Style="{StaticResource KartenTitel}"
                            Text="Ordner" />
                    </StackPanel>
                </StackPanel>

                <!--
                    Dubletten-Ordner: die Seite, die weg kann. Als eigene Gruppe gerahmt,
                    damit auf einen Blick klar ist, was zusammengehört – und dass diese
                    Zeile die gefährliche ist.
                -->
                <Border
                    x:Name="BRD_DublettenZeile"
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    Padding="8"
                    local:OrdnerDropHelper.Command="{Binding CommandExecuteDublettenOrdnerAusDropCommand}"
                    CornerRadius="8"
                    SnapsToDevicePixels="True"
                    ToolTip="Datei oder Ordner irgendwo auf diese Zeile ziehen, um den Dubletten-Ordner zu setzen">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FFFEFCFC" />
                            <Setter Property="BorderBrush" Value="#FFEBD8D8" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <Trigger Property="local:OrdnerDropHelper.IstZielAktiv" Value="True">
                                    <Setter Property="Background" Value="#FFFDECEC" />
                                    <Setter Property="BorderBrush" Value="#FFD98A8A" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid x:Name="GRD_DublettenOrdner">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="COL_DublettenLabel" Width="Auto" />
                            <ColumnDefinition x:Name="COL_DublettenFeld" Width="*" />
                            <ColumnDefinition x:Name="COL_DublettenButton" Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            x:Name="STP_DublettenLabel"
                            Grid.Column="0"
                            VerticalAlignment="Center">
                            <!--
                                Keine feste Höhe: Zwei Textzeilen brauchen mehr als die vorherigen
                                29 px, sonst werden Unterlängen (g, ö) abgeschnitten. Padding gibt
                                Luft zum Rand, der dezente Hintergrund zeigt, dass hier abgelegt
                                werden kann – beim Ziehen färbt er sich kräftiger.
                            -->
                            <!--
                                Nur noch Beschriftung: Drop-Ziel ist die ganze Zeile
                                (BRD_DublettenZeile), damit die Trefferfläche gross ist.
                            -->
                            <Border
                                x:Name="BRD_DublettenDropZone"
                                MinWidth="150"
                                Padding="9,6"
                                Background="Transparent"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                                <StackPanel x:Name="STP_DublettenDropInhalt">
                                    <TextBlock
                                        x:Name="TXT_DublettenLabel"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#FF1F2937"
                                        Text="Dubletten-Ordner" />
                                    <TextBlock
                                        x:Name="TXT_DublettenHinweis"
                                        Margin="0,2,0,0"
                                        FontSize="10"
                                        Foreground="#FF9B1C1C"
                                        Text="hier wird gelöscht" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!--
                            UpdateSourceTrigger=PropertyChanged: Der Suchen-Knopf prüft per
                            CanExecute, ob der Ordner existiert. Ohne das käme die Änderung
                            erst beim Verlassen des Feldes an.
                        -->
                        <TextBox
                            x:Name="TXB_DublettenOrdner"
                            Grid.Column="1"
                            Margin="8,0,8,0"
                            d:Text="C:\Bilder\Sammlung"
                            AllowDrop="False"
                            Style="{StaticResource PfadFeld}"
                            Text="{Binding DublettenOrdner, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Pfad lässt sich tippen, einfügen oder löschen" />

                        <Button
                            x:Name="BTN_DublettenOrdnerWaehlen"
                            Grid.Column="2"
                            Command="{Binding CommandExecuteDublettenOrdnerWaehlenCommand}"
                            Content="Wählen …"
                            Style="{StaticResource ButtonBasis}" />
                    </Grid>
                </Border>

                <!--
                    Referenzordner: der Bestand, der bleibt. Gleicher Rahmen wie die
                    Dubletten-Zeile, nur in Grün – die beiden Seiten sollen sich auf
                    einen Blick unterscheiden lassen.
                -->
                <Border
                    x:Name="BRD_ReferenzZeile"
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    Padding="8"
                    local:OrdnerDropHelper.Command="{Binding CommandExecuteReferenzOrdnerAusDropCommand}"
                    CornerRadius="8"
                    SnapsToDevicePixels="True"
                    ToolTip="Datei oder Ordner irgendwo auf diese Zeile ziehen, um einen Referenzordner hinzuzufügen">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FFFCFDFC" />
                            <Setter Property="BorderBrush" Value="#FFDCEDE3" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <Trigger Property="local:OrdnerDropHelper.IstZielAktiv" Value="True">
                                    <Setter Property="Background" Value="#FFECFDF3" />
                                    <Setter Property="BorderBrush" Value="#FF6BB68A" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid x:Name="GRD_ReferenzOrdner">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="COL_ReferenzLabel" Width="Auto" />
                            <ColumnDefinition x:Name="COL_ReferenzListe" Width="*" />
                            <ColumnDefinition x:Name="COL_ReferenzButtons" Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            x:Name="STP_ReferenzLabel"
                            Grid.Column="0"
                            VerticalAlignment="Top">
                            <Border
                                x:Name="BRD_ReferenzDropZone"
                                MinWidth="150"
                                Padding="9,6"
                                Background="Transparent"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                                <StackPanel x:Name="STP_ReferenzDropInhalt">
                                    <TextBlock
                                        x:Name="TXT_ReferenzLabel"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#FF1F2937"
                                        Text="Referenzordner" />
                                    <TextBlock
                                        x:Name="TXT_ReferenzHinweis"
                                        Margin="0,2,0,0"
                                        FontSize="10"
                                        Foreground="#FF059669"
                                        Text="bleibt unangetastet" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border
                            x:Name="BRD_ReferenzListe"
                            Grid.Column="1"
                            MinHeight="60"
                            MaxHeight="110"
                            Margin="0,0,8,0"
                            Background="#FFF8FAFC"
                            BorderBrush="#FFCBD5E1"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid x:Name="GRD_ReferenzListeInhalt">
                                <ListBox
                                    x:Name="LBX_ReferenzOrdner"
                                    d:ItemsSource="{d:SampleData ItemCount=2}"
                                    AllowDrop="False"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FocusVisualStyle="{x:Null}"
                                    FontSize="12"
                                    ItemsSource="{Binding DublettenReferenzOrdner}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    SelectedItem="{Binding AusgewaehlterReferenzOrdner, Mode=TwoWay}" />

                                <TextBlock
                                    x:Name="TXT_KeineReferenzOrdner"
                                    Margin="8,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    d:Visibility="Collapsed"
                                    FontSize="11"
                                    FontStyle="Italic"
                                    Foreground="Gray"
                                    IsHitTestVisible="False"
                                    Text="Noch kein Referenzordner gewählt">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DublettenReferenzOrdner.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <StackPanel
                            x:Name="STP_ReferenzButtons"
                            Grid.Column="2"
                            VerticalAlignment="Top">
                            <Button
                                x:Name="BTN_ReferenzOrdnerHinzufuegen"
                                Margin="0,0,0,6"
                                Command="{Binding CommandExecuteReferenzOrdnerHinzufuegenCommand}"
                                Content="Ordner +"
                                Style="{StaticResource ButtonBasis}"
                                ToolTip="Einen oder mehrere Ordner zum Durchsuchen hinzufügen" />
                            <!--
                                „Eine Ebene höher" wie das „..“ im Dateimanager: ersetzt den
                                markierten Eintrag durch seinen übergeordneten Ordner.
                            -->
                            <Button
                                x:Name="BTN_ReferenzOrdnerEineEbeneHoch"
                                Margin="0,0,0,6"
                                Command="{Binding CommandExecuteReferenzOrdnerEineEbeneHochCommand}"
                                Style="{StaticResource ButtonBasis}"
                                ToolTip="Markierten Ordner durch den übergeordneten ersetzen (wie „..“ im Dateimanager)">
                                <StackPanel x:Name="STP_EineEbeneHochInhalt" Orientation="Horizontal">
                                    <TextBlock
                                        x:Name="IC_EineEbeneHoch"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="12"
                                        Text="&#xE74A;" />
                                    <TextBlock x:Name="TXT_EineEbeneHoch" Text="Eine Ebene höher" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="BTN_ReferenzOrdnerEntfernen"
                                Command="{Binding CommandExecuteReferenzOrdnerEntfernenCommand}"
                                Content="Entfernen"
                                Style="{StaticResource ButtonBasis}"
                                ToolTip="Markierten Ordner aus der Liste nehmen" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--
                    Optionen unter den beiden gerahmten Zeilen. GRD_Ordner hat keine
                    Spalten, ein Grid.Column wäre hier wirkungslos.

                    WrapPanel statt StackPanel: Die beiden Optionsgruppen, die
                    Einlese-Anzeige und der Entfernen-Knopf passen nicht immer
                    nebeneinander. Im StackPanel ragte das letzte Element seitlich
                    heraus; hier bricht es um, und die Karte wächst mit (Zeile ist Auto).

                    Die vier Haken sind zwei verschiedene Sorten und deshalb getrennt
                    beschriftet: „Umfang" bestimmt, WAS eingesammelt wird, und liest den
                    Ordner sofort neu ein. „Kriterium" bestimmt, WIE verglichen wird, und
                    wirkt erst beim nächsten Suchlauf. In einer Reihe nebeneinander war
                    weder das eine noch das andere zu erkennen — auch nicht, warum die
                    ersten beiden sofort etwas tun und die anderen scheinbar nichts.

                    Gruppen als eigene StackPanel: So bleibt eine Gruppe beim Umbruch
                    zusammen, statt zwischen Beschriftung und Haken zu zerreissen.
                -->
                <WrapPanel
                    x:Name="STP_DublettenOptionen"
                    Grid.Row="3"
                    Margin="2,12,0,0"
                    Orientation="Horizontal">

                    <!--  ===== Gruppe: Umfang — was überhaupt eingesammelt wird =====  -->
                    <StackPanel x:Name="STP_GruppeUmfang" Margin="0,0,0,4">
                        <TextBlock
                            x:Name="TXT_GruppeUmfang"
                            Margin="0,0,0,5"
                            FontSize="11"
                            Foreground="Gray"
                            Text="Umfang — was durchsucht wird" />

                        <CheckBox
                            x:Name="CHK_MitUnterordnern"
                            Margin="0,0,0,4"
                            VerticalContentAlignment="Center"
                            FontSize="12"
                            Foreground="#FF1F2937"
                            IsChecked="{Binding DublettenMitUnterordnern}"
                            ToolTip="Aus: nur der Ordner selbst. Ein: alle Unterordner mit – auf grossen Bäumen deutlich langsamer.">
                            <StackPanel x:Name="STP_UnterordnerInhalt" Orientation="Horizontal">
                                <TextBlock
                                    x:Name="IC_Unterordner"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13"
                                    Foreground="#FF64748B"
                                    Text="&#xED43;" />
                                <TextBlock x:Name="TXT_Unterordner" Text="Unterordner einbeziehen" />
                            </StackPanel>
                        </CheckBox>

                        <!--
                            Das Symbol wechselt mit dem Zustand: Bild-Symbol solange nur Bilder
                            gesucht werden, Raster sobald alle Dateitypen gelten. So ist der
                            aktuelle Modus auch ohne Lesen des Hakens erkennbar.
                        -->
                        <CheckBox
                            x:Name="CHK_AlleDateitypen"
                            VerticalContentAlignment="Center"
                            FontSize="12"
                            Foreground="#FF1F2937"
                            IsChecked="{Binding DublettenAlleDateitypen}"
                            ToolTip="Aus: nur Bilddateien (jpg, png, bmp, gif, webp). Ein: jede Datei – auch Archive, Videos, Dokumente. Die Liste wird sofort neu eingelesen.">
                            <StackPanel x:Name="STP_DateitypenInhalt" Orientation="Horizontal">
                                <TextBlock
                                    x:Name="IC_Dateitypen"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xEB9F;" />
                                            <Setter Property="Foreground" Value="#FF64748B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DublettenAlleDateitypen}" Value="True">
                                                    <Setter Property="Text" Value="&#xE71D;" />
                                                    <Setter Property="Foreground" Value="#FF1F2937" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock x:Name="TXT_Dateitypen" Text="Alle Dateitypen" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>

                    <!--
                        Trennt die beiden Gruppen. Ohne feste Höhe: Der Strich wird auf die
                        Höhe der Zeile gedehnt, die die Gruppen ohnehin vorgeben.
                    -->
                    <Border
                        x:Name="BRD_OptionenTrenner"
                        Width="1"
                        Margin="22,2,22,6"
                        VerticalAlignment="Stretch"
                        Background="#FFE2E8F0" />

                    <!--  ===== Gruppe: Kriterium — wann etwas als Dublette gilt =====  -->
                    <StackPanel x:Name="STP_GruppeKriterium" Margin="0,0,0,4">
                        <TextBlock
                            x:Name="TXT_GruppeKriterium"
                            Margin="0,0,0,5"
                            FontSize="11"
                            Foreground="Gray"
                            Text="Kriterium — wann etwas als Dublette gilt" />

                        <!--
                            Grenzt die Paarbildung auf gleichnamige Dateien ein — die Denkweise
                            der Dublettensuche im Dateimanager. Nebeneffekt: Der Lauf wird
                            drastisch schneller, weil pro Kandidat statt einer ganzen
                            Grössengruppe meist genau ein Gegenstück übrig bleibt.
                        -->
                        <CheckBox
                            x:Name="CHK_NurGleicherName"
                            Margin="0,0,0,4"
                            VerticalContentAlignment="Center"
                            FontSize="12"
                            Foreground="#FF1F2937"
                            IsChecked="{Binding DublettenNurGleicherName}"
                            ToolTip="Aus: jede Datei wird gegen den gesamten Bestand gleicher Grösse geprüft. Ein: nur gegen Dateien mit demselben Dateinamen – die Ordner dürfen anders heissen. Deutlich schneller, besonders über Netzlaufwerke.">
                            <StackPanel x:Name="STP_NurGleicherNameInhalt" Orientation="Horizontal">
                                <TextBlock
                                    x:Name="IC_NurGleicherName"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE8AC;" />
                                            <Setter Property="Foreground" Value="#FF64748B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DublettenNurGleicherName}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF1F2937" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock x:Name="TXT_NurGleicherName" Text="Nur gleicher Dateiname" />
                            </StackPanel>
                        </CheckBox>

                        <!--
                            Eingerückt, weil es keine gleichrangige fünfte Option ist,
                            sondern eine Unteroption des Namensvergleichs: Ohne
                            Namensbezug bliebe „alles gleicher Grösse ist eine Dublette"
                            übrig, und das räumt wahllos ab. Deshalb nur bedienbar,
                            solange der Haken darüber gesetzt ist — sichtbar bleibt er
                            trotzdem, sonst fände ihn niemand.

                            Das Symbol wechselt in den Warnzustand, sobald der Inhalt nicht
                            mehr geprüft wird — der riskante Zustand soll auffallen, ohne
                            dass man den Haken liest. Im gesperrten Zustand wird es
                            mitgedimmt: Eine ausdrücklich gesetzte Foreground-Farbe macht
                            die Ausgrauung von WPF sonst nicht mit, und das Symbol stünde
                            in voller Farbe neben einer blassen Beschriftung.
                        -->
                        <CheckBox
                            x:Name="CHK_Tiefenpruefung"
                            Margin="18,0,0,0"
                            VerticalContentAlignment="Center"
                            FontSize="12"
                            Foreground="#FF1F2937"
                            IsChecked="{Binding DublettenTiefenpruefung}"
                            IsEnabled="{Binding DublettenNurGleicherName}"
                            ToolTip="Ein (Vorgabe): Der Inhalt wird gelesen und geprüft – ein Treffer ist dann sicher. Aus: Es entscheidet allein der Dateiname, keine Datei wird geöffnet. Das ist in Sekunden fertig, kann aber gleichnamige Dateien mit verschiedenem Inhalt zusammenbringen. Nur zusammen mit „Nur gleicher Dateiname“ abschaltbar.">
                            <StackPanel x:Name="STP_TiefenpruefungInhalt" Orientation="Horizontal">
                                <TextBlock
                                    x:Name="IC_Tiefenpruefung"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE9D9;" />
                                            <Setter Property="Foreground" Value="#FF1F2937" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DublettenTiefenpruefung}" Value="False">
                                                    <Setter Property="Text" Value="&#xE7BA;" />
                                                    <Setter Property="Foreground" Value="#FFB45309" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DublettenNurGleicherName}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock x:Name="TXT_Tiefenpruefung" Text="Inhalt prüfen" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>

                    <!--  Arbeitsanzeige: nur während des Einlesens, mit Abbruchmöglichkeit  -->
                    <StackPanel
                        x:Name="STP_EinlesenAnzeige"
                        Margin="24,0,0,4"
                        VerticalAlignment="Center"
                        d:Visibility="Visible"
                        Orientation="Horizontal"
                        Visibility="{Binding CommandExecuteDublettenOrdnerNeuLesenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}}">
                        <TextBlock
                            x:Name="IC_EinlesenSpinner"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="13"
                            Foreground="#FF64748B"
                            RenderTransformOrigin="0.5,0.5"
                            Text="&#xE72C;">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="0" />
                            </TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CommandExecuteDublettenOrdnerNeuLesenCommand.IsRunning}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="SB_EinlesenSpinner">
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            RepeatBehavior="Forever"
                                                            Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                                                            From="0"
                                                            To="360"
                                                            Duration="0:0:0.9" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="SB_EinlesenSpinner" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock
                            x:Name="TXT_EinlesenHinweis"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="Gray"
                            Text="liest …" />

                        <Button
                            x:Name="BTN_EinlesenAbbrechen"
                            Margin="8,0,0,0"
                            Padding="6,1"
                            VerticalAlignment="Center"
                            Command="{Binding CommandExecuteDublettenOrdnerNeuLesenCancelCommand}"
                            Content="&#xE711;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="9"
                            Foreground="DarkRed"
                            Style="{StaticResource ButtonSekundär}"
                            ToolTip="Einlesen abbrechen" />
                    </StackPanel>

                    <!--
                        Erscheint erst, wenn im Dubletten-Ordner keine Datei mehr liegt –
                        also typischerweise nach dem Aufräumen. Löschstil, weil der Ordner
                        tatsächlich verschwindet (in den Papierkorb).
                    -->
                    <Button
                        x:Name="BTN_LeerenOrdnerLoeschen"
                        Margin="24,0,0,4"
                        Padding="9,1"
                        VerticalAlignment="Center"
                        d:Visibility="Visible"
                        Command="{Binding CommandExecuteLeerenDublettenOrdnerLoeschenCommand}"
                        Style="{StaticResource ButtonLöschen}"
                        ToolTip="Der Dubletten-Ordner enthält keine Datei mehr – leere Hülle samt leerer Unterordner in den Papierkorb verschieben"
                        Visibility="{Binding DublettenOrdnerIstLeer, Converter={StaticResource CLconverterVisiblityBoolian}}">
                        <StackPanel x:Name="STP_LeerenOrdnerInhalt" Orientation="Horizontal">
                            <TextBlock
                                x:Name="IC_LeererOrdner"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="12"
                                Text="&#xE74D;" />
                            <TextBlock
                                x:Name="TXT_LeererOrdner"
                                FontSize="11"
                                Text="Leeren Ordner entfernen" />
                        </StackPanel>
                    </Button>

                    <!--
                        Steht anstelle des Entfernen-Knopfes, solange noch Dateien im
                        Ordner liegen. Ohne diesen Hinweis wäre nicht erkennbar, warum
                        der Knopf ausbleibt – gerade bei „nur Bilder" bleibt alles
                        andere zwangsläufig zurück.
                    -->
                    <TextBlock
                        x:Name="TXT_OrdnerRestHinweis"
                        Margin="24,0,0,4"
                        VerticalAlignment="Center"
                        d:Text="noch 143 Dateien im Dubletten-Ordner"
                        FontSize="11"
                        Foreground="Gray"
                        Text="{Binding DublettenOrdnerRestText}"
                        ToolTip="{Binding DublettenOrdnerRestTooltip}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!--  ===== Karte: Suche =====  -->
        <Border
            x:Name="BRD_SucheKarte"
            Grid.Row="2"
            Margin="14,0,14,10"
            Style="{StaticResource Karte}">
            <Grid x:Name="GRD_Suche">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="COL_SucheButton" Width="Auto" />
                    <ColumnDefinition x:Name="COL_SucheAbbrechen" Width="Auto" />
                    <ColumnDefinition x:Name="COL_SucheFortschritt" Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="BTN_ByteDublettenSuchen"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Command="{Binding CommandExecuteByteDublettenSuchenCommand}"
                    Style="{StaticResource ButtonBasis}"
                    ToolTip="Im Dubletten-Ordner alles suchen, was byte-identisch im Referenzbestand liegt">
                    <StackPanel x:Name="STP_SuchenInhalt" Orientation="Horizontal">
                        <TextBlock
                            x:Name="IC_Suchen"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11"
                            Text="&#xE71E;" />
                        <TextBlock x:Name="TXT_Suchen" Text="Byte-Duplikate suchen" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="BTN_ByteDublettenSuchenAbbrechen"
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    d:Visibility="Visible"
                    Command="{Binding CommandExecuteByteDublettenSuchenCancelCommand}"
                    Content="Abbrechen"
                    Style="{StaticResource ButtonSekundär}"
                    ToolTip="Suche abbrechen"
                    Visibility="{Binding CommandExecuteByteDublettenSuchenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}}" />

                <StackPanel
                    x:Name="STP_SuchFortschritt"
                    Grid.Column="2"
                    VerticalAlignment="Center">
                    <!--
                        Statuszeile ohne Restzeit: die steht jetzt unten direkt neben dem
                        Balken, sonst stünde dieselbe Angabe zweimal untereinander.
                    -->
                    <Grid x:Name="GRD_StatusZeile">
                        <TextBlock
                            x:Name="TXT_DublettenStatus"
                            d:Text="Wird in den Papierkorb verschoben … 12 von 40"
                            FontSize="12"
                            Foreground="#FF374151"
                            Text="{Binding DublettenStatus}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!--  Balken, Restzeit und Abbruch in einer Zeile  -->
                    <Grid x:Name="GRD_FortschrittZeile" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="COL_Balken" Width="*" />
                            <ColumnDefinition x:Name="COL_Restzeit" Width="Auto" />
                            <ColumnDefinition x:Name="COL_Abbrechen" Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ProgressBar
                            x:Name="PGB_DublettenFortschritt"
                            Grid.Column="0"
                            Height="4"
                            VerticalAlignment="Center"
                            d:Value="35"
                            Background="#FFEFF1F4"
                            BorderThickness="0"
                            Foreground="#FF64748B"
                            IsIndeterminate="{Binding DublettenFortschrittUnbestimmt}"
                            Maximum="{Binding DublettenFortschrittMax}"
                            Value="{Binding DublettenFortschritt}" />

                        <TextBlock
                            x:Name="TXT_DublettenRestzeit"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            d:Text="noch ca. 45 s"
                            FontSize="11"
                            Foreground="Gray"
                            Text="{Binding DublettenRestzeit}" />

                        <Button
                            x:Name="BTN_LoeschenAbbrechenBalken"
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            d:Visibility="Visible"
                            Command="{Binding CommandExecuteMarkierteLoeschenCancelCommand}"
                            Content="&#xE711;"
                            Cursor="Hand"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Style="{StaticResource ButtonLöschen}"
                            ToolTip="Verschieben in den Papierkorb abbrechen"
                            Visibility="{Binding CommandExecuteMarkierteLoeschenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!--  ===== Karte: Treffer =====  -->
        <Border
            x:Name="BRD_TrefferKarte"
            Grid.Row="3"
            Margin="14,0,14,10"
            Style="{StaticResource Karte}">
            <Grid x:Name="GRD_Treffer">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ROW_TrefferKopf" Height="Auto" />
                    <RowDefinition x:Name="ROW_TrefferListe" Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="GRD_TrefferKopf"
                    Grid.Row="0"
                    Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="COL_TrefferTitel" Width="*" />
                        <ColumnDefinition x:Name="COL_TrefferZaehler" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        x:Name="STP_TrefferTitel"
                        Grid.Column="0"
                        Orientation="Horizontal">
                        <TextBlock
                            x:Name="IC_Treffer"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="13"
                            Foreground="#FF64748B"
                            Text="&#xE8C8;" />
                        <!--
                            Beim Öffnen der Ansicht wird der Ordner des angezeigten Bildes
                            übernommen und sein Inhalt aufgelistet. Über dieser Liste stand
                            „Gefundene Duplikate" — behauptet war damit ein Ergebnis, das es
                            noch gar nicht gab. Titel und Zusatz nennen jetzt den Stand.
                        -->
                        <TextBlock
                            x:Name="TXT_TrefferTitel"
                            VerticalAlignment="Center"
                            d:Text="Gefundene Duplikate"
                            Style="{StaticResource KartenTitel}"
                            Text="{Binding DublettenTrefferTitel}" />
                        <TextBlock
                            x:Name="TXT_TrefferUntertitel"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            d:Text="ungeprüft – erst die Suche bestätigt Duplikate"
                            FontSize="11"
                            Foreground="Gray"
                            Text="{Binding DublettenTrefferUntertitel}"
                            TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DublettenSucheGelaufen}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!--  Zähler-Pille  -->
                    <Border
                        x:Name="BRD_TrefferZaehler"
                        Grid.Column="1"
                        MinWidth="160"
                        Padding="10,3"
                        Background="#FFF1F5F9"
                        BorderBrush="#FFCBD5E1"
                        BorderThickness="1"
                        CornerRadius="10">
                        <!--
                            Während der Suche zählt die Pille nichts: Die Treffer stehen
                            erst am Ende fest, bis dahin behauptete sie minutenlang
                            „0 markiert – 0,0 MB". Das las sich wie ein Ergebnis, war aber
                            nur der Anfangszustand. Deshalb tritt für die Dauer der Suche
                            eine Wortmeldung an ihre Stelle.

                            Beim Löschlauf bleiben die Zahlen stehen — dort zählen sie
                            tatsächlich herunter und sind die eigentliche Information.
                        -->
                        <Grid x:Name="GRD_TrefferZaehlerInhalt">
                            <!--
                                Feste Mindestbreiten für Zahl und Grösse: Beim Löschen zählen
                                beide herunter, und ohne das würde die Pille bei jedem Schritt
                                in der Breite springen. Rechtsbündig, damit die Ziffern stehen.
                            -->
                            <StackPanel x:Name="STP_TrefferZaehler" Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandExecuteByteDublettenSuchenCommand.IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock
                                    x:Name="TXT_TrefferMarkiert"
                                    MinWidth="26"
                                    d:Text="18"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#FF1F2937"
                                    Text="{Binding DublettenMarkierteAnzahl}"
                                    TextAlignment="Right" />
                                <TextBlock
                                    x:Name="TXT_TrefferMarkiertLabel"
                                    Margin="5,0,8,0"
                                    FontSize="12"
                                    Foreground="Gray"
                                    Text="markiert" />
                                <TextBlock
                                    x:Name="TXT_TrefferGroesse"
                                    MinWidth="62"
                                    d:Text="42,3 MB"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#FF9B1C1C"
                                    Text="{Binding DublettenMarkierteGroesseText}"
                                    TextAlignment="Right" />
                            </StackPanel>

                            <TextBlock
                                x:Name="TXT_TrefferZaehlerWaehrendSuche"
                                HorizontalAlignment="Center"
                                d:Visibility="Collapsed"
                                FontSize="12"
                                Foreground="Gray"
                                Text="steht am Ende fest">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandExecuteByteDublettenSuchenCommand.IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>

                <Border
                    x:Name="BRD_TrefferListe"
                    Grid.Row="1"
                    Background="#FFFCFCFD"
                    BorderBrush="#FFE5E7EB"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid x:Name="GRD_TrefferListeInhalt">
                        <ListBox
                            x:Name="LBX_ByteDubletten"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            FocusVisualStyle="{x:Null}"
                            ItemsSource="{Binding ByteDublettenTreffer}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">

                            <!--
                                Nur für den Designer: zeigt alle vier Zeilenzustände
                                (bestätigt/markiert, bestätigt/abgewählt, ungeprüft,
                                gelöscht). Zur Laufzeit greift ItemsSource oben.
                            -->
                            <d:ListBox.ItemsSource>
                                <bildersuche:ByteDublettenDesignDaten />
                            </d:ListBox.ItemsSource>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type bildersuche:ByteDublettenTreffer}">
                                    <Border
                                        x:Name="BRD_TrefferZeile"
                                        Margin="4,3"
                                        Padding="8,6"
                                        Background="White"
                                        BorderBrush="#FFE5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <Grid x:Name="GRD_TrefferZeileInhalt">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="COL_ZeileHaken" Width="Auto" />
                                                <ColumnDefinition x:Name="COL_ZeileIcon" Width="Auto" />
                                                <ColumnDefinition x:Name="COL_ZeileDublette" Width="*" />
                                                <ColumnDefinition x:Name="COL_ZeileGroesse" Width="Auto" />
                                                <ColumnDefinition x:Name="COL_ZeileExplorer" Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox
                                                x:Name="CHK_TrefferMarkiert"
                                                Grid.Column="0"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding IstMarkiert, Mode=TwoWay}"
                                                ToolTip="Zum Löschen vormerken" />

                                            <!--
                                                Windows-Dateisymbol: zeigt auf einen Blick PDF, JPG,
                                                Archiv … Kommt aus FileIconProvider, der je Endung
                                                zwischenspeichert – kein Plattenzugriff pro Zeile.
                                                
                                                Darunter liegt ein neutrales Blatt-Symbol als
                                                Platzhalter. Es braucht keinen Converter: Liefert der
                                                Provider nichts (Datei fehlt, gesperrt, oder im
                                                Designer), bleibt das Image leer und der Platzhalter
                                                scheint durch. So bleibt die Spalte immer belegt und
                                                die Zeilen fluchten.
                                            -->
                                            <Grid
                                                x:Name="GRD_ZeileDateiIcon"
                                                Grid.Column="1"
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    x:Name="IC_ZeileIconPlatzhalter"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="14"
                                                    Foreground="#FFB4BECB"
                                                    Text="&#xE7C3;" />
                                                <Image
                                                    x:Name="IMG_ZeileDateiIcon"
                                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                    Source="{Binding DublettenDatei, Converter={StaticResource CLconverterStringZuDateiIcon}}" />
                                            </Grid>

                                            <StackPanel x:Name="STP_ZeilePfade" Grid.Column="2">
                                                <!--  Löschkandidat  -->
                                                <TextBlock
                                                    x:Name="TXT_ZeileDublette"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="#FF1F2937"
                                                    Text="{Binding DublettenDateiName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding DublettenDatei}" />
                                                <TextBlock
                                                    x:Name="TXT_ZeileDublettenOrdner"
                                                    FontSize="10"
                                                    Foreground="#FF9B1C1C"
                                                    Text="{Binding DublettenOrdner}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding DublettenDatei}" />
                                                <!--  Behaltenes Gegenstück  -->
                                                <StackPanel
                                                    x:Name="STP_ZeileReferenz"
                                                    Margin="0,3,0,0"
                                                    Orientation="Horizontal">
                                                    <!--
                                                        Der grüne Haken steht für „Inhalt verglichen".
                                                        Wurde nur der Name geprüft, wäre er eine
                                                        Zusicherung, die niemand eingelöst hat — dann
                                                        steht dort das Warnzeichen.
                                                    -->
                                                    <TextBlock
                                                        x:Name="IC_ZeileReferenz"
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="9">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE73E;" />
                                                                <Setter Property="Foreground" Value="#FF059669" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IstNurNamensTreffer}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE7BA;" />
                                                                        <Setter Property="Foreground" Value="#FFB45309" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock
                                                        x:Name="TXT_ZeileReferenz"
                                                        FontSize="10"
                                                        Foreground="Gray"
                                                        Text="{Binding ReferenzDatei}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding ReferenzDatei}" />

                                                    <!--
                                                        Nur bei Namenstreffern sichtbar. Nennt bei
                                                        abweichender Grösse gleich die des Bestands —
                                                        das ist der Fall, in dem sicher feststeht, dass
                                                        es nicht dieselbe Datei ist.
                                                    -->
                                                    <Border
                                                        x:Name="BRD_ZeilePruefung"
                                                        Margin="6,0,0,0"
                                                        Padding="5,0"
                                                        VerticalAlignment="Center"
                                                        d:Visibility="Visible"
                                                        Background="#FFFEF3C7"
                                                        BorderBrush="#FFFCD34D"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        ToolTip="{Binding PruefungTooltip}"
                                                        Visibility="{Binding IstNurNamensTreffer, Converter={StaticResource CLconverterVisiblityBoolian}}">
                                                        <TextBlock
                                                            x:Name="TXT_ZeilePruefung"
                                                            d:Text="nur Name — Bestand 2,4 MB"
                                                            FontSize="10"
                                                            Foreground="#FFB45309"
                                                            Text="{Binding PruefungHinweis}" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock
                                                x:Name="TXT_ZeileGroesse"
                                                Grid.Column="3"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="#FF64748B"
                                                Text="{Binding GroesseText}" />

                                            <Button
                                                x:Name="BTN_ZeileImExplorer"
                                                Grid.Column="4"
                                                Width="24"
                                                Height="24"
                                                Margin="8,0,0,0"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.CommandExecuteDubletteImExplorerZeigenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Content="&#xE838;"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="11"
                                                Style="{StaticResource ButtonSekundär}"
                                                ToolTip="Im Explorer zeigen" />
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <!--
                                            Noch nicht verglichen (reine Ordner-Auflistung nach dem
                                            Drop): Haken gesperrt, Gegenstück-Zeile ausgeblendet.
                                            Sonst entstünde der Eindruck, hier sei etwas geprüft.
                                        -->
                                        <DataTrigger Binding="{Binding IstBestaetigt}" Value="False">
                                            <Setter TargetName="CHK_TrefferMarkiert" Property="IsEnabled" Value="False" />
                                            <Setter TargetName="CHK_TrefferMarkiert" Property="Opacity" Value="0.35" />
                                            <Setter TargetName="STP_ZeileReferenz" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="TXT_ZeileDublettenOrdner" Property="Foreground" Value="Gray" />
                                        </DataTrigger>

                                        <!--  Bereits im Papierkorb: ausgegraut und durchgestrichen  -->
                                        <DataTrigger Binding="{Binding IstGeloescht}" Value="True">
                                            <Setter TargetName="BRD_TrefferZeile" Property="Opacity" Value="0.45" />
                                            <Setter TargetName="BRD_TrefferZeile" Property="Background" Value="#FFF3F4F6" />
                                            <Setter TargetName="TXT_ZeileDublette" Property="TextDecorations" Value="Strikethrough" />
                                            <Setter TargetName="CHK_TrefferMarkiert" Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!--  Platzhalter, solange nichts gefunden wurde  -->
                        <StackPanel
                            x:Name="STP_KeineTreffer"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            d:Visibility="Collapsed"
                            IsHitTestVisible="False">
                            <!--
                                Nur zeigen, solange nichts läuft. DublettenLeerHinweis wird
                                weder beim Suchstart noch beim Einlesen neu gesetzt und
                                stand deshalb während eines langen Laufs minutenlang auf
                                „Bereit – auf ‚Byte-Duplikate suchen‘ klicken": eine
                                Aufforderung, genau das zu tun, was gerade lief. Für beide
                                Fälle treten die Blöcke darunter an diese Stelle.
                            -->
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ByteDublettenTreffer.Count}" Value="0" />
                                                <Condition Binding="{Binding CommandExecuteByteDublettenSuchenCommand.IsRunning}" Value="False" />
                                                <Condition Binding="{Binding CommandExecuteDublettenOrdnerNeuLesenCommand.IsRunning}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock
                                x:Name="IC_KeineTreffer"
                                HorizontalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="28"
                                Foreground="#FFCBD5E1"
                                Text="&#xE8B7;" />
                            <TextBlock
                                x:Name="TXT_KeineTreffer"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                d:Text="Keine byte-gleichen Dateien im Referenzbestand gefunden"
                                FontSize="12"
                                Foreground="Gray"
                                Text="{Binding DublettenLeerHinweis}" />
                        </StackPanel>

                        <!--
                            Während der Suche. Die Liste bleibt bis zum Schluss leer — die
                            Treffer werden erst gesetzt, wenn alles verglichen ist. Genau
                            das muss hier stehen, sonst wartet man vor einer leeren Fläche
                            und weiss nicht, ob noch etwas kommt.

                            Der Fortschritt selbst steht bewusst nicht noch einmal hier: Er
                            steht eine Karte höher mit Balken und Restzeit, und zweimal
                            dieselbe Zahl auf einem Schirm liest sich wie zwei Vorgänge.
                        -->
                        <StackPanel
                            x:Name="STP_SucheLaeuft"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            d:Visibility="Collapsed"
                            IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CommandExecuteByteDublettenSuchenCommand.IsRunning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock
                                x:Name="IC_SucheLaeuftSpinner"
                                HorizontalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="24"
                                Foreground="#FFCBD5E1"
                                RenderTransformOrigin="0.5,0.5"
                                Text="&#xE72C;">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandExecuteByteDublettenSuchenCommand.IsRunning}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SB_SucheLaeuftSpinner">
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                RepeatBehavior="Forever"
                                                                Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                                                                From="0"
                                                                To="360"
                                                                Duration="0:0:1.6" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SB_SucheLaeuftSpinner" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock
                                x:Name="TXT_SucheLaeuftTitel"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#FF374151"
                                Text="Die Suche läuft" />

                            <TextBlock
                                x:Name="TXT_SucheLaeuftHinweis"
                                Margin="0,4,0,0"
                                MaxWidth="380"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Foreground="Gray"
                                Text="Die Liste füllt sich erst am Ende — verglichen wird bis dahin durchgehend. Stand und Restzeit stehen oben über dieser Karte."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!--
                            Während das Einlesen des Ordners läuft. Derselbe Fall wie bei
                            der Suche, nur kürzer: Die Liste ist geleert, und ohne diesen
                            Block stünde mitten darin der alte Leerhinweis. Über ein
                            Netzlaufwerk mit vielen Dateien zieht sich auch das Auflisten.

                            Bewusst ein anderer Text als bei der Suche: Hier wird nichts
                            verglichen, sondern nur aufgezählt, was auf der Löschseite
                            liegt — und die Zusatzbedingung stellt sicher, dass nie beide
                            Blöcke übereinanderliegen.
                        -->
                        <StackPanel
                            x:Name="STP_EinlesenLaeuft"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            d:Visibility="Collapsed"
                            IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CommandExecuteDublettenOrdnerNeuLesenCommand.IsRunning}" Value="True" />
                                                <Condition Binding="{Binding CommandExecuteByteDublettenSuchenCommand.IsRunning}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock
                                x:Name="IC_EinlesenLaeuftSpinner"
                                HorizontalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="24"
                                Foreground="#FFCBD5E1"
                                RenderTransformOrigin="0.5,0.5"
                                Text="&#xE72C;">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandExecuteDublettenOrdnerNeuLesenCommand.IsRunning}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SB_EinlesenLaeuftSpinner">
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                RepeatBehavior="Forever"
                                                                Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                                                                From="0"
                                                                To="360"
                                                                Duration="0:0:1.6" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SB_EinlesenLaeuftSpinner" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock
                                x:Name="TXT_EinlesenLaeuftTitel"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#FF374151"
                                Text="Der Ordner wird gelesen" />

                            <TextBlock
                                x:Name="TXT_EinlesenLaeuftHinweis"
                                Margin="0,4,0,0"
                                MaxWidth="380"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Foreground="Gray"
                                Text="Danach steht hier, was im Dubletten-Ordner liegt — aufgezählt, noch nicht verglichen. Der Stand steht oben über dieser Karte."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!--  ===== Aktionsleiste =====  -->
        <Border
            x:Name="BRD_Aktionsleiste"
            Grid.Row="4"
            Padding="14,10"
            Background="White"
            BorderBrush="#FFE5E7EB"
            BorderThickness="0,1,0,0">
            <Grid x:Name="GRD_Aktionen">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="COL_AktionenLinks" Width="Auto" />
                    <ColumnDefinition x:Name="COL_AktionenMitte" Width="*" />
                    <ColumnDefinition x:Name="COL_AktionenRechts" Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    x:Name="STP_AktionenLinks"
                    Grid.Column="0"
                    Orientation="Horizontal">
                    <Button
                        x:Name="BTN_AlleMarkieren"
                        Margin="0,0,6,0"
                        Command="{Binding CommandExecuteAlleDublettenMarkierenCommand}"
                        Content="Alle markieren"
                        Style="{StaticResource ButtonSekundär}" />
                    <Button
                        x:Name="BTN_KeineMarkieren"
                        Command="{Binding CommandExecuteKeineDublettenMarkierenCommand}"
                        Content="Auswahl aufheben"
                        Style="{StaticResource ButtonSekundär}" />
                </StackPanel>

                <TextBlock
                    x:Name="TXT_PapierkorbHinweis"
                    Grid.Column="1"
                    Margin="12,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="Gray"
                    Text="Gelöscht wird immer in den Papierkorb — nichts wird endgültig entfernt."
                    TextTrimming="CharacterEllipsis" />

                <StackPanel
                    x:Name="STP_AktionenRechts"
                    Grid.Column="2"
                    Orientation="Horizontal">
                    <Button
                        x:Name="BTN_MarkierteLoeschenAbbrechen"
                        Margin="0,0,6,0"
                        d:Visibility="Visible"
                        Command="{Binding CommandExecuteMarkierteLoeschenCancelCommand}"
                        Content="Abbrechen"
                        Style="{StaticResource ButtonSekundär}"
                        Visibility="{Binding CommandExecuteMarkierteLoeschenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}}" />

                    <Button
                        x:Name="BTN_MarkierteLoeschen"
                        Command="{Binding CommandExecuteMarkierteLoeschenCommand}"
                        Style="{StaticResource ButtonLöschen}"
                        ToolTip="Markierte Duplikate in den Papierkorb verschieben">
                        <StackPanel x:Name="STP_LoeschenInhalt" Orientation="Horizontal">
                            <TextBlock
                                x:Name="IC_Loeschen"
                                Margin="0,0,6,0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="11"
                                Text="&#xE74D;" />
                            <TextBlock x:Name="TXT_Loeschen" Text="Markierte in den Papierkorb" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
