<UserControl
    x:Class="TestImage.Ansichten.DublettenAnsicht"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bildersuche="clr-namespace:TestImage.Bildersuche"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TestImage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="760"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--  Modern, hell, neutral — kein Blau.  -->
        <Style x:Key="ButtonBasis" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Foreground" Value="#FF1F2937" />
            <Setter Property="Background" Value="#FFF3F4F6" />
            <Setter Property="BorderBrush" Value="#FFCBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="BRD_Fläche"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BRD_Fläche" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BRD_Fläche" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BRD_Fläche" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Sekundär: heller, dezenter.  -->
        <Style
            x:Key="ButtonSekundär"
            BasedOn="{StaticResource ButtonBasis}"
            TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!--  Destruktiv: dezent rot abgesetzt, nicht schreiend.  -->
        <Style
            x:Key="ButtonLöschen"
            BasedOn="{StaticResource ButtonBasis}"
            TargetType="Button">
            <Setter Property="Background" Value="#FFFDF2F2" />
            <Setter Property="BorderBrush" Value="#FFE7B7B7" />
            <Setter Property="Foreground" Value="#FF9B1C1C" />
        </Style>

        <!--  Karte: weiss, feiner Rand, abgerundet.  -->
        <Style x:Key="Karte" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFCBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10,12,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="8"
                        Opacity="0.10"
                        ShadowDepth="1"
                        Color="#FF64748B" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KartenTitel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FF1F2937" />
        </Style>

        <Style x:Key="KartenUntertitel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="PfadFeld" TargetType="TextBox">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="#FFF8FAFC" />
            <Setter Property="BorderBrush" Value="#FFCBD5E1" />
            <Setter Property="Foreground" Value="#FF1F2937" />
            <Setter Property="FontSize" Value="12" />
        </Style>

    </UserControl.Resources>

    <!--  Byte-Dubletten-Ansicht: Basisordner behalten, Duplikate in Vergleichsordnern löschen.  -->
    <Grid x:Name="GRD_DublettenWurzel" Background="#FFF6F7F9">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ROW_Kopf" Height="Auto" />
            <RowDefinition x:Name="ROW_Ordner" Height="Auto" />
            <RowDefinition x:Name="ROW_Suche" Height="Auto" />
            <RowDefinition x:Name="ROW_Treffer" Height="*" />
            <RowDefinition x:Name="ROW_Aktionen" Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ===== Kopfzeile =====  -->
        <Grid x:Name="GRD_Kopf" Margin="14,12,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="COL_KopfText" Width="*" />
                <ColumnDefinition x:Name="COL_KopfZurück" Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="STP_KopfText" Grid.Column="0">
                <TextBlock
                    x:Name="TXT_KopfTitel"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#FF111827"
                    Text="Byte-Duplikate aufräumen" />
                <TextBlock
                    x:Name="TXT_KopfUntertitel"
                    Style="{StaticResource KartenUntertitel}"
                    Text="Bilder des Basisordners werden behalten — byte-identische Kopien in den Vergleichsordnern kommen in den Papierkorb." />
            </StackPanel>

            <Button
                x:Name="BTN_DublettenZurueck"
                Grid.Column="1"
                VerticalAlignment="Top"
                Command="{Binding CommandExecuteDublettenAnsichtSchliessenCommand}"
                Style="{StaticResource ButtonSekundär}"
                ToolTip="Zurück zur Bildansicht">
                <StackPanel x:Name="STP_ZurueckInhalt" Orientation="Horizontal">
                    <TextBlock
                        x:Name="IC_Zurueck"
                        Margin="0,0,6,0"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="11"
                        Text="&#xE72B;" />
                    <TextBlock x:Name="TXT_Zurueck" Text="Zurück" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  ===== Karte: Ordner =====  -->
        <Border
            x:Name="BRD_OrdnerKarte"
            Grid.Row="1"
            Margin="14,0,14,10"
            Style="{StaticResource Karte}">
            <Grid x:Name="GRD_Ordner">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ROW_OrdnerTitel" Height="Auto" />
                    <RowDefinition x:Name="ROW_Basis" Height="Auto" />
                    <RowDefinition x:Name="ROW_Vergleich" Height="Auto" />
                    <RowDefinition x:Name="ROW_Optionen" Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="STP_OrdnerTitel" Grid.Row="0">
                    <StackPanel x:Name="STP_OrdnerTitelZeile" Orientation="Horizontal">
                        <TextBlock
                            x:Name="IC_Ordner"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="13"
                            Foreground="#FF64748B"
                            Text="&#xE8B7;" />
                        <TextBlock
                            x:Name="TXT_OrdnerTitel"
                            VerticalAlignment="Center"
                            Style="{StaticResource KartenTitel}"
                            Text="Ordner" />
                    </StackPanel>
                </StackPanel>

                <!--  Basisordner  -->
                <Grid
                    x:Name="GRD_BasisOrdner"
                    Grid.Row="1"
                    Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="COL_BasisLabel" Width="150" />
                        <ColumnDefinition x:Name="COL_BasisFeld" Width="*" />
                        <ColumnDefinition x:Name="COL_BasisButton" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        x:Name="STP_BasisLabel"
                        Grid.Column="0"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="TXT_BasisLabel"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#FF1F2937"
                            Text="Basisordner" />
                        <TextBlock
                            x:Name="TXT_BasisHinweis"
                            FontSize="10"
                            Foreground="#FF059669"
                            Text="wird behalten" />
                    </StackPanel>

                    <TextBox
                        x:Name="TXB_BasisOrdner"
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        d:Text="C:\Bilder\Sammlung"
                        Style="{StaticResource PfadFeld}"
                        Text="{Binding DublettenBasisOrdner}"
                        ToolTip="{Binding DublettenBasisOrdner}" />

                    <Button
                        x:Name="BTN_BasisOrdnerWaehlen"
                        Grid.Column="2"
                        Command="{Binding CommandExecuteBasisOrdnerWaehlenCommand}"
                        Content="Wählen …"
                        Style="{StaticResource ButtonBasis}" />
                </Grid>

                <!--  Vergleichsordner  -->
                <Grid
                    x:Name="GRD_VergleichsOrdner"
                    Grid.Row="2"
                    Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="COL_VergleichLabel" Width="150" />
                        <ColumnDefinition x:Name="COL_VergleichListe" Width="*" />
                        <ColumnDefinition x:Name="COL_VergleichButtons" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        x:Name="STP_VergleichLabel"
                        Grid.Column="0"
                        VerticalAlignment="Top">
                        <TextBlock
                            x:Name="TXT_VergleichLabel"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#FF1F2937"
                            Text="Vergleichsordner" />
                        <TextBlock
                            x:Name="TXT_VergleichHinweis"
                            FontSize="10"
                            Foreground="#FF9B1C1C"
                            Text="hier wird gelöscht" />
                    </StackPanel>

                    <Border
                        x:Name="BRD_VergleichsListe"
                        Grid.Column="1"
                        MinHeight="60"
                        MaxHeight="110"
                        Margin="0,0,8,0"
                        Background="#FFF8FAFC"
                        BorderBrush="#FFCBD5E1"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid x:Name="GRD_VergleichsListeInhalt">
                            <ListBox
                                x:Name="LBX_VergleichsOrdner"
                                d:ItemsSource="{d:SampleData ItemCount=2}"
                                Background="Transparent"
                                BorderThickness="0"
                                FocusVisualStyle="{x:Null}"
                                FontSize="12"
                                ItemsSource="{Binding DublettenVergleichsOrdner}"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                SelectedItem="{Binding AusgewaehlterVergleichsOrdner, Mode=TwoWay}" />

                            <TextBlock
                                x:Name="TXT_KeineVergleichsOrdner"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                d:Visibility="Collapsed"
                                FontSize="11"
                                FontStyle="Italic"
                                Foreground="Gray"
                                IsHitTestVisible="False"
                                Text="Noch kein Vergleichsordner gewählt">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DublettenVergleichsOrdner.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <StackPanel
                        x:Name="STP_VergleichButtons"
                        Grid.Column="2"
                        VerticalAlignment="Top">
                        <Button
                            x:Name="BTN_VergleichsOrdnerHinzufuegen"
                            Margin="0,0,0,6"
                            Command="{Binding CommandExecuteVergleichsOrdnerHinzufuegenCommand}"
                            Content="Ordner +"
                            Style="{StaticResource ButtonBasis}"
                            ToolTip="Einen oder mehrere Ordner zum Durchsuchen hinzufügen" />
                        <Button
                            x:Name="BTN_VergleichsOrdnerEntfernen"
                            Command="{Binding CommandExecuteVergleichsOrdnerEntfernenCommand}"
                            Content="Entfernen"
                            Style="{StaticResource ButtonSekundär}"
                            ToolTip="Markierten Ordner aus der Liste nehmen" />
                    </StackPanel>
                </Grid>

                <!--  Optionen  -->
                <CheckBox
                    x:Name="CHK_MitUnterordnern"
                    Grid.Row="3"
                    Margin="150,10,0,0"
                    VerticalContentAlignment="Center"
                    Content="Unterordner einbeziehen"
                    FontSize="12"
                    Foreground="#FF1F2937"
                    IsChecked="{Binding DublettenMitUnterordnern}" />
            </Grid>
        </Border>

        <!--  ===== Karte: Suche =====  -->
        <Border
            x:Name="BRD_SucheKarte"
            Grid.Row="2"
            Margin="14,0,14,10"
            Style="{StaticResource Karte}">
            <Grid x:Name="GRD_Suche">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="COL_SucheButton" Width="Auto" />
                    <ColumnDefinition x:Name="COL_SucheAbbrechen" Width="Auto" />
                    <ColumnDefinition x:Name="COL_SucheFortschritt" Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="BTN_ByteDublettenSuchen"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Command="{Binding CommandExecuteByteDublettenSuchenCommand}"
                    Style="{StaticResource ButtonBasis}"
                    ToolTip="Byte-identische Bilder in den Vergleichsordnern suchen">
                    <StackPanel x:Name="STP_SuchenInhalt" Orientation="Horizontal">
                        <TextBlock
                            x:Name="IC_Suchen"
                            Margin="0,0,6,0"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11"
                            Text="&#xE71E;" />
                        <TextBlock x:Name="TXT_Suchen" Text="Byte-Duplikate suchen" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="BTN_ByteDublettenSuchenAbbrechen"
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    d:Visibility="Visible"
                    Command="{Binding CommandExecuteByteDublettenSuchenCancelCommand}"
                    Content="Abbrechen"
                    Style="{StaticResource ButtonSekundär}"
                    ToolTip="Suche abbrechen"
                    Visibility="{Binding CommandExecuteByteDublettenSuchenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}}" />

                <StackPanel
                    x:Name="STP_SuchFortschritt"
                    Grid.Column="2"
                    VerticalAlignment="Center">
                    <Grid x:Name="GRD_StatusZeile">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="COL_StatusText" Width="*" />
                            <ColumnDefinition x:Name="COL_StatusRestzeit" Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="TXT_DublettenStatus"
                            Grid.Column="0"
                            d:Text="Prüfsummen: 240 / 980"
                            FontSize="12"
                            Foreground="#FF374151"
                            Text="{Binding DublettenStatus}"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            x:Name="TXT_DublettenRestzeit"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            d:Text="noch ca. 12 s"
                            FontSize="11"
                            Foreground="Gray"
                            Text="{Binding DublettenRestzeit}" />
                    </Grid>

                    <ProgressBar
                        x:Name="PGB_DublettenFortschritt"
                        Height="4"
                        Margin="0,6,0,0"
                        d:Value="35"
                        Background="#FFEFF1F4"
                        BorderThickness="0"
                        Foreground="#FF64748B"
                        Maximum="{Binding DublettenFortschrittMax}"
                        Value="{Binding DublettenFortschritt}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ===== Karte: Treffer =====  -->
        <Border
            x:Name="BRD_TrefferKarte"
            Grid.Row="3"
            Margin="14,0,14,10"
            Style="{StaticResource Karte}">
            <Grid x:Name="GRD_Treffer">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ROW_TrefferKopf" Height="Auto" />
                    <RowDefinition x:Name="ROW_TrefferListe" Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="GRD_TrefferKopf"
                    Grid.Row="0"
                    Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="COL_TrefferTitel" Width="*" />
                        <ColumnDefinition x:Name="COL_TrefferZaehler" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        x:Name="STP_TrefferTitel"
                        Grid.Column="0"
                        Orientation="Horizontal">
                        <TextBlock
                            x:Name="IC_Treffer"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="13"
                            Foreground="#FF64748B"
                            Text="&#xE8C8;" />
                        <TextBlock
                            x:Name="TXT_TrefferTitel"
                            VerticalAlignment="Center"
                            Style="{StaticResource KartenTitel}"
                            Text="Gefundene Duplikate" />
                    </StackPanel>

                    <!--  Zähler-Pille  -->
                    <Border
                        x:Name="BRD_TrefferZaehler"
                        Grid.Column="1"
                        Padding="8,2"
                        Background="#FFF1F5F9"
                        BorderBrush="#FFCBD5E1"
                        BorderThickness="1"
                        CornerRadius="9">
                        <StackPanel x:Name="STP_TrefferZaehler" Orientation="Horizontal">
                            <TextBlock
                                x:Name="TXT_TrefferMarkiert"
                                d:Text="18"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#FF1F2937"
                                Text="{Binding DublettenMarkierteAnzahl}" />
                            <TextBlock
                                x:Name="TXT_TrefferMarkiertLabel"
                                Margin="4,0,6,0"
                                FontSize="11"
                                Foreground="Gray"
                                Text="markiert" />
                            <TextBlock
                                x:Name="TXT_TrefferGroesse"
                                d:Text="42,3 MB"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#FF9B1C1C"
                                Text="{Binding DublettenMarkierteGroesseText}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border
                    x:Name="BRD_TrefferListe"
                    Grid.Row="1"
                    Background="#FFFCFCFD"
                    BorderBrush="#FFE5E7EB"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid x:Name="GRD_TrefferListeInhalt">
                        <ListBox
                            x:Name="LBX_ByteDubletten"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            FocusVisualStyle="{x:Null}"
                            ItemsSource="{Binding ByteDublettenTreffer}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type bildersuche:ByteDublettenTreffer}">
                                    <Border
                                        x:Name="BRD_TrefferZeile"
                                        Margin="4,3"
                                        Padding="8,6"
                                        Background="White"
                                        BorderBrush="#FFE5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <Grid x:Name="GRD_TrefferZeileInhalt">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="COL_ZeileHaken" Width="Auto" />
                                                <ColumnDefinition x:Name="COL_ZeileDublette" Width="*" />
                                                <ColumnDefinition x:Name="COL_ZeileGroesse" Width="Auto" />
                                                <ColumnDefinition x:Name="COL_ZeileExplorer" Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox
                                                x:Name="CHK_TrefferMarkiert"
                                                Grid.Column="0"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding IstMarkiert, Mode=TwoWay}"
                                                ToolTip="Zum Löschen vormerken" />

                                            <StackPanel x:Name="STP_ZeilePfade" Grid.Column="1">
                                                <!--  Löschkandidat  -->
                                                <TextBlock
                                                    x:Name="TXT_ZeileDublette"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="#FF1F2937"
                                                    Text="{Binding DublettenDateiName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding DublettenDatei}" />
                                                <TextBlock
                                                    x:Name="TXT_ZeileDublettenOrdner"
                                                    FontSize="10"
                                                    Foreground="#FF9B1C1C"
                                                    Text="{Binding DublettenOrdner}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding DublettenDatei}" />
                                                <!--  Behaltenes Gegenstück  -->
                                                <StackPanel
                                                    x:Name="STP_ZeileBasis"
                                                    Margin="0,3,0,0"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        x:Name="IC_ZeileBasis"
                                                        Margin="0,0,4,0"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="9"
                                                        Foreground="#FF059669"
                                                        Text="&#xE73E;" />
                                                    <TextBlock
                                                        x:Name="TXT_ZeileBasis"
                                                        FontSize="10"
                                                        Foreground="Gray"
                                                        Text="{Binding BasisDatei}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding BasisDatei}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock
                                                x:Name="TXT_ZeileGroesse"
                                                Grid.Column="2"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="#FF64748B"
                                                Text="{Binding GroesseText}" />

                                            <Button
                                                x:Name="BTN_ZeileImExplorer"
                                                Grid.Column="3"
                                                Width="24"
                                                Height="24"
                                                Margin="8,0,0,0"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.CommandExecuteDubletteImExplorerZeigenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Content="&#xE838;"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="11"
                                                Style="{StaticResource ButtonSekundär}"
                                                ToolTip="Im Explorer zeigen" />
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <!--  Bereits im Papierkorb: ausgegraut und durchgestrichen  -->
                                        <DataTrigger Binding="{Binding IstGeloescht}" Value="True">
                                            <Setter TargetName="BRD_TrefferZeile" Property="Opacity" Value="0.45" />
                                            <Setter TargetName="BRD_TrefferZeile" Property="Background" Value="#FFF3F4F6" />
                                            <Setter TargetName="TXT_ZeileDublette" Property="TextDecorations" Value="Strikethrough" />
                                            <Setter TargetName="CHK_TrefferMarkiert" Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!--  Platzhalter, solange nichts gefunden wurde  -->
                        <StackPanel
                            x:Name="STP_KeineTreffer"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            d:Visibility="Collapsed"
                            IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ByteDublettenTreffer.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock
                                x:Name="IC_KeineTreffer"
                                HorizontalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="28"
                                Foreground="#FFCBD5E1"
                                Text="&#xE8B7;" />
                            <TextBlock
                                x:Name="TXT_KeineTreffer"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="Gray"
                                Text="Noch keine Duplikate gefunden" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!--  ===== Aktionsleiste =====  -->
        <Border
            x:Name="BRD_Aktionsleiste"
            Grid.Row="4"
            Padding="14,10"
            Background="White"
            BorderBrush="#FFE5E7EB"
            BorderThickness="0,1,0,0">
            <Grid x:Name="GRD_Aktionen">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="COL_AktionenLinks" Width="Auto" />
                    <ColumnDefinition x:Name="COL_AktionenMitte" Width="*" />
                    <ColumnDefinition x:Name="COL_AktionenRechts" Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    x:Name="STP_AktionenLinks"
                    Grid.Column="0"
                    Orientation="Horizontal">
                    <Button
                        x:Name="BTN_AlleMarkieren"
                        Margin="0,0,6,0"
                        Command="{Binding CommandExecuteAlleDublettenMarkierenCommand}"
                        Content="Alle markieren"
                        Style="{StaticResource ButtonSekundär}" />
                    <Button
                        x:Name="BTN_KeineMarkieren"
                        Command="{Binding CommandExecuteKeineDublettenMarkierenCommand}"
                        Content="Auswahl aufheben"
                        Style="{StaticResource ButtonSekundär}" />
                </StackPanel>

                <TextBlock
                    x:Name="TXT_PapierkorbHinweis"
                    Grid.Column="1"
                    Margin="12,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="Gray"
                    Text="Gelöscht wird immer in den Papierkorb — nichts wird endgültig entfernt."
                    TextTrimming="CharacterEllipsis" />

                <StackPanel
                    x:Name="STP_AktionenRechts"
                    Grid.Column="2"
                    Orientation="Horizontal">
                    <Button
                        x:Name="BTN_MarkierteLoeschenAbbrechen"
                        Margin="0,0,6,0"
                        d:Visibility="Visible"
                        Command="{Binding CommandExecuteMarkierteLoeschenCancelCommand}"
                        Content="Abbrechen"
                        Style="{StaticResource ButtonSekundär}"
                        Visibility="{Binding CommandExecuteMarkierteLoeschenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}}" />

                    <Button
                        x:Name="BTN_MarkierteLoeschen"
                        Command="{Binding CommandExecuteMarkierteLoeschenCommand}"
                        Style="{StaticResource ButtonLöschen}"
                        ToolTip="Markierte Duplikate in den Papierkorb verschieben">
                        <StackPanel x:Name="STP_LoeschenInhalt" Orientation="Horizontal">
                            <TextBlock
                                x:Name="IC_Loeschen"
                                Margin="0,0,6,0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="11"
                                Text="&#xE74D;" />
                            <TextBlock x:Name="TXT_Loeschen" Text="Markierte in den Papierkorb" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
