<UserControl
    x:Class="TestImage.Ansichten.VollbildAnsicht"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Converters="clr-namespace:TestImage.Converters"
    xmlns:Converters1="clr-namespace:TestImageViewer.Converters"
    xmlns:ansichten="clr-namespace:TestImage.Ansichten"
    xmlns:bildersuche="clr-namespace:TestImage.Bildersuche"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:TestImage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <!--
        Vollbildansicht (IsImageMaximiert = true): eigenes Bild, Klickzonen,
        Schwebe-Filmstrip, Hover-Zone, Drop-Overlay.

        MouseWheel zoomt (bubbling, damit der Filmstrip sein eigenes Rad-Verhalten
        behält). Im vergrösserten Bild verschiebt Ziehen mit der linken Maustaste den
        Ausschnitt, Doppelklick stellt das eingepasste Bild wieder her; die Zieh-Ereignisse
        laufen als Preview, damit sie auch über der unteren Hover-Zone ankommen. Bei 100 %
        greift nichts davon — dann gehören die Klicks wie bisher den Navigationszonen
        links und rechts.
    -->
    <Grid
        x:Name="GRD_VollbildWurzel"
        local:FileDragDropHelper.IsFileDragDropEnabled="True"
        AllowDrop="True"
        Background="#FF111111"
        d:Background="LightGray"
        DragEnter="Vollbild_DragEnter"
        DragLeave="Vollbild_DragLeave"
        Drop="Vollbild_Drop"
        LostMouseCapture="Vollbild_ZiehenAbgebrochen"
        MouseWheel="Vollbild_MouseWheel"
        PreviewMouseLeftButtonDown="Vollbild_ZiehenStart"
        PreviewMouseLeftButtonUp="Vollbild_ZiehenEnde"
        PreviewMouseMove="Vollbild_Ziehen">

        <!--
            Eigenes Vollbild-Image (Fit). Die Ablage hängt am Wurzel-Grid, nicht hier:
            Ein Image ist nur dort trefferfähig, wo es tatsächlich zeichnet — auf den
            schwarzen Balken neben dem eingepassten Bild fiele das Ziehen hindurch.
        -->
        <Image
            x:Name="imgVollbild"
            RenderOptions.BitmapScalingMode="HighQuality"
            RenderTransformOrigin="0.5,0.5"
            Source="{Binding DisplayImage, NotifyOnTargetUpdated=True}"
            d:Source="/Images/HeavyO.jpg"
            Stretch="Uniform"
            TargetUpdated="Vollbild_BildGewechselt">
            <Image.RenderTransform>
                <TransformGroup>
                    <!--
                        Erst skalieren (um die Mitte, siehe RenderTransformOrigin), dann
                        verschieben: So entspricht eine Einheit von imgPanTransform genau
                        einem Bildschirmpunkt, das Bild folgt der Maus also 1:1.
                    -->
                    <ScaleTransform x:Name="imgZoomTransform" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="imgPanTransform" />
                    <TranslateTransform x:Name="imgShakeTransform" />
                </TransformGroup>
            </Image.RenderTransform>
            <Image.Effect>
                <DropShadowEffect
                    BlurRadius="20"
                    Opacity="0.8"
                    ShadowDepth="0"
                    Color="Black" />
            </Image.Effect>
        </Image>

        <!--
            Klickzonen links/rechts. Die Commands sind dieselben wie bei
            RDBTN_BildNachLinks/-Rechts der Normalansicht — das Überspringen bereits
            verschobener Bilder (BildFürLinks) steckt dort drin und gilt hier ebenso.

            Neu ist die Sichtbarkeit: Der Pfeil taucht beim Überfahren der Zone auf und
            wird blass, sobald in dieser Richtung nichts mehr kommt (CanExecute), genau
            wie das ausgegraute Icon in der Normalansicht. Vorher war die Zone völlig
            unsichtbar — man musste wissen, dass sie existiert.
        -->
        <Button
            x:Name="BTN_VollbildLinks"
            Width="120"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Panel.ZIndex="10"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding CommandExecuteBildLinksCommand}"
            Cursor="Arrow"
            FocusVisualStyle="{x:Null}"
            ToolTip="Vorheriges Bild (bereits verschobene werden übersprungen)">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="BRD_ZoneLinks" Background="Transparent">
                        <Grid
                            x:Name="GRD_PfeilLinks"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <Path x:Name="PTH_FüllungLinks" Data="M 35,4 L 11,24 L 35,44 Z" Fill="#FF101010" />
                            <!--
                                Kontur als sechs Halbstrecken, jede beginnt an einer Ecke und
                                endet in der Mitte der Kante. Das Strichmuster fängt bei jeder
                                Teilstrecke neu an, deshalb wächst mit einem einzigen
                                StrokeDashOffset die Kontur gleichzeitig aus allen drei Spitzen.
                            -->
                            <Path
                                x:Name="PTH_KonturLinks"
                                Data="M 35,4 L 23,14 M 11,24 L 23,14 M 11,24 L 23,34 M 35,44 L 23,34 M 35,44 L 35,24 M 35,4 L 35,24"
                                Stroke="White"
                                StrokeDashArray="10 10"
                                StrokeDashOffset="10"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="3" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GRD_PfeilLinks" Property="Opacity" Value="0.85" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SB_KonturLinks">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="PTH_KonturLinks"
                                            Storyboard.TargetProperty="StrokeDashOffset"
                                            From="10"
                                            To="3"
                                            Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <!--  Zurück auf den Ruhewert, damit die Kontur beim nächsten Mal wieder zuläuft.  -->
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SB_KonturLinks" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <!--  Kein Bild mehr in dieser Richtung: nur schwach andeuten.  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="GRD_PfeilLinks" Property="Opacity" Value="0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="GRD_PfeilLinks" Property="Opacity" Value="0.2" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!--  Klickzone rechts: nächstes Bild  -->
        <Button
            x:Name="BTN_VollbildRechts"
            Width="120"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Panel.ZIndex="10"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding CommandExecuteBildNachRechtsCommand}"
            Cursor="Arrow"
            FocusVisualStyle="{x:Null}"
            ToolTip="Nächstes Bild (bereits verschobene werden übersprungen)">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="BRD_ZoneRechts" Background="Transparent">
                        <Grid
                            x:Name="GRD_PfeilRechts"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <Path x:Name="PTH_FüllungRechts" Data="M 13,4 L 37,24 L 13,44 Z" Fill="#FF101010" />
                            <Path
                                x:Name="PTH_KonturRechts"
                                Data="M 13,4 L 25,14 M 37,24 L 25,14 M 37,24 L 25,34 M 13,44 L 25,34 M 13,44 L 13,24 M 13,4 L 13,24"
                                Stroke="White"
                                StrokeDashArray="10 10"
                                StrokeDashOffset="10"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="3" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GRD_PfeilRechts" Property="Opacity" Value="0.85" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SB_KonturRechts">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="PTH_KonturRechts"
                                            Storyboard.TargetProperty="StrokeDashOffset"
                                            From="10"
                                            To="3"
                                            Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SB_KonturRechts" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="GRD_PfeilRechts" Property="Opacity" Value="0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="GRD_PfeilRechts" Property="Opacity" Value="0.2" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!--  Schwebende Filmstrip-Leiste: bei Hover im unteren Bereich  -->
        <ListBox
            x:Name="Listbox_SchwebeMiniaturen"
            Height="110"
            VerticalAlignment="Bottom"
            FocusVisualStyle="{x:Null}"
            d:ItemsSource="{d:SampleData ItemCount=8}"
            d:Visibility="Visible"
            local:HorizontalListBoxBehavior.CenterSelectedItem="True"
            local:HorizontalListBoxBehavior.EnableHorizontalMouseWheel="True"
            IsSynchronizedWithCurrentItem="True"
            ItemsSource="{Binding AufgabenView}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            SelectedItem="{Binding SelectedBildchen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling">

            <!--  Moderne dünne Scrollleiste nur für diese ListBox  -->
            <ListBox.Resources>
                <Style TargetType="{x:Type ScrollBar}">
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Setter Property="OverridesDefaultStyle" Value="True" />
                    <Style.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="8" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                        <Grid Height="8" Background="Transparent">
                                            <!--  Track-Hintergrund: sehr dezent  -->
                                            <Rectangle
                                                Height="2"
                                                VerticalAlignment="Center"
                                                Fill="#33FFFFFF"
                                                RadiusX="1"
                                                RadiusY="1" />
                                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton
                                                        Command="ScrollBar.PageLeftCommand"
                                                        Focusable="False"
                                                        Opacity="0" />
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                                <Border
                                                                    x:Name="ThBd"
                                                                    Height="4"
                                                                    VerticalAlignment="Center"
                                                                    Background="#88FFFFFF"
                                                                    CornerRadius="2" />
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ThBd" Property="Height" Value="6" />
                                                                        <Setter TargetName="ThBd" Property="Background" Value="#DDFFFFFF" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsDragging" Value="True">
                                                                        <Setter TargetName="ThBd" Property="Height" Value="8" />
                                                                        <Setter TargetName="ThBd" Property="Background" Value="White" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton
                                                        Command="ScrollBar.PageRightCommand"
                                                        Focusable="False"
                                                        Opacity="0" />
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Resources>

            <ListBox.Style>
                <Style TargetType="{x:Type ListBox}">
                    <Setter Property="Background" Value="#CC0A0A0A" />
                    <Setter Property="BorderBrush" Value="#66FFFFFF" />
                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Panel.ZIndex" Value="200" />
                    <Style.Triggers>
                        <!--  Hover in unterer Zone: einblenden  -->
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=BRD_HoverZoneUnten}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!--  Maus direkt auf der Leiste: sichtbar bleiben  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>

            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding CommandExecuteKleinesBildGrossesBildLadenCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>

            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding CommandExecuteDateiImExplorerÖffnenCommand}" Header="Explorer öffnen" />
                </ContextMenu>
            </ListBox.ContextMenu>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <!--  Kino-Karte: Bild vollständig sichtbar, Letterbox durch dunklen Hintergrund  -->
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:MeinBildchen}">
                    <Grid Width="100" Height="72">
                        <!--  Bild komplett sichtbar, kein Zuschnitt  -->
                        <Border ClipToBounds="True" CornerRadius="5">
                            <!--
                                Wie in der Miniaturleiste der Normalansicht: Bindung auf die
                                Eigenschaft, gefüllt von MiniaturLader im Hintergrund. Der
                                Konverter dekodierte im UI-Faden, während man scrollte.
                            -->
                            <Grid x:Name="GRD_SchwebeKachel">

                                <!--
                                    Platzhalter, solange die Miniatur noch nicht da ist —
                                    wie in der Normalansicht, aber dunkel: Hier liegt die
                                    Kachel auf schwarzem Grund, ein heller Fleck würde
                                    blenden.
                                -->
                                <Border x:Name="BRD_SchwebePlatzhalter" Background="#FF2A2A2A">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Miniatur}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <Image
                                    x:Name="IMG_SchwebeMiniatur"
                                    DataContextChanged="Miniatur_DataContextChanged"
                                    Source="{Binding Miniatur}"
                                    d:Source="/Images/HeavyO.jpg"
                                    Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <!--  Vignette unten (Kontrast für Stern-Icon)  -->
                        <Rectangle
                            Height="28"
                            VerticalAlignment="Bottom"
                            RadiusX="5"
                            RadiusY="5">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Offset="0" Color="#00000000" />
                                    <GradientStop Offset="1" Color="#AA000000" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!--  Badge: Datei verschoben  -->
                        <Border
                            Width="18"
                            Height="18"
                            Margin="0,4,4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#DDCC2222"
                            CornerRadius="9"
                            Visibility="{Binding BildFürLinks, Converter={StaticResource CLconverterVisiblityBoolian}}">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="4"
                                    Opacity="0.6"
                                    ShadowDepth="1"
                                    Color="Black" />
                            </Border.Effect>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="9"
                                Foreground="White"
                                Text="&#xE10B;" />
                        </Border>
                        <!--  Badge: Wasserzeichen oder Metadaten-Markierung gefunden  -->
                        <Border
                            x:Name="BRD_WasserzeichenBadgeVollbild"
                            Width="18"
                            Height="18"
                            Margin="4,4,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#DDD97706"
                            CornerRadius="9"
                            ToolTip="{Binding WasserzeichenGrund}"
                            Visibility="{Binding HatWasserzeichen, Converter={StaticResource CLconverterVisiblityBoolian}}">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="4"
                                    Opacity="0.6"
                                    ShadowDepth="1"
                                    Color="Black" />
                            </Border.Effect>
                            <TextBlock
                                x:Name="IC_WasserzeichenBadgeVollbild"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="9"
                                Foreground="White"
                                Text="&#xE72E;" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <!--  Container: orangefarbener Akzentbalken oben + Glow bei Auswahl  -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Setter Property="OverridesDefaultStyle" Value="True" />
                    <Setter Property="Margin" Value="4,0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border
                                    x:Name="Bd"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="6">
                                    <Grid>
                                        <ContentPresenter />
                                        <!--  Akzentbalken oben: nur bei Auswahl  -->
                                        <Rectangle
                                            x:Name="AkzentOben"
                                            Height="3"
                                            VerticalAlignment="Top"
                                            Fill="#FFFF8C00"
                                            RadiusX="3"
                                            RadiusY="3"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!--  Ausgewählt: oranger Rahmen + Glow + Balken  -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFF8C00" />
                                        <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                        <Setter TargetName="AkzentOben" Property="Visibility" Value="Visible" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect
                                                    BlurRadius="14"
                                                    Opacity="0.75"
                                                    ShadowDepth="0"
                                                    Color="#FFFF8C00" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <!--  Hover (nicht ausgewählt): heller Rahmen + leichtes Vergrössern  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True" />
                                            <Condition Property="IsSelected" Value="False" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#88FFFFFF" />
                                        <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1.05" ScaleY="1.05" />
                                            </Setter.Value>
                                        </Setter>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

        </ListBox>

        <!--  Hover-Zone unten: Maus hier rein -> Filmstrip kommt nach vorne  -->
        <Border
            x:Name="BRD_HoverZoneUnten"
            Height="150"
            VerticalAlignment="Bottom"
            Background="Transparent"
            IsHitTestVisible="True" />

        <!--
            Zoomstufe, oben links. Erscheint nur bei vergrössertem Bild und nennt
            zugleich den Rückweg – sonst wüsste man nicht, wie man wieder herauskommt.
        -->
        <Border
            x:Name="BRD_ZoomAnzeige"
            Margin="16,12,0,0"
            Padding="10,5"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Panel.ZIndex="230"
            Background="#99000000"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="6"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <StackPanel x:Name="STP_ZoomAnzeige" Orientation="Horizontal">
                <TextBlock
                    x:Name="TXT_ZoomWert"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="#FFFFC46B"
                    Text="100 %" />
                <TextBlock
                    x:Name="TXT_ZoomHinweis"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="11"
                    Foreground="#FFCCCCCC"
                    Text="Ziehen verschiebt · Doppelklick zurück" />
            </StackPanel>
        </Border>

        <!--
            Kantenschein: kurze Rückmeldung, wenn eine Taste das Bild wegräumt oder
            zurückholt.

            <b>Warum an der Kante.</b> Sie trägt schon die halbe Aussage: unten =
            weggelegt, oben = zurückgeholt. Die Farbe sagt den Rest, nämlich wohin — vier
            Ziele, vier Töne (siehe Bildablage im Code-Behind). Ein Aufblitzen der ganzen
            Fläche könnte das nicht und verdeckte dabei das Bild.

            <b>Warum nicht das Bild selbst bewegt wird.</b> Beim Verschieben steht in
            imgVollbild im selben Augenblick schon das nächste Bild — eine
            Wegflieg-Bewegung würde also das falsche wegwerfen. Der Schein liegt darüber
            und lässt das Bild in Ruhe.

            <b>Warum kein senkrechter Ruck.</b> Den gibt es bereits, und er heisst etwas
            anderes: ShakeImageSenkrecht meldet „geht gerade nicht".

            Beide Kanten sind für die Maus taub und stehen in Ruhe auf Deckkraft null;
            sichtbar werden sie nur für die 200 ms der Animation. Der Verlauf endet in
            derselben Farbe mit Alpha null — nicht in Transparent: Sonst liefe er über
            Weiss und legte einen milchigen Rand über das Bild.
        -->
        <Border
            x:Name="BRD_KantenscheinUnten"
            Height="130"
            VerticalAlignment="Bottom"
            Panel.ZIndex="235"
            IsHitTestVisible="False"
            Opacity="0"
            d:Opacity="0.55">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                    <GradientStop x:Name="GRS_KantenscheinUntenVoll" Offset="0" Color="#FFB33A2B" />
                    <GradientStop x:Name="GRS_KantenscheinUntenLeer" Offset="1" Color="#00B33A2B" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border
            x:Name="BRD_KantenscheinOben"
            Height="130"
            VerticalAlignment="Top"
            Panel.ZIndex="235"
            IsHitTestVisible="False"
            Opacity="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="GRS_KantenscheinObenVoll" Offset="0" Color="#FFDDE3EA" />
                    <GradientStop x:Name="GRS_KantenscheinObenLeer" Offset="1" Color="#00DDE3EA" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!--
            Warte-Indikator: ein Ring, der sich in der Bildmitte dreht, solange etwas
            lädt oder rechnet.

            <b>Warum mittig.</b> Diese Ansicht hat keine Kopfleiste — weder den
            Fortschrittsstreifen noch PGB_BildLadenStufen der Normalansicht. Wer blättert,
            sieht auf das Bild; eine Anzeige am Rand müsste man suchen, und gesucht wird
            genau dann nicht, wenn man auf etwas wartet. Verdeckt wird dabei nichts, was
            man gerade betrachtet: Solange der Ring läuft, ist das nächste Bild noch nicht
            da.

            <b>Warum verzögert.</b> Er blendet mit 100 ms Verzug ein — gerade genug, dass
            ein Bild aus dem Vorrat kein Flackern hinterlässt, aber kurz genug, um ihn
            beim Blättern tatsächlich zu sehen. Die Drehung läuft ausschliesslich in
            dieser Zeit; StopStoryboard setzt am Ende auch die Deckkraft auf ihren
            Ruhewert null zurück.

            <b>Verhältnis zum Wackeln.</b> Das Wackeln des Bildes heisst „hier ist
            Schluss" und meint das Ende der Liste. Dass es auch mitten in der Liste
            auftrat, lag daran, dass ein noch laufender Ladevorgang die Pfeile sperrt —
            siehe MainWindow.DarfWackeln. Die beiden Meldungen sind jetzt getrennt: Ende
            der Liste wackelt, Warten dreht sich.

            <b>Warum ein Control mit Vorlage</b> und kein Border mit Style: Ein Storyboard
            in einem Style-Trigger darf kein Storyboard.TargetName nennen, und ohne das
            käme man an den RotateTransform im Inneren nicht heran.

            <b>Im Entwurf sichtbar.</b> Der Ruhewert der Deckkraft ist null, und im
            Entwurfsfenster läuft weder der Auslöser noch die Animation — der Ring wäre
            dort also nie zu sehen und liesse sich nicht einordnen. d:Opacity zeigt ihn
            im Entwurf und wird beim Übersetzen entfernt; zur Laufzeit gilt weiter die
            null. Gedreht wird im Entwurf nicht, der Ring steht still.
        -->
        <Control
            x:Name="CTL_WarteIndikator"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="240"
            Focusable="False"
            IsHitTestVisible="False">
            <Control.Template>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border
                        x:Name="BRD_WarteFläche"
                        Width="46"
                        Height="46"
                        Background="#99000000"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="23"
                        Opacity="0"
                        d:Opacity="1">
                        <Path
                            x:Name="PTH_WarteRing"
                            Width="26"
                            Height="26"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M 13,2 A 11,11 0 1 1 2,13"
                            RenderTransformOrigin="0.5,0.5"
                            Stroke="#FFFFC46B"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="RTF_WarteRing" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding WartenLäuft}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="SBD_Warten">
                                    <Storyboard>
                                        <DoubleAnimation
                                            BeginTime="0:0:0.1"
                                            Storyboard.TargetName="BRD_WarteFläche"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.15" />
                                        <DoubleAnimation
                                            RepeatBehavior="Forever"
                                            Storyboard.TargetName="RTF_WarteRing"
                                            Storyboard.TargetProperty="Angle"
                                            From="0"
                                            To="360"
                                            Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SBD_Warten" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Control.Template>
        </Control>

        <!--  Drop-Overlay: sichtbar wenn Datei über das Bild gezogen wird  -->
        <Border
            x:Name="BRD_DropOverlay"
            Panel.ZIndex="300"
            Background="#CC111111"
            BorderBrush="#88FFFFFF"
            BorderThickness="2"
            CornerRadius="8"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="48"
                    Foreground="#CCFFFFFF"
                    Text="&#xE896;" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="#EEFFFFFF"
                    Text="Bild hier ablegen" />
                <TextBlock
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="13"
                    Foreground="#88FFFFFF"
                    Text="Alle Bilder im selben Ordner werden geladen" />
            </StackPanel>
        </Border>

        <!--
            Aufnahme-Anzeigen und Umschalter, oben rechts.

            Hier ist Schweben richtig: Die Ansicht ist ein Bild ohne Kopfleiste, jeder
            reservierte Streifen ginge vom Bild ab. Der Umschalter ist eine zweite
            Instanz — er hängt am selben Command wie BTN_BildmodusToggle in der
            Normalansicht, behält aber die dunkle Pille, die über einem Bild lesbar ist.
            Das Symbol steht fest auf „verkleinern": In dieser Ansicht ist der Bildmodus
            immer an.

            ZIndex über den Klickzonen, damit ein Klick auf den Knopf nicht zum Blättern
            führt; unter dem Drop-Overlay (300), das alles verdecken soll.
        -->
        <StackPanel
            x:Name="STP_VollbildWerkzeuge"
            Margin="0,8,10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="200"
            Orientation="Horizontal">

            <ansichten:IndikatorLeiste x:Name="CTL_Indikatoren" VerticalAlignment="Center" Margin="0,0,20,0" />

            <Button
                x:Name="BTN_BildmodusVollbild"
                Width="28"
                Height="28"
                VerticalAlignment="Center"
                Command="{Binding CommandExecuteImageMaximierenToggleCommand}"
                Content="&#xE73F;"
                Cursor="Hand"
                Focusable="False"
                FontFamily="Segoe MDL2 Assets"
                FontSize="14"
                ToolTip="Bildmodus verlassen (F11)">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Opacity" Value="0.6" />
                        <Setter Property="Background" Value="#88000000" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border
                                        Padding="4"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                                <Setter Property="Background" Value="#CC007ACC" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
