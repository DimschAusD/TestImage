<UserControl
    x:Class="TestImage.Ansichten.NormalAnsicht"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Converters="clr-namespace:TestImage.Converters"
    xmlns:Converters1="clr-namespace:TestImageViewer.Converters"
    xmlns:bildersuche="clr-namespace:TestImage.Bildersuche"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:TestImage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svg1="clr-namespace:SVGImage.SVG;assembly=DotNetProjects.SVGImage"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="700"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <!--  Normalansicht (IsImageMaximiert = false). Inhalt wird etappenweise aus MainWindow hierher verschoben.  -->
    <Grid x:Name="GRD_NormalWurzel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="2"
            Height="90"
            Margin="45,0,45,160"
            VerticalAlignment="Bottom"
            Orientation="Vertical"
            Visibility="{Binding IsObenMinimiert, Converter={StaticResource CLconverterVisiblityBoolian}}">
            <StackPanel Orientation="Horizontal">

                <!--  Erste Zeile: Position + Gesamt  -->
                <TextBlock Margin="0,0,0,2"><Run Text="Pos: " /><Run Text=" " /><Run Text="{Binding AufgabenView.CurrentPosition, Converter={StaticResource CLconverterProgressbarIntPlusEins}, Mode=OneWay}" /><Run Text=" " /><Run Text=" / " /><Run Text=" " /><Run Text="{Binding AufgabenView.Count, Mode=OneWay}" /><Run Text=" " /><Run Text="   (" /><Run Text=" " /><Run Text="{Binding CountBildchenFürLinks, Mode=OneWay}" /><Run Text=" " /><Run Text=" verschoben)" /></TextBlock>

                <!--  Zweite Zeile: Name  -->
                <TextBlock Margin="0,0,0,2"><Run Foreground="Gray" Text="  Name: " /><Run Text=" " /><Run Text="{Binding SelectedBildchen.BName, Converter={StaticResource ConverterFullPathToNameConverter}}" /></TextBlock>

                <!--  Dritte Zeile: weitere Metadaten  -->
                <TextBlock><Run Text="  " /><Run Text=" " /><Run Foreground="LightBlue" Text="{Binding Version}" /></TextBlock>

            </StackPanel>

            <ProgressBar
                Width="auto"
                Height="2"
                Maximum="{Binding AufgabenView.Count, Mode=OneWay}"
                Value="{Binding AufgabenView.CurrentPosition, Converter={StaticResource CLconverterProgressbarIntPlusEins}, Mode=OneWay}" />
            <ListBox
                x:Name="listBox"
                Height="70"
                local:HorizontalListBoxBehavior.CenterSelectedItem="True"
                IsSynchronizedWithCurrentItem="True"
                ItemsSource="{Binding AufgabenView}"
                ScrollViewer.HorizontalScrollBarVisibility="Visible"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectedBildchen}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:MeinBildchen}">
                        <StackPanel Width="auto" Orientation="Horizontal">
                            <TextBlock
                                Margin="2,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding BName}" />
                        </StackPanel>
                    </DataTemplate>

                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Blue" />
                                <Setter Property="Foreground" Value="Blue" />
                                <Setter Property="FontWeight" Value="DemiBold" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Background" Value="#FFE8E6E6" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3399FF" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                            </Trigger>

                            <DataTrigger Binding="{Binding BildFürLinks}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BildFürLinks}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>



                </ListBox.ItemContainerStyle>
            </ListBox>
        </StackPanel>
        <ListBox
            x:Name="Listbox_MiniaturBilder"
            Grid.Row="2"
            Height="138"
            Margin="93,0,25,10"
            VerticalAlignment="Bottom"
            d:ItemsSource="{d:SampleData ItemCount=4}"
            local:HorizontalListBoxBehavior.CenterSelectedItem="True"
            local:HorizontalListBoxBehavior.EnableHorizontalMouseWheel="True"
            FocusVisualStyle="{x:Null}"
            IsSynchronizedWithCurrentItem="True"
            ItemsSource="{Binding AufgabenView}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectedItem="{Binding SelectedBildchen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling"
            Visibility="{Binding IsObenMinimiert, Converter={StaticResource CLconverterVisiblityBoolian}}">

            <!--  Hintergrundfarbe per Style, damit DataTrigger greifen kann  -->
            <ListBox.Style>
                <Style TargetType="{x:Type ListBox}">
                    <Setter Property="Background" Value="{Binding SelectedBildchen.BildFürLinks, Converter={StaticResource CLconverterColorBoolianMasterHintergrund}, FallbackValue={x:Static Brushes.Transparent}, TargetNullValue={x:Static Brushes.Transparent}}" />
                    <Style.Triggers>
                        <!--  Alle Bilder verschoben → Rot  -->
                        <DataTrigger Binding="{Binding AlleBilderVerschoben}" Value="True">
                            <Setter Property="Background" Value="#FFE83030" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>

            <!--  Kontextmenü  -->
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding CommandExecuteDateiImExplorerÖffnenCommand}" Header="Explorer öffnen" />
                </ContextMenu>
            </ListBox.ContextMenu>

            <!--  EventTrigger  -->
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding CommandExecuteKleinesBildGrossesBildLadenCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>

            <!--  Horizontaler ItemsPanel  -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <!--  ItemTemplate: neutral (Farbe steuern wir im Container-Template)  -->
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:MeinBildchen}">
                    <Border
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                        <Grid>
                            <Image
                                Width="80"
                                Height="80"
                                Margin="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{Binding BName, Converter={StaticResource CLconverterStringZuKleinemImage}}"
                                Stretch="Uniform" />
                            <!--  Badge: Bild wurde verschoben  -->
                            <Border
                                Width="18"
                                Height="18"
                                Margin="0,4,4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#DDCC2222"
                                CornerRadius="9"
                                Visibility="{Binding BildFürLinks, Converter={StaticResource CLconverterVisiblityBoolian}}">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="4"
                                        Opacity="0.6"
                                        ShadowDepth="1"
                                        Color="Black" />
                                </Border.Effect>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="9"
                                    Foreground="White"
                                    Text="&#xE10B;" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <!--  ContainerStyle: eigenes Template (kein Windows/Accent-Overlay)  -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <!--  Fokusrahmen aus  -->
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Setter Property="OverridesDefaultStyle" Value="True" />

                    <!--  Ausrichtung von der ListBox übernehmen  -->
                    <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
                    <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />

                    <!--  Basis-Rand  -->
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Padding" Value="2" />

                    <!--  Eigenes ControlTemplate  -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <!--  Default-Hintergrund JE ITEM = Converter (nur im Normalzustand sichtbar)  -->
                                <Border
                                    x:Name="Bd"
                                    Background="{Binding BildFürLinks, Converter={StaticResource CLconverterColorBoolianMasterHintergrund}, FallbackValue={x:Static Brushes.Transparent}, TargetNullValue={x:Static Brushes.Transparent}}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                    <ContentPresenter
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>

                                <ControlTemplate.Triggers>
                                    <!--  SELECTED: überschreibt Converter-Farbe  -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FF007ACC" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="DarkBlue" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect
                                                    BlurRadius="14"
                                                    Opacity="0.7"
                                                    ShadowDepth="0"
                                                    Color="#66005FB8" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>

                                    <!--  MOUSEOVER nur wenn NICHT selected: überschreibt Converter-Farbe  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True" />
                                            <Condition Property="IsSelected" Value="False" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Background" Value="#FFBAFF6A" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7A9E39" />
                                        <Setter Property="Foreground" Value="Black" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

        </ListBox>
        <Border
            x:Name="BRD_NachObenVerschieben"
            Grid.Row="2"
            Width="78"
            Height="auto"
            Margin="10,0,0,10"
            Padding="2,2,2,2"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderThickness="2,2,2,2"
            CornerRadius="2,2,2,2"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <StackPanel
                Width="70"
                Height="auto"
                Orientation="Vertical">
                <Image
                    x:Name="image_Kopieren"
                    Width="70"
                    Height="70"
                    Source="{Binding SelectedBildchen.BName, Converter={StaticResource CLconverterStringZuKleinemImage}}"
                    Visibility="{Binding IsEnabled, Converter={StaticResource CLconverterVisiblityBoolian}, ElementName=RDBTN_BildNachOben}" />
                <!--  MouseOverBackground="#FFB7F393"  -->
                <RibbonButton
                    x:Name="RDBTN_BildNachOben"
                    Height="70"
                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteBildInsHauptVerzeichnisZuruckVerschiebenCommand, Mode=OneWay}"
                    Content="Button"
                    Label="In die Liste"
                    LargeImageSource="/Images/PfeilNachOben.png"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE">

                    <RibbonButton.MouseOverBackground>

                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">

                            <!--  Ziel: oben = klar gut, dominant  -->
                            <GradientStop Offset="0.0" Color="#FF8FE88F" />
                            <!--  sattes, positives Grün  -->
                            <GradientStop Offset="0.35" Color="#FFBFF0BF" />
                            <!--  weiches Übergangsgrün  -->

                            <!--  Übergang  -->
                            <GradientStop Offset="0.6" Color="#FFF6D880" />
                            <!--  Amber  -->

                            <!--  Abstieg: Problemzone unten, kompakt  -->
                            <GradientStop Offset="0.82" Color="#FFF0A070" />
                            <!--  warmes Orange  -->
                            <GradientStop Offset="1.0" Color="#FFD96666" />
                            <!--  gedämpftes Rot  -->

                        </LinearGradientBrush>

                    </RibbonButton.MouseOverBackground>

                </RibbonButton>
            </StackPanel>
        </Border>
        <!--  Bild-Container der NORMALANSICHT (Vollbild läuft über Ansichten:VollbildAnsicht)  -->
        <Border
            x:Name="ViewedPhotoArea"
            Grid.Row="1"
            BorderBrush="#22000000"
            BorderThickness="0"
            ClipToBounds="True"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Margin" Value="45,5,45,10" />
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="Background" Value="{Binding SelectedBildchen.BildFürLinks, Converter={StaticResource CLconverterColorBoolianMasterHintergrund}}" />
                    <Style.Triggers>
                        <!--  Alle Bilder verschoben → Rot  -->
                        <DataTrigger Binding="{Binding AlleBilderVerschoben}" Value="True">
                            <Setter Property="Background" Value="#FFE83030" />
                        </DataTrigger>
                        <!--  Bildmodus: Margins weg, volle Fläche, dunkler Hintergrund  -->
                        <DataTrigger Binding="{Binding IsImageMaximiert}" Value="True">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Grid.RowSpan" Value="3" />
                            <Setter Property="Grid.Row" Value="0" />
                            <Setter Property="Background" Value="#FF111111" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!--  Image Display + Hover-Zone unten (blendet Miniaturleiste ein)  -->
            <Grid>
                <ScrollViewer
                    x:Name="scdd"
                    local:FileDragDropHelper.IsFileDragDropEnabled="True"
                    AllowDrop="True"
                    DragEnter="scdd_DragEnter"
                    DragLeave="scdd_DragLeave"
                    Drop="scdd_Drop"
                    HorizontalScrollBarVisibility="{Binding MyHorizontalScrollBarVisibility}"
                    PreviewMouseWheel="Scdd_PreviewMouseWheel"
                    VerticalScrollBarVisibility="{Binding MyHorizontalScrollBarVisibility}">

                    <!--
                        Einzelbild direkt im ScrollViewer: meldet bei Stretch=None seine
                        Pixelgröße -> beide Bildlaufleisten funktionieren korrekt.
                    -->
                    <Image
                        x:Name="imgCurrent"
                        Margin="4,4,4,4"
                        IsManipulationEnabled="True"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        RenderOptions.EdgeMode="Aliased"
                        SizeChanged="imgCurrent_SizeChanged"
                        Source="{Binding DisplayImage}"
                        Stretch="{Binding ImageStretch}"
                        UseLayoutRounding="False">
                        <Image.RenderTransform>
                            <TranslateTransform x:Name="imgShakeTransform" />
                        </Image.RenderTransform>

                        <Image.Effect>
                            <DropShadowEffect
                                BlurRadius="20"
                                Opacity="0.8"
                                ShadowDepth="0"
                                Color="Black" />
                        </Image.Effect>
                    </Image>

                </ScrollViewer>

                <!--  Vollbild-Elemente (Klickzonen, Filmstrip, Hover-Zone) → Ansichten/VollbildAnsicht.xaml  -->


                <!--  Drop-Overlay: sichtbar wenn Datei über das Bild gezogen wird  -->
                <Border
                    x:Name="BRD_DropOverlay"
                    Panel.ZIndex="300"
                    Background="#CC111111"
                    BorderBrush="#88FFFFFF"
                    BorderThickness="2"
                    CornerRadius="8"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="48"
                            Foreground="#CCFFFFFF"
                            Text="&#xE896;" />
                        <TextBlock
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#EEFFFFFF"
                            Text="Bild hier ablegen" />
                        <TextBlock
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#88FFFFFF"
                            Text="Alle Bilder im selben Ordner werden geladen" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <!--<RibbonButton
            x:Name="RDBTN_BildNachRechts"
            Grid.Row="1"
            Width="48"
            Height="155"
            Margin="0,0,10,167"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding CommandExecuteBildNachRechtsCommand}"
            Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
            Label="Weiter"
            LargeImageSource="/Images/PfeilNachRechts.png"
            MouseOverBackground="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
            MouseOverBorderBrush="Transparent"
            PressedBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />-->


        <Grid
            Grid.Row="1"
            Width="54"
            Margin="0,137,10,167"
            HorizontalAlignment="Right"
            Background="Transparent"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">

            <!--  Klickfläche  -->
            <RibbonButton
                x:Name="RDBTN_BildNachRechts"
                Grid.Row="1"
                Margin="1,1,1,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                Command="{Binding CommandExecuteBildNachRechtsCommand, Mode=OneWay}"
                CornerRadius="8,8,8,8"
                KeyTip="STRG+D"
                MouseOverBackground="#FFB7F393"
                MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                PressedBackground="#FFCACFFE"
                ToolTip="Nächstes Bild (→)"
                ToolTipService.InitialShowDelay="20000" />

            <!--  Sichtbares Icon  -->
            <Image
                Width="38"
                Height="38"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Source="/Images/PfeilNachRechts.png">

                <Image.Style>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Opacity" Value="1" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=RDBTN_BildNachRechts}" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>

            </Image>
        </Grid>


        <Border
            Grid.Row="1"
            Width="78"
            Height="122"
            Margin="0,10,10,0"
            Padding="2,2,2,2"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderThickness="2,2,2,2"
            CornerRadius="2,2,2,2"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">

            <StackPanel
                Width="70"
                Height="auto"
                Orientation="Vertical">
                <RibbonButton
                    x:Name="BTN_VerschieberRückgängigMachen"
                    Width="40"
                    Height="40"
                    Margin="0,0,0,4"
                    Background="{Binding IsEnabled, Converter={StaticResource CLconverterBrushesBoolian}, RelativeSource={RelativeSource Mode=Self}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    Command="{Binding CommandExecuteVerschiebenZurückCommand, Mode=OneWay}"
                    Foreground="Red"
                    Label="X"
                    LargeImageSource="/Images/Rueckwerts.png"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="#FF49AF0C"
                    PressedBackground="#FFCACFFE" />

                <Image
                    x:Name="image"
                    Width="70"
                    Height="70"
                    Source="{Binding BildchenVorher, Converter={StaticResource CLconverterStringZuKleinemImage}}" />
            </StackPanel>
        </Border>
        <Border
            x:Name="BRD_NachUntenVerschieben"
            Grid.Row="1"
            Width="78"
            Height="auto"
            MaxHeight="156"
            Margin="0,0,10,10"
            Padding="2,2,2,2"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            d:MaxHeight="200"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderThickness="2,2,2,2"
            CornerRadius="2,2,2,2"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <StackPanel
                Width="70"
                Height="auto"
                Orientation="Vertical">
                <Image
                    x:Name="image_Kopieren1"
                    Width="70"
                    Height="auto"
                    MaxHeight="70"
                    Margin="0,0,0,4"
                    Source="{Binding SelectedBildchen.BName, Converter={StaticResource CLconverterStringZuKleinemImage}}"
                    Visibility="{Binding IsEnabled, Converter={StaticResource CLconverterVisiblityBoolian}, ElementName=RDBTN_BildEKeinFav}" />
                <!--  Abbrechen Bilder Verschieben  -->


                <!--  MouseOverBackground="#FFB7F393"  -->
                <RibbonButton
                    x:Name="RDBTN_BildEKeinFav"
                    Width="70"
                    Height="70"
                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteBildInsKeinFavVerzeichnisVerschiebenCommand, Mode=OneWay}"
                    FontFamily="Segoe UI Symbol"
                    KeyTip="&#xE019;"
                    Label="Kein Fav"
                    LargeImageSource="/Images/PfeilNachUnten.png"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE">
                    <RibbonButton.MouseOverBackground>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">

                            <!--  verblasstes Grün: war mal wichtig  -->
                            <GradientStop Offset="0.0" Color="#FFB8F5B8" />

                            <!--  Übergang: staubiges Gelb / Amber  -->
                            <GradientStop Offset="0.45" Color="#FFF5D87A" />

                            <!--  Entscheidung kippt  -->
                            <GradientStop Offset="0.75" Color="#FFF0A35E" />

                            <!--  Ziel: unten = schlecht / ablegen  -->
                            <GradientStop Offset="1.0" Color="#FFE57373" />
                        </LinearGradientBrush>
                    </RibbonButton.MouseOverBackground>
                    <RibbonButton.ContextMenu>
                        <ContextMenu>
                            <MenuItem
                                Command="{Binding CommandExecuteAlleBilderInsKeinFavVerschiebenCommand, Mode=OneWay}"
                                Header="Alle Verschieben"
                                ToolTip="Dateien werden kopiert, dann gelöscht, Ab und zu Fehler beim Löschen der Datei" />
                            <!--<MenuItem Header="Aktion 2" />
                            <Separator/>
                            <MenuItem Header="Einstellungen" />-->

                            <MenuItem
                                Command="{Binding CommandExecuteBildInsKIFehlerVerschiebenCommand, Mode=OneWay}"
                                Header="Ins KI Fehler Verzeichnis Verschieben"
                                ToolTip="Selectierte Datei wird ins 'KI Fehler Verzeichnis' verschoben">
                                <MenuItem.Icon>
                                    <Image
                                        Width="20"
                                        Height="20"
                                        Source="/Images/KIFehler.png"
                                        Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>

                        </ContextMenu>
                    </RibbonButton.ContextMenu>
                </RibbonButton>

                <!--  Visibility="{Binding CommandExecuteAlleBilderInsKeinFavVerschiebenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}" />  -->
                <RibbonButton
                    x:Name="RBTN_AbbrechenNixFavVerschieben"
