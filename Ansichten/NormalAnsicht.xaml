                                                Background="Transparent"
                                                CornerRadius="5" />
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="overlay" Property="Background" Value="#33000000" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="overlay" Property="Background" Value="#55000000" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!--  Indikatoren (Webcam/Mikrofon/Screen-Share) → jetzt im Host-Cluster (MainWindow), oben rechts.  -->

            <!--  Unscheinbarer Button: blendet die Such-/Index-Leiste ein/aus  -->
            <Button
                x:Name="BTN_IndexSuchleiste"
                Width="54"
                Height="28"
                Margin="8,0,0,0"
                Padding="10,0"
                Command="{Binding CommandExecuteSuchleisteToggleCommand}"
                Cursor="Hand"
                ToolTip="Bildersuche ein-/ausblenden">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#FF6B6B6B" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border
                                        x:Name="bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="#33000000"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                Margin="2,3,6,0"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="12"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="&#xE721;" />
                                            <TextBlock
                                                FontFamily="Segoe UI"
                                                FontSize="12"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="Index" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#11000000" />
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#55000000" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#22000000" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSuchleisteOffen}" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#22000000" />
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#55000000" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!--  Bildersuche: schlanke Zeile — als Popup unter dem Button  -->
            <Popup
                x:Name="POP_IndexSuchLeiste"
                AllowsTransparency="True"
                HorizontalOffset="0"
                IsOpen="{Binding IsSuchleisteOffen}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=BTN_IndexSuchleiste}"
                PopupAnimation="Fade"
                StaysOpen="False"
                VerticalOffset="6">
                <bildersuche:IndexSuchPanel Margin="12" />
            </Popup>

        </StackPanel>
        <Button
            x:Name="BTN_OrdnerÖffnen"
            Grid.Row="2"
            Width="25"
            Height="20"
            Margin="0,70,10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Command="{Binding CommandExecuteOrdnerDerAnwendungÖffnenCommand, Mode=OneWay}"
            Content="OÖ"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}" />

        <!--  „Liste": öffnet das Schnell-Listen-Popup (alle Miniaturen zum Finden)  -->
        <Button
            x:Name="BTN_BildListe"
            Grid.Row="2"
            Height="24"
            Margin="29,95,0,0"
            Padding="8,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Command="{Binding CommandExecuteBildListeToggleCommand}"
            Cursor="Hand"
            ToolTip="Alle Bilder als Liste – schnell zu einem Bild springen"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="12"
                    Text="&#xE8FD;" />
                <TextBlock VerticalAlignment="Center" Text="Liste" />
            </StackPanel>
        </Button>

        <!--  Schnell-Liste als Popup, rechtsbündig über der Miniaturleiste  -->
        <Popup
            x:Name="POP_BildListe"
            AllowsTransparency="True"
            IsOpen="{Binding IsBildListeOffen, Mode=TwoWay}"
            Placement="Custom"
            PlacementTarget="{Binding ElementName=Listbox_MiniaturBilder}"
            PopupAnimation="Fade"
            StaysOpen="False">
            <bildersuche:BildListePanel Margin="12" />
        </Popup>
        <Border
            Grid.Row="2"
            Width="34"
            Height="34"
            Margin="8,20,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            BorderBrush="#44000000"
            BorderThickness="0.6"
            CornerRadius="6"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="6"
                    Opacity="0.3"
                    ShadowDepth="1"
                    Color="Black" />
            </Border.Effect>
            <Grid>

                <!--  Links (Left)  -->
                <!--  Position — Windrad-Dreiecke  -->
                <Canvas
                    x:Name="CVS_PositionDreiecke"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ToolTip="Bildposition im Ordner (Viertel-Anzeige)">
                    <Canvas.Effect>
                        <DropShadowEffect
                            BlurRadius="3"
                            Opacity="0.6"
                            ShadowDepth="0"
                            Color="#FF25B2C4" />
                    </Canvas.Effect>
                    <!--  Dreieck 1: Links  -->
                    <Polygon x:Name="PLG_DreieckLinks" Points="10,10 0,20 0,0">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="0">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Dreieck 2: Oben  -->
                    <Polygon x:Name="PLG_DreieckOben" Points="10,10 0,0 20,0">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="1">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Dreieck 3: Rechts  -->
                    <Polygon x:Name="PLG_DreieckRechts" Points="10,10 20,0 20,20">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="2">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Dreieck 4: Unten  -->
                    <Polygon x:Name="PLG_DreieckUnten" Points="10,10 20,20 0,20">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="3">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Trennlinien  -->
                    <Line
                        Stroke="#40000000"
                        StrokeThickness="0.6"
                        X1="0"
                        X2="20"
                        Y1="0"
                        Y2="20" />
                    <Line
                        Stroke="#40000000"
                        StrokeThickness="0.6"
                        X1="20"
                        X2="0"
                        Y1="0"
                        Y2="20" />
                </Canvas>

                <!--  Links (Left)  -->
                <Border
                    Margin="2,2,25,2"
                    d:Background="Gold"
                    CornerRadius="4,0,0,4">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="1">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Oben (Top)  -->
                <Border
                    Margin="2,2,2,25"
                    d:Background="Gold"
                    CornerRadius="4,4,0,0">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="2">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Rechts (Right)  -->
                <Border
                    Margin="25,2,2,2"
                    d:Background="Gold"
                    CornerRadius="0,4,4,0">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="3">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Unten (Bottom)  -->
                <Border
                    Margin="2,25,2,2"
                    d:Background="Gold"
                    CornerRadius="0,0,4,4">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="4">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Position — Windrad-Dreiecke  -->

            </Grid>
        </Border>
    </Grid>
</UserControl>
