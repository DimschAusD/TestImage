                                                    <TextBlock
                                                        x:Name="IC_Einfarbig"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="16"
                                                        Foreground="#3B82C4"
                                                        Text="&#xE790;" />
                                                    <TextBlock
                                                        x:Name="TXT_EinfarbigTitel"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="#222222"
                                                        Text="E – Einfarbigkeit" />
                                                </StackPanel>

                                                <TextBlock
                                                    x:Name="TXT_EinfarbigBefund"
                                                    Margin="0,0,0,8"
                                                    d:Text="Helligkeitsstreuung 0,182&#x0a;Ordner-Median 0,164 aus 63 Bildern&#x0a;Genug Struktur im Bild."
                                                    FontSize="11"
                                                    Foreground="#555555"
                                                    Text="{Binding EinfarbigText}"
                                                    TextWrapping="Wrap" />

                                                <TextBlock
                                                    x:Name="TXT_EinfarbigWas"
                                                    Margin="0,0,0,8"
                                                    FontSize="11"
                                                    Foreground="#555555"
                                                    Text="Wie stark die Helligkeit über das Bild streut. Nahe null heisst: eine gleichmässige Fläche – Platzhalter, gespeicherte Fehlerseite, versehentlich abgelegte Farbfläche."
                                                    TextWrapping="Wrap" />

                                                <Separator x:Name="SEP_Einfarbig" Margin="0,0,0,6" />

                                                <TextBlock
                                                    x:Name="TXT_EinfarbigFuss"
                                                    FontSize="10"
                                                    Foreground="#999999"
                                                    Text="Gerechnet auf dem 100-Pixel-Vorschaubild, das für die Anzeige ohnehin entsteht. Unter 0,02 schlägt es auch ohne Ordnervergleich an."
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </ToolTip>
                                </Border.ToolTip>

                                <TextBlock
                                    x:Name="TXT_AmpelEinfarbig"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#FF1F2937"
                                    Text="E" />
                            </Border>
                            <Border
                                x:Name="BRD_AmpelKantenarm"
                                Width="20"
                                Height="20"
                                Margin="1,1,1,1"
                                d:Background="GreenYellow"
                                Background="{Binding IsBildKantenarm, Converter={StaticResource ConverterAmpelFarbe}}"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                BorderThickness="2"
                                ToolTipService.ShowDuration="30000">
                                <Border.ToolTip>
                                    <ToolTip
                                        x:Name="TTP_AmpelKantenarm"
                                        MaxWidth="320"
                                        HasDropShadow="True"
                                        Placement="Bottom"
                                        VerticalOffset="8">
                                        <Border
                                            x:Name="BRD_KantenarmKarte"
                                            Padding="12,12,14,12"
                                            Background="#F4F4F0"
                                            BorderBrush="#C0C0BA">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                                                    <Setter Property="BorderBrush" Value="#3B82C4" />
                                                </Style>
                                            </Border.Style>

                                            <StackPanel x:Name="STP_Kantenarm">
                                                <StackPanel
                                                    x:Name="STP_KantenarmKopf"
                                                    Margin="0,0,0,8"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        x:Name="IC_Kantenarm"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="16"
                                                        Foreground="#3B82C4"
                                                        Text="&#xE7A8;" />
                                                    <TextBlock
                                                        x:Name="TXT_KantenarmTitel"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="#222222"
                                                        Text="K – Kantendichte" />
                                                </StackPanel>

                                                <TextBlock
                                                    x:Name="TXT_KantenarmBefund"
                                                    Margin="0,0,0,8"
                                                    d:Text="Kantendichte 0,009&#x0a;Ordner-Median 0,042 aus 29 Bildern, Grenze 0,023 (55 %)&#x0a;Deutlich weniger Kanten als der Rest des Ordners."
                                                    FontSize="11"
                                                    Foreground="#555555"
                                                    Text="{Binding KantenText}"
                                                    TextWrapping="Wrap" />

                                                <TextBlock
                                                    x:Name="TXT_KantenarmWas"
                                                    Margin="0,0,0,8"
                                                    FontSize="11"
                                                    Foreground="#555555"
                                                    Text="Unterschied benachbarter Bildpunkte, geteilt durch die Gesamtstreuung. Wenige harte Übergänge heisst hochskaliert oder weich gezeichnet – die Zahl kann beides nicht trennen. Deshalb „kantenarm“ und nicht „unscharf“."
                                                    TextWrapping="Wrap" />

                                                <Separator x:Name="SEP_Kantenarm" Margin="0,0,0,6" />

                                                <TextBlock
                                                    x:Name="TXT_KantenarmFuss"
                                                    FontSize="10"
                                                    Foreground="#999999"
                                                    Text="Nur ab 2 Megapixel ein Mangel – ein kleines Bild darf weich sein. Gemessen am Bild in Anzeigegrösse, nicht am Original."
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </ToolTip>
                                </Border.ToolTip>

                                <TextBlock
                                    x:Name="TXT_AmpelKantenarm"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#FF1F2937"
                                    Text="K" />
                            </Border>
                        </StackPanel>
                        <!--
                            Vier Stufen: Vorschau geladen, Vorschau sichtbar, grosses Bild
                            sichtbar, fertig. Die Werte stehen als benannte Konstanten im
                            ViewModel (LadestufeFertig muss zu Maximum passen).
                        -->
                        <ProgressBar
                            x:Name="PGB_BildLadenStufen"
                            Width="40"
                            Height="10"
                            d:Value="3"
                            d:Visibility="Visible"
                            Maximum="4"
                            Visibility="{Binding CommandExecuteKleinesBildGrossesBildLadenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}"
                            Value="{Binding ProgressValue, Mode=OneWay}" />



                    </StackPanel>
                </Border>
                <!--
                    Hier stand STP_Ladestufen mit BRD_GrossesBild und BRD_KonturBild — zwei
                    Kästchen von 28 × 20 Punkten, in denen Miniaturen des Anzeigebildes und
                    des Kantenbildes lagen.

                    Die Miniaturen zeigten dasselbe wie das grosse Bild daneben, kosteten
                    aber bei jedem Bildwechsel je eine hochwertige Verkleinerung von
                    Anzeigegrösse auf 24 × 16 Punkte. Ohne sie waren die Kästchen leer.

                    Die Ladezeiten, die in ihren ToolTips standen, gibt es weiter im
                    ViewModel: SWkleinesBild, SWgrossesBild, SWkonturBild. Falls sie wieder
                    sichtbar sein sollen, dann besser als Text — dafür muss man nicht hovern.
                -->

                <RibbonButton
                    x:Name="RDBTN_BildOriginalgrösse"
                    Width="36"
                    Height="28"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteBildStretchAnpassenCommand, Mode=OneWay}"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE"
                    SmallImageSource="/Images/Scallieren.png" />

            </StackPanel>
            <!--
                Farbsignatur des Bildes: bandweise Mittelwerte von oben nach unten. Der
                Verlauf kommt fertig aus dem ViewModel (BildFarbsignatur), berechnet auf dem
                100-px-Vorschaubild. Ohne Bild bleibt die Fläche leer, der Rahmen zeigt den
                Streifen trotzdem an.
            -->
            <Rectangle
                x:Name="LLL"
                Grid.Row="3"
                Width="10"
                Height="72"
                Margin="25,0,0,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Fill="{Binding BildFarbsignatur}"
                Stroke="Black"
                ToolTip="Farbsignatur: Durchschnittsfarbe des Bildes, von oben nach unten in Bändern">
                <d:Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#FFE7F926" />
                        <GradientStop Offset="0.083" Color="#FFF18CD5" />
                        <GradientStop Offset="0.923" Color="#FFF694DB" />
                        <GradientStop Offset="0.953" Color="#FFF44EC8" />
                        <GradientStop Offset="0.993" Color="#FFF4EA4E" />
                    </LinearGradientBrush>
                </d:Rectangle.Fill>
            </Rectangle>
        </Grid>
        <!--
            Werkzeugleiste zum Byte-, SHA- und Grauabgleich. Eigene Zeile unter dem Bild
            statt schwebend in dessen linker unterer Ecke — dort verdeckte sie einen
            Streifen des Bildes und stiess bei kleinen Fenstern mit der Farbsignatur
            zusammen.
        -->
        <Border
            x:Name="BRD_AbgleichWerkzeuge"
            Grid.Row="3"
            Grid.Column="1"
            Width="auto"
            Height="28"
            Margin="5,4,0,4"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
            BorderThickness="1,1,1,1"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <StackPanel Orientation="Horizontal">
                <CheckBox
                    x:Name="CHBX_MultiGleichheit"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="Multi"
                    IsChecked="{Binding MultiByteParallelGleichheit, Mode=TwoWay}"
                    ToolTip="Multi Thriding, lohnt sich bei einer schnellen Festplatte, sonnst nicht" />
                <!--  SmallImageSource="/Images/Gleich.png"  -->


                <!--  d:Source="images/gleich.png"  -->


                <!--  d:SmallImageSource="/Images/UngefährGleichKlein.png"  -->


                <!--  SmallImageSource="{svg1:SvgIcon Source=Images/EinGleicher.svg} "  -->
                <RibbonButton
                    x:Name="RDBTN_BildGleicheByteBildFinden"
                    Width="30"
                    Height="22"
                    Margin="8,2,2,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    d:SmallImageSource="/Images/EinGleicherKlein.png"
                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteSuchenGleichesBildByteVergleichCommand, Mode=OneWay}"
                    Content="Byte-Abgleich"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE"
                    SmallImageSource="{svg1:SvgIcon Source=/Images/EinGleicher.svg}"
                    ToolTip="Byte-Abgleich, gleiches Bild">
                    <RibbonButton.ContextMenu>
                        <ContextMenu>
                            <MenuItem
                                Command="{Binding CommandExecuteAlleBilderMiteinanderAufByteGleichheitPrüfenCommand, Mode=OneWay}"
                                Header="Byte-Vergleich aller Bilder"
                                ToolTip="Byte-Abgleich: Jedes Bild mit jedem Bild vergleichen">
                                <MenuItem.Icon>
                                    <Image
                                        Width="16"
                                        Height="16"
                                        d:Source="/Images/VieleGleicheKlein.png"
                                        Source="{svg1:SvgIcon Source=/Images/vielegleiche.svg}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <!--  Icon="{svg1:SvgIcon Source=Images/EinGleicher.svg}" d:Icon="/Images/Gleich.png"  -->
                            <MenuItem
                                Command="{Binding CommandExecuteAlleBilderSHA256AbgleichPrüfenCommand, Mode=OneWay}"
                                Header="Alle SHA256 Vergleich nacheinander"
                                ToolTip="Den SHA256 Wert Jedes Bildes mit jedem Bild Abgleichen, nur 1x berechnet">
                                <MenuItem.Icon>
                                    <Image
                                        Width="16"
                                        Height="16"
                                        d:Source="/Images/VieleGleicheKlein.png"
                                        Source="{svg1:SvgIcon Source=/Images/vielegleiche.svg}" />
                                </MenuItem.Icon>
                            </MenuItem>



                        </ContextMenu>

                    </RibbonButton.ContextMenu>

                </RibbonButton>
                <RibbonButton
                    Width="22"
                    Height="22"
                    d:Visibility="Visible"
                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteSuchenGleichesBildByteVergleichCancelCommand, Mode=OneWay}"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE"
                    SmallImageSource="/Images/Abbrechenn.png"
                    ToolTip="Byte Abgleich, Abbrechen"
                    Visibility="{Binding CommandExecuteSuchenGleichesBildByteVergleichCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}" />
                <RibbonButton
                    x:Name="RDBTN_AbbrechenByteAbgleichAlle"
                    Width="22"
                    Height="22"
                    Margin="2,0,0,0"
                    d:Visibility="Visible"
                    Background="#FFF7E9E9"
                    BorderBrush="#FFFC4747"
                    Command="{Binding CommandExecuteAlleBilderMiteinanderAufByteGleichheitPrüfenCancelCommand, Mode=OneWay}"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="#FF49AF0C"
                    PressedBackground="#FFCACFFE"
                    SmallImageSource="/Images/Abbrechen.png"
                    ToolTip="Byte-Abgleich (alle) Abbrechen"
                    Visibility="{Binding CommandExecuteAlleBilderMiteinanderAufByteGleichheitPrüfenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}" />

                <RibbonButton
                    x:Name="RDBTN_AbbrechenSHA256AlleFinden"
                    Width="22"
                    Height="22"
                    d:Visibility="Visible"
                    Background="#FFF7E9E9"
                    BorderBrush="#FFFC4747"
                    Command="{Binding CommandExecuteAlleBilderSHA256AbgleichPrüfenCancelCommand, Mode=OneWay}"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="#FF49AF0C"
                    PressedBackground="#FFCACFFE"
                    SmallImageSource="/Images/Abbrechen.png"
                    ToolTip="Alle SHA256 Abgleich, Abbrechen"
                    Visibility="{Binding CommandExecuteAlleBilderSHA256AbgleichPrüfenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}" />


                <!--  Vertical Separator  -->
                <Separator x:Name="SEP_VorGrauAbgleich" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                <!--  SmallImageSource="{svg1:SvgIcon Source=Images/UngefährGleich.svg}"  -->
                <RibbonButton
                    x:Name="RDBTN_GrauAbgleich"
                    Width="30"
                    Height="22"
                    Margin="2,0,0,0"
                    d:SmallImageSource="/Images/UngefährGleichKlein.png"
                    Background="{x:Null}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteSuchenUngefährGleichesBildCommand, Mode=OneWay}"
                    Content="Grau Gleich"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE"
                    SmallImageSource="/Images/UngefährGleich.png"
                    ToolTip="Grau Abgleich (HammingDistance &gt; 10)">

                    <RibbonButton.ContextMenu>
                        <ContextMenu x:Name="CTM_GrauAbgleich">
                            <MenuItem x:Name="MNI_GrauAbgleichPlatzhalter" Header="Nix" IsEnabled="False" />
                        </ContextMenu>
                    </RibbonButton.ContextMenu>

                </RibbonButton>
                <Button
                    x:Name="BTN_AbbrechenGrauAbgleich"
                    Width="22"
                    Height="22"
                    Margin="2,0,2,0"
                    Command="{Binding CommandExecuteSuchenUngefährGleichesBildCancelCommand, Mode=OneWay}"
                    Content="X"
                    Foreground="Red" />

                <!--
                    Tastensteuerung: Die Übersicht liegt im Fenster (BRD_TastenHilfe) und
                    gilt für beide Ansichten. Hier als sichtbarer Knopf, überall auch über F1.
                -->

            </StackPanel>
        </Border>
        <!--
            Hier stand der zweite Fortschrittsbalken (GRD_PruefFortschritt) mit
            PGB_PruefFortschritt, TXBL_ProzentProgressbar und RDBTN_AbbrechenKonsistenz.

            Er ist in BRD_AufgabeFortschritt in der Kopfleiste aufgegangen, das jetzt alle
            langlaufenden Vorgänge zeigt. Der Abbrechen-Knopf hier hatte kein Command und
            tat beim Klick nichts; sein Ersatz BTN_AufgabeAbbrechen trifft den Vorgang,
            der tatsächlich läuft.
        -->
        <!--  Kopfleiste links: Ablagefeld, Fensterknöpfe und Einstieg in die Bildersuche  -->
        <StackPanel
            x:Name="STP_KopfleisteLinks"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <Label
                x:Name="label"
                Width="190"
                Height="34"
                VerticalContentAlignment="Center"
                local:FileDragDropHelper.IsFileDragDropEnabled="True"
                AllowDrop="True"
                Background="#FFCEE067"
                Content="{Binding LabelDropContent}"
                ToolTip="{Binding Version}" />
            <Button
                x:Name="BTN_BilderAktualisieren"
                Width="28"
                Height="28"
                Margin="4,0,0,0"
                Command="{Binding CommandExecuteAlleBilderNeuEinlesenCommand, Mode=OneWay}"
                Cursor="Hand"
                ToolTip="Alle Bilder neu einlesen">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF26A69A" />
                        <Setter Property="Foreground" Value="#FFFFFFFF" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Content" Value="&#xE72C;" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <Grid>
                                            <Border
                                                x:Name="overlay"
                                                Background="Transparent"
                                                CornerRadius="5" />
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="overlay" Property="Background" Value="#33000000" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="overlay" Property="Background" Value="#55000000" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!--  Indikatoren (Webcam/Mikrofon/Screen-Share) → jetzt im Host-Cluster (MainWindow), oben rechts.  -->

            <!--
                Unscheinbarer Button: blendet die Such-/Index-Leiste ein/aus.

                Fernglas statt Lupe. Die Lupe (MDL2 E721) steht überall für die einfache
                Suche im gerade Sichtbaren — dieselbe Bedeutung wie Strg+F. Dieser Knopf
                öffnet die erweiterte Suche über den Index: andere Ordner, Begriffe,
                Ähnlichkeit. Adobe trennt beides genauso, und das Fernglas ist dort das
                Zeichen fürs Weitersuchen.
            -->
            <Button
                x:Name="BTN_IndexSuchleiste"
                Width="58"
                Height="28"
                Margin="8,0,0,0"
                Padding="10,0"
                Command="{Binding CommandExecuteSuchleisteToggleCommand}"
                Cursor="Hand"
                ToolTip="Bildersuche ein-/ausblenden">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#FF6B6B6B" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border
                                        x:Name="bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="#33000000"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                                            <!--
                                                Gezeichnet, nicht als Schriftzeichen: Segoe
                                                MDL2 Assets kennt kein Fernglas. Fünf
                                                Rechtecke — zwei Rohre, zwei Okulare, eine
                                                Brücke — bleiben bei jeder Bildschirm-
                                                auflösung scharf und nehmen die Schriftfarbe
                                                des Knopfes an, auch beim Überfahren.
                                            -->
                                            <Canvas
                                                x:Name="CNV_Fernglas"
                                                Width="16"
                                                Height="13"
                                                Margin="2,1,6,0"
                                                VerticalAlignment="Center">
                                                <!--
                                                    Okulare oben, halb unter den Rohren —
                                                    dadurch verschmelzen beide zu einem
                                                    abgesetzten Rohr statt zu zwei
                                                    getrennten Klötzchen.
                                                -->
                                                <Rectangle
                                                    x:Name="RCT_FernglasOkularLinks"
                                                    Canvas.Left="1"
                                                    Canvas.Top="0"
                                                    Width="4"
                                                    Height="6"
                                                    Fill="{TemplateBinding Foreground}"
                                                    RadiusX="1"
                                                    RadiusY="1" />
                                                <Rectangle
                                                    x:Name="RCT_FernglasOkularRechts"
                                                    Canvas.Left="11"
                                                    Canvas.Top="0"
                                                    Width="4"
                                                    Height="6"
                                                    Fill="{TemplateBinding Foreground}"
                                                    RadiusX="1"
                                                    RadiusY="1" />

                                                <!--
                                                    Radius 2, nicht 3: Bei 3 wäre das
                                                    6 Punkte breite Rohr oben und unten
                                                    halbrund — die Form las sich dann als
                                                    Hantel, nicht als Fernglas.
                                                -->
                                                <Rectangle
                                                    x:Name="RCT_FernglasRohrLinks"
                                                    Canvas.Left="0"
                                                    Canvas.Top="4"
                                                    Width="6"
                                                    Height="9"
                                                    Fill="{TemplateBinding Foreground}"
                                                    RadiusX="2"
                                                    RadiusY="2" />
                                                <Rectangle
                                                    x:Name="RCT_FernglasRohrRechts"
                                                    Canvas.Left="10"
                                                    Canvas.Top="4"
                                                    Width="6"
                                                    Height="9"
                                                    Fill="{TemplateBinding Foreground}"
                                                    RadiusX="2"
                                                    RadiusY="2" />

                                                <!--  Brücke im oberen Drittel; mittig sähe es aus wie ein H  -->
                                                <Rectangle
                                                    x:Name="RCT_FernglasBruecke"
                                                    Canvas.Left="5"
                                                    Canvas.Top="3"
                                                    Width="6"
                                                    Height="3"
                                                    Fill="{TemplateBinding Foreground}" />
                                            </Canvas>
                                            <TextBlock
                                                x:Name="TXT_IndexSuchleiste"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe UI"
                                                FontSize="12"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="Index" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#11000000" />
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#55000000" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#22000000" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSuchleisteOffen}" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#22000000" />
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#55000000" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!--
                HIER STAND BRD_AufgabeFortschritt.

                Der Streifen sitzt jetzt in GRD_StreifenUeberBild, in der Zeile über dem
                Bild. Grund: Diese Zeile ist wegen der Kontur-Karte ohnehin 36 Punkte hoch
                und links leer — der Streifen kostet dort keinen Punkt zusätzlich. Und die
                Kopfleiste hier war mit label (190) plus zwei Knöpfen plus 280 für den
                Streifen die engste Reihe der Ansicht.
            -->

            <!--
                Die Bildersuche lief bis hier als Popup unter dem Knopf. Sie sitzt jetzt
                in einem eigenen Werkzeugfenster (IndexSuchFenster), geöffnet über
                IsSuchleisteOffen in NormalAnsicht.xaml.cs.

                Grund: Ein Popup mit StaysOpen="False" schliesst sich, sobald man in den
                Explorer klickt — und genau das braucht man, um einen Ordner auf die
                Index-Karte zu ziehen. Ausserdem lässt sich ein Popup nicht in der Grösse
                ändern.
            -->

        </StackPanel>
        <Button
            x:Name="BTN_OrdnerÖffnen"
            Grid.Row="4"
            Grid.Column="2"
            Width="25"
            Height="20"
            Margin="0,0,10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Command="{Binding CommandExecuteOrdnerDerAnwendungÖffnenCommand, Mode=OneWay}"
            Content="OÖ"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}" />

        <!--  „Liste": öffnet das Schnell-Listen-Popup (alle Miniaturen zum Finden)  -->
        <Button
            x:Name="BTN_BildListe"
            Grid.Row="5"
            Grid.Column="0"
            Height="24"
            Margin="10,0,0,0"
            Padding="8,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Command="{Binding CommandExecuteBildListeToggleCommand}"
            Cursor="Hand"
            ToolTip="Alle Bilder als Kacheln – schnell zu einem Bild springen"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <StackPanel x:Name="STP_BildListeInhalt" Orientation="Horizontal">
                <!--  ECA5 = Tiles. Vorher E8FD (List) – das Panel zeigt aber ein Kachelraster.  -->
                <TextBlock
                    x:Name="IC_BildListe"
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="12"
                    Text="&#xECA5;" />
                <TextBlock
                    x:Name="TXT_BildListe"
                    VerticalAlignment="Center"
                    Text="Kacheln" />
            </StackPanel>
        </Button>

        <!--  Schnell-Liste als Popup, rechtsbündig über der Miniaturleiste  -->
        <Popup
            x:Name="POP_BildListe"
            AllowsTransparency="True"
            IsOpen="{Binding IsBildListeOffen, Mode=TwoWay}"
            Placement="Custom"
            PlacementTarget="{Binding ElementName=Listbox_MiniaturBilder}"
            PopupAnimation="Fade"
            StaysOpen="False">
            <bildersuche:BildListePanel Margin="12" />
        </Popup>
        <!--  Windrad: zeigt als Viertel, wo im Ordner das gewählte Bild steht  -->
        <Border
            x:Name="BRD_Positionsanzeige"
            Grid.Row="4"
            Grid.Column="0"
            Width="34"
            Height="34"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            BorderBrush="#44000000"
            BorderThickness="0.6"
            CornerRadius="6"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="6"
                    Opacity="0.3"
                    ShadowDepth="1"
                    Color="Black" />
            </Border.Effect>
            <Grid>

                <!--  Links (Left)  -->
                <!--  Position — Windrad-Dreiecke  -->
                <Canvas
                    x:Name="CVS_PositionDreiecke"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ToolTip="Bildposition im Ordner (Viertel-Anzeige)">
                    <Canvas.Effect>
                        <DropShadowEffect
                            BlurRadius="3"
                            Opacity="0.6"
                            ShadowDepth="0"
                            Color="#FF25B2C4" />
                    </Canvas.Effect>
                    <!--  Dreieck 1: Links  -->
                    <Polygon x:Name="PLG_DreieckLinks" Points="10,10 0,20 0,0">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="0">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Dreieck 2: Oben  -->
                    <Polygon x:Name="PLG_DreieckOben" Points="10,10 0,0 20,0">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="1">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Dreieck 3: Rechts  -->
                    <Polygon x:Name="PLG_DreieckRechts" Points="10,10 20,0 20,20">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="2">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Dreieck 4: Unten  -->
                    <Polygon x:Name="PLG_DreieckUnten" Points="10,10 20,20 0,20">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="3">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Trennlinien  -->
                    <Line
                        Stroke="#40000000"
                        StrokeThickness="0.6"
                        X1="0"
                        X2="20"
                        Y1="0"
                        Y2="20" />
                    <Line
                        Stroke="#40000000"
                        StrokeThickness="0.6"
                        X1="20"
                        X2="0"
                        Y1="0"
                        Y2="20" />
                </Canvas>

                <!--  Links (Left)  -->
                <Border
                    Margin="2,2,25,2"
                    d:Background="Gold"
                    CornerRadius="4,0,0,4">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="1">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Oben (Top)  -->
                <Border
                    Margin="2,2,2,25"
                    d:Background="Gold"
                    CornerRadius="4,4,0,0">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="2">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Rechts (Right)  -->
                <Border
                    Margin="25,2,2,2"
                    d:Background="Gold"
                    CornerRadius="0,4,4,0">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="3">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Unten (Bottom)  -->
                <Border
                    Margin="2,25,2,2"
                    d:Background="Gold"
                    CornerRadius="0,0,4,4">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="4">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Position — Windrad-Dreiecke  -->

            </Grid>
        </Border>
    </Grid>
</UserControl>
