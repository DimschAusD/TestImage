<UserControl
    x:Class="TestImage.Ansichten.NormalAnsicht"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Converters="clr-namespace:TestImage.Converters"
    xmlns:Converters1="clr-namespace:TestImageViewer.Converters"
    xmlns:ansichten="clr-namespace:TestImage.Ansichten"
    xmlns:bildersuche="clr-namespace:TestImage.Bildersuche"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:TestImage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="700"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--
            Normaler Button in Ribbon-Anmutung. MouseOverBackground, PressedBackground
            und CornerRadius gehören zu RibbonButtonBase; hier sind dieselben Zustände
            über Trigger nachgebaut, mit den Farben von RDBTN_BildNachRechts.
            
            WICHTIG — jeder Zustand ist auch ohne Farbsehen erkennbar. Die Farbe allein
            trägt die Rückmeldung nicht:
            
            überfahren   Rand wird doppelt so dick (1 → 2)
            gedrückt     Inhalt rutscht einen Punkt nach unten rechts
            gesperrt     halbe Deckkraft, und das Überfahren reagiert gar nicht
            
            Der Hover-Trigger muss ein MultiTrigger bleiben: Ein einfacher Trigger auf
            IsMouseOver feuert auch bei gesperrtem Knopf, der dann kräftig grün leuchtet,
            ohne dass ein Klick etwas täte. Die kräftige Farbe heisst „das geht jetzt".
        -->
        <Style x:Key="RibbonKnopf" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border
                            x:Name="BRD_RibbonFlaeche"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                x:Name="CTP_RibbonInhalt"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>

                            <!--  Überfahren, aber nur wenn der Knopf auch etwas tut  -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BRD_RibbonFlaeche" Property="Background" Value="#FFB7F393" />
                                <Setter TargetName="BRD_RibbonFlaeche" Property="BorderBrush" Value="#FF49AF0C" />
                                <Setter TargetName="BRD_RibbonFlaeche" Property="BorderThickness" Value="2" />
                            </MultiTrigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BRD_RibbonFlaeche" Property="Background" Value="#FFCACFFE" />
                                <Setter TargetName="BRD_RibbonFlaeche" Property="BorderBrush" Value="#FF3B4FC4" />
                                <Setter TargetName="BRD_RibbonFlaeche" Property="BorderThickness" Value="2" />
                                <Setter TargetName="CTP_RibbonInhalt" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="1" Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <!--  Zuletzt, damit es die beiden darüber überstimmt  -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BRD_RibbonFlaeche" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Prüf-Schalter in der linken Werkzeugspalte.
            
            Kästchen und Beschriftung. Der Zustand hängt am HAKEN, also an einer Form —
            die dunkle Füllung ist nur die Zugabe. Dieselbe Regel wie bei RibbonKnopf:
            Farbe allein trägt nie die Auskunft.
            
            Beim Überfahren dasselbe Grün und derselbe doppelt dicke Rand wie dort, damit
            „hier kann ich klicken" in der ganzen Ansicht gleich aussieht.
            
            Die Schriftgrösse setzt das Element, nicht dieser Style — sie entscheidet über
            die Breite, und die Spalte ist so breit wie ihr breitestes Stück. Gemessen:
            „Prüfen" bei Grösse 12 misst mit Kästchen und Rand rund 70 Punkte, „Bilder
            prüfen" bei Grösse 10 rund 80. Die Spalte hat 96.
        -->
        <Style x:Key="PrüfKästchen" TargetType="{x:Type CheckBox}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF1F2937" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">

                        <!--  Background="Transparent": sonst reagiert nur der Text auf die Maus, nicht die Lücken  -->
                        <StackPanel
                            x:Name="STP_PrüfKästchenReihe"
                            Background="Transparent"
                            Orientation="Horizontal">
                            <Border
                                x:Name="BRD_PrüfKästchen"
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Background="White"
                                BorderBrush="#FF6B7280"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                                <TextBlock
                                    x:Name="IC_PrüfHaken"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="11"
                                    FontWeight="Normal"
                                    Foreground="White"
                                    Text="&#xE73E;"
                                    Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter
                                x:Name="CTP_PrüfText"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BRD_PrüfKästchen" Property="Background" Value="#FF2B3440" />
                                <Setter TargetName="IC_PrüfHaken" Property="Visibility" Value="Visible" />
                            </Trigger>

                            <!--  Nur wenn der Schalter auch bedienbar ist — sonst leuchtet er gesperrt grün  -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BRD_PrüfKästchen" Property="BorderBrush" Value="#FF49AF0C" />
                                <Setter TargetName="BRD_PrüfKästchen" Property="BorderThickness" Value="2" />
                            </MultiTrigger>

                            <!--  Die helle Fläche nur im leeren Kästchen; im vollen würde sie den Haken schlucken  -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BRD_PrüfKästchen" Property="Background" Value="#FFEDFBE4" />
                            </MultiTrigger>

                            <!--  Zuletzt, damit es die Trigger darüber überstimmt  -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="STP_PrüfKästchenReihe" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Die kleinen Info-Kacheln in der Kopfleiste rechts: Dateigrösse, Massstab,
            Abmessungen. Gleiche Machart wie die Karten im Streifen über dem Bild —
            weiss, feiner Rand, abgerundet — nur kleiner.

            Die Sichtbarkeit steckt im Style und nicht an den drei Kacheln: Ohne Bild sind
            alle drei Zahlen bedeutungslos, und eine leere Kachel ist schlechter als keine.
        -->
        <Style x:Key="InfoKachel" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFCBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Visibility" Value="{Binding HatBild, Converter={StaticResource CLconverterVisiblityBoolian}}" />
        </Style>

        <Style x:Key="InfoKachelText" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF4B5563" />
        </Style>

        <!--
            Knöpfe der Kopfleiste: hell, neutral, nur ein feiner Rahmen.
            
            Die beiden Knöpfe kamen aus dem MainWindow, wo sie als dunkle, halbdurch-
            sichtige Pillen über dem Bild schwebten. Über einem Bild ist das richtig — in
            einer hellen Kopfleiste nicht. Gleiche Anmutung wie BTN_IndexSuchleiste links.
        -->
        <Style x:Key="KopfleisteKnopf" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FF6B6B6B" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border
                            x:Name="BRD_KnopfFlaeche"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#33000000"
                            BorderThickness="1"
                            CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BRD_KnopfFlaeche" Property="Background" Value="#11000000" />
                                <Setter TargetName="BRD_KnopfFlaeche" Property="BorderBrush" Value="#55000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BRD_KnopfFlaeche" Property="Background" Value="#22000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Entwurfsdaten für das Monatsband: 28 Monate über drei Jahre. Als Ressource,
            weil zwei ItemsControls dieselbe Reihe brauchen — die Jahreszeile oben und die
            Balken darunter. Zur Laufzeit ungenutzt, kostet nur ein paar kleine Objekte.
        -->
        <x:Array x:Key="ZeitBandBeispiel" Type="{x:Type bildersuche:ZeitBalken}">
            <bildersuche:ZeitBalken
                Hoehe="4"
                IstJahresAnfang="True"
                JahrText="2011"
                Tooltip="Jan 2011: 3 Bilder" />
            <bildersuche:ZeitBalken Hoehe="7" Tooltip="Feb 2011: 6 Bilder" />
            <bildersuche:ZeitBalken Hoehe="12" Tooltip="Mär 2011: 12 Bilder" />
            <bildersuche:ZeitBalken Hoehe="19" Tooltip="Apr 2011: 21 Bilder" />
            <bildersuche:ZeitBalken Hoehe="9" Tooltip="Mai 2011: 8 Bilder" />
            <bildersuche:ZeitBalken Hoehe="2" Tooltip="Jun 2011: keine Bilder" />
            <bildersuche:ZeitBalken Hoehe="2" Tooltip="Jul 2011: keine Bilder" />
            <bildersuche:ZeitBalken Hoehe="5" Tooltip="Aug 2011: 4 Bilder" />
            <bildersuche:ZeitBalken Hoehe="14" Tooltip="Sep 2011: 15 Bilder" />
            <bildersuche:ZeitBalken Hoehe="22" Tooltip="Okt 2011: 25 Bilder" />
            <bildersuche:ZeitBalken Hoehe="17" Tooltip="Nov 2011: 18 Bilder" />
            <bildersuche:ZeitBalken Hoehe="8" Tooltip="Dez 2011: 7 Bilder" />

            <bildersuche:ZeitBalken
                Hoehe="11"
                IstJahresAnfang="True"
                JahrText="2012"
                Tooltip="Jan 2012: 11 Bilder" />
            <bildersuche:ZeitBalken Hoehe="26" Tooltip="Feb 2012: 31 Bilder" />
            <bildersuche:ZeitBalken Hoehe="20" Tooltip="Mär 2012: 22 Bilder" />
            <bildersuche:ZeitBalken Hoehe="6" Tooltip="Apr 2012: 5 Bilder" />
            <bildersuche:ZeitBalken Hoehe="2" Tooltip="Mai 2012: keine Bilder" />
            <bildersuche:ZeitBalken Hoehe="3" Tooltip="Jun 2012: 2 Bilder" />
            <bildersuche:ZeitBalken Hoehe="13" Tooltip="Jul 2012: 13 Bilder" />
            <bildersuche:ZeitBalken Hoehe="18" Tooltip="Aug 2012: 19 Bilder" />
            <bildersuche:ZeitBalken Hoehe="24" Tooltip="Sep 2012: 28 Bilder" />
            <bildersuche:ZeitBalken Hoehe="16" Tooltip="Okt 2012: 17 Bilder" />
            <bildersuche:ZeitBalken Hoehe="10" Tooltip="Nov 2012: 9 Bilder" />
            <bildersuche:ZeitBalken Hoehe="4" Tooltip="Dez 2012: 3 Bilder" />

            <bildersuche:ZeitBalken
                Hoehe="15"
                IstJahresAnfang="True"
                JahrText="2013"
                Tooltip="Jan 2013: 16 Bilder" />
            <bildersuche:ZeitBalken Hoehe="21" Tooltip="Feb 2013: 24 Bilder" />
            <bildersuche:ZeitBalken Hoehe="9" Tooltip="Mär 2013: 8 Bilder" />
            <bildersuche:ZeitBalken Hoehe="5" Tooltip="Apr 2013: 4 Bilder" />
        </x:Array>
    </UserControl.Resources>

    <!--  Normalansicht (IsImageMaximiert = false). Inhalt wird etappenweise aus MainWindow hierher verschoben.  -->
    <!--
        AUFBAU DER ANSICHT
        
        Drei Spalten, sieben Zeilen. Jedes Element sitzt in genau einer Zelle. Platz
        nicht über Margin suchen: Überschneiden zwei Kinder dieselbe Zelle, verdeckt
        das später notierte das andere — lautlos, ohne Fehler und ohne Designer-Hinweis.
        
        Spalten (die äusseren sind Auto — sie schrumpfen auf 0, wenn ihr Inhalt im
        Bildmodus ausgeblendet wird, und das Bild bekommt die ganze Breite):
        
        COL_WerkzeugeLinks    Auto    GRD_WerkzeugeLinks, Kacheln, Ablage oben
        COL_Inhalt            *       Bild, Leisten, Statuszeile
        COL_WerkzeugeRechts   Auto    GRD_WerkzeugeRechts, Ordner öffnen
        
        Zeilen von oben nach unten:
        
        0  ROW_Kopfleiste       Auto   über alle Spalten
        1  ROW_WerkzeugeOben    Auto   Streifen über alle Spalten: Pfad, Vorgang, Kontur, ↑
        2  ROW_Bild             *      Werkzeuge links | Bild | Werkzeuge rechts
        3  ROW_BildWerkzeuge    Auto   Abgleich-Leiste unter dem Bild
        4  ROW_Statuszeile      Auto   Windrad | Pos/Name/Pfad | Ordner öffnen
        5  ROW_Zeitleiste       Auto   Kacheln | Zeitleiste
        6  ROW_Miniaturen       Auto   Ablage oben | Miniaturleiste
        
        WICHTIG — die Werkzeuge neben dem Bild gehören in GRD_WerkzeugeLinks und
        GRD_WerkzeugeRechts, nicht in eigene Zeilen dieses Rasters. Im verschachtelten
        Grid bleibt ihre Höhe in der Bildzeile eingesperrt; als Wurzelzeilen zählen sie
        zur Mindesthöhe des Fensters. Gemessen: 310 statt 724 Punkte — als Wurzelzeilen
        fiel auf 1080 Zeilen bei 125 % die Miniaturleiste unten heraus.
        
        Die Regel: Wächst ein Element, wächst seine Zeile mit. Kein Abstand muss
        nachgerechnet werden.
    -->
    <Grid x:Name="GRD_NormalWurzel">
        <!--
            Auto, nicht fest: Die Spalten sind so breit wie ihr breitestes Stück — links
            der Knopf „Kacheln" und die Ablage oben (78 + 10 Rand), rechts die Ablage
            unten. Nachgemessen am laufenden Fenster: je 96.
            
            Beide Kopfleisten spannen über alle drei Spalten. Das ist unbedenklich,
            solange die mittlere Spalte den Stern hat — sie nimmt auf, was die
            Kopfleiste über die Werkzeugspalten hinaus braucht.
        -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="COL_WerkzeugeLinks" Width="Auto" />
            <ColumnDefinition x:Name="COL_Inhalt" Width="*" />
            <ColumnDefinition x:Name="COL_WerkzeugeRechts" Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ROW_Kopfleiste" Height="Auto" />
            <RowDefinition x:Name="ROW_WerkzeugeOben" Height="Auto" />
            <RowDefinition x:Name="ROW_Bild" Height="*" />
            <RowDefinition x:Name="ROW_BildWerkzeuge" Height="Auto" />
            <RowDefinition x:Name="ROW_Statuszeile" Height="Auto" />
            <RowDefinition x:Name="ROW_Zeitleiste" Height="Auto" />
            <RowDefinition x:Name="ROW_Miniaturen" Height="Auto" />
        </Grid.RowDefinitions>
        <!--  Pos/Name/Version, Fortschrittsstreifen und der Pfad der gewählten Datei  -->
        <StackPanel
            x:Name="STP_Statuszeile"
            Grid.Row="4"
            Grid.Column="1"
            Margin="5,0,10,0"
            Orientation="Vertical">

            <StackPanel Orientation="Horizontal">

                <!--  Erste Zeile: Position + Gesamt  -->
                <TextBlock Margin="0,0,0,2"><Run Text="Pos: " /><Run Text=" " /><Run Text="{Binding AufgabenView.CurrentPosition, Converter={StaticResource CLconverterProgressbarIntPlusEins}, Mode=OneWay}" /><Run Text=" " /><Run Text=" / " /><Run Text=" " /><Run Text="{Binding AufgabenView.Count, Mode=OneWay}" /><Run Text=" " /><Run Text="   (" /><Run Text=" " /><Run Text="{Binding CountBildchenFürLinks, Mode=OneWay}" /><Run Text=" " /><Run Text=" verschoben)" /></TextBlock>

                <!--  Zweite Zeile: Name  -->
                <TextBlock Margin="0,0,0,2"><Run Foreground="Gray" Text="  Name: " /><Run Text=" " /><Run Text="{Binding SelectedBildchen.BName, Converter={StaticResource ConverterFullPathToNameConverter}}" /></TextBlock>

                <!--
                    Fassung der Anwendung.
                    
                    Vorher hellblau — auf dem hellgrauen Grund der Statuszeile praktisch
                    unsichtbar. Jetzt dasselbe Grau wie „Name:" davor: lesbar, aber
                    zurückhaltend. Ausführlich steht sie in der Tastenhilfe (F1).
                -->
                <TextBlock x:Name="TXT_Version"><Run Text="  " /><Run Text=" " /><Run Foreground="#FF9CA3AF" Text="{Binding Version}" /></TextBlock>

            </StackPanel>

            <ProgressBar
                Width="auto"
                Height="2"
                Maximum="{Binding AufgabenView.Count, Mode=OneWay}"
                Value="{Binding AufgabenView.CurrentPosition, Converter={StaticResource CLconverterProgressbarIntPlusEins}, Mode=OneWay}" />
            <ListBox
                x:Name="LBX_Dateiliste"
                Height="70"
                local:ListBoxAuswahlBehavior.SichtbarHalten="True"
                IsSynchronizedWithCurrentItem="True"
                ItemsSource="{Binding AufgabenView}"
                ScrollViewer.HorizontalScrollBarVisibility="Visible"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectedBildchen}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:MeinBildchen}">
                        <StackPanel Width="auto" Orientation="Horizontal">
                            <TextBlock
                                Margin="2,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding BName}" />
                        </StackPanel>
                    </DataTemplate>

                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Blue" />
                                <Setter Property="Foreground" Value="Blue" />
                                <Setter Property="FontWeight" Value="DemiBold" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Background" Value="#FFE8E6E6" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3399FF" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                            </Trigger>

                            <DataTrigger Binding="{Binding BildFürLinks}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BildFürLinks}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>



                </ListBox.ItemContainerStyle>
            </ListBox>
        </StackPanel>
        <!--
            Übersicht: Bilder je Zeitraum. Die Einheit wechselt selbsttätig — zwölf
            Monate, solange alles in einem Jahr liegt, sonst Jahre. Liegt direkt über
            der Miniaturleiste und ist genauso breit.
            
            Statuszeile, Zeitleiste und Miniaturleiste haben je eine eigene Zeile
            (ROW_Statuszeile, ROW_Zeitleiste, ROW_Miniaturen). Vorher teilten sich die
            drei eine Zeile und wurden über ihren unteren Abstand gestapelt — 135 hier,
            186 dort —, sodass jede Höhenänderung von Hand nachgerechnet werden musste
            und ein Vergessen die Nachbarn verdeckte.
            
            Beide Leisten reichen über COL_Inhalt und COL_WerkzeugeRechts, weil rechts
            neben ihnen nichts steht.
        -->
        <Border
            x:Name="BRD_Zeitleiste"
            Grid.Row="5"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="5,0,10,5"
            Padding="6,3,6,4"
            VerticalAlignment="Bottom"
            d:ToolTip="1.136 Bilder · 11.2013 bis 02.2026"
            d:Visibility="Visible"
            Background="White"
            BorderBrush="#FFCBD5E1"
            BorderThickness="1"
            CornerRadius="6"
            ToolTip="{Binding ZeitraumText}"
            Visibility="{Binding ZeitleisteVorhanden, Converter={StaticResource CLconverterVisiblityBoolian}}">
            <!--
                Der Umschalter steht ausserhalb beider Übersichten.
                
                Er lag vorher in der groben Leiste – und verschwand damit mitsamt ihr,
                sobald das Monatsband gewählt war. Da die selbsttätige Wahl bei mehreren
                Jahren immer das Band nimmt, war er im Regelfall gar nicht zu sehen.
            -->
            <Grid x:Name="GRD_ZeitleisteRahmen">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="COL_ZeitleisteEinheit" Width="Auto" />
                    <ColumnDefinition x:Name="COL_ZeitleisteInhalt" Width="*" />
                </Grid.ColumnDefinitions>

                <!--
                    Die Einheit ist zugleich der Umschalter zwischen grober Leiste und
                    feinem Monatsband. Die Anwendung wählt beim Laden selbst — mehrere
                    Jahre sprechen für das Band —, aber die Wahl bleibt änderbar.
                -->
                <Button
                    x:Name="BTN_ZeitleisteUmschalten"
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding CommandExecuteZeitleisteUmschaltenCommand}"
                    Cursor="Hand"
                    ToolTip="Zwischen Jahres-/Monatsleiste und feinem Monatsband wechseln">
                    <TextBlock
                        x:Name="TXT_ZeitleisteEinheit"
                        d:Text="Monatsband"
                        FontFamily="Segoe UI"
                        FontSize="11"
                        Foreground="Gray"
                        Text="{Binding ZeitleisteEinheit}"
                        TextDecorations="Underline" />
                </Button>

                <StackPanel
                    x:Name="STP_Zeitleiste"
                    Grid.Column="1"
                    Orientation="Vertical">

                    <!--  Grobe Leiste – nur eine der beiden Übersichten ist sichtbar  -->
                    <Grid
                        x:Name="GRD_Zeitleiste"
                        d:Visibility="Collapsed"
                        Visibility="{Binding ZeitBandBevorzugt, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">

                        <ItemsControl x:Name="IC_Zeitleiste" ItemsSource="{Binding Zeitleiste}">
                            <d:ItemsControl.ItemsSource>
                                <x:Array Type="{x:Type bildersuche:ZeitAbschnitt}">
                                    <bildersuche:ZeitAbschnitt
                                        Anzahl="45"
                                        Beschriftung="2018"
                                        Deckkraft="0.13" />
                                    <bildersuche:ZeitAbschnitt
                                        Anzahl="120"
                                        Beschriftung="2019"
                                        Deckkraft="0.24" />
                                    <bildersuche:ZeitAbschnitt
                                        Anzahl="88"
                                        Beschriftung="2020"
                                        Deckkraft="0.19" />
                                    <bildersuche:ZeitAbschnitt
                                        Anzahl="200"
                                        Beschriftung="2021"
                                        Deckkraft="0.35" />
                                    <bildersuche:ZeitAbschnitt
                                        Anzahl="15"
                                        Beschriftung="2022"
                                        Deckkraft="0.08" />
                                    <bildersuche:ZeitAbschnitt
                                        Anzahl="301"
                                        Beschriftung="2023"
                                        Deckkraft="0.50" />
                                </x:Array>
                            </d:ItemsControl.ItemsSource>

                            <!--  Gleich breite Felder – funktioniert für zwölf Monate wie für n Jahre  -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="GRD_ZeitFeld" ToolTip="{Binding Tooltip}">
                                        <!--
                                            Deckkraft kommt fertig aus dem ViewModel, damit hier kein
                                            Konverter nötig ist. Volle Deckkraft ist bewusst nicht
                                            vorgesehen — die Beschriftung muss lesbar bleiben.
                                        -->
                                        <Rectangle
                                            x:Name="RCT_ZeitFeldFuellung"
                                            Margin="1,0"
                                            Fill="#FF64748B"
                                            Opacity="{Binding Deckkraft}"
                                            RadiusX="3"
                                            RadiusY="3" />

                                        <StackPanel x:Name="STP_ZeitFeld" Orientation="Vertical">
                                            <!--
                                                Schriftfarbe kommt fertig aus dem ViewModel, wie
                                                die Deckkraft daneben. Grund: Die Fläche ändert
                                                nicht ihre Farbe, sondern ihre Deckkraft — die
                                                tatsächliche Farbe entsteht erst durch die
                                                Mischung mit dem weissen Kartengrund, und die
                                                sieht ein Konverter hier nicht.
                                            -->
                                            <TextBlock
                                                x:Name="TXT_ZeitFeldName"
                                                HorizontalAlignment="Center"
                                                d:Foreground="Gray"
                                                FontFamily="Segoe UI"
                                                FontSize="10"
                                                Foreground="{Binding Beschriftungsfarbe}"
                                                Text="{Binding Beschriftung}" />
                                            <TextBlock
                                                x:Name="TXT_ZeitFeldAnzahl"
                                                HorizontalAlignment="Center"
                                                FontFamily="Segoe UI"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="#FF1F2937"
                                                Text="{Binding Anzahl}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!--
                        Feines Band: ein Balken je Monat über den ganzen Zeitraum, die Jahre
                        als Abschnitte mit Trennstrich und Jahreszahl. Zeigt, wo innerhalb
                        eines Jahres die Bilder liegen — das kann die grobe Leiste darüber nicht.
                        
                        Zwei ItemsControls über derselben Sammlung: So sitzt jede Jahreszahl
                        ohne Rechnerei genau über ihrem ersten Monat. Beschriftungen dürfen
                        dabei über die Nachbarzellen hinausragen; WPF-Panels schneiden nicht ab.
                    -->
                    <StackPanel
                        x:Name="STP_ZeitBand"
                        d:Visibility="Visible"
                        Orientation="Vertical"
                        Visibility="{Binding ZeitBandBevorzugt, Converter={StaticResource CLconverterVisiblityBoolian}}">

                        <ItemsControl
                            x:Name="IC_ZeitBandJahre"
                            d:ItemsSource="{StaticResource ZeitBandBeispiel}"
                            ItemsSource="{Binding ZeitBand}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--
                                        Der Canvas ist hier kein Zierrat, sondern das Mittel
                                        zum Zweck.
                                        
                                        Eine Monatszelle ist bei 148 Monaten nur rund fünf
                                        Punkte breit. Ein TextBlock direkt im UniformGrid wird
                                        mit genau dieser Breite *gemessen* — der Textsatz
                                        bekommt also von vornherein zu wenig Platz, und übrig
                                        bleibt ein Glyphenrest. Abgeschnitten wird dabei
                                        nichts; ClipToBounds half deshalb auch nicht.
                                        
                                        Ein Canvas misst seine Kinder dagegen mit unbegrenzter
                                        Breite und ordnet sie in ihrer Wunschgrösse an. Die
                                        Jahreszahl wird also vollständig gesetzt und ragt über
                                        die Nachbarzellen – bei zwölf Zellen Abstand zwischen
                                        zwei Jahren ist dafür reichlich Platz.
                                        
                                        Und weil der Canvas selbst 0 breit sein will, bläht er
                                        die Wunschbreite des Bandes nicht auf. Eine feste
                                        Breite am TextBlock hätte das getan: 148 mal 34 Punkte.
                                    -->
                                    <Canvas x:Name="CNV_ZeitBandJahr" Height="13">
                                        <TextBlock
                                            x:Name="TXT_ZeitBandJahr"
                                            Canvas.Left="2"
                                            Canvas.Top="0"
                                            FontFamily="Segoe UI"
                                            FontSize="10"
                                            Foreground="#FF6B6B6B"
                                            Text="{Binding JahrText}" />
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl
                            x:Name="IC_ZeitBand"
                            Height="20"
                            Margin="0,1,0,0"
                            d:ItemsSource="{StaticResource ZeitBandBeispiel}"
                            ItemsSource="{Binding ZeitBand}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="GRD_ZeitBandZelle" ToolTip="{Binding Tooltip}">
                                        <!--  Durchsichtiger Grund, damit die ganze Zelle den ToolTip auslöst  -->
                                        <Rectangle x:Name="RCT_ZeitBandFlaeche" Fill="Transparent" />

                                        <!--  Trennstrich am Jahreswechsel  -->
                                        <Rectangle
                                            x:Name="RCT_ZeitBandTrenner"
                                            Width="1"
                                            HorizontalAlignment="Left"
                                            Fill="#FFD0D0D0"
                                            Visibility="{Binding IstJahresAnfang, Converter={StaticResource CLconverterVisiblityBoolian}}" />

                                        <!--
                                            Farbe kommt aus dem ViewModel: Grün heisst „hier
                                            liegen Bilder". Leere Monate behalten ihren Sockel,
                                            aber in Grau — vorher sah eine Reihe leerer Monate
                                            aus wie viele kleine Treffer.
                                        -->
                                        <Rectangle
                                            x:Name="RCT_ZeitBandBalken"
                                            Height="{Binding Hoehe}"
                                            Margin="1,0"
                                            VerticalAlignment="Bottom"
                                            d:Fill="#FF3A9B45"
                                            Fill="{Binding Farbe}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ListBox
            x:Name="Listbox_MiniaturBilder"
            Grid.Row="6"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Height="120"
            Margin="5,0,10,10"
            VerticalAlignment="Bottom"
            d:ItemsSource="{d:SampleData ItemCount=4}"
            local:HorizontalListBoxBehavior.CenterSelectedItem="True"
            local:HorizontalListBoxBehavior.EnableHorizontalMouseWheel="True"
            FocusVisualStyle="{x:Null}"
            IsSynchronizedWithCurrentItem="True"
            ItemsSource="{Binding AufgabenView}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectedItem="{Binding SelectedBildchen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling">

            <!--  Hintergrundfarbe per Style, damit DataTrigger greifen kann  -->
            <ListBox.Style>
                <Style TargetType="{x:Type ListBox}">
                    <Setter Property="Background" Value="{Binding SelectedBildchen.BildFürLinks, Converter={StaticResource CLconverterColorBoolianMasterHintergrund}, FallbackValue={x:Static Brushes.Transparent}, TargetNullValue={x:Static Brushes.Transparent}}" />
                    <Style.Triggers>
                        <!--  Alle Bilder verschoben → Rot  -->
                        <DataTrigger Binding="{Binding AlleBilderVerschoben}" Value="True">
                            <Setter Property="Background" Value="#FFE83030" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>

            <!--  Kontextmenü  -->
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding CommandExecuteDateiImExplorerÖffnenCommand}" Header="Explorer öffnen" />
                </ContextMenu>
            </ListBox.ContextMenu>

            <!--  EventTrigger  -->
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding CommandExecuteKleinesBildGrossesBildLadenCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>

            <!--  Horizontaler ItemsPanel  -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <!--  ItemTemplate: neutral (Farbe steuern wir im Container-Template)  -->
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:MeinBildchen}">
                    <Border
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                        <Grid>
                            <!--
                                Bindet auf die Eigenschaft, nicht mehr über einen Konverter
                                auf den Pfad.
                                
                                Der Konverter dekodierte im UI-Faden, sobald eine Kachel
                                sichtbar wurde — bei einem Zug an der Bildlaufleiste also
                                dutzendfach hintereinander, und bei grossen Dateien stand
                                dabei die Oberfläche. Miniatur wird von MiniaturLader im
                                Hintergrund gefüllt; die Kachel ist dafür kurz leer.
                                
                                DataContextChanged statt Loaded: Beim Recycling behält die
                                Kachel ihr Image und bekommt nur eine andere Datei
                                zugewiesen — Loaded feuert dann nicht.
                            -->
                            <!--
                                Platzhalter, solange die Miniatur noch nicht da ist.
                                
                                Ohne ihn ist eine ungeladene Kachel schlicht leer und
                                nicht von einer Lücke zu unterscheiden. Der graue Grund
                                sagt „hier kommt gleich ein Bild".
                                
                                Über einen DataTrigger auf null statt über einen
                                Konverter: Es gibt im Projekt keinen für „null zu
                                Sichtbarkeit", und für eine einzige Stelle lohnt keiner.
                            -->
                            <Border
                                x:Name="BRD_MiniaturPlatzhalter"
                                Width="80"
                                Height="80"
                                Margin="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#FFF1F2F4"
                                BorderBrush="#FFE2E5E9"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Miniatur}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <Image
                                x:Name="IMG_Miniatur"
                                Width="80"
                                Height="80"
                                Margin="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                DataContextChanged="Miniatur_DataContextChanged"
                                Source="{Binding Miniatur}"
                                Stretch="Uniform" />
                            <!--  Badge: Bild wurde verschoben  -->
                            <Border
                                Width="18"
                                Height="18"
                                Margin="0,4,4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#DDCC2222"
                                CornerRadius="9"
                                Visibility="{Binding BildFürLinks, Converter={StaticResource CLconverterVisiblityBoolian}}">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="4"
                                        Opacity="0.6"
                                        ShadowDepth="1"
                                        Color="Black" />
                                </Border.Effect>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="9"
                                    Foreground="White"
                                    Text="&#xE10B;" />
                            </Border>
                            <!--  Badge: Wasserzeichen oder Metadaten-Markierung gefunden  -->
                            <Border
                                x:Name="BRD_WasserzeichenBadge"
                                Width="18"
                                Height="18"
                                Margin="4,4,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#DDD97706"
                                CornerRadius="9"
                                ToolTip="{Binding WasserzeichenGrund}"
                                Visibility="{Binding HatWasserzeichen, Converter={StaticResource CLconverterVisiblityBoolian}}">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="4"
                                        Opacity="0.6"
                                        ShadowDepth="1"
                                        Color="Black" />
                                </Border.Effect>
                                <TextBlock
                                    x:Name="IC_WasserzeichenBadge"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="9"
                                    Foreground="White"
                                    Text="&#xE72E;" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <!--  ContainerStyle: eigenes Template (kein Windows/Accent-Overlay)  -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <!--  Fokusrahmen aus  -->
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Setter Property="OverridesDefaultStyle" Value="True" />

                    <!--  Ausrichtung von der ListBox übernehmen  -->
                    <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
                    <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />

                    <!--  Basis-Rand  -->
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Padding" Value="2" />

                    <!--
                        Kachelfarbe an die Eigenschaft selbst, nicht direkt ins Template.
                        
                        Vorher band das ControlTemplate den Hintergrund von „Bd" direkt an
                        BildFürLinks. Dann steht die Farbe aber nur im Template und ist von
                        aussen nicht mehr lesbar — und genau das braucht die Schriftfarbe
                        eine Zeile weiter unten.
                    -->
                    <Setter Property="Background" Value="{Binding BildFürLinks, Converter={StaticResource CLconverterColorBoolianMasterHintergrund}, FallbackValue={x:Static Brushes.Transparent}, TargetNullValue={x:Static Brushes.Transparent}}" />

                    <!--
                        Schriftfarbe folgt der Kachelfarbe.
                        
                        Gelesen wird der eigene Hintergrund und daraus die wahrgenommene
                        Helligkeit nach BT.709 bestimmt — nicht der Mittelwert aus R, G, B,
                        der bei Grün und Blau danebenläge.
                        
                        Im Zustand IsSelected setzt das ControlTemplate weiter fest auf
                        Weiss: Dort ist der Hintergrund bekannt (#FF007ACC), da gibt es
                        nichts zu rechnen.
                    -->
                    <Setter Property="Foreground" Value="{Binding Background, RelativeSource={RelativeSource Self}, Converter={StaticResource ConverterReadableForeground}}" />

                    <!--  Eigenes ControlTemplate  -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <!--  Default-Hintergrund JE ITEM: kommt jetzt über die Eigenschaft, siehe Setter oben  -->
                                <Border
                                    x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                    <ContentPresenter
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>

                                <ControlTemplate.Triggers>
                                    <!--  SELECTED: überschreibt Converter-Farbe  -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FF007ACC" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="DarkBlue" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect
                                                    BlurRadius="14"
                                                    Opacity="0.7"
                                                    ShadowDepth="0"
                                                    Color="#66005FB8" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>

                                    <!--  MOUSEOVER nur wenn NICHT selected: überschreibt Converter-Farbe  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True" />
                                            <Condition Property="IsSelected" Value="False" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Background" Value="#FFBAFF6A" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7A9E39" />
                                        <Setter Property="Foreground" Value="Black" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

        </ListBox>
        <Border
            x:Name="BRD_NachObenVerschieben"
            Grid.Row="6"
            Grid.Column="0"
            Width="78"
            Height="auto"
            Margin="10,0,0,10"
            Padding="2,2,2,2"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderThickness="2,2,2,2"
            CornerRadius="2,2,2,2"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <StackPanel
                Width="70"
                Height="auto"
                Orientation="Vertical">
                <Image
                    x:Name="image_Kopieren"
                    Width="70"
                    Height="70"
                    Source="{Binding SelectedBildchen.BName, Converter={StaticResource CLconverterStringZuKleinemImage}}"
                    Visibility="{Binding IsEnabled, Converter={StaticResource CLconverterVisiblityBoolian}, ElementName=RDBTN_BildNachOben}" />
                <!--  MouseOverBackground="#FFB7F393"  -->
                <RibbonButton
                    x:Name="RDBTN_BildNachOben"
                    Height="70"
                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteBildInsHauptVerzeichnisZuruckVerschiebenCommand, Mode=OneWay}"
                    Content="Button"
                    Label="In die Liste"
                    LargeImageSource="{StaticResource di_PfeilOben}"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE">

                    <RibbonButton.MouseOverBackground>

                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">

                            <!--  Ziel: oben = klar gut, dominant  -->
                            <GradientStop Offset="0.0" Color="#FF8FE88F" />
                            <!--  sattes, positives Grün  -->
                            <GradientStop Offset="0.35" Color="#FFBFF0BF" />
                            <!--  weiches Übergangsgrün  -->

                            <!--  Übergang  -->
                            <GradientStop Offset="0.6" Color="#FFF6D880" />
                            <!--  Amber  -->

                            <!--  Abstieg: Problemzone unten, kompakt  -->
                            <GradientStop Offset="0.82" Color="#FFF0A070" />
                            <!--  warmes Orange  -->
                            <GradientStop Offset="1.0" Color="#FFD96666" />
                            <!--  gedämpftes Rot  -->

                        </LinearGradientBrush>

                    </RibbonButton.MouseOverBackground>

                </RibbonButton>
            </StackPanel>
        </Border>
        <!--  Bild-Container der NORMALANSICHT (Vollbild läuft über Ansichten:VollbildAnsicht)  -->
        <Border
            x:Name="ViewedPhotoArea"
            Grid.Row="2"
            Grid.Column="1"
            BorderBrush="#22000000"
            BorderThickness="0"
            ClipToBounds="True"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <!--
                        Vorher 45 links und rechts. Das war der Versuch, Platz für die
                        Werkzeuge zu lassen — die aber 88 breit sind und deshalb 43 Pixel
                        weit über dem Bild lagen. Jetzt haben sie eigene Spalten, und hier
                        steht nur noch der Abstand zur Nachbarspalte.
                    -->
                    <Setter Property="Margin" Value="5,2,5,4" />
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="Background" Value="{Binding SelectedBildchen.BildFürLinks, Converter={StaticResource CLconverterColorBoolianMasterHintergrund}}" />
                    <Style.Triggers>
                        <!--  Alle Bilder verschoben → Rot  -->
                        <DataTrigger Binding="{Binding AlleBilderVerschoben}" Value="True">
                            <Setter Property="Background" Value="#FFE83030" />
                        </DataTrigger>
                        <!--  Bildmodus: Margins weg, volle Fläche, dunkler Hintergrund  -->
                        <DataTrigger Binding="{Binding IsImageMaximiert}" Value="True">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Grid.Row" Value="0" />
                            <Setter Property="Grid.RowSpan" Value="7" />
                            <Setter Property="Grid.Column" Value="0" />
                            <Setter Property="Grid.ColumnSpan" Value="3" />
                            <Setter Property="Background" Value="#FF111111" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!--  Image Display + Hover-Zone unten (blendet Miniaturleiste ein)  -->
            <Grid>
                <!--
                    Background="Transparent" ist hier kein Schönheitswert, sondern die
                    Ablagefläche selbst: WPF prüft Treffer nur gegen tatsächlich gezeichnete
                    Flächen. Ohne Hintergrund (Vorgabe des ScrollViewers) fällt jedes Ziehen
                    hindurch, solange kein Bild darin liegt — Drag & Drop ging deshalb genau
                    dann nicht, wenn man es braucht: beim leeren Fenster nach dem Start.
                -->
                <ScrollViewer
                    x:Name="scdd"
                    local:FileDragDropHelper.IsFileDragDropEnabled="True"
                    AllowDrop="True"
                    Background="Transparent"
                    DragEnter="scdd_DragEnter"
                    DragLeave="scdd_DragLeave"
                    Drop="scdd_Drop"
                    HorizontalScrollBarVisibility="{Binding MyHorizontalScrollBarVisibility}"
                    PreviewMouseWheel="Scdd_PreviewMouseWheel"
                    VerticalScrollBarVisibility="{Binding MyHorizontalScrollBarVisibility}">

                    <!--
                        Einzelbild direkt im ScrollViewer: meldet bei Stretch=None seine
                        Pixelgröße -> beide Bildlaufleisten funktionieren korrekt.
                    -->
                    <Image
                        x:Name="imgCurrent"
                        Margin="4,4,4,4"
                        IsManipulationEnabled="True"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        RenderOptions.EdgeMode="Aliased"
                        SizeChanged="imgCurrent_SizeChanged"
                        Source="{Binding AnzeigeBild}"
                        Stretch="{Binding ImageStretch}"
                        UseLayoutRounding="False">
                        <Image.RenderTransform>
                            <TranslateTransform x:Name="imgShakeTransform" />
                        </Image.RenderTransform>

                        <Image.Effect>
                            <DropShadowEffect
                                BlurRadius="20"
                                Opacity="0.8"
                                ShadowDepth="0"
                                Color="Black" />
                        </Image.Effect>
                    </Image>

                </ScrollViewer>

                <!--  Vollbild-Elemente (Klickzonen, Filmstrip, Hover-Zone) → Ansichten/VollbildAnsicht.xaml  -->


                <!--
                    Erststart-Hinweis: Ohne geladene Bilder ist die Fläche leer, und nichts
                    verrät, wie Bilder hereinkommen — einen Öffnen-Dialog gibt es nicht, nur
                    das Ziehen aus dem Explorer. Dasselbe Symbol wie das Drop-Overlay, damit
                    beim ersten Ziehen der Wiedererkennungswert da ist.

                    Verschwindet, sobald die Liste etwas enthält, und liegt unter dem
                    Drop-Overlay. IsHitTestVisible="False": Der Hinweis darf das Ziehen auf
                    die Fläche unter ihm nicht abfangen.
                -->
                <Border
                    x:Name="BRD_LeerHinweis"
                    Padding="28,22,28,22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Panel.ZIndex="200"
                    Background="White"
                    BorderBrush="#FFCBD5E1"
                    BorderThickness="1"
                    CornerRadius="8"
                    IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OcAufgabens.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel x:Name="STP_LeerHinweis" HorizontalAlignment="Center">
                        <TextBlock
                            x:Name="IC_LeerHinweis"
                            HorizontalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="40"
                            Foreground="#FF9CA3AF"
                            Text="&#xE896;" />
                        <TextBlock
                            x:Name="TXT_LeerHinweisTitel"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#FF1F2937"
                            Text="Bild hierher ziehen" />
                        <TextBlock
                            x:Name="TXT_LeerHinweisText"
                            MaxWidth="320"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="12"
                            Foreground="Gray"
                            Text="Ein Bild oder einen Ordner aus dem Explorer auf dieses Fenster ziehen. Geladen werden immer alle Bilder des Ordners."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="TXT_LeerHinweisTasten"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="11"
                            Foreground="#FF9CA3AF"
                            Text="Danach: Pfeiltasten blättern und verschieben · F1 zeigt alle Tasten" />
                    </StackPanel>
                </Border>

                <!--  Drop-Overlay: sichtbar wenn Datei über das Bild gezogen wird  -->
                <Border
                    x:Name="BRD_DropOverlay"
                    Panel.ZIndex="300"
                    Background="#CC111111"
                    BorderBrush="#88FFFFFF"
                    BorderThickness="2"
                    CornerRadius="8"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="48"
                            Foreground="#CCFFFFFF"
                            Text="&#xE896;" />
                        <TextBlock
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#EEFFFFFF"
                            Text="Bild hier ablegen" />
                        <TextBlock
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#88FFFFFF"
                            Text="Alle Bilder im selben Ordner werden geladen" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <!--<RibbonButton
            x:Name="RDBTN_BildNachRechts"
            Grid.Row="1"
            Width="48"
            Height="155"
            Margin="0,0,10,167"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding CommandExecuteBildNachRechtsCommand}"
            Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
            Label="Weiter"
            LargeImageSource="{StaticResource di_PfeilRechts}"
            MouseOverBackground="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
            MouseOverBorderBrush="Transparent"
            PressedBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />-->


        <!--
            Der Streifen über dem Bild. Links der laufende Vorgang, rechts die Anzeigeart.
            
            Zwei Spalten statt beider Elemente in einer Zelle mit „links" und „rechts":
            Genau die Bauart hatte die Ansicht vorher, und sie überdeckt lautlos, sobald
            der Platz knapp wird. Hier schrumpft stattdessen die Sternspalte, wenn die
            Kontur-Karte aufklappt.
            
            Die Zeile ist rund 36 Punkte hoch und bleibt es — beide Stücke wachsen nur
            seitlich. Das Bild behält seine Höhe.
        -->
        <Grid
            x:Name="GRD_StreifenUeberBild"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3">
            <!--
                Reicht über beide Werkzeugspalten hinweg (ColumnSpan 3).
                
                Die Werkzeugspalten haben erst in der Bildzeile Inhalt — in dieser Zeile
                stünden links und rechts sonst je 96 Punkte leer, während der Ordnerpfad
                dazwischen abgekürzt wird.
                
                Fünf Spalten: Ordner, Meldung, Vorgang, Anzeigeart, Ebene höher.
                
                Der Ordner bekommt den Stern, die vier anderen Auto. Damit nutzt er den
                Platz, der die meiste Zeit ohnehin leer ist — Meldungskarte und
                Fortschrittsstreifen sind nur zeitweise da, die Kontur-Karte meist
                zugeklappt. Kommt etwas davon dazu, schrumpft der Ordnerpfad und wird
                abgekürzt, statt sich damit zu überlagern.
                
                Der ↑-Knopf steht ganz rechts über der Ablagespalte, in einer eigenen
                Spalte und nicht neben dem Pfadtext: Der Text wird abgekürzt und ändert
                dabei seine Breite, der Knopf würde bei jedem Bildwechsel wandern.
            -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="COL_StreifenOrdner" Width="*" />
                <ColumnDefinition x:Name="COL_StreifenMeldung" Width="Auto" />
                <ColumnDefinition x:Name="COL_StreifenVorgang" Width="Auto" />
                <ColumnDefinition x:Name="COL_StreifenAnsicht" Width="Auto" />
                <ColumnDefinition x:Name="COL_StreifenHoch" Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                Meldungskarte. Zeigt LabelDropContent — den Namen der zuletzt abgelegten
                Datei, „nix .jpg" bei einer Nicht-Bilddatei und die Restzeiten der
                Sammelläufe. Rund fünfzehn Stellen im ViewModel schreiben darauf.
                
                Sie hatte bis eben ein Zuhause: das 190 Punkte breite Ablagefeld in der
                Kopfleiste. Das ist entfallen, und damit lief alles davon ins Leere.
                
                Leer wird die Karte ausgeblendet, sonst stünde die meiste Zeit ein weisser
                Kasten im Streifen. MaxWidth, damit eine lange Meldung dem Ordnerpfad
                daneben nicht den Platz nimmt — sie endet dann mit Auslassungspunkten und
                steht vollständig im Tooltip.
            -->
            <Border
                x:Name="BRD_MeldungKarte"
                Grid.Column="1"
                Height="38"
                MaxWidth="260"
                Margin="0,4,8,0"
                Padding="8,2,8,2"
                VerticalAlignment="Top"
                d:Visibility="Visible"
                Background="White"
                BorderBrush="#FFCBD5E1"
                BorderThickness="1"
                CornerRadius="6">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LabelDropContent}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LabelDropContent}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    x:Name="TXT_MeldungKarte"
                    VerticalAlignment="Center"
                    d:Text="Rest 12 Sek  ( 340 Stk/Sek )"
                    FontSize="11"
                    Foreground="#FF4B5563"
                    Text="{Binding LabelDropContent}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding LabelDropContent}" />
            </Border>

            <!--
                Die beiden Ordner-Knöpfe, rechts am Ende des Streifens über der
                Ablagespalte. Beide arbeiten mit Ordnern, beide tragen den gelben Ordner
                aus Symbole.xaml — sie gehören nebeneinander.
                
                Die Sichtbarkeit sitzt am StackPanel und nicht an den Knöpfen: Im Bildmodus
                verschwindet der ganze Streifeninhalt, so wie es BRD_KonturKarte daneben
                schon macht.
            -->
            <StackPanel
                x:Name="STP_OrdnerKnöpfe"
                Grid.Column="4"
                Margin="0,4,10,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">

                <!--
                    „Eine Ebene höher" wie das „.." im Dateimanager, aber nur aus einer
                    Ablage heraus — kein_Fav, KI_Fehler, Doppelt, Besonders, Wasserzeichen.
                    Siehe CanExecuteOrdnerEineEbeneHoch im ViewModel.
                    
                    RibbonKnopf statt des ButtonBasis aus der Dublettenansicht: Der Knopf
                    ist die meiste Zeit gesperrt, und nur RibbonKnopf zeigt das auch (halbe
                    Deckkraft, kein Hover-Grün). ButtonBasis hat dafür keinen Trigger.
                    
                    Gezeichnet statt Schriftzeichen (di_OrdnerHoch in Symbole.xaml): Nur
                    mit der Lasche links oben liest sich die Form zweifelsfrei als Ordner.
                    Die Schriftzeichen E197 und E8B7 zeigen ein Blatt mit geknickter Ecke.
                -->
                <Button
                    x:Name="BTN_OrdnerEineEbeneHoch"
                    Height="30"
                    Margin="0,0,6,0"
                    Padding="10,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Command="{Binding CommandExecuteOrdnerEineEbeneHochCommand}"
                    FontWeight="Bold"
                    Style="{StaticResource RibbonKnopf}"
                    ToolTipService.ShowDuration="30000">
                    <Button.ToolTip>
                        <ToolTip
                            x:Name="TTP_OrdnerEineEbeneHoch"
                            MaxWidth="320"
                            HasDropShadow="True"
                            Placement="Bottom"
                            VerticalOffset="8">
                            <Border
                                x:Name="BRD_EineEbeneHochKarte"
                                Padding="12,12,14,12"
                                Background="#F4F4F0"
                                BorderBrush="#3B82C4"
                                BorderThickness="3,0,0,0">
                                <StackPanel x:Name="STP_EineEbeneHochKarte">
                                    <StackPanel
                                        x:Name="STP_EineEbeneHochKopf"
                                        Margin="0,0,0,8"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="IC_EineEbeneHochKarte"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="16"
                                            Foreground="#3B82C4"
                                            Text="&#xE197;" />
                                        <TextBlock
                                            x:Name="TXT_EineEbeneHochTitel"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#222222"
                                            Text="Ablage verlassen" />
                                    </StackPanel>

                                    <TextBlock
                                        x:Name="TXT_EineEbeneHochWas"
                                        Margin="0,0,0,8"
                                        FontSize="11"
                                        Foreground="#555555"
                                        Text="Zeigt den Ordner über der Ablage an — das „..&quot; des Dateimanagers. Gewählt wird dort das Bild, das auf das weggelegte folgt, nicht das erste des Ordners: Man kommt an der Stelle heraus, an der man aufgehört hat."
                                        TextWrapping="Wrap" />

                                    <Separator x:Name="SEP_EineEbeneHoch" Margin="0,0,0,6" />

                                    <TextBlock
                                        x:Name="TXT_EineEbeneHochFuss"
                                        FontSize="10"
                                        Foreground="#999999"
                                        Text="Nur in den Ablagen dieser Anwendung eingeschaltet: kein_Fav, KI_Fehler, Doppelt, Besonders, Wasserzeichen. In einem gewöhnlichen Ordner bliebe „eine Ebene höher&quot; ein Sprung aus dem Künstlerordner heraus — deshalb ist der Knopf dort gesperrt."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </ToolTip>
                    </Button.ToolTip>
                    <StackPanel x:Name="STP_OrdnerEineEbeneHoch" Orientation="Horizontal">
                        <Image
                            x:Name="IC_OrdnerEineEbeneHochOrdner"
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{StaticResource di_OrdnerHoch}" />

                        <!--
                            Aufklappende Beschriftung wie bei BTN_BilderAktualisieren.

                            Animiert wird die BREITE dieses TextBlocks, nicht die des
                            Knopfes: Der Knopf misst sich am Inhalt und wächst von selbst
                            mit. Deshalb ist am Knopf auch die feste Breite 44 entfallen —
                            eingeklappt messen 10 + 22 + 10 + zweimal 1 Rand wieder genau
                            die 44 wie vorher.

                            Der Knopf steht in der Auto-Spalte COL_StreifenHoch; beim
                            Aufklappen schrumpft die Sternspalte mit dem Ordnerpfad, so wie
                            es die Kontur-Karte daneben schon macht.

                            Zielbreite 95 ist gemessen: „Ablage verlassen" misst in Segoe
                            UI bei Grösse 12 genau 88,9 DIP, dazu 6 links. Rechts kommt
                            kein Padding dazu — dort liegen schon die 10 Innenabstand des
                            Knopfes. Auf Auto lässt sich nicht animieren, deshalb die Zahl.
                            Wird der Text geändert, muss sie mitgeändert werden.

                            FontWeight ausdrücklich Normal: Der Knopf selbst steht auf
                            Bold, das galt seinem früheren Textinhalt.

                            Der MultiDataTrigger prüft IsEnabled mit — dieser Knopf ist die
                            meiste Zeit gesperrt und darf sich dann nicht aufklappen und
                            Tatendrang vortäuschen.
                        -->
                        <TextBlock
                            x:Name="TXT_OrdnerEineEbeneHoch"
                            Padding="6,0,0,0"
                            VerticalAlignment="Center"
                            d:Width="95"
                            FontFamily="Segoe UI"
                            FontSize="12"
                            FontWeight="Normal"
                            Text="Ablage verlassen"
                            TextTrimming="None"
                            TextWrapping="NoWrap">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Width" Value="0" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True" />
                                                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="Width"
                                                            To="95"
                                                            Duration="0:0:0.18">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="Width"
                                                            To="0"
                                                            Duration="0:0:0.14">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseIn" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <!--
                    Öffnet den Ordner, in dem die Anwendung liegt, im Explorer.
                    
                    Ordner mit „Ö": Der gelbe Ordner sagt, worum es geht, der Buchstabe
                    steht für Öffnen. Die Aussage hängt nicht an der Farbe — der Buchstabe
                    ist schwarz.
                -->
                <Button
                    x:Name="BTN_OrdnerÖffnen"
                    Height="30"
                    Command="{Binding CommandExecuteOrdnerDerAnwendungÖffnenCommand, Mode=OneWay}"
                    Style="{StaticResource RibbonKnopf}"
                    ToolTip="Ordner der Anwendung im Explorer öffnen">
                    <StackPanel x:Name="STP_OrdnerÖffnen" Orientation="Horizontal">
                        <!--
                            Feste 32 statt Auto: Eingeklappt soll der Knopf genau die 34
                            messen wie vorher (32 + zweimal 1 Rand). Deshalb ist am Knopf
                            die feste Breite 34 entfallen — er misst sich jetzt am Inhalt.
                        -->
                        <Grid x:Name="GRD_OrdnerÖffnen" Width="32">
                            <Image
                                x:Name="IC_OrdnerÖffnen"
                                Width="20"
                                Height="20"
                                Source="{StaticResource di_Ordner}" />
                            <TextBlock
                                x:Name="TXT_OrdnerÖffnen"
                                Margin="0,2,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe UI"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="#FF101010"
                                Text="Ö" />
                        </Grid>

                        <!--
                            Aufklappende Beschriftung wie bei BTN_BilderAktualisieren.

                            „Anwendungsordner" und nicht bloss „Ordner": Daneben steht der
                            Ordnerpfad des gezeigten Bildes, und genau der ist hier nicht
                            gemeint.

                            Zielbreite 157 ist gemessen: „Anwendungsordner öffnen" misst in
                            Segoe UI bei Grösse 12 genau 142,3 DIP, dazu 6 links und 8
                            rechts. Auf Auto lässt sich nicht animieren, deshalb die Zahl.
                            Wird der Text geändert, muss sie mitgeändert werden.

                            Der Abstand steckt im Padding, nicht im Margin — ein Margin
                            würde auch bei Breite 0 seine Punkte behalten und den
                            eingeklappten Knopf aufblähen.
                        -->
                        <TextBlock
                            x:Name="TXT_OrdnerÖffnenBeschriftung"
                            Padding="6,0,8,0"
                            VerticalAlignment="Center"
                            d:Width="157"
                            FontFamily="Segoe UI"
                            FontSize="12"
                            Text="Anwendungsordner öffnen"
                            TextTrimming="None"
                            TextWrapping="NoWrap">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Width" Value="0" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True" />
                                                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="Width"
                                                            To="157"
                                                            Duration="0:0:0.18">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="Width"
                                                            To="0"
                                                            Duration="0:0:0.14">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseIn" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--
                Wo bin ich: der Ordner des gewählten Bildes.
                
                Gekürzt auf die letzten beiden Stufen, vollständig im Tooltip. Der ganze
                Pfad wäre hier meist länger als die Zeile, und abgeschnitten würde
                ausgerechnet das Ende fehlen — der Ordnername, um den es geht.
                
                Hängt an SelectedBildchen, nicht am eingelesenen Ordner: Nach dem
                Verschieben eines Bildes ins kein_Fav steht hier dessen neuer Ort, und
                das ist die ehrlichere Antwort auf „wo bin ich".
            -->
            <StackPanel
                x:Name="STP_OrdnerPfad"
                Grid.Column="0"
                Margin="2,0,10,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                ToolTip="{Binding SelectedBildchen.BName, Converter={StaticResource ConverterPfadZuOrdner}}">
                <TextBlock
                    x:Name="IC_OrdnerPfad"
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    Foreground="#FF9CA3AF"
                    Text="&#xE8B7;" />
                <TextBlock
                    x:Name="TXT_OrdnerPfad"
                    VerticalAlignment="Center"
                    d:Text="…\Bilder\Sammlung"
                    FontWeight="SemiBold"
                    Foreground="#FF4B5563"
                    Text="{Binding SelectedBildchen.BName, Converter={StaticResource ConverterPfadZuOrdner}, ConverterParameter=Kurz}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!--
                Eine Anzeige für alle langlaufenden Vorgänge — Indexieren, Byte-/SHA-/
                Grau-Abgleich, Wasserzeichen lernen.
                
                Sie hängt am ViewModel, nicht am Werkzeugfenster der Bildersuche, und
                bleibt deshalb sichtbar, wenn man das Fenster zumacht.
                
                Die Werte kommen aus der Fassade in AufgabeViewModel.LaufendeAufgabe.cs,
                nicht von einem einzelnen Vorgang. Der frühere zweite Balken über der
                Miniaturleiste (GRD_PruefFortschritt) ist dafür entfallen; sein
                Abbrechen-Knopf hatte ohnehin kein Command.
                
                Dass hier immer nur ein Vorgang stehen kann, sichern die CanExecute-
                Sperren der schweren Befehle — sonst liefe einer davon unsichtbar weiter.
                
                Stand vorher in STP_KopfleisteLinks.
            -->
            <Border
                x:Name="BRD_AufgabeFortschritt"
                Grid.Column="2"
                Width="280"
                Height="38"
                Margin="0,4,0,0"
                Padding="8,2,4,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                d:Opacity="1"
                d:Visibility="Visible"
                d:Width="130"
                Background="White"
                BorderBrush="#FFCBD5E1"
                BorderThickness="1"
                CornerRadius="6">

                <!--
                    Sichtbarkeit über den Style statt über eine Visibility-Bindung: Nur so
                    lässt sich das Verschwinden weich machen. Eine Bindung setzt Collapsed
                    hart in dem Moment, in dem AufgabeLäuft umfällt.

                    Beim Start hart einblenden (0,15 s), beim Ende über 0,8 s ausblenden
                    und erst danach zusammenklappen. Die beiden Zeiten müssen gleich
                    bleiben — klappt es früher zu, bricht das Verblassen mittendrin ab.
                    Ohne das abschliessende Collapsed
                    bliebe die Karte unsichtbar, aber platzhaltend stehen und würde den
                    Ordnerpfad daneben weiter kurz halten.

                    Die Grundwerte des Style sind Collapsed UND Opacity 0. Für den Designer
                    braucht es deshalb beide d:-Angaben — mit d:Visibility allein stünde
                    die Karte zwar da, aber vollständig durchsichtig.

                    ACHTUNG, das ist reine Kosmetik: Text und Balken hängen an Bindungen
                    und sind sofort leer beziehungsweise auf null. Die Karte verblasst also
                    bereits ohne Inhalt. Wer die Schlussmeldung LESEN können soll, braucht
                    etwas im ViewModel — mit einer Animation allein geht das nicht.
                -->
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AufgabeLäuft}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.8" />
                                            <ObjectAnimationUsingKeyFrames BeginTime="0:0:0.8" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid x:Name="GRD_AufgabeFortschritt">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="COL_AufgabeText" Width="*" />
                        <ColumnDefinition x:Name="COL_AufgabeAbbrechen" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        x:Name="STP_AufgabeFortschritt"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <TextBlock
                            x:Name="TXT_AufgabeFortschritt"
                            d:Text="Indexiere 1.240/5.310 – noch ~4 min"
                            FontFamily="Segoe UI"
                            FontSize="11"
                            Foreground="#FF1F2937"
                            Text="{Binding AufgabeText}"
                            TextTrimming="CharacterEllipsis" />

                        <!--
                            IsIndeterminate: In der Anlaufphase gibt es nichts zu zählen —
                            CLIP lädt seine Modelle, und das Wasserzeichen-Lernen meldet
                            gar keinen Prozentwert. Ein Balken auf null sähe dort aus wie
                            ein Hänger.
                        -->
                        <ProgressBar
                            x:Name="PGB_AufgabeFortschritt"
                            Height="3"
                            Margin="0,3,0,0"
                            d:Value="35"
                            Background="#FFE5E7EB"
                            BorderThickness="0"
                            Foreground="#FF3A9B45"
                            IsIndeterminate="{Binding AufgabeUnbestimmt}"
                            Maximum="100"
                            Value="{Binding AufgabeFortschritt, Mode=OneWay}" />
                    </StackPanel>

                    <Button
                        x:Name="BTN_AufgabeAbbrechen"
                        Grid.Column="1"
                        Width="20"
                        Height="20"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding CommandExecuteAufgabeAbbrechenCommand}"
                        Cursor="Hand"
                        ToolTip="Laufenden Vorgang abbrechen"
                        Visibility="{Binding AufgabeAbbrechbar, Converter={StaticResource CLconverterVisiblityBoolian}}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#FF6B6B6B" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border
                                                x:Name="BRD_AbbrechenFlaeche"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="4">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="10"
                                                    Foreground="{TemplateBinding Foreground}"
                                                    Text="&#xE711;" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BRD_AbbrechenFlaeche" Property="Background" Value="#FFF3F4F6" />
                                                    <Setter Property="Foreground" Value="#FFB03030" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="BRD_AbbrechenFlaeche" Property="Background" Value="#FFE9EBEF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!--
                Konturansicht: Kantenbild statt Originalbild im grossen Bild, Schwelle am
                Regler.
                
                Vorher lag die Karte über der rechten oberen Ecke des Bildes und verdeckte
                genau den Ausschnitt, den man beim Kantenbild anschauen will.
            -->
            <Border
                x:Name="BRD_KonturKarte"
                Grid.Column="3"
                Margin="0,4,5,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                d:Padding="10,5,10,5"
                d:Width="280"
                Background="White"
                BorderBrush="#FFCBD5E1"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">

                <!--
                    Ruhezustand: nur der Symbolknopf. Erst beim Einschalten kommen Regler und
                    Kästchen dazu, und die Karte wird nach links breiter. Keine feste Breite,
                    sonst wäre sie auch im Ruhezustand so breit wie aufgeklappt.
                -->
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Padding" Value="5" />
                        <Style.Triggers>
                            <!--
                                Aufgeklappt nur seitlich mehr Luft. Oben und unten bleiben es
                                5, damit die Karte genau so hoch bleibt wie zugeklappt — sonst
                                würde die Zeile beim Umschalten springen und das Bild mit ihr.
                            -->
                            <DataTrigger Binding="{Binding ZeigeKontur}" Value="True">
                                <Setter Property="Padding" Value="10,5,10,5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <!--
                    Waagerecht, und die Einstellungen stehen VOR dem Schalter.
                    
                    Beides zusammen lässt die Karte nach links auswachsen: Sie ist
                    rechtsbündig, also bleibt der Schalter beim Aufklappen an seinem Platz und
                    der neue Inhalt schiebt sich nach links davor. Wächse sie nach unten,
                    würde die Zeile höher und das Bild bei jedem Umschalten kürzer.
                -->
                <StackPanel x:Name="STP_KonturKarte" Orientation="Horizontal">

                    <!--
                        Reglerbereich nur zeigen, wenn die Kontur auch an ist.
                        
                        Der Rahmen darum trägt die Laufanzeige: Sie unterstreicht die ganze
                        Reihe, statt unter einem einzelnen Bedienelement zu hängen. Gerechnet
                        wird am Bild, nicht am Regler — und unter dessen Spur sah der Balken
                        aus wie eine zweite Skala desselben Reglers.
                        
                        Feste Höhe 26 wie der Schalter daneben: Sie hält die Bedienelemente
                        mittig und lässt unter ihnen Platz für den Balken.
                    -->
                    <Grid
                        x:Name="GRD_KonturEinstellungen"
                        Height="26"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        d:Visibility="Visible"
                        Visibility="{Binding ZeigeKontur, Converter={StaticResource CLconverterVisiblityBoolian}}">

                        <StackPanel
                            x:Name="STP_KonturEinstellungen"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                            <TextBlock
                                x:Name="TXT_KonturSchwelleLabel"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="Gray"
                                Text="Schwelle" />

                            <!--
                                Feste Breite, rechtsbündig: Sonst würde der Sprung von „9" auf
                                „90" auf „255" alles dahinter verschieben.
                            -->
                            <TextBlock
                                x:Name="TXT_KonturSchwelleWert"
                                Width="22"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#FF1F2937"
                                Text="{Binding KonturSchwelle, StringFormat=\{0:F0\}}"
                                TextAlignment="Right" />

                            <!--
                                Feste Breite: Ein Regler hat waagerecht keine eigene
                                Wunschbreite und würde sonst auf null zusammenfallen.
                            -->
                            <Slider
                                x:Name="SLD_KonturSchwelle"
                                Width="140"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                d:Width="40"
                                IsSnapToTickEnabled="True"
                                Maximum="255"
                                Minimum="0"
                                TickFrequency="1"
                                ToolTip="Niedrig = viele Kanten, hoch = nur kräftige Kanten. Vorgabe 90."
                                Value="{Binding KonturSchwelle, Mode=TwoWay}" />

                            <CheckBox
                                x:Name="CHK_KonturWeichzeichnen"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                Content="Weichzeichnen"
                                FontSize="11"
                                Foreground="#FF555555"
                                IsChecked="{Binding KonturWeichzeichnen, Mode=TwoWay}"
                                ToolTip="Vorher glätten – weniger Rauschkanten, dafür weichere Konturen." />
                        </StackPanel>

                        <!--
                            Anzeige, dass gerechnet wird; bei grossen Bildern dauert es kurz.
                            
                            Liegt über der Reihe statt darin: So kostet der Balken keine
                            Breite. Käme er und ginge er in der Reihe, änderte sich jedes Mal
                            die Breite der Karte — und weil sie rechtsbündig ist und nach
                            links wächst, rutschte alles davor hin und her.
                        -->
                        <ProgressBar
                            x:Name="PGB_KonturLäuft"
                            Height="3"
                            VerticalAlignment="Bottom"
                            d:Visibility="Visible"
                            IsIndeterminate="True"
                            Visibility="{Binding KonturLäuft, Converter={StaticResource CLconverterVisiblityBoolian}}" />
                    </Grid>

                    <ToggleButton
                        x:Name="TGL_KonturAnzeigen"
                        Height="26"
                        Padding="6,0"
                        Cursor="Hand"
                        FontSize="12"
                        FontWeight="SemiBold"
                        IsChecked="{Binding ZeigeKontur, Mode=TwoWay}"
                        IsEnabled="{Binding HatBild}"
                        SnapsToDevicePixels="True"
                        ToolTip="Statt des Bildes sein Kantenbild anzeigen (Sobel). Macht auch schwache Aufdrucke sichtbar.">
                        <StackPanel x:Name="STP_KonturSchalter" Orientation="Horizontal">
                            <TextBlock
                                x:Name="IC_KonturSchalter"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Text="&#xE9A9;" />

                            <!--  Beschriftung erst im aufgeklappten Zustand – spart im Ruhezustand die halbe Breite  -->
                            <TextBlock
                                x:Name="TXT_KonturSchalter"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                d:Visibility="Visible"
                                Text="Kontur"
                                Visibility="{Binding ZeigeKontur, Converter={StaticResource CLconverterVisiblityBoolian}}" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Border>
        </Grid>

        <!--
            Werkzeugspalte rechts. Drei Zeilen: Rückgängig oben, Blätterfläche in der
            Mitte, Ablage nach unten am Fuss.
            
            Die mittlere Zeile ist die dehnbare — sie nimmt auf, was übrig bleibt, und
            hält die Blätterfläche damit auf halber Höhe des Bildes, ohne dass ein
            Abstand nachgerechnet werden müsste.
        -->
        <Grid
            x:Name="GRD_WerkzeugeRechts"
            Grid.Row="2"
            Grid.Column="2"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ROW_RechtsOben" Height="Auto" />
                <RowDefinition x:Name="ROW_RechtsBlättern" Height="*" />
                <RowDefinition x:Name="ROW_RechtsUnten" Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="GRD_BlaetternRechts"
                Grid.Row="1"
                Width="54"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                Background="Transparent"
                Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">

                <!--  Klickfläche  -->
                <RibbonButton
                    x:Name="RDBTN_BildNachRechts"
                    Grid.Row="1"
                    Margin="1,1,1,1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteBildNachRechtsCommand, Mode=OneWay}"
                    CornerRadius="8,8,8,8"
                    KeyTip="→"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE"
                    ToolTip="Nächstes Bild (→)"
                    ToolTipService.InitialShowDelay="20000" />

                <!--  Sichtbares Icon  -->
                <Image
                    Width="38"
                    Height="38"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Source="{StaticResource di_PfeilRechts}">

                    <Image.Style>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Opacity" Value="1" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled, ElementName=RDBTN_BildNachRechts}" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>

                </Image>
            </Grid>


            <!--
                Rückgängig: letztes Verschieben zurückholen, darunter das Bild, das es trifft.
                
                Die d:-Angaben gelten nur im Designer (mc:Ignorable="d"). Ohne sie steht hier
                ein leeres Feld: BildchenVorher liefert ohne DataContext kein Bild, und der
                Rahmen allein ist ein hellgrauer Strich auf weissem Grund.
            -->
            <Border
                x:Name="BRD_Rückgängig"
                Grid.Row="0"
                Width="78"
                Height="122"
                Margin="0,10,10,0"
                Padding="2,2,2,2"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                d:Background="#FFF8FAFC"
                d:Visibility="Visible"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderThickness="2,2,2,2"
                CornerRadius="2,2,2,2"
                Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">

                <StackPanel
                    x:Name="STP_Rückgängig"
                    Width="70"
                    Height="auto"
                    Orientation="Vertical">
                    <!--
                        Das Zeichen sitzt als Text in IC_VerschieberRückgängig und lässt sich
                        dort austauschen: FontFamily und Text ändern, sonst nichts. E10E ist
                        in Segoe UI Symbol ein kräftiger Bogenpfeil; in Segoe MDL2 Assets und
                        Segoe Fluent Icons steht unter derselben Nummer eine dünne Linienform.
                    -->
                    <Button
                        x:Name="BTN_VerschieberRückgängigMachen"
                        Width="40"
                        Height="40"
                        Margin="0,0,0,4"
                        Command="{Binding CommandExecuteVerschiebenZurückCommand, Mode=OneWay}"
                        Style="{StaticResource RibbonKnopf}"
                        ToolTip="Letztes Verschieben zurückholen">
                        <TextBlock
                            x:Name="IC_VerschieberRückgängig"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            d:Text="&#xE10E;"
                            FontFamily="Segoe UI Symbol"
                            FontSize="20"
                            Text="&#xE10E;" />
                    </Button>

                    <Image
                        x:Name="IC_RückgängigVorher"
                        Width="70"
                        Height="70"
                        d:Source="/Images/HeavyO.jpg"
                        Source="{Binding BildchenVorher, Converter={StaticResource CLconverterStringZuKleinemImage}}" />
                </StackPanel>
            </Border>
            <Border
                x:Name="BRD_NachUntenVerschieben"
                Grid.Row="2"
                Width="78"
                Height="auto"
                MaxHeight="156"
                Margin="0,0,10,10"
                Padding="2,2,2,2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                d:MaxHeight="200"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderThickness="2,2,2,2"
                CornerRadius="2,2,2,2"
                Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
                <StackPanel
                    Width="70"
                    Height="auto"
                    Orientation="Vertical">
                    <Image
                        x:Name="image_Kopieren1"
                        Width="70"
                        Height="auto"
                        MaxHeight="70"
                        Margin="0,0,0,4"
                        Source="{Binding SelectedBildchen.BName, Converter={StaticResource CLconverterStringZuKleinemImage}}"
                        Visibility="{Binding IsEnabled, Converter={StaticResource CLconverterVisiblityBoolian}, ElementName=RDBTN_BildNachKeinFav}" />
                    <!--  Abbrechen Bilder Verschieben  -->


                    <!--  MouseOverBackground="#FFB7F393"  -->
                    <RibbonButton
                        x:Name="RDBTN_BildNachKeinFav"
                        Width="70"
                        Height="70"
                        Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                        Command="{Binding CommandExecuteBildInsKeinFavVerzeichnisVerschiebenCommand, Mode=OneWay}"
                        FontFamily="Segoe UI Symbol"
                        KeyTip="&#xE019;"
                        Label="Kein Fav"
                        LargeImageSource="{StaticResource di_PfeilUnten}"
                        MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                        PressedBackground="#FFCACFFE">
                        <RibbonButton.MouseOverBackground>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">

                                <!--  verblasstes Grün: war mal wichtig  -->
                                <GradientStop Offset="0.0" Color="#FFB8F5B8" />

                                <!--  Übergang: staubiges Gelb / Amber  -->
                                <GradientStop Offset="0.45" Color="#FFF5D87A" />

                                <!--  Entscheidung kippt  -->
                                <GradientStop Offset="0.75" Color="#FFF0A35E" />

                                <!--  Ziel: unten = schlecht / ablegen  -->
                                <GradientStop Offset="1.0" Color="#FFE57373" />
                            </LinearGradientBrush>
                        </RibbonButton.MouseOverBackground>
                        <RibbonButton.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    x:Name="MNI_AlleInsKeinFavVerschieben"
                                    Command="{Binding CommandExecuteAlleBilderInsKeinFavVerschiebenCommand, Mode=OneWay}"
                                    Header="Alle Verschieben"
                                    ToolTip="Dateien werden kopiert, dann gelöscht, Ab und zu Fehler beim Löschen der Datei" />
                                <!--<MenuItem Header="Aktion 2" />
                                <Separator/>
                                <MenuItem Header="Einstellungen" />-->

                                <!--  Gegenstück zur Taste K  -->
                                <MenuItem
                                    x:Name="MNI_InsKIFehlerVerschieben"
                                    Command="{Binding CommandExecuteBildInsKIFehlerVerschiebenCommand, Mode=OneWay}"
                                    Header="Ins KI Fehler Verzeichnis Verschieben"
                                    InputGestureText="K"
                                    ToolTip="Selectierte Datei wird ins 'KI Fehler Verzeichnis' verschoben">
                                    <MenuItem.Icon>
                                        <Image
                                            x:Name="IC_InsKIFehlerVerschieben"
                                            Width="20"
                                            Height="20"
                                            Source="/Images/KIFehler.png"
                                            Stretch="Uniform" />
                                    </MenuItem.Icon>
                                </MenuItem>

                                <!--  Gegenstück zur Tastenkombination Shift+↓  -->
                                <MenuItem
                                    x:Name="MNI_InsBesondersVerschieben"
                                    Command="{Binding CommandExecuteBildInsBesondersVerschiebenCommand, Mode=OneWay}"
                                    Header="Ins Besonders Verzeichnis Verschieben"
                                    InputGestureText="Shift+↓"
                                    ToolTip="Selectierte Datei wird ins 'Besonders' Verzeichnis verschoben">
                                    <MenuItem.Icon>
                                        <TextBlock
                                            x:Name="IC_BesondersMenue"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="15"
                                            Foreground="#FFD9A404"
                                            Text="&#xE735;" />
                                    </MenuItem.Icon>
                                </MenuItem>

                            </ContextMenu>
                        </RibbonButton.ContextMenu>
                    </RibbonButton>

                    <!--  Visibility="{Binding CommandExecuteAlleBilderInsKeinFavVerschiebenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}" />  -->
                    <RibbonButton
                        x:Name="RBTN_AbbrechenNixFavVerschieben"
                        Width="40"
                        Height="40"
                        Margin="4,4,4,0"
                        d:Visibility="Visible"
                        Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                        Command="{Binding CommandExecuteAlleBilderInsKeinFavVerschiebenCancelCommand, Mode=OneWay}"
                        Foreground="Red"
                        LargeImageSource="{StaticResource di_Abbrechen}"
                        MouseOverBackground="#FFB7F393"
                        PressedBackground="#FFCACFFE"
                        Visibility="{Binding CommandExecuteAlleBilderInsKeinFavVerschiebenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}" />
                    <ProgressBar
                        Width="60"
                        Height="10"
                        Margin="4,4,4,0"
                        d:Visibility="Visible"
                        Visibility="{Binding CommandExecuteAlleBilderInsKeinFavVerschiebenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}"
                        Value="{Binding PercentageValueVerschieben}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  Background="{Binding SelectedBildchen.BildFürLinks, Converter={StaticResource CLconverterColorBoolianMasterHintergrund}}"  -->


        <!--  Kopfleiste rechts: Dateigrösse, Zoom, Abmessungen, Filter  -->
        <StackPanel
            x:Name="STP_KopfleisteRechts"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Height="26"
            MinWidth="24"
            Margin="0,0,10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">


            <!--
                Die drei Angaben zum angezeigten Bild: Dateigrösse, Anzeige-Massstab,
                Abmessungen. Vorher drei nackte TextBlöcke mit grauem Hintergrund, ohne
                Innenabstand und ohne Erklärung — die Zahlen standen für sich und man
                musste wissen, welche welche ist.

                Jetzt Kacheln in derselben Machart wie BRD_MeldungKarte und
                BRD_AufgabeFortschritt, jede mit einem Tooltip. Der Style InfoKachel
                blendet sie alle über HatBild aus, wenn kein Bild da ist.
            -->
            <Border x:Name="BRD_Dateigroesse" Style="{StaticResource InfoKachel}" ToolTip="Dateigrösse des angezeigten Bildes">
                <TextBlock
                    x:Name="TXT_Dateigroesse"
                    Style="{StaticResource InfoKachelText}"
                    Text="{Binding SelectedBildchen.BName, Converter={StaticResource CLconverterStringZuMB}}" />
            </Border>

            <Border x:Name="BRD_Bildmassstab" Style="{StaticResource InfoKachel}" ToolTip="Anzeige-Massstab: Wie gross das Bild gerade dargestellt wird, gemessen an seinen Bildpunkten. 100 % heisst ein Bildpunkt je Bildpunkt.">
                <TextBlock
                    x:Name="TXT_Bildmassstab"
                    d:Text="42 %"
                    Style="{StaticResource InfoKachelText}" />
            </Border>

            <Border x:Name="BRD_BildAbmessungen" Style="{StaticResource InfoKachel}" ToolTip="Abmessungen der Bilddatei in Bildpunkten">
                <TextBlock x:Name="TXT_BildAbmessungen" Style="{StaticResource InfoKachelText}"><Run Text="{Binding OriginalImageWidth, Mode=OneWay, StringFormat=\{0:D\}}" /><Run Text=" × " /><Run Text="{Binding OriginalImageHeight, Mode=OneWay, StringFormat=\{0:D\}}" /></TextBlock>
            </Border>


            <!--
                Filterfeld mit eingebautem Lösch-Knopf.

                Der Knopf liegt IM Feld, wie in jedem Suchfeld von Windows. Dafür braucht
                es das Grid: Eine TextBox hat keinen Platz für Beiwerk, also wird der Knopf
                darübergelegt und rechtsbündig gesetzt.

                Padding rechts 24 hält den Text vom Knopf fern — ohne das liefe eine lange
                Eingabe darunter hindurch. Die Breite ist um dieselben 24 gewachsen, damit
                zum Tippen so viel Platz bleibt wie vorher.
            -->
            <Grid x:Name="GRD_Filterfeld" Margin="2,0,2,0">
                <TextBox
                    x:Name="TXB_DateinameFiltern"
                    Width="94"
                    Height="26"
                    Padding="0,0,24,0"
                    VerticalContentAlignment="Center"
                    BorderBrush="#FF9AB0F3"
                    FontSize="14"
                    Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="NoWrap">
                    <TextBox.Style>
                        <Style TargetType="{x:Type TextBox}">
                            <Setter Property="Background" Value="LightGreen" />
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource WasserzeichenFilter}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!--
                    Das ✕ im Feld ist die Geste, die jeder aus Such- und Adressfeldern
                    kennt — hier heisst es nicht „abbrechen", sondern „Feld leeren". Ein
                    Radiergummi wäre treffender benannt, aber niemand sucht danach.

                    E10A aus Segoe UI Symbol, weil es dort kräftig ist. Dieselbe Nummer in
                    Segoe MDL2 Assets ist eine Haarlinie und verschwindet bei 20 Punkten
                    Knopfgrösse fast.

                    Randlos und mit durchsichtigem Grund, damit er im Feld liegt statt
                    darauf. Beim Überfahren dasselbe Grün wie überall sonst.

                    Die Visibility-Bindung auf das EIGENE IsEnabled ist der Kniff, der ihn
                    verschwinden lässt, solange das Feld leer ist — CanExecuteFilterLeeren
                    schaltet ihn dann ab. Der ElementName muss auf diesen Knopf zeigen;
                    beim Umbenennen bricht die Bindung sonst still.
                -->
                <Button
                    x:Name="BTN_FilterLeeren"
                    Width="20"
                    Height="24"
                    Margin="0,0,1,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    d:Visibility="Visible"
                    Command="{Binding CommandExecuteFilterLeerenCommandCommand, Mode=OneWay}"
                    Cursor="Hand"
                    ToolTip="Filter leeren"
                    Visibility="{Binding IsEnabled, Converter={StaticResource CLconverterVisiblityBoolian}, ElementName=BTN_FilterLeeren}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#FF3F4650" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border
                                            x:Name="BRD_FilterLeeren"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4">
                                            <TextBlock
                                                x:Name="IC_FilterLeeren"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe UI Symbol"
                                                FontSize="11"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="&#xE10A;" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BRD_FilterLeeren" Property="Background" Value="#FFB7F393" />
                                                <Setter Property="Foreground" Value="#FF17300A" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="BRD_FilterLeeren" Property="Background" Value="#FFCACFFE" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <!--
                Diagnosezähler, gleiche Machart wie die drei Info-Kacheln links.

                Visibility ausdrücklich auf Visible: Der Style InfoKachel blendet über
                HatBild aus, aber dieser Zähler beschreibt kein Bild — er zählt
                Filterdurchläufe und Ordner-Einlesevorgänge und soll gerade dann lesbar
                bleiben, wenn ein Filter alles ausgeblendet hat.
            -->
            <Border
                x:Name="BRD_InnerZaehler"
                Style="{StaticResource InfoKachel}"
                ToolTip="Innerer Zähler — Diagnose: zählt die Filterdurchläufe und das Einlesen von Ordnern"
                Visibility="Visible">
                <TextBlock
                    x:Name="TXT_InnerZaehler"
                    d:Text="IC 1130"
                    Style="{StaticResource InfoKachelText}"
                    Text="{Binding InnerZählerCount, StringFormat=IC \{0:D\}}"
                    TextWrapping="NoWrap" />
            </Border>

            <!--
                Aufnahme-Anzeigen und die beiden Ansichts-Knöpfe. Sie lagen bis hierher im
                MainWindow und schwebten mit ausgerechneten Rändern (136, 100, 64 von
                rechts) über allem. Jetzt stehen sie in der Reihe und halten ihren Abstand
                selbst; die Reihenfolge ist dieselbe wie vorher.
            -->
            <ansichten:IndikatorLeiste
                x:Name="CTL_Indikatoren"
                Margin="10,0,0,0"
                VerticalAlignment="Center" />

            <Button
                x:Name="BTN_BildmodusToggle"
                VerticalAlignment="Center"
                Command="{Binding CommandExecuteImageMaximierenToggleCommand}"
                Content="&#xE740;"
                Style="{StaticResource KopfleisteKnopf}"
                ToolTip="Bildmodus einschalten (F11)" />

            <Button
                x:Name="BTN_DublettenAnsicht"
                VerticalAlignment="Center"
                Command="{Binding CommandExecuteDublettenAnsichtOeffnenCommand}"
                Content="&#xE8C8;"
                Style="{StaticResource KopfleisteKnopf}"
                ToolTip="Byte-Duplikate in anderen Ordnern aufräumen" />

        </StackPanel>
        <!--
            Werkzeugspalte links. Prüf-Schalter, Prüf-Ampel, darunter die dehnbare Zeile
            mit Blätterfläche und Farbsignatur nebeneinander.
            
            Die Ampel ist mit 180 Punkten das höchste Stück der Ansicht. Genau deshalb
            steckt sie hier und nicht in einer Zeile des Wurzelrasters — dort hätte sie
            dem Bild die Höhe genommen (siehe Kommentar oben).
        -->
        <Grid
            x:Name="GRD_WerkzeugeLinks"
            Grid.Row="2"
            Grid.Column="0"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <Grid.RowDefinitions>
                <RowDefinition
                    x:Name="ROW_LinksPrüfSchalter"
                    Height="Auto"
                    MinHeight="22" />
                <RowDefinition
                    x:Name="ROW_LinksAmpel"
                    Height="Auto"
                    MinHeight="172" />
                <RowDefinition x:Name="ROW_LinksBlättern" />

                <!--
                    Leer, seit die Farbsignatur in die Sternzeile darüber gewandert ist.
                    Eine leere Auto-Zeile misst 0 und kostet nichts; sie steht als Platz
                    für ein weiteres Werkzeug unter der Blätterfläche bereit.
                -->
                <RowDefinition x:Name="ROW_LinksUnten" Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                Schaltet die Prüfungen ein, deren Ergebnis STP_PrüfAmpel darunter anzeigt.

                Als Karte gefasst, damit Schalter, Ampel und Farbsignatur als ein Block zu
                lesen sind: Der Schalter stand vorher rahmenlos über den beiden und wirkte
                wie ein einzelnes Kästchen irgendwo am Rand. Rahmen, Stärke und Rundung sind
                bewusst dieselben wie bei BRD_PrüfAmpel — die drei Teile gehören derselben
                Familie an, statt jedes für sich zu sprechen.

                Breite 71 = von 10 bis 81 Punkten, also genau über Ampel (10 bis 62) und
                Farbsignatur (67 bis 81). Die Spalte wird dadurch nicht breiter, denn ihr
                rechter Rand liegt mit der Signatur ohnehin schon bei 81. Innenabstand knapp
                gehalten: Er geht in die Höhe der Spalte ein, und die Ampel ist bereits das
                höchste Stück der Ansicht.
            -->
            <Border
                x:Name="BRD_PrüfKarte"
                Width="71"
                Margin="10,0,0,2"
                Padding="3,2,3,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderThickness="2"
                CornerRadius="2">
                <CheckBox
                    x:Name="CHK_BildPrüfen"
                    Width="60"
                    Height="18"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="Prüfen"
                    FontSize="12"
                    IsChecked="{Binding SollBildGeprüftWerden}"
                    Style="{StaticResource PrüfKästchen}"
                    ToolTip="Bilder beim Anzeigen auf Schäden prüfen – Ergebnis in der Ampel darunter" />
            </Border>

            <Grid
                x:Name="GRD_BlaetternLinks"
                Grid.Row="2"
                Width="54"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                Background="Transparent">

                <RibbonButton
                    x:Name="RDBTN_BildNachLinks"
                    Height="auto"
                    Margin="1,1,1,1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteBildLinksCommand, Mode=OneWay}"
                    Content="Button"
                    CornerRadius="8"
                    KeyTip="-"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE" />

                <!--  Sichtbares Icon  -->
                <Image
                    Width="38"
                    Height="38"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Source="{StaticResource di_PfeilLinks}">

                    <Image.Style>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Opacity" Value="1" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled, ElementName=RDBTN_BildNachLinks}" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Grid>
            <!--
                Prüf-Ampel: sechs Felder zum Bildzustand, je Feld eine Prüfung aus dem
                ViewModel. Grün = in Ordnung, Rot = auffällig, Grau = noch nicht geprüft
                (der Zustand bei null). Darunter der Fortschritt des Bildladens.
            -->
            <StackPanel
                x:Name="STP_PrüfAmpel"
                Grid.Row="1"
                Width="52"
                Height="162"
                d:Background="Wheat"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Orientation="Vertical">
                <Border
                    x:Name="BRD_PrüfAmpel"
                    Height="auto"
                    d:BorderBrush="Blue"
                    d:BorderThickness="1"
                    Padding="2,2,2,2"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    BorderThickness="2,2,2,2"
                    CornerRadius="2,2,2,2"
                    ToolTipService.ShowDuration="30000">

                    <!--
                        Legende am Rahmen. Die Buchstaben in den Feldern sind kurz genug für
                        20 Punkte, aber allein nicht zu deuten — wer sie zum ersten Mal sieht,
                        fährt über den Rahmen und hat die Übersicht.
                    -->
                    <Border.ToolTip>
                        <ToolTip
                            x:Name="TTP_PrüfAmpel"
                            MaxWidth="320"
                            HasDropShadow="True"
                            Placement="Bottom"
                            VerticalOffset="8">
                            <Border
                                x:Name="BRD_AmpelLegende"
                                Padding="12,12,14,12"
                                Background="#F4F4F0"
                                BorderBrush="#C0C0BA">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="3,0,0,0" />
                                        <Setter Property="BorderBrush" Value="#3B82C4" />
                                    </Style>
                                </Border.Style>

                                <StackPanel x:Name="STP_AmpelLegende">

                                    <!--  Kopfzeile: Zeichen und Überschrift  -->
                                    <StackPanel
                                        x:Name="STP_LegendeKopf"
                                        Margin="0,0,0,8"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="IC_LegendeZeichen"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="16"
                                            Foreground="#3B82C4"
                                            Text="&#xE946;" />
                                        <TextBlock
                                            x:Name="TXT_LegendeTitel"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#222222"
                                            Text="Prüf-Ampel" />
                                    </StackPanel>

                                    <TextBlock
                                        x:Name="TXT_LegendeReihe1"
                                        Margin="0,0,0,8"
                                        FontSize="11"
                                        Foreground="#555555"
                                        Text="Obere zwei Reihen – ist die Datei heil: beschädigt, Dateikopf gegen Endung, Bildrahmen vorhanden, Download unvollständig, 0 Byte, erkanntes Format."
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        x:Name="TXT_LegendeReihe2"
                                        Margin="0,0,0,4"
                                        FontSize="11"
                                        Foreground="#555555"
                                        Text="Untere zwei Reihen – taugt das Bild etwas:"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        x:Name="TXT_LegendeBuchstaben"
                                        Margin="0,0,0,8"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="#555555"
                                        TextWrapping="Wrap"><Run FontWeight="Bold" Text="D" /><Run Text=" = Datei beschädigt" /><LineBreak /><Run FontWeight="Bold" Text="B" /><Run Text=" = Byte je Pixel (Kompression)" /><LineBreak /><Run FontWeight="Bold" Text="G" /><Run Text=" = Grösse (Abmessungen)" /><LineBreak /><Run FontWeight="Bold" Text="E" /><Run Text=" = Einfarbigkeit (Platzhalter?)" /><LineBreak /><Run FontWeight="Bold" Text="K" /><Run Text=" = Kantendichte (verwaschen?)" /></TextBlock>

                                    <Separator x:Name="SEP_Legende" Margin="0,0,0,6" />

                                    <TextBlock
                                        x:Name="TXT_LegendeFarben"
                                        FontSize="10"
                                        Foreground="#999999"
                                        Text="Grün in Ordnung, Rot auffällig, Grau kein Urteil. Verglichen wird mit dem Median des offenen Ordners – die ersten zehn Bilder liefern nur den Massstab."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </ToolTip>
                    </Border.ToolTip>

                    <StackPanel
                        x:Name="STP_PrüfAmpelInhalt"
                        Width="auto"
                        Height="auto"
                        Orientation="Vertical">
                        <StackPanel x:Name="STP_PrüfZeile1" Orientation="Horizontal">
                            <Border
                                x:Name="BRD_AmpelDateiBeschädigt"
                                Width="20"
                                Height="20"
                                Margin="1,1,1,1"
                                d:Background="GreenYellow"
                                Background="{Binding IsBildDateiBeschädigt, Converter={StaticResource ConverterAmpelFarbe}}"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                BorderThickness="2"
                                ToolTipService.ShowDuration="30000">
                                <Border.ToolTip>
                                    <ToolTip
                                        x:Name="TTP_AmpelDateiBeschädigt"
                                        MaxWidth="320"
                                        HasDropShadow="True"
                                        Placement="Bottom"
                                        VerticalOffset="8">
                                        <Border
                                            x:Name="BRD_DateiBeschädigtKarte"
                                            Padding="12,12,14,12"
                                            Background="#F4F4F0"
                                            BorderBrush="#C0C0BA">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                                                    <Setter Property="BorderBrush" Value="#3B82C4" />
                                                </Style>
                                            </Border.Style>

                                            <StackPanel x:Name="STP_DateiBeschädigt">
                                                <StackPanel
                                                    x:Name="STP_DateiBeschädigtKopf"
                                                    Margin="0,0,0,8"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        x:Name="IC_DateiBeschädigt"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="16"
                                                        Foreground="#3B82C4"
                                                        Text="&#xE7BA;" />
                                                    <TextBlock
                                                        x:Name="TXT_DateiBeschädigtTitel"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="#222222"
                                                        Text="D – Datei beschädigt" />
                                                </StackPanel>

                                                <TextBlock
                                                    x:Name="TXT_DateiBeschädigtWas"
                                                    Margin="0,0,0,8"
                                                    FontSize="11"
                                                    Foreground="#555555"
                                                    Text="Die härteste der Prüfungen: Die Datei wird vollständig dekodiert. Gelingt das nicht, ist sie unbrauchbar – gleich ob sie fehlt, 0 Byte gross ist oder mittendrin abbricht."
                                                    TextWrapping="Wrap" />

                                                <TextBlock
                                                    x:Name="TXT_DateiBeschädigtWie"
                                                    Margin="0,0,0,8"
                                                    FontSize="11"
                                                    Foreground="#555555"
                                                    Text="Bei WebP wird zuerst der Codec versucht; fehlt er auf diesem Rechner, entscheidet ersatzweise der RIFF-Dateikopf. Sonst hiesse „kein Codec“ fälschlich „beschädigt“."
                                                    TextWrapping="Wrap" />

                                                <Separator x:Name="SEP_DateiBeschädigt" Margin="0,0,0,6" />

                                                <TextBlock
                                                    x:Name="TXT_DateiBeschädigtFuss"
                                                    FontSize="10"
                                                    Foreground="#999999"
                                                    Text="Kostet einen vollen Dekodierdurchgang und läuft deshalb nur mit gesetztem Häkchen „Prüfen“. Ohne Häkchen bleibt das Feld grau."
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </ToolTip>
                                </Border.ToolTip>

                                <TextBlock
                                    x:Name="TXT_AmpelDateiBeschädigt"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#FF1F2937"
                                    Text="D" />
                            </Border>
                            <Border
                                x:Name="BRD_AmpelHeaderPasst"
                                Width="20"
                                Height="20"
                                Margin="1,1,1,1"
                                d:Background="GreenYellow"
                                Background="{Binding IsHeaderPassendZurErweiterung, Converter={StaticResource ConverterAmpelFarbe}, ConverterParameter=Gut}"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                BorderThickness="2"
                                ToolTipService.ShowDuration="30000">
                                <Border.ToolTip>
                                    <ToolTip
                                        x:Name="TTP_AmpelHeaderPasst"
                                        MaxWidth="320"
                                        HasDropShadow="True"
                                        Placement="Bottom"
                                        VerticalOffset="8">
                                        <Border
                                            x:Name="BRD_HeaderPasstKarte"
                                            Padding="12,12,14,12"
                                            Background="#F4F4F0"
                                            BorderBrush="#C0C0BA">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                                                    <Setter Property="BorderBrush" Value="#3B82C4" />
                                                </Style>
                                            </Border.Style>

                                            <StackPanel x:Name="STP_HeaderPasst">
                                                <StackPanel
                                                    x:Name="STP_HeaderPasstKopf"
                                                    Margin="0,0,0,8"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        x:Name="IC_HeaderPasst"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="16"
                                                        Foreground="#3B82C4"
                                                        Text="&#xE8A5;" />
                                                    <TextBlock
                                                        x:Name="TXT_HeaderPasstTitel"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="#222222"
                                                        Text="H – Dateikopf gegen Endung" />
                                                </StackPanel>

                                                <TextBlock
                                                    x:Name="TXT_HeaderPasstBefund"
                                                    Margin="0,0,0,8"
                                                    d:Text="Die Datei heisst .jpg, ist aber ein PNG. Richtig wäre die Endung .png."
                                                    FontSize="11"
                                                    Foreground="#555555"
                                                    Text="{Binding HeaderText}"
                                                    TextWrapping="Wrap" />

                                                <TextBlock
                                                    x:Name="TXT_HeaderPasstWas"
                                                    Margin="0,0,0,8"
                                                    FontSize="11"
                                                    Foreground="#555555"
                                                    Text="Verglichen werden die ersten Bytes der Datei mit ihrer Endung. Stimmen sie nicht überein, wird der Kopf gegen alle bekannten Signaturen geprüft – daher der Vorschlag, welche Endung richtig wäre."
                                                    TextWrapping="Wrap" />

                                                <Separator x:Name="SEP_HeaderPasst" Margin="0,0,0,6" />

                                                <TextBlock
                                                    x:Name="TXT_HeaderPasstFuss"
                                                    FontSize="10"
                                                    Foreground="#999999"
                                                    Text="Umbenannt wird nichts. Eine falsche Endung stört die Anzeige meist nicht – wohl aber andere Programme."
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </ToolTip>
                                </Border.ToolTip>

                                <TextBlock
                                    x:Name="TXT_AmpelHeaderPasst"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#FF1F2937"
                                    Text="H" />
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="STP_PrüfZeile2" Orientation="Horizontal">
                            <Border
                                x:Name="BRD_AmpelFrameImBild"
                                Width="20"
                                Height="20"
                                Margin="1,1,1,1"
                                d:Background="GreenYellow"
                                Background="{Binding IsFrameImBildDrin, Converter={StaticResource ConverterAmpelFarbe}, ConverterParameter=Gut}"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                BorderThickness="2"
                                ToolTipService.ShowDuration="30000">
                                <Border.ToolTip>
                                    <ToolTip
                                        x:Name="TTP_AmpelFrameImBild"
                                        MaxWidth="320"
                                        HasDropShadow="True"
                                        Placement="Bottom"
                                        VerticalOffset="8">
                                        <Border
                                            x:Name="BRD_FrameImBildKarte"
                                            Padding="12,12,14,12"
                                            Background="#F4F4F0"
                                            BorderBrush="#C0C0BA">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                                                    <Setter Property="BorderBrush" Value="#3B82C4" />
                                                </Style>
                                            </Border.Style>

                                            <StackPanel x:Name="STP_FrameImBild">
                                                <StackPanel
                                                    x:Name="STP_FrameImBildKopf"
                                                    Margin="0,0,0,8"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        x:Name="IC_FrameImBild"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="16"
                                                        Foreground="#3B82C4"
                                                        Text="&#xE91B;" />
                                                    <TextBlock
                                                        x:Name="TXT_FrameImBildTitel"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="#222222"
                                                        Text="F – Bild im Behälter" />
                                                </StackPanel>

                                                <TextBlock
                                                    x:Name="TXT_FrameImBildWas"
                                                    Margin="0,0,0,8"
                                                    FontSize="11"
                                                    Foreground="#555555"
                                                    Text="Grün heisst: Der Dekodierer findet in der Datei mindestens ein Einzelbild. Eine Datei kann einen tadellosen Kopf haben und trotzdem keines enthalten – dann ist nur die Hülle da."
                                                    TextWrapping="Wrap" />

                                                <Separator x:Name="SEP_FrameImBild" Margin="0,0,0,6" />

                                                <TextBlock
                                                    x:Name="TXT_FrameImBildFuss"
                                                    FontSize="10"
                                                    Foreground="#999999"
                                                    Text="Bei bewegten GIF- oder WebP-Dateien stecken viele Einzelbilder darin; geprüft wird nur, ob überhaupt eines da ist."
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </ToolTip>
                                </Border.ToolTip>

                                <TextBlock
                                    x:Name="TXT_AmpelFrameImBild"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#FF1F2937"
                                    Text="F" />
                            </Border>
                            <Border
                                x:Name="BRD_AmpelDownloadDefekt"
                                Width="20"
                                Height="20"
                                Margin="1,1,1,1"
                                d:Background="GreenYellow"
                                Background="{Binding IsBildDownloadCorrupted, Converter={StaticResource ConverterAmpelFarbe}}"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                BorderThickness="2"
                                ToolTipService.ShowDuration="30000">
