                                                    <Setter Property="BorderBrush" Value="#3B82C4" />
                                                </Style>
                                            </Border.Style>

                                            <StackPanel x:Name="STP_Einfarbig">
                                                <StackPanel
                                                    x:Name="STP_EinfarbigKopf"
