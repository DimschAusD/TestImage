                                        </Border>
                                    </ToolTip>
                                </Border.ToolTip>

                                <TextBlock
                                    x:Name="TXT_AmpelKantenarm"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#FF1F2937"
                                    Text="K" />
                            </Border>
                        </StackPanel>
                        <!--
                            Vier Stufen: Vorschau geladen, Vorschau sichtbar, grosses Bild
                            sichtbar, fertig. Die Werte stehen als benannte Konstanten im
                            ViewModel (LadestufeFertig muss zu Maximum passen).
                        -->
                        <ProgressBar
                            x:Name="PGB_BildLadenStufen"
                            Width="40"
                            Height="10"
                            d:Value="3"
                            d:Visibility="Visible"
                            Maximum="4"
                            Visibility="{Binding CommandExecuteKleinesBildGrossesBildLadenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}"
                            Value="{Binding ProgressValue, Mode=OneWay}" />



                    </StackPanel>
                </Border>
                <!--
                    Die Ladezeiten der drei Bildstufen liegen weiter im ViewModel:
                    SWkleinesBild, SWgrossesBild, SWkonturBild. Sollen sie wieder
                    sichtbar werden, dann als Text — dafür muss man nicht hovern.
                -->

                <!--
                    Massstab des Bildes: Stretch.Uniform (eingepasst) oder Stretch.None
                    (Originalpixel). Das Zeichen zeigt die nächste Wirkung, nicht den
                    Zustand — ein Button rastet nicht ein.
                    
                    Segoe UI Symbol ist Absicht: E1D9/E1D8 sind dort vier kräftige Pfeile.
                    In Segoe MDL2 wären es zwei dünne — fast das E740 des Vollbildknopfes,
                    mit dem dieser Knopf ohnehin leicht verwechselt wird.
                -->
                <Button
                    x:Name="RDBTN_BildOriginalgrösse"
                    Height="28"
                    Margin="0,2,0,0"
                    Padding="7,0"
                    HorizontalAlignment="Left"
                    Command="{Binding CommandExecuteBildStretchAnpassenCommand, Mode=OneWay}"
                    Style="{StaticResource RibbonKnopf}"
                    ToolTipService.ShowDuration="30000">
                    <Button.ToolTip>
                        <ToolTip
                            x:Name="TTP_BildOriginalgrösse"
                            MaxWidth="320"
                            HasDropShadow="True"
                            Placement="Bottom"
                            VerticalOffset="8">
                            <Border
                                x:Name="BRD_OriginalgrösseKarte"
                                Padding="12,12,14,12"
                                Background="#F4F4F0"
                                BorderBrush="#3B82C4"
                                BorderThickness="3,0,0,0">
                                <StackPanel x:Name="STP_Originalgrösse">
                                    <StackPanel
                                        x:Name="STP_OriginalgrösseKopf"
                                        Margin="0,0,0,8"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="IC_OriginalgrösseKarte"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="16"
                                            Foreground="#3B82C4"
                                            Text="&#xE9A6;" />
                                        <TextBlock
                                            x:Name="TXT_OriginalgrösseTitel"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#222222"
                                            Text="Massstab des grossen Bildes" />
                                    </StackPanel>

                                    <TextBlock
                                        x:Name="TXT_OriginalgrösseWas"
                                        Margin="0,0,0,8"
                                        FontSize="11"
                                        Foreground="#555555"
                                        Text="Schaltet die Bildfläche zwischen „ins Fenster eingepasst&quot; und „Originalgrösse, ein Bildpunkt je Bildpunkt&quot; um. In Originalgrösse erscheinen Bildlaufleisten, wenn das Bild grösser ist als die Fläche."
                                        TextWrapping="Wrap" />

                                    <Separator x:Name="SEP_Originalgrösse" Margin="0,0,0,6" />

                                    <TextBlock
                                        x:Name="TXT_OriginalgrösseFuss"
                                        FontSize="10"
                                        Foreground="#999999"
                                        Text="Nicht zu verwechseln mit F11: Das wechselt den Ansichtsmodus und legt das Bild über das ganze Fenster. Dieser Knopf lässt die Ansicht, wie sie ist, und ändert nur den Massstab darin."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </ToolTip>
                    </Button.ToolTip>

                    <!--  E1D9 = Pfeile nach aussen (auf Originalgrösse), E1D8 nach innen (einpassen)  -->
                    <TextBlock
                        x:Name="IC_Originalgrösse"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:Text="&#xE1D9;"
                        FontFamily="Segoe UI Symbol"
                        FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Text" Value="&#xE1D9;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImageStretch}" Value="None">
                                        <Setter Property="Text" Value="&#xE1D8;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

            </StackPanel>
            <!--
                Farbsignatur des Bildes: bandweise Mittelwerte von oben nach unten. Der
                Verlauf kommt fertig aus dem ViewModel (BildFarbsignatur), berechnet auf dem
                100-px-Vorschaubild. Ohne Bild bleibt die Fläche leer, der Rahmen zeigt den
                Streifen trotzdem an.
                
                Steht in der DEHNBAREN Zeile neben der Blätterfläche, nicht in einer eigenen
                Auto-Zeile darunter. Zwei Gründe:
                
                Er wird damit so hoch, wie das Fenster hergibt — bei einem Verlauf aus Bändern
                ist Höhe genau das, was ihn lesbar macht. Und er kostet dabei keinen Punkt
                Mindesthöhe: Eine Auto-Zeile hätte ihre 72 Punkte fest zur Fensterhöhe
                addiert, in der Sternzeile nimmt er nur, was ohnehin übrig ist.
                
                Waagerecht bei 68 Punkten, also rechts neben GRD_BlaetternLinks (10 bis 64)
                und innerhalb der 96 Punkte, die die Spalte ohnehin misst — die Spalte wird
                dadurch nicht breiter.
            -->
            <Rectangle
                x:Name="RCT_Farbsignatur"
                Grid.Row="1"
                Width="14"
                Margin="67,0,0,54"
                HorizontalAlignment="Left"
                d:Visibility="Visible"
                Fill="{Binding BildFarbsignatur}"
                Stroke="Black"
                Visibility="{Binding HatBild, Converter={StaticResource CLconverterVisiblityBoolian}}"
                ToolTip="Farbsignatur: Durchschnittsfarbe des Bildes, von oben nach unten in Bändern">
                <d:Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#FFE7F926" />
                        <GradientStop Offset="0.083" Color="#FFF18CD5" />
                        <GradientStop Offset="0.923" Color="#FFF694DB" />
                        <GradientStop Offset="0.953" Color="#FFF44EC8" />
                        <GradientStop Offset="0.993" Color="#FFF4EA4E" />
                    </LinearGradientBrush>
                </d:Rectangle.Fill>
            </Rectangle>
        </Grid>
        <!--
            Werkzeugleiste zum Byte-, SHA- und Grauabgleich. Eigene Zeile unter dem Bild
            statt schwebend in dessen linker unterer Ecke — dort verdeckte sie einen
            Streifen des Bildes und stiess bei kleinen Fenstern mit der Farbsignatur
            zusammen.
        -->
        <Border
            x:Name="BRD_AbgleichWerkzeuge"
            Grid.Row="3"
            Grid.Column="1"
            Width="auto"
            Height="28"
            Margin="5,4,0,4"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
            BorderThickness="1,1,1,1"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <StackPanel Orientation="Horizontal">
                <CheckBox
                    x:Name="CHBX_MultiGleichheit"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="Multi"
                    IsChecked="{Binding MultiByteParallelGleichheit, Mode=TwoWay}"
                    ToolTip="Multi Thriding, lohnt sich bei einer schnellen Festplatte, sonnst nicht" />
                <!--  SmallImageSource="/Images/Gleich.png"  -->


                <!--  d:Source="images/gleich.png"  -->


                <!--  d:SmallImageSource="/Images/UngefährGleichKlein.png"  -->


                <!--  SmallImageSource="{svg1:SvgIcon Source=Images/EinGleicher.svg} "  -->
                <RibbonButton
                    x:Name="RDBTN_BildGleicheByteBildFinden"
                    Width="30"
                    Height="22"
                    Margin="8,2,2,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    d:SmallImageSource="{StaticResource di_EinGleicher}"
                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteSuchenGleichesBildByteVergleichCommand, Mode=OneWay}"
                    Content="Byte-Abgleich"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE"
                    SmallImageSource="{StaticResource di_EinGleicher}"
                    ToolTip="Byte-Abgleich, gleiches Bild">
                    <RibbonButton.ContextMenu>
                        <ContextMenu x:Name="CTM_ByteAbgleich">
                            <MenuItem
                                x:Name="MNI_ByteVergleichAlle"
                                Command="{Binding CommandExecuteAlleBilderMiteinanderAufByteGleichheitPrüfenCommand, Mode=OneWay}"
                                Header="Byte-Vergleich aller Bilder"
                                ToolTip="Byte-Abgleich: Jedes Bild mit jedem Bild vergleichen">
                                <MenuItem.Icon>
                                    <Image
                                        x:Name="IC_ByteVergleichAlle"
                                        Width="16"
                                        Height="16"
                                        d:Source="{StaticResource di_VieleGleiche}"
                                        Source="{StaticResource di_VieleGleiche}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                x:Name="MNI_SHA256VergleichAlle"
                                Command="{Binding CommandExecuteAlleBilderSHA256AbgleichPrüfenCommand, Mode=OneWay}"
                                Header="Alle SHA256 Vergleich nacheinander"
                                ToolTip="Den SHA256 Wert Jedes Bildes mit jedem Bild Abgleichen, nur 1x berechnet">
                                <MenuItem.Icon>
                                    <Image
                                        x:Name="IC_SHA256VergleichAlle"
                                        Width="16"
                                        Height="16"
                                        d:Source="{StaticResource di_VieleGleiche}"
                                        Source="{StaticResource di_VieleGleiche}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </RibbonButton.ContextMenu>

                </RibbonButton>
                <RibbonButton
                    x:Name="RDBTN_AbbrechenByteAbgleich"
                    Width="22"
                    Height="22"
                    d:Visibility="Visible"
                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteSuchenGleichesBildByteVergleichCancelCommand, Mode=OneWay}"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE"
                    SmallImageSource="{StaticResource di_AbbrechenOrange}"
                    ToolTip="Byte Abgleich, Abbrechen"
                    Visibility="{Binding CommandExecuteSuchenGleichesBildByteVergleichCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}" />
                <RibbonButton
                    x:Name="RDBTN_AbbrechenByteAbgleichAlle"
                    Width="22"
                    Height="22"
                    Margin="2,0,0,0"
                    d:Visibility="Visible"
                    Background="#FFF7E9E9"
                    BorderBrush="#FFFC4747"
                    Command="{Binding CommandExecuteAlleBilderMiteinanderAufByteGleichheitPrüfenCancelCommand, Mode=OneWay}"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="#FF49AF0C"
                    PressedBackground="#FFCACFFE"
                    SmallImageSource="{StaticResource di_Abbrechen}"
                    ToolTip="Byte-Abgleich (alle) Abbrechen"
                    Visibility="{Binding CommandExecuteAlleBilderMiteinanderAufByteGleichheitPrüfenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}" />

                <RibbonButton
                    x:Name="RDBTN_AbbrechenSHA256AlleFinden"
                    Width="22"
                    Height="22"
                    d:Visibility="Visible"
                    Background="#FFF7E9E9"
                    BorderBrush="#FFFC4747"
                    Command="{Binding CommandExecuteAlleBilderSHA256AbgleichPrüfenCancelCommand, Mode=OneWay}"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="#FF49AF0C"
                    PressedBackground="#FFCACFFE"
                    SmallImageSource="{StaticResource di_Abbrechen}"
                    ToolTip="Alle SHA256 Abgleich, Abbrechen"
                    Visibility="{Binding CommandExecuteAlleBilderSHA256AbgleichPrüfenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}" />


                <!--  Vertical Separator  -->
                <Separator x:Name="SEP_VorGrauAbgleich" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                <!--  SmallImageSource="{svg1:SvgIcon Source=Images/UngefährGleich.svg}"  -->
                <RibbonButton
                    x:Name="RDBTN_GrauAbgleich"
                    Width="30"
                    Height="22"
                    Margin="2,0,0,0"
                    d:SmallImageSource="{StaticResource di_UngefaehrGleich}"
                    Background="{x:Null}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteSuchenUngefährGleichesBildCommand, Mode=OneWay}"
                    Content="Grau Gleich"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE"
                    SmallImageSource="{StaticResource di_UngefaehrGleich}"
                    ToolTip="Grau Abgleich (HammingDistance &gt; 10)">

                    <RibbonButton.ContextMenu>
                        <ContextMenu x:Name="CTM_GrauAbgleich">
                            <MenuItem
                                x:Name="MNI_GrauAbgleichPlatzhalter"
                                Header="Nix"
                                IsEnabled="False" />
                        </ContextMenu>
                    </RibbonButton.ContextMenu>

                </RibbonButton>
                <Button
                    x:Name="BTN_AbbrechenGrauAbgleich"
                    Width="22"
                    Height="22"
                    Margin="2,0,2,0"
                    Command="{Binding CommandExecuteSuchenUngefährGleichesBildCancelCommand, Mode=OneWay}"
                    Content="X"
                    Foreground="Red" />

                <!--
                    Tastensteuerung: Die Übersicht liegt im Fenster (BRD_TastenHilfe) und
                    gilt für beide Ansichten. Hier als sichtbarer Knopf, überall auch über F1.
                -->

            </StackPanel>
        </Border>
        <!--  Kopfleiste links: Ablagefeld, Fensterknöpfe und Einstieg in die Bildersuche  -->
        <StackPanel
            x:Name="STP_KopfleisteLinks"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <!--
                Das Zeichen sitzt als eigener TextBlock im Knopf, nicht als Content-Setter:
                RibbonKnopf setzt keine FontFamily, ein blosses Content="&#x2026;" bliebe
                als Kästchen stehen.
                
                E117 aus Segoe UI Symbol — dort ein kräftiger Doppelpfeil-Kreis. In Segoe
                MDL2 Assets wäre dieselbe Nummer eine dünne Linienform, und das früher
                benutzte E72C gibt es in Segoe UI Symbol gar nicht.
            -->
            <Button
                x:Name="BTN_BilderAktualisieren"
                Height="28"
                Margin="4,0,0,0"
                Command="{Binding CommandExecuteAlleBilderNeuEinlesenCommand, Mode=OneWay}"
                Cursor="Hand"
                Style="{StaticResource RibbonKnopf}"
                ToolTip="Alle Bilder neu einlesen">
                <StackPanel x:Name="STP_BilderAktualisieren" Orientation="Horizontal">
                    <!--
                        Feste 26 statt Auto: Eingeklappt soll der Knopf genau die 28 messen
                        wie vorher (26 + zweimal 1 Rand). Das Zeichen selbst misst 18,4.
                    -->
                    <TextBlock
                        x:Name="IC_BilderAktualisieren"
                        Width="26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Symbol"
                        FontSize="15"
                        Text="&#xE117;"
                        TextAlignment="Center" />

                    <!--
                        Die Beschriftung wächst beim Überfahren aus dem Nichts heraus.

                        Animiert wird die BREITE dieses TextBlocks, nicht die des Knopfes:
                        Der Knopf misst sich am Inhalt und wächst dadurch von selbst mit,
                        und der ganze Rest der Leiste rückt sauber mit nach rechts.

                        Der Abstand zum Zeichen steckt im Padding, nicht im Margin — ein
                        Margin würde auch bei Breite 0 seine 6 Punkte behalten und den
                        eingeklappten Knopf auf 34 aufblähen.

                        Zielbreite 123 ist gemessen, nicht geraten: „Ansicht aktualisieren"
                        misst in Segoe UI bei Grösse 12 genau 108,6 DIP, dazu 6 links und
                        8 rechts. Auf Auto lässt sich nicht animieren, deshalb die Zahl.
                        Wird der Text geändert, muss sie mitgeändert werden.

                        Der Auslöser ist ein MultiDataTrigger und prüft IsEnabled mit: Ein
                        gesperrter Knopf darf sich nicht aufklappen und Tatendrang
                        vortäuschen — dieselbe Regel wie beim grünen Überfahren in
                        RibbonKnopf.
                    -->
                    <TextBlock
                        x:Name="TXT_BilderAktualisieren"
                        VerticalAlignment="Center"
                        d:Width="123"
                        FontFamily="Segoe UI"
                        FontSize="12"
                        Padding="6,0,8,0"
                        Text="Ansicht aktualisieren"
                        TextTrimming="None"
                        TextWrapping="NoWrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Width" Value="0" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True" />
                                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Width"
                                                        To="123"
                                                        Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                        <MultiDataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Width"
                                                        To="0"
                                                        Duration="0:0:0.14">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseIn" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.ExitActions>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>

            <!--  Indikatoren (Webcam/Mikrofon/Screen-Share) → jetzt im Host-Cluster (MainWindow), oben rechts.  -->

            <!--
                Unscheinbarer Button: blendet die Such-/Index-Leiste ein/aus.
                
                Fernglas statt Lupe. Die Lupe (MDL2 E721) steht überall für die einfache
                Suche im gerade Sichtbaren — dieselbe Bedeutung wie Strg+F. Dieser Knopf
                öffnet die erweiterte Suche über den Index: andere Ordner, Begriffe,
                Ähnlichkeit. Adobe trennt beides genauso, und das Fernglas ist dort das
                Zeichen fürs Weitersuchen.
                
                Beschriftet mit „Erw. Suche", nicht mit „Index": Was ein Index ist, weiss
                nur, wer ihn selbst angelegt hat. Was die Leiste tut, steht damit auf dem
                Knopf. Keine feste Breite mehr — der Text ist länger als „Index" war, und
                der Knopf misst sich am Inhalt statt an einer Zahl.
            -->
            <Button
                x:Name="BTN_IndexSuchleiste"
                Width="84"
                Height="28"
                Margin="8,0,0,0"
                Padding="10,0"
                Command="{Binding CommandExecuteSuchleisteToggleCommand}"
                Cursor="Hand"
                ToolTip="Erweiterte Suche über den Index ein-/ausblenden (Umschalt+F)">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#FF6B6B6B" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border
                                        x:Name="bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="#33000000"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                                            <!--
                                                Gezeichnet, nicht als Schriftzeichen: Segoe
                                                MDL2 Assets kennt kein Fernglas. Fünf
                                                Rechtecke — zwei Rohre, zwei Okulare, eine
                                                Brücke — bleiben bei jeder Bildschirm-
                                                auflösung scharf und nehmen die Schriftfarbe
                                                des Knopfes an, auch beim Überfahren.
                                            -->
                                            <Canvas
                                                x:Name="CNV_Fernglas"
                                                Width="16"
                                                Height="13"
                                                Margin="2,1,6,0"
                                                VerticalAlignment="Center">
                                                <!--
                                                    Okulare oben, halb unter den Rohren —
                                                    dadurch verschmelzen beide zu einem
                                                    abgesetzten Rohr statt zu zwei
                                                    getrennten Klötzchen.
                                                -->
                                                <Rectangle
                                                    x:Name="RCT_FernglasOkularLinks"
                                                    Canvas.Left="1"
                                                    Canvas.Top="0"
                                                    Width="4"
                                                    Height="6"
                                                    Fill="{TemplateBinding Foreground}"
                                                    RadiusX="1"
                                                    RadiusY="1" />
                                                <Rectangle
                                                    x:Name="RCT_FernglasOkularRechts"
                                                    Canvas.Left="11"
                                                    Canvas.Top="0"
                                                    Width="4"
                                                    Height="6"
                                                    Fill="{TemplateBinding Foreground}"
                                                    RadiusX="1"
                                                    RadiusY="1" />

                                                <!--
                                                    Radius 2, nicht 3: Bei 3 wäre das
                                                    6 Punkte breite Rohr oben und unten
                                                    halbrund — die Form las sich dann als
                                                    Hantel, nicht als Fernglas.
                                                -->
                                                <Rectangle
                                                    x:Name="RCT_FernglasRohrLinks"
                                                    Canvas.Left="0"
                                                    Canvas.Top="4"
                                                    Width="6"
                                                    Height="9"
                                                    Fill="{TemplateBinding Foreground}"
                                                    RadiusX="2"
                                                    RadiusY="2" />
                                                <Rectangle
                                                    x:Name="RCT_FernglasRohrRechts"
                                                    Canvas.Left="10"
                                                    Canvas.Top="4"
                                                    Width="6"
                                                    Height="9"
                                                    Fill="{TemplateBinding Foreground}"
                                                    RadiusX="2"
                                                    RadiusY="2" />

                                                <!--  Brücke im oberen Drittel; mittig sähe es aus wie ein H  -->
                                                <Rectangle
                                                    x:Name="RCT_FernglasBruecke"
                                                    Canvas.Left="5"
                                                    Canvas.Top="3"
                                                    Width="6"
                                                    Height="3"
                                                    Fill="{TemplateBinding Foreground}" />
                                            </Canvas>
                                            <TextBlock
                                                x:Name="TXT_IndexSuchleiste"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe UI"
                                                FontSize="12"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="Erw. Suche" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#11000000" />
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#55000000" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#22000000" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSuchleisteOffen}" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#22000000" />
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#55000000" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!--
                HIER STAND BRD_AufgabeFortschritt.
                
                Der Streifen sitzt jetzt in GRD_StreifenUeberBild, in der Zeile über dem
                Bild. Grund: Diese Zeile ist wegen der Kontur-Karte ohnehin 36 Punkte hoch
                und links leer — der Streifen kostet dort keinen Punkt zusätzlich. Und die
                Kopfleiste hier war mit label (190) plus zwei Knöpfen plus 280 für den
                Streifen die engste Reihe der Ansicht.
            -->

            <!--
                Die Bildersuche lief bis hier als Popup unter dem Knopf. Sie sitzt jetzt
                in einem eigenen Werkzeugfenster (IndexSuchFenster), geöffnet über
                IsSuchleisteOffen in NormalAnsicht.xaml.cs.
                
                Grund: Ein Popup mit StaysOpen="False" schliesst sich, sobald man in den
                Explorer klickt — und genau das braucht man, um einen Ordner auf die
                Index-Karte zu ziehen. Ausserdem lässt sich ein Popup nicht in der Grösse
                ändern.
            -->

        </StackPanel>

        <!--  „Liste": öffnet das Schnell-Listen-Popup (alle Miniaturen zum Finden)  -->
        <Button
            x:Name="BTN_BildListe"
            Grid.Row="5"
            Grid.Column="0"
            Height="26"
            Margin="10,0,0,0"
            Padding="8,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Command="{Binding CommandExecuteBildListeToggleCommand}"
            Style="{StaticResource RibbonKnopf}"
            ToolTip="Alle Bilder als Kacheln – schnell zu einem Bild springen"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <StackPanel x:Name="STP_BildListeInhalt" Orientation="Horizontal">
                <!--  ECA5 = Tiles. Vorher E8FD (List) – das Panel zeigt aber ein Kachelraster.  -->
                <TextBlock
                    x:Name="IC_BildListe"
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Text="&#xECA5;" />
                <TextBlock
                    x:Name="TXT_BildListe"
                    VerticalAlignment="Center"
                    Text="Kacheln" />
            </StackPanel>
        </Button>

        <!--  Schnell-Liste als Popup, rechtsbündig über der Miniaturleiste  -->
        <Popup
            x:Name="POP_BildListe"
            AllowsTransparency="True"
            IsOpen="{Binding IsBildListeOffen, Mode=TwoWay}"
            Placement="Custom"
            PlacementTarget="{Binding ElementName=Listbox_MiniaturBilder}"
            PopupAnimation="Fade"
            StaysOpen="False">
            <bildersuche:BildListePanel Margin="12" />
        </Popup>
        <!--  Windrad: zeigt als Viertel, wo im Ordner das gewählte Bild steht  -->
        <Border
            x:Name="BRD_Positionsanzeige"
            Grid.Row="4"
            Grid.Column="0"
            Width="34"
            Height="34"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            BorderBrush="#44000000"
            BorderThickness="0.6"
            CornerRadius="6"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="6"
                    Opacity="0.3"
                    ShadowDepth="1"
                    Color="Black" />
            </Border.Effect>
            <Grid>

                <!--  Links (Left)  -->
                <!--  Position — Windrad-Dreiecke  -->
                <Canvas
                    x:Name="CVS_PositionDreiecke"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ToolTip="Bildposition im Ordner (Viertel-Anzeige)">
                    <Canvas.Effect>
                        <DropShadowEffect
                            BlurRadius="3"
                            Opacity="0.6"
                            ShadowDepth="0"
                            Color="#FF25B2C4" />
                    </Canvas.Effect>
                    <!--  Dreieck 1: Links  -->
                    <Polygon x:Name="PLG_DreieckLinks" Points="10,10 0,20 0,0">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="0">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Dreieck 2: Oben  -->
                    <Polygon x:Name="PLG_DreieckOben" Points="10,10 0,0 20,0">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="1">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Dreieck 3: Rechts  -->
                    <Polygon x:Name="PLG_DreieckRechts" Points="10,10 20,0 20,20">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="2">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Dreieck 4: Unten  -->
                    <Polygon x:Name="PLG_DreieckUnten" Points="10,10 20,20 0,20">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="3">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Trennlinien  -->
                    <Line
                        Stroke="#40000000"
                        StrokeThickness="0.6"
                        X1="0"
                        X2="20"
                        Y1="0"
                        Y2="20" />
                    <Line
                        Stroke="#40000000"
                        StrokeThickness="0.6"
                        X1="20"
                        X2="0"
                        Y1="0"
                        Y2="20" />
                </Canvas>

                <!--  Links (Left)  -->
                <Border
                    Margin="2,2,25,2"
                    d:Background="Gold"
                    CornerRadius="4,0,0,4">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="1">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Oben (Top)  -->
                <Border
                    Margin="2,2,2,25"
                    d:Background="Gold"
                    CornerRadius="4,4,0,0">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="2">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Rechts (Right)  -->
                <Border
                    Margin="25,2,2,2"
                    d:Background="Gold"
                    CornerRadius="0,4,4,0">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="3">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Unten (Bottom)  -->
                <Border
                    Margin="2,25,2,2"
                    d:Background="Gold"
                    CornerRadius="0,0,4,4">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="4">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Position — Windrad-Dreiecke  -->

            </Grid>
        </Border>
    </Grid>
</UserControl>
