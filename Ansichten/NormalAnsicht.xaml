<UserControl
    x:Class="TestImage.Ansichten.NormalAnsicht"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Converters="clr-namespace:TestImage.Converters"
    xmlns:Converters1="clr-namespace:TestImageViewer.Converters"
    xmlns:bildersuche="clr-namespace:TestImage.Bildersuche"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:TestImage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svg1="clr-namespace:SVGImage.SVG;assembly=DotNetProjects.SVGImage"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="700"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--
            Entwurfsdaten für das Monatsband: 28 Monate über drei Jahre. Als Ressource,
            weil zwei ItemsControls dieselbe Reihe brauchen — die Jahreszeile oben und die
            Balken darunter. Zur Laufzeit ungenutzt, kostet nur ein paar kleine Objekte.
        -->
        <x:Array x:Key="ZeitBandBeispiel" Type="{x:Type bildersuche:ZeitBalken}">
            <bildersuche:ZeitBalken Hoehe="4" IstJahresAnfang="True" JahrText="2011" Tooltip="Jan 2011: 3 Bilder" />
            <bildersuche:ZeitBalken Hoehe="7" Tooltip="Feb 2011: 6 Bilder" />
            <bildersuche:ZeitBalken Hoehe="12" Tooltip="Mär 2011: 12 Bilder" />
            <bildersuche:ZeitBalken Hoehe="19" Tooltip="Apr 2011: 21 Bilder" />
            <bildersuche:ZeitBalken Hoehe="9" Tooltip="Mai 2011: 8 Bilder" />
            <bildersuche:ZeitBalken Hoehe="2" Tooltip="Jun 2011: keine Bilder" />
            <bildersuche:ZeitBalken Hoehe="2" Tooltip="Jul 2011: keine Bilder" />
            <bildersuche:ZeitBalken Hoehe="5" Tooltip="Aug 2011: 4 Bilder" />
            <bildersuche:ZeitBalken Hoehe="14" Tooltip="Sep 2011: 15 Bilder" />
            <bildersuche:ZeitBalken Hoehe="22" Tooltip="Okt 2011: 25 Bilder" />
            <bildersuche:ZeitBalken Hoehe="17" Tooltip="Nov 2011: 18 Bilder" />
            <bildersuche:ZeitBalken Hoehe="8" Tooltip="Dez 2011: 7 Bilder" />

            <bildersuche:ZeitBalken Hoehe="11" IstJahresAnfang="True" JahrText="2012" Tooltip="Jan 2012: 11 Bilder" />
            <bildersuche:ZeitBalken Hoehe="26" Tooltip="Feb 2012: 31 Bilder" />
            <bildersuche:ZeitBalken Hoehe="20" Tooltip="Mär 2012: 22 Bilder" />
            <bildersuche:ZeitBalken Hoehe="6" Tooltip="Apr 2012: 5 Bilder" />
            <bildersuche:ZeitBalken Hoehe="2" Tooltip="Mai 2012: keine Bilder" />
            <bildersuche:ZeitBalken Hoehe="3" Tooltip="Jun 2012: 2 Bilder" />
            <bildersuche:ZeitBalken Hoehe="13" Tooltip="Jul 2012: 13 Bilder" />
            <bildersuche:ZeitBalken Hoehe="18" Tooltip="Aug 2012: 19 Bilder" />
            <bildersuche:ZeitBalken Hoehe="24" Tooltip="Sep 2012: 28 Bilder" />
            <bildersuche:ZeitBalken Hoehe="16" Tooltip="Okt 2012: 17 Bilder" />
            <bildersuche:ZeitBalken Hoehe="10" Tooltip="Nov 2012: 9 Bilder" />
            <bildersuche:ZeitBalken Hoehe="4" Tooltip="Dez 2012: 3 Bilder" />

            <bildersuche:ZeitBalken Hoehe="15" IstJahresAnfang="True" JahrText="2013" Tooltip="Jan 2013: 16 Bilder" />
            <bildersuche:ZeitBalken Hoehe="21" Tooltip="Feb 2013: 24 Bilder" />
            <bildersuche:ZeitBalken Hoehe="9" Tooltip="Mär 2013: 8 Bilder" />
            <bildersuche:ZeitBalken Hoehe="5" Tooltip="Apr 2013: 4 Bilder" />
        </x:Array>
    </UserControl.Resources>

    <!--  Normalansicht (IsImageMaximiert = false). Inhalt wird etappenweise aus MainWindow hierher verschoben.  -->
    <Grid x:Name="GRD_NormalWurzel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="2"
            Height="90"
            Margin="45,0,45,160"
            VerticalAlignment="Bottom"
            Orientation="Vertical">
            <StackPanel Orientation="Horizontal">

                <!--  Erste Zeile: Position + Gesamt  -->
                <TextBlock Margin="0,0,0,2"><Run Text="Pos: " /><Run Text=" " /><Run Text="{Binding AufgabenView.CurrentPosition, Converter={StaticResource CLconverterProgressbarIntPlusEins}, Mode=OneWay}" /><Run Text=" " /><Run Text=" / " /><Run Text=" " /><Run Text="{Binding AufgabenView.Count, Mode=OneWay}" /><Run Text=" " /><Run Text="   (" /><Run Text=" " /><Run Text="{Binding CountBildchenFürLinks, Mode=OneWay}" /><Run Text=" " /><Run Text=" verschoben)" /></TextBlock>

                <!--  Zweite Zeile: Name  -->
                <TextBlock Margin="0,0,0,2"><Run Foreground="Gray" Text="  Name: " /><Run Text=" " /><Run Text="{Binding SelectedBildchen.BName, Converter={StaticResource ConverterFullPathToNameConverter}}" /></TextBlock>

                <!--  Dritte Zeile: weitere Metadaten  -->
                <TextBlock><Run Text="  " /><Run Text=" " /><Run Foreground="LightBlue" Text="{Binding Version}" /></TextBlock>

            </StackPanel>

            <ProgressBar
                Width="auto"
                Height="2"
                Maximum="{Binding AufgabenView.Count, Mode=OneWay}"
                Value="{Binding AufgabenView.CurrentPosition, Converter={StaticResource CLconverterProgressbarIntPlusEins}, Mode=OneWay}" />
            <ListBox
                x:Name="listBox"
                Height="70"
                local:HorizontalListBoxBehavior.CenterSelectedItem="True"
                IsSynchronizedWithCurrentItem="True"
                ItemsSource="{Binding AufgabenView}"
                ScrollViewer.HorizontalScrollBarVisibility="Visible"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectedBildchen}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:MeinBildchen}">
                        <StackPanel Width="auto" Orientation="Horizontal">
                            <TextBlock
                                Margin="2,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding BName}" />
                        </StackPanel>
                    </DataTemplate>

                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Blue" />
                                <Setter Property="Foreground" Value="Blue" />
                                <Setter Property="FontWeight" Value="DemiBold" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Background" Value="#FFE8E6E6" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3399FF" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                            </Trigger>

                            <DataTrigger Binding="{Binding BildFürLinks}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BildFürLinks}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>



                </ListBox.ItemContainerStyle>
            </ListBox>
        </StackPanel>
        <!--
            Übersicht: Bilder je Zeitraum. Die Einheit wechselt selbsttätig — zwölf
            Monate, solange alles in einem Jahr liegt, sonst Jahre. Liegt direkt über
            der Miniaturleiste und ist genauso breit.
        -->
        <Border
            x:Name="BRD_Zeitleiste"
            Grid.Row="2"
            Margin="108,0,10,135"
            Padding="6,3,6,4"
            d:ToolTip="1.136 Bilder · 11.2013 bis 02.2026"
            ToolTip="{Binding ZeitraumText}"
            VerticalAlignment="Bottom"
            Background="White"
            BorderBrush="#FFCBD5E1"
            BorderThickness="1"
            CornerRadius="6"
            d:Visibility="Visible"
            Visibility="{Binding ZeitleisteVorhanden, Converter={StaticResource CLconverterVisiblityBoolian}}">
            <StackPanel x:Name="STP_Zeitleiste" Orientation="Vertical">

                <!--  Grobe Leiste – nur eine der beiden Übersichten ist sichtbar  -->
                <Grid
                    x:Name="GRD_Zeitleiste"
                    d:Visibility="Collapsed"
                    Visibility="{Binding ZeitBandBevorzugt, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="COL_ZeitleisteEinheit" Width="Auto" />
                    <ColumnDefinition x:Name="COL_ZeitleisteFelder" Width="*" />
                </Grid.ColumnDefinitions>

                <!--
                    Die Einheit ist zugleich der Umschalter zwischen grober Leiste und
                    feinem Monatsband. Die Anwendung wählt beim Laden selbst — mehrere
                    Jahre sprechen für das Band —, aber die Wahl bleibt änderbar.
                -->
                <Button
                    x:Name="BTN_ZeitleisteUmschalten"
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding CommandExecuteZeitleisteUmschaltenCommand}"
                    Cursor="Hand"
                    ToolTip="Zwischen Jahres-/Monatsleiste und feinem Monatsband wechseln">
                    <TextBlock
                        x:Name="TXT_ZeitleisteEinheit"
                        d:Text="Monatsband"
                        FontFamily="Segoe UI"
                        FontSize="11"
                        Foreground="Gray"
                        Text="{Binding ZeitleisteEinheit}"
                        TextDecorations="Underline" />
                </Button>

                <ItemsControl
                    x:Name="IC_Zeitleiste"
                    Grid.Column="1"
                    ItemsSource="{Binding Zeitleiste}">
                    <d:ItemsControl.ItemsSource>
                        <x:Array Type="{x:Type bildersuche:ZeitAbschnitt}">
                            <bildersuche:ZeitAbschnitt
                                Anzahl="45"
                                Beschriftung="2018"
                                Deckkraft="0.13" />
                            <bildersuche:ZeitAbschnitt
                                Anzahl="120"
                                Beschriftung="2019"
                                Deckkraft="0.24" />
                            <bildersuche:ZeitAbschnitt
                                Anzahl="88"
                                Beschriftung="2020"
                                Deckkraft="0.19" />
                            <bildersuche:ZeitAbschnitt
                                Anzahl="200"
                                Beschriftung="2021"
                                Deckkraft="0.35" />
                            <bildersuche:ZeitAbschnitt
                                Anzahl="15"
                                Beschriftung="2022"
                                Deckkraft="0.08" />
                            <bildersuche:ZeitAbschnitt
                                Anzahl="301"
                                Beschriftung="2023"
                                Deckkraft="0.50" />
                        </x:Array>
                    </d:ItemsControl.ItemsSource>

                    <!--  Gleich breite Felder – funktioniert für zwölf Monate wie für n Jahre  -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="GRD_ZeitFeld" ToolTip="{Binding Tooltip}">
                                <!--
                                    Deckkraft kommt fertig aus dem ViewModel, damit hier kein
                                    Konverter nötig ist. Volle Deckkraft ist bewusst nicht
                                    vorgesehen — die Beschriftung muss lesbar bleiben.
                                -->
                                <Rectangle
                                    x:Name="RCT_ZeitFeldFuellung"
                                    Margin="1,0"
                                    Fill="#FF64748B"
                                    Opacity="{Binding Deckkraft}"
                                    RadiusX="3"
                                    RadiusY="3" />

                                <StackPanel x:Name="STP_ZeitFeld" Orientation="Vertical">
                                    <TextBlock
                                        x:Name="TXT_ZeitFeldName"
                                        HorizontalAlignment="Center"
                                        FontFamily="Segoe UI"
                                        FontSize="10"
                                        Foreground="Gray"
                                        Text="{Binding Beschriftung}" />
                                    <TextBlock
                                        x:Name="TXT_ZeitFeldAnzahl"
                                        HorizontalAlignment="Center"
                                        FontFamily="Segoe UI"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="#FF1F2937"
                                        Text="{Binding Anzahl}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Grid>

                <!--
                    Feines Band: ein Balken je Monat über den ganzen Zeitraum, die Jahre
                    als Abschnitte mit Trennstrich und Jahreszahl. Zeigt, wo innerhalb
                    eines Jahres die Bilder liegen — das kann die grobe Leiste darüber nicht.

                    Zwei ItemsControls über derselben Sammlung: So sitzt jede Jahreszahl
                    ohne Rechnerei genau über ihrem ersten Monat. Beschriftungen dürfen
                    dabei über die Nachbarzellen hinausragen; WPF-Panels schneiden nicht ab.
                -->
                <StackPanel
                    x:Name="STP_ZeitBand"
                    d:Visibility="Visible"
                    Orientation="Vertical"
                    Visibility="{Binding ZeitBandBevorzugt, Converter={StaticResource CLconverterVisiblityBoolian}}">

                    <ItemsControl
                        x:Name="IC_ZeitBandJahre"
                        d:ItemsSource="{StaticResource ZeitBandBeispiel}"
                        ItemsSource="{Binding ZeitBand}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--
                                    Die Beschriftung ragt bewusst über ihre Zelle hinaus –
                                    eine Monatszelle ist nur wenige Punkte breit. WPF-Panels
                                    schneiden nicht ab, ClipToBounds bleibt aus.
                                -->
                                <TextBlock
                                    x:Name="TXT_ZeitBandJahr"
                                    Margin="2,0,0,0"
                                    ClipToBounds="False"
                                    FontFamily="Segoe UI"
                                    FontSize="10"
                                    Foreground="#FF6B6B6B"
                                    Text="{Binding JahrText}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl
                        x:Name="IC_ZeitBand"
                        Height="20"
                        Margin="0,1,0,0"
                        d:ItemsSource="{StaticResource ZeitBandBeispiel}"
                        ItemsSource="{Binding ZeitBand}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="GRD_ZeitBandZelle" ToolTip="{Binding Tooltip}">
                                    <!--  Durchsichtiger Grund, damit die ganze Zelle den ToolTip auslöst  -->
                                    <Rectangle x:Name="RCT_ZeitBandFlaeche" Fill="Transparent" />

                                    <!--  Trennstrich am Jahreswechsel  -->
                                    <Rectangle
                                        x:Name="RCT_ZeitBandTrenner"
                                        Width="1"
                                        HorizontalAlignment="Left"
                                        Fill="#FFD0D0D0"
                                        Visibility="{Binding IstJahresAnfang, Converter={StaticResource CLconverterVisiblityBoolian}}" />

                                    <Rectangle
                                        x:Name="RCT_ZeitBandBalken"
                                        Margin="1,0"
                                        VerticalAlignment="Bottom"
                                        Fill="#FF3A9B45"
                                        Height="{Binding Hoehe}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </StackPanel>
        </Border>

        <ListBox
            x:Name="Listbox_MiniaturBilder"
            Grid.Row="2"
            Height="120"
            Margin="93,0,10,10"
            VerticalAlignment="Bottom"
            d:ItemsSource="{d:SampleData ItemCount=4}"
            local:HorizontalListBoxBehavior.CenterSelectedItem="True"
            local:HorizontalListBoxBehavior.EnableHorizontalMouseWheel="True"
            FocusVisualStyle="{x:Null}"
            IsSynchronizedWithCurrentItem="True"
            ItemsSource="{Binding AufgabenView}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectedItem="{Binding SelectedBildchen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling">

            <!--  Hintergrundfarbe per Style, damit DataTrigger greifen kann  -->
            <ListBox.Style>
                <Style TargetType="{x:Type ListBox}">
                    <Setter Property="Background" Value="{Binding SelectedBildchen.BildFürLinks, Converter={StaticResource CLconverterColorBoolianMasterHintergrund}, FallbackValue={x:Static Brushes.Transparent}, TargetNullValue={x:Static Brushes.Transparent}}" />
                    <Style.Triggers>
                        <!--  Alle Bilder verschoben → Rot  -->
                        <DataTrigger Binding="{Binding AlleBilderVerschoben}" Value="True">
                            <Setter Property="Background" Value="#FFE83030" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>

            <!--  Kontextmenü  -->
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding CommandExecuteDateiImExplorerÖffnenCommand}" Header="Explorer öffnen" />
                </ContextMenu>
            </ListBox.ContextMenu>

            <!--  EventTrigger  -->
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding CommandExecuteKleinesBildGrossesBildLadenCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>

            <!--  Horizontaler ItemsPanel  -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <!--  ItemTemplate: neutral (Farbe steuern wir im Container-Template)  -->
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:MeinBildchen}">
                    <Border
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                        <Grid>
                            <Image
                                Width="80"
                                Height="80"
                                Margin="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{Binding BName, Converter={StaticResource CLconverterStringZuKleinemImage}}"
                                Stretch="Uniform" />
                            <!--  Badge: Bild wurde verschoben  -->
                            <Border
                                Width="18"
                                Height="18"
                                Margin="0,4,4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#DDCC2222"
                                CornerRadius="9"
                                Visibility="{Binding BildFürLinks, Converter={StaticResource CLconverterVisiblityBoolian}}">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="4"
                                        Opacity="0.6"
                                        ShadowDepth="1"
                                        Color="Black" />
                                </Border.Effect>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="9"
                                    Foreground="White"
                                    Text="&#xE10B;" />
                            </Border>
                            <!--  Badge: Wasserzeichen oder Metadaten-Markierung gefunden  -->
                            <Border
                                x:Name="BRD_WasserzeichenBadge"
                                Width="18"
                                Height="18"
                                Margin="4,4,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#DDD97706"
                                CornerRadius="9"
                                ToolTip="{Binding WasserzeichenGrund}"
                                Visibility="{Binding HatWasserzeichen, Converter={StaticResource CLconverterVisiblityBoolian}}">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="4"
                                        Opacity="0.6"
                                        ShadowDepth="1"
                                        Color="Black" />
                                </Border.Effect>
                                <TextBlock
                                    x:Name="IC_WasserzeichenBadge"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="9"
                                    Foreground="White"
                                    Text="&#xE72E;" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <!--  ContainerStyle: eigenes Template (kein Windows/Accent-Overlay)  -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <!--  Fokusrahmen aus  -->
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Setter Property="OverridesDefaultStyle" Value="True" />

                    <!--  Ausrichtung von der ListBox übernehmen  -->
                    <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
                    <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />

                    <!--  Basis-Rand  -->
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Padding" Value="2" />

                    <!--  Eigenes ControlTemplate  -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <!--  Default-Hintergrund JE ITEM = Converter (nur im Normalzustand sichtbar)  -->
                                <Border
                                    x:Name="Bd"
                                    Background="{Binding BildFürLinks, Converter={StaticResource CLconverterColorBoolianMasterHintergrund}, FallbackValue={x:Static Brushes.Transparent}, TargetNullValue={x:Static Brushes.Transparent}}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                    <ContentPresenter
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>

                                <ControlTemplate.Triggers>
                                    <!--  SELECTED: überschreibt Converter-Farbe  -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FF007ACC" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="DarkBlue" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect
                                                    BlurRadius="14"
                                                    Opacity="0.7"
                                                    ShadowDepth="0"
                                                    Color="#66005FB8" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>

                                    <!--  MOUSEOVER nur wenn NICHT selected: überschreibt Converter-Farbe  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True" />
                                            <Condition Property="IsSelected" Value="False" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Background" Value="#FFBAFF6A" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7A9E39" />
                                        <Setter Property="Foreground" Value="Black" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

        </ListBox>
        <Border
            x:Name="BRD_NachObenVerschieben"
            Grid.Row="2"
            Width="78"
            Height="auto"
            Margin="10,0,0,10"
            Padding="2,2,2,2"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderThickness="2,2,2,2"
            CornerRadius="2,2,2,2"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <StackPanel
                Width="70"
                Height="auto"
                Orientation="Vertical">
                <Image
                    x:Name="image_Kopieren"
                    Width="70"
                    Height="70"
                    Source="{Binding SelectedBildchen.BName, Converter={StaticResource CLconverterStringZuKleinemImage}}"
                    Visibility="{Binding IsEnabled, Converter={StaticResource CLconverterVisiblityBoolian}, ElementName=RDBTN_BildNachOben}" />
                <!--  MouseOverBackground="#FFB7F393"  -->
                <RibbonButton
                    x:Name="RDBTN_BildNachOben"
                    Height="70"
                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteBildInsHauptVerzeichnisZuruckVerschiebenCommand, Mode=OneWay}"
                    Content="Button"
                    Label="In die Liste"
                    LargeImageSource="/Images/PfeilNachOben.png"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE">

                    <RibbonButton.MouseOverBackground>

                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">

                            <!--  Ziel: oben = klar gut, dominant  -->
                            <GradientStop Offset="0.0" Color="#FF8FE88F" />
                            <!--  sattes, positives Grün  -->
                            <GradientStop Offset="0.35" Color="#FFBFF0BF" />
                            <!--  weiches Übergangsgrün  -->

                            <!--  Übergang  -->
                            <GradientStop Offset="0.6" Color="#FFF6D880" />
                            <!--  Amber  -->

                            <!--  Abstieg: Problemzone unten, kompakt  -->
                            <GradientStop Offset="0.82" Color="#FFF0A070" />
                            <!--  warmes Orange  -->
                            <GradientStop Offset="1.0" Color="#FFD96666" />
                            <!--  gedämpftes Rot  -->

                        </LinearGradientBrush>

                    </RibbonButton.MouseOverBackground>

                </RibbonButton>
            </StackPanel>
        </Border>
        <!--  Bild-Container der NORMALANSICHT (Vollbild läuft über Ansichten:VollbildAnsicht)  -->
        <Border
            x:Name="ViewedPhotoArea"
            Grid.Row="1"
            BorderBrush="#22000000"
            BorderThickness="0"
            ClipToBounds="True"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Margin" Value="45,5,45,10" />
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="Background" Value="{Binding SelectedBildchen.BildFürLinks, Converter={StaticResource CLconverterColorBoolianMasterHintergrund}}" />
                    <Style.Triggers>
                        <!--  Alle Bilder verschoben → Rot  -->
                        <DataTrigger Binding="{Binding AlleBilderVerschoben}" Value="True">
                            <Setter Property="Background" Value="#FFE83030" />
                        </DataTrigger>
                        <!--  Bildmodus: Margins weg, volle Fläche, dunkler Hintergrund  -->
                        <DataTrigger Binding="{Binding IsImageMaximiert}" Value="True">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Grid.RowSpan" Value="3" />
                            <Setter Property="Grid.Row" Value="0" />
                            <Setter Property="Background" Value="#FF111111" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!--  Image Display + Hover-Zone unten (blendet Miniaturleiste ein)  -->
            <Grid>
                <ScrollViewer
                    x:Name="scdd"
                    local:FileDragDropHelper.IsFileDragDropEnabled="True"
                    AllowDrop="True"
                    DragEnter="scdd_DragEnter"
                    DragLeave="scdd_DragLeave"
                    Drop="scdd_Drop"
                    HorizontalScrollBarVisibility="{Binding MyHorizontalScrollBarVisibility}"
                    PreviewMouseWheel="Scdd_PreviewMouseWheel"
                    VerticalScrollBarVisibility="{Binding MyHorizontalScrollBarVisibility}">

                    <!--
                        Einzelbild direkt im ScrollViewer: meldet bei Stretch=None seine
                        Pixelgröße -> beide Bildlaufleisten funktionieren korrekt.
                    -->
                    <Image
                        x:Name="imgCurrent"
                        Margin="4,4,4,4"
                        IsManipulationEnabled="True"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        RenderOptions.EdgeMode="Aliased"
                        SizeChanged="imgCurrent_SizeChanged"
                        Source="{Binding AnzeigeBild}"
                        Stretch="{Binding ImageStretch}"
                        UseLayoutRounding="False">
                        <Image.RenderTransform>
                            <TranslateTransform x:Name="imgShakeTransform" />
                        </Image.RenderTransform>

                        <Image.Effect>
                            <DropShadowEffect
                                BlurRadius="20"
                                Opacity="0.8"
                                ShadowDepth="0"
                                Color="Black" />
                        </Image.Effect>
                    </Image>

                </ScrollViewer>

                <!--  Vollbild-Elemente (Klickzonen, Filmstrip, Hover-Zone) → Ansichten/VollbildAnsicht.xaml  -->


                <!--  Drop-Overlay: sichtbar wenn Datei über das Bild gezogen wird  -->
                <Border
                    x:Name="BRD_DropOverlay"
                    Panel.ZIndex="300"
                    Background="#CC111111"
                    BorderBrush="#88FFFFFF"
                    BorderThickness="2"
                    CornerRadius="8"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="48"
                            Foreground="#CCFFFFFF"
                            Text="&#xE896;" />
                        <TextBlock
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#EEFFFFFF"
                            Text="Bild hier ablegen" />
                        <TextBlock
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#88FFFFFF"
                            Text="Alle Bilder im selben Ordner werden geladen" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <!--<RibbonButton
            x:Name="RDBTN_BildNachRechts"
            Grid.Row="1"
            Width="48"
            Height="155"
            Margin="0,0,10,167"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding CommandExecuteBildNachRechtsCommand}"
            Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
            Label="Weiter"
            LargeImageSource="/Images/PfeilNachRechts.png"
            MouseOverBackground="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
            MouseOverBorderBrush="Transparent"
            PressedBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />-->


        <!--
            Konturansicht: Kantenbild statt Originalbild im grossen Bild, Schwelle am
            Regler. Rechts oben, weil links die Werkzeugleiste und unten die Statusleisten
            sitzen; darunter beginnt erst bei 137 px die rechte Klickfläche zum Blättern.
        -->
        <Border
            x:Name="BRD_KonturKarte"
            Grid.Row="1"
            Margin="0,10,93,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            d:Padding="12,10,12,12"
            Background="White"
            BorderBrush="#FFCBD5E1"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">

            <!--
                Ruhezustand: nur der Symbolknopf, damit die Karte möglichst wenig vom
                Bild verdeckt. Erst beim Einschalten kommen Regler und Kästchen dazu –
                Breite und Innenmass wachsen dann mit. Keine feste Breite, sonst wäre
                die Karte auch im Ruhezustand so breit wie aufgeklappt.
            -->
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Padding" Value="5" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ZeigeKontur}" Value="True">
                            <Setter Property="Padding" Value="12,10,12,12" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel x:Name="STP_KonturKarte" Orientation="Vertical">

                <ToggleButton
                    x:Name="TGL_KonturAnzeigen"
                    Height="26"
                    Padding="6,0"
                    Cursor="Hand"
                    FontSize="12"
                    FontWeight="SemiBold"
                    IsChecked="{Binding ZeigeKontur, Mode=TwoWay}"
                    SnapsToDevicePixels="True"
                    ToolTip="Statt des Bildes sein Kantenbild anzeigen (Sobel). Macht auch schwache Aufdrucke sichtbar.">
                    <StackPanel x:Name="STP_KonturSchalter" Orientation="Horizontal">
                        <TextBlock
                            x:Name="IC_KonturSchalter"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Text="&#xE9A9;" />

                        <!--  Beschriftung erst im aufgeklappten Zustand – spart im Ruhezustand die halbe Breite  -->
                        <TextBlock
                            x:Name="TXT_KonturSchalter"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            d:Visibility="Visible"
                            Text="Kontur"
                            Visibility="{Binding ZeigeKontur, Converter={StaticResource CLconverterVisiblityBoolian}}" />
                    </StackPanel>
                </ToggleButton>

                <!--  Reglerbereich nur zeigen, wenn die Kontur auch an ist  -->
                <StackPanel
                    x:Name="STP_KonturEinstellungen"
                    Width="188"
                    Margin="0,10,0,0"
                    d:Visibility="Visible"
                    Orientation="Vertical"
                    Visibility="{Binding ZeigeKontur, Converter={StaticResource CLconverterVisiblityBoolian}}">

                    <Grid x:Name="GRD_KonturSchwelleKopf">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="COL_KonturSchwelleLabel" Width="*" />
                            <ColumnDefinition x:Name="COL_KonturSchwelleWert" Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="TXT_KonturSchwelleLabel"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="Gray"
                            Text="Schwelle" />

                        <TextBlock
                            x:Name="TXT_KonturSchwelleWert"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FF1F2937"
                            Text="{Binding KonturSchwelle, StringFormat=\{0:F0\}}" />
                    </Grid>

                    <Slider
                        x:Name="SLD_KonturSchwelle"
                        Margin="0,2,0,0"
                        IsSnapToTickEnabled="True"
                        Maximum="255"
                        Minimum="0"
                        TickFrequency="1"
                        ToolTip="Niedrig = viele Kanten, hoch = nur kräftige Kanten. Vorgabe 90."
                        Value="{Binding KonturSchwelle, Mode=TwoWay}" />

                    <CheckBox
                        x:Name="CHK_KonturWeichzeichnen"
                        Margin="0,6,0,0"
                        VerticalContentAlignment="Center"
                        Content="Weichzeichnen"
                        FontSize="11"
                        Foreground="#FF555555"
                        IsChecked="{Binding KonturWeichzeichnen, Mode=TwoWay}"
                        ToolTip="Vorher glätten – weniger Rauschkanten, dafür weichere Konturen." />

                    <!--  Anzeige, dass gerechnet wird; bei grossen Bildern dauert es kurz  -->
                    <ProgressBar
                        x:Name="PGB_KonturLäuft"
                        Height="3"
                        Margin="0,8,0,0"
                        d:Visibility="Visible"
                        IsIndeterminate="True"
                        Visibility="{Binding KonturLäuft, Converter={StaticResource CLconverterVisiblityBoolian}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid
            Grid.Row="1"
            Width="54"
            Margin="0,137,10,167"
            HorizontalAlignment="Right"
            Background="Transparent"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">

            <!--  Klickfläche  -->
            <RibbonButton
                x:Name="RDBTN_BildNachRechts"
                Grid.Row="1"
                Margin="1,1,1,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                Command="{Binding CommandExecuteBildNachRechtsCommand, Mode=OneWay}"
                CornerRadius="8,8,8,8"
                KeyTip="→"
                MouseOverBackground="#FFB7F393"
                MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                PressedBackground="#FFCACFFE"
                ToolTip="Nächstes Bild (→)"
                ToolTipService.InitialShowDelay="20000" />

            <!--  Sichtbares Icon  -->
            <Image
                Width="38"
                Height="38"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Source="/Images/PfeilNachRechts.png">

                <Image.Style>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Opacity" Value="1" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=RDBTN_BildNachRechts}" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>

            </Image>
        </Grid>


        <Border
            Grid.Row="1"
            Width="78"
            Height="122"
            Margin="0,10,10,0"
            Padding="2,2,2,2"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderThickness="2,2,2,2"
            CornerRadius="2,2,2,2"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">

            <StackPanel
                Width="70"
                Height="auto"
                Orientation="Vertical">
                <RibbonButton
                    x:Name="BTN_VerschieberRückgängigMachen"
                    Width="40"
                    Height="40"
                    Margin="0,0,0,4"
                    Background="{Binding IsEnabled, Converter={StaticResource CLconverterBrushesBoolian}, RelativeSource={RelativeSource Mode=Self}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    Command="{Binding CommandExecuteVerschiebenZurückCommand, Mode=OneWay}"
                    Foreground="Red"
                    Label="X"
                    LargeImageSource="/Images/Rueckwerts.png"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="#FF49AF0C"
                    PressedBackground="#FFCACFFE" />

                <Image
                    x:Name="image"
                    Width="70"
                    Height="70"
                    Source="{Binding BildchenVorher, Converter={StaticResource CLconverterStringZuKleinemImage}}" />
            </StackPanel>
        </Border>
        <Border
            x:Name="BRD_NachUntenVerschieben"
            Grid.Row="1"
            Width="78"
            Height="auto"
            MaxHeight="156"
            Margin="0,0,10,10"
            Padding="2,2,2,2"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            d:MaxHeight="200"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderThickness="2,2,2,2"
            CornerRadius="2,2,2,2"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <StackPanel
                Width="70"
                Height="auto"
                Orientation="Vertical">
                <Image
                    x:Name="image_Kopieren1"
                    Width="70"
                    Height="auto"
                    MaxHeight="70"
                    Margin="0,0,0,4"
                    Source="{Binding SelectedBildchen.BName, Converter={StaticResource CLconverterStringZuKleinemImage}}"
                    Visibility="{Binding IsEnabled, Converter={StaticResource CLconverterVisiblityBoolian}, ElementName=RDBTN_BildEKeinFav}" />
                <!--  Abbrechen Bilder Verschieben  -->


                <!--  MouseOverBackground="#FFB7F393"  -->
                <RibbonButton
                    x:Name="RDBTN_BildEKeinFav"
                    Width="70"
                    Height="70"
                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteBildInsKeinFavVerzeichnisVerschiebenCommand, Mode=OneWay}"
                    FontFamily="Segoe UI Symbol"
                    KeyTip="&#xE019;"
                    Label="Kein Fav"
                    LargeImageSource="/Images/PfeilNachUnten.png"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE">
                    <RibbonButton.MouseOverBackground>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">

                            <!--  verblasstes Grün: war mal wichtig  -->
                            <GradientStop Offset="0.0" Color="#FFB8F5B8" />

                            <!--  Übergang: staubiges Gelb / Amber  -->
                            <GradientStop Offset="0.45" Color="#FFF5D87A" />

                            <!--  Entscheidung kippt  -->
                            <GradientStop Offset="0.75" Color="#FFF0A35E" />

                            <!--  Ziel: unten = schlecht / ablegen  -->
                            <GradientStop Offset="1.0" Color="#FFE57373" />
                        </LinearGradientBrush>
                    </RibbonButton.MouseOverBackground>
                    <RibbonButton.ContextMenu>
                        <ContextMenu>
                            <MenuItem
                                Command="{Binding CommandExecuteAlleBilderInsKeinFavVerschiebenCommand, Mode=OneWay}"
                                Header="Alle Verschieben"
                                ToolTip="Dateien werden kopiert, dann gelöscht, Ab und zu Fehler beim Löschen der Datei" />
                            <!--<MenuItem Header="Aktion 2" />
                            <Separator/>
                            <MenuItem Header="Einstellungen" />-->

                            <MenuItem
                                Command="{Binding CommandExecuteBildInsKIFehlerVerschiebenCommand, Mode=OneWay}"
                                Header="Ins KI Fehler Verzeichnis Verschieben"
                                ToolTip="Selectierte Datei wird ins 'KI Fehler Verzeichnis' verschoben">
                                <MenuItem.Icon>
                                    <Image
                                        Width="20"
                                        Height="20"
                                        Source="/Images/KIFehler.png"
                                        Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>

                            <!--  Gegenstück zur Tastenkombination Shift+↓  -->
                            <MenuItem
                                x:Name="MNI_InsBesondersVerschieben"
                                Command="{Binding CommandExecuteBildInsBesondersVerschiebenCommand, Mode=OneWay}"
                                Header="Ins Besonders Verzeichnis Verschieben"
                                InputGestureText="Shift+↓"
                                ToolTip="Selectierte Datei wird ins 'Besonders' Verzeichnis verschoben">
                                <MenuItem.Icon>
                                    <TextBlock
                                        x:Name="IC_BesondersMenue"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="15"
                                        Foreground="#FFD9A404"
                                        Text="&#xE735;" />
                                </MenuItem.Icon>
                            </MenuItem>

                        </ContextMenu>
                    </RibbonButton.ContextMenu>
                </RibbonButton>

                <!--  Visibility="{Binding CommandExecuteAlleBilderInsKeinFavVerschiebenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}" />  -->
                <RibbonButton
                    x:Name="RBTN_AbbrechenNixFavVerschieben"
                    Width="40"
                    Height="40"
                    Margin="4,4,4,0"
                    d:Visibility="Visible"
                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteAlleBilderInsKeinFavVerschiebenCancelCommand, Mode=OneWay}"
                    Foreground="Red"
                    LargeImageSource="/Images/Abbrechen.png"
                    MouseOverBackground="#FFB7F393"
                    PressedBackground="#FFCACFFE"
                    Visibility="{Binding CommandExecuteAlleBilderInsKeinFavVerschiebenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}" />
                <ProgressBar
                    Width="60"
                    Height="10"
                    Margin="4,4,4,0"
                    d:Visibility="Visible"
                    Visibility="{Binding CommandExecuteAlleBilderInsKeinFavVerschiebenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}"
                    Value="{Binding PercentageValueVerschieben}" />
            </StackPanel>
        </Border>

        <!--  Background="{Binding SelectedBildchen.BildFürLinks, Converter={StaticResource CLconverterColorBoolianMasterHintergrund}}"  -->


        <Grid
            Grid.Row="1"
            Width="54"
            Margin="10,172,0,139"
            HorizontalAlignment="Left"
            Background="Transparent"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">

            <RibbonButton
                x:Name="RDBTN_BildNachLinks"
                Height="auto"
                Margin="1,1,1,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                Command="{Binding CommandExecuteBildLinksCommand, Mode=OneWay}"
                Content="Button"
                CornerRadius="8"
                KeyTip="-"
                MouseOverBackground="#FFB7F393"
                MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                PressedBackground="#FFCACFFE" />

            <!--  Sichtbares Icon  -->
            <Image
                Width="38"
                Height="38"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Source="{StaticResource ResourceKey=di_Ebene_1}">

                <Image.Style>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Opacity" Value="1" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=RDBTN_BildNachLinks}" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </Grid>
        <StackPanel
            Grid.Row="0"
            Height="26"
            MinWidth="24"
            Margin="0,0,10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">


            <TextBlock
                Margin="0,0,7,0"
                VerticalAlignment="Center"
                Background="#FFDCDADA"
                Text="{Binding SelectedBildchen.BName, Converter={StaticResource CLconverterStringZuMB}}" />


            <TextBlock
                x:Name="txtScale"
                Margin="0,0,7,0"
                VerticalAlignment="Center"
                Background="#FFDCDADA"
                Text="12" />
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Background="#FFDCDADA"><Run Text="{Binding OriginalImageWidth, Mode=OneWay, StringFormat=' \{0:D\}'}" /><Run Text=" x " /><Run Text="{Binding OriginalImageHeight, Mode=OneWay, StringFormat=' \{0:D\} '}" /></TextBlock>


            <TextBox
                x:Name="TXB_SuchenInFertige"
                Width="70"
                Height="26"
                Margin="2,0,2,0"
                VerticalContentAlignment="Center"
                BorderBrush="#FF9AB0F3"
                FontSize="14"
                Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="NoWrap">
                <TextBox.Style>
                    <Style TargetType="{x:Type TextBox}">
                        <Setter Property="Background" Value="LightGreen" />
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background" Value="{StaticResource WasserzeichenFilter}" />
                            </Trigger>
                        </Style.Triggers>


                    </Style>
                </TextBox.Style>
            </TextBox>
            <RibbonButton
                x:Name="BTN_AbbrechenKonsistenz"
                Width="22"
                Height="20"
                Margin="2,0,2,0"
                d:Visibility="Visible"
                Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                Command="{Binding CommandExecuteFilterLeerenCommandCommand, Mode=OneWay}"
                Foreground="Red"
                Label="X"
                MouseOverBackground="#FFB7F393"
                PressedBackground="#FFCACFFE"
                SmallImageSource="/Images/Abbrechen.png"
                Visibility="{Binding IsEnabled, Converter={StaticResource CLconverterVisiblityBoolian}, ElementName=BTN_AbbrechenKonsistenz}" />
            <TextBlock
                x:Name="textBlock1"
                Width="auto"
                Height="auto"
                Margin="2,0,4,0"
                VerticalAlignment="Center"
                Background="#FFF0F0F0"
                Text="{Binding InnerZählerCount, StringFormat=' IC  \{0:D\} '}"
                TextWrapping="NoWrap"
                d:LayoutOverrides="Height" />

        </StackPanel>
        <!--  Schaltet die Prüfungen ein, deren Ergebnis STP_PrüfAmpel darunter anzeigt  -->
        <CheckBox
            x:Name="CHK_BildPrüfen"
            Grid.Row="1"
            Width="58"
            Height="16"
            Margin="10,10,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="Prüfen"
            IsChecked="{Binding SollBildGeprüftWerden}"
            ToolTip="Bilder beim Anzeigen auf Schäden prüfen – Ergebnis in der Ampel darunter"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}" />
        <!--
            Prüf-Ampel: sechs Felder zum Bildzustand, je Feld eine Prüfung aus dem
            ViewModel. Grün = in Ordnung, Rot = auffällig, Grau = noch nicht geprüft
            (der Zustand bei null). Darunter der Fortschritt des Bildladens.
        -->
        <StackPanel
            x:Name="STP_PrüfAmpel"
            Grid.Row="1"
            Width="52"
            Height="126"
            Margin="10,31,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Orientation="Vertical"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <Border
                x:Name="BRD_PrüfAmpel"
                Height="auto"
                Padding="2,2,2,2"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderThickness="2,2,2,2"
                CornerRadius="2,2,2,2">

                <StackPanel
                    x:Name="STP_PrüfAmpelInhalt"
                    Width="auto"
                    Height="auto"
                    Orientation="Vertical">
                    <StackPanel x:Name="STP_PrüfZeile1" Orientation="Horizontal">
                        <Border
                            x:Name="BRD_AmpelDateiBeschädigt"
                            Width="20"
                            Height="20"
                            Margin="1,1,1,1"
                            Padding="2,2,2,2"
                            d:Background="GreenYellow"
                            Background="{Binding IsBildDateiBeschädigt, Converter={StaticResource CLconverterBrushesBoolianG1}}"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                            BorderThickness="2"
                            ToolTip="Datei beschädigt (IsBildDateiBeschädigt)" />
                        <Border
                            x:Name="BRD_AmpelHeaderPasst"
                            Width="20"
                            Height="20"
                            Margin="1,1,1,1"
                            Padding="2,2,2,2"
                            d:Background="GreenYellow"
                            Background="{Binding IsHeaderPassendZurErweiterung, Converter={StaticResource CLconverterBrushesBoolianG2}}"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                            BorderThickness="2"
                            ToolTip="Dateikopf passt zur Endung (IsHeaderPassendZurErweiterung)" />
                    </StackPanel>
                    <StackPanel x:Name="STP_PrüfZeile2" Orientation="Horizontal">
                        <Border
                            x:Name="BRD_AmpelFrameImBild"
                            Width="20"
                            Height="20"
                            Margin="1,1,1,1"
                            Padding="2,2,2,2"
                            d:Background="GreenYellow"
                            Background="{Binding IsFrameImBildDrin, Converter={StaticResource CLconverterBrushesBoolianG2}}"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                            BorderThickness="2"
                            ToolTip="Rahmen im Bild erkannt (IsFrameImBildDrin)" />
                        <Border
                            x:Name="BRD_AmpelDownloadDefekt"
                            Width="20"
                            Height="20"
                            Margin="1,1,1,1"
                            Padding="2,2,2,2"
                            d:Background="GreenYellow"
                            Background="{Binding IsBildDownloadCorrupted, Converter={StaticResource CLconverterBrushesBoolianG1}}"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                            BorderThickness="2"
                            ToolTip="Download unvollständig (IsBildDownloadCorrupted)" />
                    </StackPanel>

                    <StackPanel x:Name="STP_PrüfZeile3" Orientation="Horizontal">
                        <Border
                            x:Name="BRD_AmpelNullDatei"
                            Width="20"
                            Height="20"
                            Margin="1,1,1,1"
                            Padding="2,2,2,2"
                            d:Background="GreenYellow"
                            Background="{Binding IsBildNullDatei, Converter={StaticResource CLconverterBrushesBoolianG5}}"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                            BorderThickness="2"
                            ToolTip="Datei ist 0 Byte gross (IsBildNullDatei)" />

                        <!--  Kein Ja/Nein-Zustand: zeigt nur das erkannte Format im ToolTip  -->
                        <Border
                            x:Name="BRD_AmpelFormat"
                            Width="20"
                            Height="20"
                            Margin="1,1,1,1"
                            Padding="2,2,2,2"
                            d:Background="Gainsboro"
                            Background="Transparent"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                            BorderThickness="2"
                            d:ToolTip="jpeg"
                            ToolTip="{Binding ErkanntesFormat}" />
                    </StackPanel>
                    <ProgressBar
                        x:Name="PGB_BildLadenStufen"
                        Width="40"
                        Height="10"
                        d:Value="4"
                        d:Visibility="Visible"
                        Maximum="6"
                        Visibility="{Binding CommandExecuteKleinesBildGrossesBildLadenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}"
                        Value="{Binding ProgressValue, Mode=OneWay}" />



                </StackPanel>
            </Border>
            <!--  Ladestufen: kleines Vorschaubild, grosses Bild, Kantenbild – ToolTip zeigt je die Zeit  -->
            <StackPanel x:Name="STP_Ladestufen" Orientation="Horizontal">
                <Border
                    x:Name="BRD_GrossesBild"
                    Width="28"
                    Height="20"
                    Margin="1,1,1,1"
                    Background="#66F4EAEA"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    BorderThickness="2"
                    ToolTip="{Binding SWgrossesBild}">
                    <Image
                        x:Name="IMG_GrosseVorschau"
                        Width="24"
                        Height="16"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{Binding DisplayImage}"
                        Stretch="Uniform" />
                </Border>

                <!--  Drittes Kästchen wie die beiden davor, nur eben das Kantenbild  -->
                <Border
                    x:Name="BRD_KonturBild"
                    Width="28"
                    Height="20"
                    Margin="1,1,1,1"
                    Background="#66F4EAEA"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    BorderThickness="2"
                    ToolTip="{Binding SWkonturBild}"
                    Visibility="{Binding ZeigeKontur, Converter={StaticResource CLconverterVisiblityBoolian}}">
                    <Image
                        x:Name="IMG_KonturVorschau"
                        Width="24"
                        Height="16"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{Binding KonturImage}"
                        Stretch="Uniform" />
                </Border>
            </StackPanel>
            <RibbonButton
                x:Name="RDBTN_BildOriginalgrösse"
                Width="36"
                Height="28"
                Margin="0,2,0,0"
                HorizontalAlignment="Left"
                Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                Command="{Binding CommandExecuteBildStretchAnpassenCommand, Mode=OneWay}"
                MouseOverBackground="#FFB7F393"
                MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                PressedBackground="#FFCACFFE"
                SmallImageSource="/Images/Scallieren.png" />

        </StackPanel>
        <!--
            Farbsignatur des Bildes: bandweise Mittelwerte von oben nach unten. Der
            Verlauf kommt fertig aus dem ViewModel (BildFarbsignatur), berechnet auf dem
            100-px-Vorschaubild. Ohne Bild bleibt die Fläche leer, der Rahmen zeigt den
            Streifen trotzdem an.
        -->
        <Rectangle
            x:Name="LLL"
            Grid.Row="1"
            Width="10"
            Height="72"
            Margin="25,0,0,62"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Fill="{Binding BildFarbsignatur}"
            Stroke="Black"
            ToolTip="Farbsignatur: Durchschnittsfarbe des Bildes, von oben nach unten in Bändern"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <d:Rectangle.Fill>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#FFE7F926" />
                    <GradientStop Offset="0.083" Color="#FFF18CD5" />
                    <GradientStop Offset="0.923" Color="#FFF694DB" />
                    <GradientStop Offset="0.953" Color="#FFF44EC8" />
                    <GradientStop Offset="0.993" Color="#FFF4EA4E" />
                </LinearGradientBrush>
            </d:Rectangle.Fill>
        </Rectangle>
        <Border
            Grid.Row="1"
            Width="auto"
            Height="28"
            Margin="10,0,0,10"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
            BorderThickness="1,1,1,1"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <StackPanel Orientation="Horizontal">
                <CheckBox
                    x:Name="CHBX_MultiGleichheit"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="Multi"
                    IsChecked="{Binding MultiByteParallelGleichheit, Mode=TwoWay}"
                    ToolTip="Multi Thriding, lohnt sich bei einer schnellen Festplatte, sonnst nicht" />
                <!--  SmallImageSource="/Images/Gleich.png"  -->


                <!--  d:Source="images/gleich.png"  -->


                <!--  d:SmallImageSource="/Images/UngefährGleichKlein.png"  -->


                <!--  SmallImageSource="{svg1:SvgIcon Source=Images/EinGleicher.svg} "  -->
                <RibbonButton
                    x:Name="RDBTN_BildGleicheByteBildFinden"
                    Width="30"
                    Height="22"
                    Margin="8,2,2,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    d:SmallImageSource="/Images/EinGleicherKlein.png"
                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteSuchenGleichesBildByteVergleichCommand, Mode=OneWay}"
                    Content="Byte-Abgleich"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE"
                    SmallImageSource="{svg1:SvgIcon Source=/Images/EinGleicher.svg}"
                    ToolTip="Byte-Abgleich, gleiches Bild">
                    <RibbonButton.ContextMenu>
                        <ContextMenu>
                            <MenuItem
                                Command="{Binding CommandExecuteAlleBilderMiteinanderAufByteGleichheitPrüfenCommand, Mode=OneWay}"
                                Header="Byte-Vergleich aller Bilder"
                                ToolTip="Byte-Abgleich: Jedes Bild mit jedem Bild vergleichen">
                                <MenuItem.Icon>
                                    <Image
                                        Width="16"
                                        Height="16"
                                        d:Source="/Images/VieleGleicheKlein.png"
                                        Source="{svg1:SvgIcon Source=/Images/vielegleiche.svg}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <!--  Icon="{svg1:SvgIcon Source=Images/EinGleicher.svg}" d:Icon="/Images/Gleich.png"  -->
                            <MenuItem
                                Command="{Binding CommandExecuteAlleBilderSHA256AbgleichPrüfenCommand, Mode=OneWay}"
                                Header="Alle SHA256 Vergleich nacheinander"
                                ToolTip="Den SHA256 Wert Jedes Bildes mit jedem Bild Abgleichen, nur 1x berechnet">
                                <MenuItem.Icon>
                                    <Image
                                        Width="16"
                                        Height="16"
                                        d:Source="/Images/VieleGleicheKlein.png"
                                        Source="{svg1:SvgIcon Source=/Images/vielegleiche.svg}" />
                                </MenuItem.Icon>
                            </MenuItem>



                        </ContextMenu>

                    </RibbonButton.ContextMenu>

                </RibbonButton>
                <RibbonButton
                    Width="22"
                    Height="22"
                    d:Visibility="Visible"
                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteSuchenGleichesBildByteVergleichCancelCommand, Mode=OneWay}"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE"
                    SmallImageSource="/Images/Abbrechenn.png"
                    ToolTip="Byte Abgleich, Abbrechen"
                    Visibility="{Binding CommandExecuteSuchenGleichesBildByteVergleichCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}" />
                <RibbonButton
                    Width="22"
                    Height="22"
                    Margin="2,0,0,0"
                    d:Visibility="Visible"
                    Background="#FFF7E9E9"
                    BorderBrush="#FFFC4747"
                    Command="{Binding CommandExecuteAlleBilderMiteinanderAufByteGleichheitPrüfenCancelCommand, Mode=OneWay}"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="#FF49AF0C"
                    PressedBackground="#FFCACFFE"
                    SmallImageSource="/Images/Abbrechen.png"
                    ToolTip="Byte-Abgleich (alle) Abbrechen"
                    Visibility="{Binding CommandExecuteAlleBilderMiteinanderAufByteGleichheitPrüfenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}" />

                <RibbonButton
                    x:Name="RDBTN_AbbrechenSHA256AlleFinden"
                    Width="22"
                    Height="22"
                    d:Visibility="Visible"
                    Background="#FFF7E9E9"
                    BorderBrush="#FFFC4747"
                    Command="{Binding CommandExecuteAlleBilderSHA256AbgleichPrüfenCancelCommand, Mode=OneWay}"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="#FF49AF0C"
                    PressedBackground="#FFCACFFE"
                    SmallImageSource="/Images/Abbrechen.png"
                    ToolTip="Alle SHA256 Abgleich, Abbrechen"
                    Visibility="{Binding CommandExecuteAlleBilderSHA256AbgleichPrüfenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}" />


                <!--  Vertical Separator  -->
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                <!--  SmallImageSource="{svg1:SvgIcon Source=Images/UngefährGleich.svg}"  -->
                <RibbonButton
                    x:Name="RDBTN_BildGleicheByteBildFinden_Kopieren"
                    Width="30"
                    Height="22"
                    Margin="2,0,0,0"
                    d:SmallImageSource="/Images/UngefährGleichKlein.png"
                    Background="{x:Null}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteSuchenUngefährGleichesBildCommand, Mode=OneWay}"
                    Content="Grau Gleich"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE"
                    SmallImageSource="/Images/UngefährGleich.png"
                    ToolTip="Grau Abgleich (HammingDistance &gt; 10)">

                    <RibbonButton.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Nix" IsEnabled="False" />
                        </ContextMenu>
                    </RibbonButton.ContextMenu>

                </RibbonButton>
                <Button
                    Width="22"
                    Height="22"
                    Margin="2,0,2,0"
                    Command="{Binding CommandExecuteSuchenUngefährGleichesBildCancelCommand, Mode=OneWay}"
                    Content="X"
                    Foreground="Red" />

                <!--
                    Tastensteuerung: Die Übersicht liegt im Fenster (BRD_TastenHilfe) und
                    gilt für beide Ansichten. Hier als sichtbarer Knopf, überall auch über F1.
                -->

            </StackPanel>
        </Border>
        <Grid
            Grid.Row="1"
            Width="auto"
            Height="12"
            Margin="15,0,0,43"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="68" />
            </Grid.ColumnDefinitions>
            <ProgressBar
                Width="248"
                Height="8"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                d:Visibility="Visible"
                Visibility="{Binding PrüfungLäuft, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}"
                Value="{Binding PercentageValueVerschieben, Mode=OneWay}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">



                <TextBlock
                    x:Name="TXBL_ProzentProgressbar"
                    Width="50"
                    Height="14"
                    Padding="4,0,4,0"
                    d:Visibility="Visible"
                    Background="#FFF9C234"
                    FontSize="10"
                    FontWeight="Medium"
                    Language="de-DE"
                    Text="{Binding ProzentAbgleich, StringFormat=\{0:F2\} %}"
                    TextWrapping="NoWrap"
                    Visibility="{Binding PrüfungLäuft, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}"
                    d:LayoutOverrides="Height, TopPosition, BottomPosition" />
                <RibbonButton
                    x:Name="RDBTN_AbbrechenKonsistenz"
                    Width="10"
                    Height="10"
                    Margin="4,0,0,0"
                    Background="#FFF7E9E9"
                    BorderBrush="#FFFC4747"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="#FF49AF0C"
                    PressedBackground="#FFCACFFE"
                    SmallImageSource="/Images/Abbrechen.png"
                    ToolTip="Enc (Verschlüsselung) Abbrechen"
                    d:LayoutOverrides="Width, Height, TopPosition, BottomPosition" />


            </StackPanel>
        </Grid>
        <!--  Visibility="{Binding PrüfungLäuft, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}"  -->
        <!--  Kopfleiste links: Ablagefeld, Fensterknöpfe und Einstieg in die Bildersuche  -->
        <StackPanel
            x:Name="STP_KopfleisteLinks"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <Label
                x:Name="label"
                Width="190"
                Height="34"
                VerticalContentAlignment="Center"
                local:FileDragDropHelper.IsFileDragDropEnabled="True"
                AllowDrop="True"
                Background="#FFCEE067"
                Content="{Binding LabelDropContent}"
                ToolTip="{Binding Version}" />
            <Button
                x:Name="BTN_BilderAktualisieren"
                Width="28"
                Height="28"
                Margin="4,0,0,0"
                Command="{Binding CommandExecuteAlleBilderNeuEinlesenCommand, Mode=OneWay}"
                Cursor="Hand"
                ToolTip="Alle Bilder neu einlesen">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF26A69A" />
                        <Setter Property="Foreground" Value="#FFFFFFFF" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Content" Value="&#xE72C;" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <Grid>
                                            <Border
                                                x:Name="overlay"
                                                Background="Transparent"
                                                CornerRadius="5" />
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="overlay" Property="Background" Value="#33000000" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="overlay" Property="Background" Value="#55000000" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!--  Indikatoren (Webcam/Mikrofon/Screen-Share) → jetzt im Host-Cluster (MainWindow), oben rechts.  -->

            <!--  Unscheinbarer Button: blendet die Such-/Index-Leiste ein/aus  -->
            <Button
                x:Name="BTN_IndexSuchleiste"
                Width="54"
                Height="28"
                Margin="8,0,0,0"
                Padding="10,0"
                Command="{Binding CommandExecuteSuchleisteToggleCommand}"
                Cursor="Hand"
                ToolTip="Bildersuche ein-/ausblenden">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#FF6B6B6B" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border
                                        x:Name="bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="#33000000"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                Margin="2,3,6,0"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="12"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="&#xE721;" />
                                            <TextBlock
                                                FontFamily="Segoe UI"
                                                FontSize="12"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="Index" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#11000000" />
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#55000000" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#22000000" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSuchleisteOffen}" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#22000000" />
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#55000000" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!--
                Die Bildersuche lief bis hier als Popup unter dem Knopf. Sie sitzt jetzt
                in einem eigenen Werkzeugfenster (IndexSuchFenster), geöffnet über
                IsSuchleisteOffen in NormalAnsicht.xaml.cs.

                Grund: Ein Popup mit StaysOpen="False" schliesst sich, sobald man in den
                Explorer klickt — und genau das braucht man, um einen Ordner auf die
                Index-Karte zu ziehen. Ausserdem lässt sich ein Popup nicht in der Grösse
                ändern.
            -->

        </StackPanel>
        <Button
            x:Name="BTN_OrdnerÖffnen"
            Grid.Row="2"
            Width="25"
            Height="20"
            Margin="0,70,10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Command="{Binding CommandExecuteOrdnerDerAnwendungÖffnenCommand, Mode=OneWay}"
            Content="OÖ"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}" />

        <!--  „Liste": öffnet das Schnell-Listen-Popup (alle Miniaturen zum Finden)  -->
        <Button
            x:Name="BTN_BildListe"
            Grid.Row="2"
            Height="24"
            Margin="12,102,0,0"
            Padding="8,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Command="{Binding CommandExecuteBildListeToggleCommand}"
            Cursor="Hand"
            ToolTip="Alle Bilder als Kacheln – schnell zu einem Bild springen"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <StackPanel x:Name="STP_BildListeInhalt" Orientation="Horizontal">
                <!--  ECA5 = Tiles. Vorher E8FD (List) – das Panel zeigt aber ein Kachelraster.  -->
                <TextBlock
                    x:Name="IC_BildListe"
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="12"
                    Text="&#xECA5;" />
                <TextBlock
                    x:Name="TXT_BildListe"
                    VerticalAlignment="Center"
                    Text="Kacheln" />
            </StackPanel>
        </Button>

        <!--  Schnell-Liste als Popup, rechtsbündig über der Miniaturleiste  -->
        <Popup
            x:Name="POP_BildListe"
            AllowsTransparency="True"
            IsOpen="{Binding IsBildListeOffen, Mode=TwoWay}"
            Placement="Custom"
            PlacementTarget="{Binding ElementName=Listbox_MiniaturBilder}"
            PopupAnimation="Fade"
            StaysOpen="False">
            <bildersuche:BildListePanel Margin="12" />
        </Popup>
        <Border
            Grid.Row="2"
            Width="34"
            Height="34"
            Margin="8,20,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            BorderBrush="#44000000"
            BorderThickness="0.6"
            CornerRadius="6"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="6"
                    Opacity="0.3"
                    ShadowDepth="1"
                    Color="Black" />
            </Border.Effect>
            <Grid>

                <!--  Links (Left)  -->
                <!--  Position — Windrad-Dreiecke  -->
                <Canvas
                    x:Name="CVS_PositionDreiecke"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ToolTip="Bildposition im Ordner (Viertel-Anzeige)">
                    <Canvas.Effect>
                        <DropShadowEffect
                            BlurRadius="3"
                            Opacity="0.6"
                            ShadowDepth="0"
                            Color="#FF25B2C4" />
                    </Canvas.Effect>
                    <!--  Dreieck 1: Links  -->
                    <Polygon x:Name="PLG_DreieckLinks" Points="10,10 0,20 0,0">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="0">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Dreieck 2: Oben  -->
                    <Polygon x:Name="PLG_DreieckOben" Points="10,10 0,0 20,0">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="1">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Dreieck 3: Rechts  -->
                    <Polygon x:Name="PLG_DreieckRechts" Points="10,10 20,0 20,20">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="2">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Dreieck 4: Unten  -->
                    <Polygon x:Name="PLG_DreieckUnten" Points="10,10 20,20 0,20">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="3">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Trennlinien  -->
                    <Line
                        Stroke="#40000000"
                        StrokeThickness="0.6"
                        X1="0"
                        X2="20"
                        Y1="0"
                        Y2="20" />
                    <Line
                        Stroke="#40000000"
                        StrokeThickness="0.6"
                        X1="20"
                        X2="0"
                        Y1="0"
                        Y2="20" />
                </Canvas>

                <!--  Links (Left)  -->
                <Border
                    Margin="2,2,25,2"
                    d:Background="Gold"
                    CornerRadius="4,0,0,4">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="1">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Oben (Top)  -->
                <Border
                    Margin="2,2,2,25"
                    d:Background="Gold"
                    CornerRadius="4,4,0,0">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="2">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Rechts (Right)  -->
                <Border
                    Margin="25,2,2,2"
                    d:Background="Gold"
                    CornerRadius="0,4,4,0">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="3">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Unten (Bottom)  -->
                <Border
                    Margin="2,25,2,2"
                    d:Background="Gold"
                    CornerRadius="0,0,4,4">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="4">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Position — Windrad-Dreiecke  -->

            </Grid>
        </Border>
    </Grid>
</UserControl>
