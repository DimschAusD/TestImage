<Window
    x:Class="TestImage.Ansichten.IndexSuchFenster"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bildersuche="clr-namespace:TestImage.Bildersuche"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Bildersuche"
    Width="1040"
    Height="760"
    MinWidth="1035"
    MinHeight="300"
    AllowDrop="True"
    DragOver="Fenster_DragOver"
    Drop="Fenster_Drop"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    WindowStyle="ToolWindow"
    mc:Ignorable="d">

    <!--
        Eigenes Fenster statt Popup. Zwei Gründe:
        
        1. Ein Popup mit StaysOpen="False" schliesst sich, sobald man in den Explorer
        klickt — und genau das muss man tun, um einen Ordner herauszuziehen. Der
        Ordner-Drop auf die Index-Karte war damit unerreichbar.
        2. Ein Popup hat keinen Rahmen und keine Anfasser; seine Grösse ergibt sich
        allein aus dem Inhalt.
        
        ToolWindow ohne Taskleisteneintrag, mit Owner: bleibt über dem Hauptfenster,
        geht beim Minimieren mit und schliesst sich beim Beenden.
    -->
    <!--
        Waagerecht bewusst „Disabled": Nur so bekommt das Panel die Breite des
        Sichtfensters zugewiesen und wächst mit. Bei „Auto" würde es mit unbegrenzter
        Breite gemessen und bliebe bei seiner Wunschbreite stehen.
        
        Damit dabei nichts abgeschnitten wird, liegt die Mindestbreite des Fensters
        über der MinWidth des Panels.
    -->
    <ScrollViewer
        x:Name="SCV_FensterInhalt"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <bildersuche:IndexSuchPanel x:Name="PNL_IndexSuche" Margin="12" />
    </ScrollViewer>
</Window>
