<Window
    x:Class="TestImage.Ansichten.IndexSuchFenster"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bildersuche="clr-namespace:TestImage.Bildersuche"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Bildersuche"
    Height="1861"
    MinHeight="310"
    AllowDrop="True"
    DragOver="Fenster_DragOver"
    Drop="Fenster_Drop"
    Loaded="Fenster_Geladen"
    ResizeMode="CanResize"
    SizeToContent="Width"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">

    <!--
        Eigene Titelleiste statt der System-Leiste von ToolWindow.

        Grund: Windows zeichnet das Schliesskreuz eines Werkzeugfensters in fester,
        kleiner Grösse mit Luft darüber und darunter — an der hellen Leiste sah das
        wie ein aufgeklebter roter Kasten aus. Ein eigener Knopf füllt die Leiste
        über die volle Höhe, so wie es moderne Fenster tun.

        WindowChrome erhält dabei alles, was die System-Leiste konnte: Ziehen am
        oberen Streifen (CaptionHeight), Anfasser an allen Kanten
        (ResizeBorderThickness), Aero-Snap und korrektes Maximieren.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="32"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!--
            Schliessknopf: volle Leistenhöhe, ohne eigenen Rand, ruhig im Normalzustand.
            Das Rot kommt erst beim Überfahren — dieselbe Sprache wie in Windows selbst,
            damit der Knopf nicht dauerhaft als Farbfleck in der hellen Leiste sitzt.
        -->
        <Style x:Key="FensterSchliessenStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF1F2937" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BRD_Schliessfläche" Background="{TemplateBinding Background}">
                            <TextBlock
                                x:Name="IC_Schliesskreuz"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                Foreground="{TemplateBinding Foreground}"
                                Text="&#xE8BB;" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BRD_Schliessfläche" Property="Background" Value="#FFE81123" />
                                <Setter TargetName="IC_Schliesskreuz" Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BRD_Schliessfläche" Property="Background" Value="#FFF1707A" />
                                <Setter TargetName="IC_Schliesskreuz" Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        Eigenes Fenster statt Popup. Zwei Gründe:
        
        1. Ein Popup mit StaysOpen="False" schliesst sich, sobald man in den Explorer
        klickt — und genau das muss man tun, um einen Ordner herauszuziehen. Der
        Ordner-Drop auf die Index-Karte war damit unerreichbar.
        2. Ein Popup hat keinen Rahmen und keine Anfasser; seine Grösse ergibt sich
        allein aus dem Inhalt.
        
        ToolWindow ohne Taskleisteneintrag, mit Owner: bleibt über dem Hauptfenster,
        geht beim Minimieren mit und schliesst sich beim Beenden.
    -->
    <!--
        Waagerecht bewusst „Disabled": Sonst käme unter der langen Werkzeugleiste eine
        waagerechte Rollleiste zum Vorschein, statt dass das Fenster die nötige Breite
        annimmt.

        Der senkrechte Balken steht dagegen auf „Visible" statt „Auto": Bei „Auto"
        misst SizeToContent="Width" das Fenster ohne ihn, der Balken erscheint erst
        danach und nimmt dem Inhalt seine Breite wieder weg — die Werkzeugleiste
        wäre erneut rechts angeschnitten. Der Inhalt ist ohnehin länger als das
        Fenster, der Balken also praktisch immer da.
    -->
    <!--
        Margin nur im maximierten Zustand: WindowChrome legt das Fenster dann um die
        Rahmenbreite über den Bildschirmrand hinaus. Ohne den Ausgleich verschwände
        oben ein Streifen der Titelleiste.
    -->
    <Border
        x:Name="BRD_FensterRahmen"
        Background="White"
        BorderBrush="#FFCBD5E1"
        BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Margin" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid x:Name="GRD_Fenster">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                x:Name="BRD_Titelleiste"
                Background="#FFF8FAFC"
                BorderBrush="#FFE5E7EB"
                BorderThickness="0,0,0,1">
                <Grid x:Name="GRD_Titelleiste">
                    <TextBlock
                        x:Name="TXT_FensterTitel"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#FF1F2937"
                        Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <!--
                        IsHitTestVisibleInChrome: Ohne das gilt der Knopf als Teil der
                        Titelleiste und schluckt keine Klicks — er liesse sich nur ziehen.
                    -->
                    <Button
                        x:Name="BTN_FensterSchliessen"
                        HorizontalAlignment="Right"
                        Click="FensterSchliessen_Click"
                        Style="{StaticResource FensterSchliessenStyle}"
                        ToolTip="Schliessen"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                </Grid>
            </Border>

            <ScrollViewer
                x:Name="SCV_FensterInhalt"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Visible">
                <bildersuche:IndexSuchPanel x:Name="PNL_IndexSuche" Margin="12" />
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
