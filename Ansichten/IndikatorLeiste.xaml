<UserControl
    x:Class="TestImage.Ansichten.IndikatorLeiste"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Webcam-, Mikrofon- und Bildschirm-Anzeige.

        Eigenes Steuerelement, weil dieselben drei Felder in mehreren Ansichten
        gebraucht werden: Normalansicht (Kopfleiste rechts), Vollbildansicht (schwebend
        oben rechts) und Dubletten-Ansicht. Vorher lagen sie einmal im MainWindow und
        schwebten mit Panel.ZIndex="100" über allem — sichtbar waren sie damit überall,
        einen Platz hatten sie nirgends.

        Der DataContext wird von der einbettenden Ansicht geerbt; die Bindungen
        IsWebcamAktiv, IsMikrofonAktiv und IsScreenShareAktiv sind unverändert.

        Grau = aus, Grün = läuft gerade.
    -->
    <UserControl.Resources>

        <!--  Gemeinsames Aussehen; nur der Auslöser unterscheidet die drei Felder.  -->
        <Style x:Key="IndikatorFlaeche" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#22000000" />
        </Style>

        <Style x:Key="IndikatorZeichen" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF888888" />
        </Style>

    </UserControl.Resources>

    <StackPanel x:Name="STP_IndikatorCluster" Orientation="Horizontal">

        <!--  Webcam  -->
        <Border x:Name="BRD_IndikatorWebcam" ToolTip="Webcam — grün = wird gerade aufgenommen">
            <Border.Style>
                <Style BasedOn="{StaticResource IndikatorFlaeche}" TargetType="{x:Type Border}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWebcamAktiv}" Value="True">
                            <Setter Property="Background" Value="#3300C853" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="IC_IndikatorWebcam" Text="&#xE714;">
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource IndikatorZeichen}" TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWebcamAktiv}" Value="True">
                                <Setter Property="Foreground" Value="#FF00C853" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!--  Mikrofon  -->
        <Border x:Name="BRD_IndikatorMikrofon" ToolTip="Mikrofon — grün = wird gerade aufgenommen">
            <Border.Style>
                <Style BasedOn="{StaticResource IndikatorFlaeche}" TargetType="{x:Type Border}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMikrofonAktiv}" Value="True">
                            <Setter Property="Background" Value="#3300C853" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="IC_IndikatorMikrofon" Text="&#xE720;">
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource IndikatorZeichen}" TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMikrofonAktiv}" Value="True">
                                <Setter Property="Foreground" Value="#FF00C853" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!--  Bildschirmaufnahme  -->
        <Border x:Name="BRD_IndikatorBildschirm" ToolTip="Bildschirmaufnahme — grün = wird gerade geteilt">
            <Border.Style>
                <Style BasedOn="{StaticResource IndikatorFlaeche}" TargetType="{x:Type Border}">
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsScreenShareAktiv}" Value="True">
                            <Setter Property="Background" Value="#3300C853" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="IC_IndikatorBildschirm" Text="&#xE7F4;">
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource IndikatorZeichen}" TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScreenShareAktiv}" Value="True">
                                <Setter Property="Foreground" Value="#FF00C853" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

    </StackPanel>
</UserControl>
