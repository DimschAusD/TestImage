<UserControl
    x:Class="TestImage.Ansichten.IndikatorLeiste"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ansichten="clr-namespace:TestImage.Ansichten"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Webcam-, Mikrofon- und Bildschirm-Anzeige.

        Eigenes Steuerelement, weil dieselben drei Felder in mehreren Ansichten
        gebraucht werden: Normalansicht (Kopfleiste rechts), Vollbildansicht (schwebend
        oben rechts) und Dubletten-Ansicht. Vorher lagen sie einmal im MainWindow und
        schwebten mit Panel.ZIndex="100" über allem — sichtbar waren sie damit überall,
        einen Platz hatten sie nirgends.

        Der DataContext wird von der einbettenden Ansicht geerbt; die Bindungen
        IsWebcamAktiv, IsMikrofonAktiv und IsScreenShareAktiv sind unverändert.
        Dazugekommen ist ein viertes Feld für Bluetooth.

        Aus = graue Fläche, graues Zeichen. Läuft gerade = grün getönte Fläche, aber
        rotes Zeichen. Die Farbe trägt hier allein das Zeichen: Das frühere dunkle Grün
        war auf dem hellen Grund kaum vom Grau zu unterscheiden, und genau das Erkennen
        auf einen Blick ist der einzige Zweck dieser Felder. Die Fläche bleibt grün, weil
        sie den Zustand nur begleitet, nicht meldet.

        Beim Bluetooth-Feld gibt es einen dritten Zustand: die volle rote Fläche mit
        weissem Zeichen. Sie heisst nicht „läuft", sondern „hier ist ein Eingabegerät,
        das beim Start noch nicht da war".
    -->
    <UserControl.Resources>

        <!--  Gemeinsames Aussehen; nur der Auslöser unterscheidet die drei Felder.  -->
        <Style x:Key="IndikatorFlaeche" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#22000000" />
        </Style>

        <Style x:Key="IndikatorZeichen" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF888888" />
        </Style>

    </UserControl.Resources>

    <StackPanel x:Name="STP_IndikatorCluster" Orientation="Horizontal">

        <!--  Webcam  -->
        <!--
            Die Erklärung (Erklärung.Titel/Text) erscheint in der Vollbildansicht im
            Erklärfeld statt des Tooltips; in der Normalansicht gibt es kein Erklärfeld,
            dort bleibt es beim Tooltip.
        -->
        <Border
            x:Name="BRD_IndikatorWebcam"
            ansichten:Erklärung.Text="Das Zeichen wird rot, solange eine Anwendung die Kamera benutzt."
            ansichten:Erklärung.Titel="Webcam"
            ToolTip="Webcam — rot = wird gerade aufgenommen">
            <Border.Style>
                <Style BasedOn="{StaticResource IndikatorFlaeche}" TargetType="{x:Type Border}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWebcamAktiv}" Value="True">
                            <Setter Property="Background" Value="#3300C853" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="IC_IndikatorWebcam" Text="&#xE714;">
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource IndikatorZeichen}" TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWebcamAktiv}" Value="True">
                                <Setter Property="Foreground" Value="#FFFF0000" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!--  Mikrofon  -->
        <Border
            x:Name="BRD_IndikatorMikrofon"
            ansichten:Erklärung.Text="Das Zeichen wird rot, solange eine Anwendung das Mikrofon benutzt."
            ansichten:Erklärung.Titel="Mikrofon"
            ToolTip="Mikrofon — rot = wird gerade aufgenommen">
            <Border.Style>
                <Style BasedOn="{StaticResource IndikatorFlaeche}" TargetType="{x:Type Border}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMikrofonAktiv}" Value="True">
                            <Setter Property="Background" Value="#3300C853" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="IC_IndikatorMikrofon" Text="&#xE720;">
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource IndikatorZeichen}" TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMikrofonAktiv}" Value="True">
                                <Setter Property="Foreground" Value="#FFFF0000" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!--  Bildschirmaufnahme  -->
        <Border
            x:Name="BRD_IndikatorBildschirm"
            ansichten:Erklärung.Text="Das Zeichen wird rot, solange eine Anwendung den Bildschirm aufnimmt oder teilt."
            ansichten:Erklärung.Titel="Bildschirmaufnahme"
            ToolTip="Bildschirmaufnahme — rot = wird gerade geteilt">
            <Border.Style>
                <Style BasedOn="{StaticResource IndikatorFlaeche}" TargetType="{x:Type Border}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsScreenShareAktiv}" Value="True">
                            <Setter Property="Background" Value="#3300C853" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="IC_IndikatorBildschirm" Text="&#xE7F4;">
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource IndikatorZeichen}" TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScreenShareAktiv}" Value="True">
                                <Setter Property="Foreground" Value="#FFFF0000" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!--
            Bluetooth. Anders als die drei davor zeigt dieses Feld nicht „wird gerade
            benutzt" — das führt Windows für Bluetooth nirgends, siehe BluetoothWaechter.
            Rot heisst hier „angemeldet". Ist seit dem Start ein Eingabegerät dazugekommen,
            wird die ganze Fläche rot und das Zeichen weiss: Das kann tippen und klicken.
            Der kleine rote Punkt oben rechts gehört nicht zu den Geräten, sondern zum
            eigenen Adapter: Dessen Treiber ist alt, Näheres im Tooltip. Grau ist er, solange
            Bluetooth ausgeschaltet ist.

            Der Text steht im Tooltip und wechselt mit dem Zustand, deshalb gebunden
            statt fest wie bei den anderen dreien.
        -->
        <!--
            Im Erklärfeld steht vor dem wechselnden Stand, was die Farben heissen — der
            Tooltip zeigt nur den Stand, wer ihn liest, kennt das Feld schon.
        -->
        <Border
            x:Name="BRD_IndikatorBluetooth"
            ansichten:Erklärung.Text="{Binding BluetoothHinweis, StringFormat='Rotes Zeichen: ein Gerät ist angemeldet. Volle rote Fläche: seit dem Start ist ein Eingabegerät dazugekommen. Kleiner Punkt: alter Treiber am eigenen Adapter, rot bei eingeschaltetem, grau bei ausgeschaltetem Bluetooth.&#x0a;&#x0a;{0}'}"
            ansichten:Erklärung.Titel="Bluetooth">
            <!--
                Eigener Tooltip statt einfacher Zeichenkette: Gerätenamen können lang
                sein, und ohne Umbruch wuchs der Tooltip über die Bildschirmbreite.
            -->
            <Border.ToolTip>
                <ToolTip x:Name="TTP_IndikatorBluetooth">
                    <TextBlock
                        x:Name="TXT_BluetoothHinweis"
                        MaxWidth="300"
                        Text="{Binding BluetoothHinweis}"
                        TextWrapping="Wrap" />
                </ToolTip>
            </Border.ToolTip>
            <Border.Style>
                <Style BasedOn="{StaticResource IndikatorFlaeche}" TargetType="{x:Type Border}">
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBluetoothAktiv}" Value="True">
                            <Setter Property="Background" Value="#3300C853" />
                        </DataTrigger>

                        <!--
                            Zuletzt, damit die Warnung den Normalfall überschreibt. Volle
                            Fläche statt Tönung: Seit das rote Zeichen „angemeldet" heisst,
                            wäre ein bloss kräftigeres Rot nicht mehr davon zu unterscheiden.
                        -->
                        <DataTrigger Binding="{Binding IsBluetoothWarnung}" Value="True">
                            <Setter Property="Background" Value="#FFE81123" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid x:Name="GRD_IndikatorBluetooth">
                <TextBlock x:Name="IC_IndikatorBluetooth" Text="&#xE702;">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource IndikatorZeichen}" TargetType="{x:Type TextBlock}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBluetoothAktiv}" Value="True">
                                    <Setter Property="Foreground" Value="#FFFF0000" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBluetoothWarnung}" Value="True">
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!--
                    Benachrichtigungspunkt wie unter Android: „im Tooltip steht ein Hinweis".
                    Hier: Der Treiber des eigenen Adapters ist alt. Oben rechts in der Ecke,
                    damit er das Zeichen nicht verdeckt; weisser Rand, damit er auch auf der
                    vollen roten Warnfläche sichtbar bleibt.
                -->
                <Ellipse
                    x:Name="ELL_BluetoothTreiberAlt"
                    Width="7"
                    Height="7"
                    Margin="0,1,1,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    d:Visibility="Visible"
                    StrokeThickness="1">
                    <Ellipse.Style>
                        <Style TargetType="{x:Type Ellipse}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <!--  Im Style statt als Attribut, sonst griffe der Grau-Trigger nicht.  -->
                            <Setter Property="Fill" Value="#FFE81123" />
                            <Setter Property="Stroke" Value="White" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBluetoothTreiberAlt}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>

                                <!--
                                    Ausgeschaltet: grau statt rot. Der alte Treiber ist bekannt,
                                    aber ein abgeschalteter Funk ist von aussen nicht erreichbar.
                                -->
                                <DataTrigger Binding="{Binding IsBluetoothAus}" Value="True">
                                    <Setter Property="Fill" Value="#FF888888" />
                                    <!--  Gedämpfter Rand: Der volle weisse hob den grauen Punkt zu stark hervor.  -->
                                    <Setter Property="Stroke" Value="#66FFFFFF" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Grid>
        </Border>

    </StackPanel>
</UserControl>
