<Window
    x:Class="TestImage.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Converters="clr-namespace:TestImage.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:TestImage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="clr-namespace:System.Windows.Media;assembly=PresentationCore"
    xmlns:media1="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
    xmlns:svg1="clr-namespace:SVGImage.SVG;assembly=DotNetProjects.SVGImage"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="MainWindow"
    Width="800"
    Height="783"
    Background="#FFC9C6C6"
    PreviewKeyDown="Window_PreviewKeyDown"
    mc:Ignorable="d">
    <Window.Resources>

        <!--  Für die automatische Anzeige  -->
        <!--  Template für Bilder  -->
        <!--
      <DataTemplate DataType="{x:Type media:BitmapSource}">
            <Image Source="{Binding}" Stretch="Uniform" />
        </DataTemplate>


        -->
        <Converters:ConverterFullPathToNameConverter x:Key="ConverterFullPathToNameConverter" />
        <!--  Template für Videos  -->
        <Converters:CLconverterCountBildchenFuerLinks x:Key="CLconverterCountBildchenFuerLinks" />
        <!--
        <DataTemplate DataType="{x:Type MediaElement}">
            <MediaElement
                LoadedBehavior="Play"
                Source="{Binding Source}"
                Stretch="Uniform"
                UnloadedBehavior="Stop" />
        </DataTemplate>-->
        <Converters:CLconverterBrushesBoolianG5 x:Key="CLconverterBrushesBoolianG5" />

        <!--  Animation für ScrollViewer.VerticalOffset  -->
        <Converters:CLconverterBrushesBoolianG2 x:Key="CLconverterBrushesBoolianG2" />
        <!--
        <Storyboard x:Key="ScrollToCenterStoryboard">
            <DoubleAnimation Storyboard.TargetName="PART_ScrollViewer"
                             Storyboard.TargetProperty="(ScrollViewerBehavior.VerticalOffset)"
                             Duration="0:0:0.4"
                             AccelerationRatio="0.3"
                             DecelerationRatio="0.3" />
        </Storyboard>
        -->
        <Converters:CLconverterBrushesBoolianG1 x:Key="CLconverterBrushesBoolianG1" />
        <Converters:CLconverterStringZuMB x:Key="CLconverterStringZuMB" />
        <local:CLconverterImageScallierung x:Key="CLconverterImageScallierung" />
        <local:CLconverterBrushesBoolian x:Key="CLconverterBrushesBoolian" />
        <local:CLconverterVisiblityBoolian x:Key="CLconverterVisiblityBoolian" />
        <local:CLconverterProgressbarIntPlusEins x:Key="CLconverterProgressbarIntPlusEins" />
        <local:BoolToBrushConverter x:Key="BoolToBrushConverter" />
        <local:CLconverterColorBoolianMasterHintergrund x:Key="CLconverterColorBoolianMasterHintergrund" />
        <local:CLconverterStringToString x:Key="CLconverterStringToString" />
        <local:CLconverterStringZuKleinemImage x:Key="CLconverterStringZuKleinemImage" />
        <local:CLconverterStringZuImage x:Key="CLconverterStringZuImage" />

        <!--  Wasserzeichen Textbox  -->
        <VisualBrush
            x:Key="WasserzeichenFilter"
            AlignmentX="Center"
            AlignmentY="Center"
            Stretch="None">
            <VisualBrush.Visual>
                <Label
                    Content="Filter Name"
                    FontStyle="Italic"
                    Foreground="Gray"
                    Opacity="0.5" />
            </VisualBrush.Visual>
        </VisualBrush>
        <Storyboard x:Key="Storyboard1">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.8000000" Value="1.071" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.8000000" Value="3.2" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.8000000" Value="1.239" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.8000000" Value="4.067" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="Storyboard2">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="1.204" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="3.467" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="1.077" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="3.467" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!--  Template für Bild oder Video  -->

        <DataTemplate DataType="{x:Type BitmapSource}">
            <Image Source="{Binding}" Stretch="Uniform" />
        </DataTemplate>
        <DataTemplate x:Key="MediaTemplate">
            <Grid>
                <!--  Bild  -->
                <Image
                    x:Name="ImageControl"
                    Source="{Binding DisplayImage}"
                    Stretch="Uniform"
                    Visibility="Visible" />

                <!--  Video  -->
                <MediaElement
                    x:Name="VideoControl"
                    LoadedBehavior="Play"
                    Source="{Binding DisplayImage}"
                    Stretch="Uniform"
                    UnloadedBehavior="Stop"
                    Visibility="Collapsed" />
            </Grid>

            <!--  Trigger für Bildformate  -->
            <DataTemplate.Triggers>
                <!--  Namespace für String  -->
                <DataTrigger Binding="{Binding}" Value="{x:Static sys:String.Empty}">
                    <Setter TargetName="ImageControl" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="VideoControl" Property="Visibility" Value="Collapsed" />
                </DataTrigger>

                <!--  Bild-Dateiendungen  -->
                <DataTrigger Binding="{Binding}" Value="*.jpg">
                    <Setter TargetName="ImageControl" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="*.png">
                    <Setter TargetName="ImageControl" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="*.bmp">
                    <Setter TargetName="ImageControl" Property="Visibility" Value="Visible" />
                </DataTrigger>

                <!--  Video-Dateiendungen  -->
                <DataTrigger Binding="{Binding}" Value="*.mp4">
                    <Setter TargetName="VideoControl" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="*.avi">
                    <Setter TargetName="VideoControl" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="*.wmv">
                    <Setter TargetName="VideoControl" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>





    </Window.Resources>
    <Window.DataContext>
        <local:AufgabeViewModel />
    </Window.DataContext>
    <Window.InputBindings>
        <!--  Bild nach rechts  -->
        <KeyBinding
            Key="D"
            Command="{Binding CommandExecuteBildNachRechtsCommand, Mode=OneWay}"
            Modifiers="Ctrl" />

        <!--  Bild nach Links  -->
        <KeyBinding
            Key="A"
            Command="{Binding CommandExecuteBildLinksCommand, Mode=OneWay}"
            Modifiers="Ctrl" />

        <!--  Bild nach Unten  -->
        <KeyBinding
            Key="S"
            Command="{Binding CommandExecuteBildInsKeinFavVerzeichnisVerschiebenCommand}"
            Modifiers="Ctrl" />

        <!--  Bild nach Oben  -->
        <KeyBinding
            Key="W"
            Command="{Binding CommandExecuteBildInsHauptVerzeichnisZuruckVerschiebenCommand, Mode=OneWay}"
            Modifiers="Ctrl" />

        <!--  Fenster minimieren  -->
        <KeyBinding Key="Space" Command="{Binding CommandExecuteFensterMinimierenCommand, Mode=OneWay}" />

        <!--  Verschieben rückgängig machen  -->
        <KeyBinding
            Key="Z"
            Command="{Binding CommandExecuteVerschiebenZurückCommand, Mode=OneWay}"
            Modifiers="Ctrl" />
    </Window.InputBindings>
    <Grid Margin="10,10,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />

            <!--  IMAGE  -->
            <RowDefinition Height="Auto" />
            <!--  StackPanel + ListBox1 + ListBox2  -->
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="2"
            Height="90"
            Margin="45,0,93,160"
            VerticalAlignment="Bottom"
            Orientation="Vertical"
            Visibility="{Binding IsObenMinimiert, Converter={StaticResource CLconverterVisiblityBoolian}}">
            <StackPanel Width="648" Orientation="Horizontal">

                <!--  Erste Zeile: Position + Gesamt  -->
                <TextBlock Margin="0,0,0,2"><Run Text="Pos: " /><Run Text=" " /><Run Text="{Binding AufgabenView.CurrentPosition, Converter={StaticResource CLconverterProgressbarIntPlusEins}, Mode=OneWay}" /><Run Text=" " /><Run Text=" / " /><Run Text=" " /><Run Text="{Binding AufgabenView.Count, Mode=OneWay}" /><Run Text=" " /><Run Text="   (" /><Run Text=" " /><Run Text="{Binding CountBildchenFürLinks, Mode=OneWay}" /><Run Text=" " /><Run Text=" verschoben)" /></TextBlock>

                <!--  Zweite Zeile: Name  -->
                <TextBlock Margin="0,0,0,2"><Run Foreground="Gray" Text="  Name: " /><Run Text=" " /><Run Text="{Binding SelectedBildchen.BName, Converter={StaticResource ConverterFullPathToNameConverter}}" /></TextBlock>

                <!--  Dritte Zeile: weitere Metadaten  -->
                <TextBlock><Run Text="  " /><Run Text=" " /><Run Foreground="LightBlue" Text="{Binding Version}" /></TextBlock>

            </StackPanel>

            <ProgressBar
                Width="648"
                Height="2"
                Maximum="{Binding AufgabenView.Count, Mode=OneWay}"
                Value="{Binding AufgabenView.CurrentPosition, Converter={StaticResource CLconverterProgressbarIntPlusEins}, Mode=OneWay}" />
            <ListBox
                x:Name="listBox"
                Height="70"
                local:HorizontalListBoxBehavior.CenterSelectedItem="True"
                IsSynchronizedWithCurrentItem="True"
                ItemsSource="{Binding AufgabenView}"
                ScrollViewer.HorizontalScrollBarVisibility="Visible"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectedBildchen}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:MeinBildchen}">
                        <StackPanel Width="auto" Orientation="Horizontal">
                            <TextBlock
                                Margin="2,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding BName}" />
                        </StackPanel>
                    </DataTemplate>

                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Blue" />
                                <Setter Property="Foreground" Value="Blue" />
                                <Setter Property="FontWeight" Value="DemiBold" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Background" Value="#FFE8E6E6" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3399FF" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                            </Trigger>

                            <DataTrigger Binding="{Binding BildFürLinks}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BildFürLinks}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>



                </ListBox.ItemContainerStyle>
            </ListBox>
        </StackPanel>
        <ListBox
            x:Name="Listbox_MiniaturBilder"
            Grid.Row="2"
            Height="138"
            Margin="93,0,25,10"
            VerticalAlignment="Bottom"
            d:ItemsSource="{d:SampleData ItemCount=4}"
            local:HorizontalListBoxBehavior.CenterSelectedItem="True"
            local:HorizontalListBoxBehavior.EnableHorizontalMouseWheel="True"
            IsSynchronizedWithCurrentItem="True"
            ItemsSource="{Binding AufgabenView}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectedItem="{Binding SelectedBildchen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            Visibility="{Binding IsObenMinimiert, Converter={StaticResource CLconverterVisiblityBoolian}}">

            <!--  Hintergrundfarbe per Style, damit DataTrigger greifen kann  -->
            <ListBox.Style>
                <Style TargetType="{x:Type ListBox}">
                    <Setter Property="Background" Value="{Binding SelectedBildchen.BildFürLinks, Converter={StaticResource CLconverterColorBoolianMasterHintergrund}, FallbackValue={x:Static Brushes.Transparent}, TargetNullValue={x:Static Brushes.Transparent}}" />
                    <Style.Triggers>
                        <!--  Alle Bilder verschoben → Rot  -->
                        <DataTrigger Binding="{Binding AlleBilderVerschoben}" Value="True">
                            <Setter Property="Background" Value="#FFE83030" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>

            <!--  Kontextmenü  -->
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding CommandExecuteDateiImExplorerÖffnenCommand}" Header="Explorer öffnen" />
                </ContextMenu>
            </ListBox.ContextMenu>

            <!--  EventTrigger  -->
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding CommandExecuteKleinesBildGrossesBildLadenCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>

            <!--  Horizontaler ItemsPanel  -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <!--  ItemTemplate: neutral (Farbe steuern wir im Container-Template)  -->
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:MeinBildchen}">
                    <Border
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                        <Grid>
                            <Image
                                Width="80"
                                Height="80"
                                Margin="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{Binding BName, Converter={StaticResource CLconverterStringZuKleinemImage}}"
                                Stretch="Uniform" />
                            <!--  falls Glyph aus MDL2 kommt  -->
                            <TextBlock
                                x:Name="TXBL_Sternchen"
                                Width="19"
                                Height="19"
                                Margin="4,4,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="&#xE1CE;"
                                Visibility="{Binding BildFürLinks, Converter={StaticResource CLconverterVisiblityBoolian}}">
                                <TextBlock.Effect>
                                    <DropShadowEffect
                                        BlurRadius="5"
                                        Opacity="0.8"
                                        ShadowDepth="0"
                                        Color="Black" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <!--  ContainerStyle: eigenes Template (kein Windows/Accent-Overlay)  -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <!--  Fokusrahmen aus  -->
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Setter Property="OverridesDefaultStyle" Value="True" />

                    <!--  Ausrichtung von der ListBox übernehmen  -->
                    <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
                    <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />

                    <!--  Basis-Rand  -->
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Padding" Value="2" />

                    <!--  Eigenes ControlTemplate  -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <!--  💡 Default-Hintergrund JE ITEM = Converter (nur im Normalzustand sichtbar)  -->
                                <Border
                                    x:Name="Bd"
                                    Background="{Binding BildFürLinks, Converter={StaticResource CLconverterColorBoolianMasterHintergrund}, FallbackValue={x:Static Brushes.Transparent}, TargetNullValue={x:Static Brushes.Transparent}}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                    <ContentPresenter
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>

                                <ControlTemplate.Triggers>
                                    <!--  🟦 SELECTED: überschreibt Converter-Farbe  -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FF007ACC" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="DarkBlue" />
                                        <Setter Property="Foreground" Value="White" />
                                        <!--  Optional: dezentes visuelles Feedback  -->
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect
                                                    BlurRadius="14"
                                                    Opacity="0.7"
                                                    ShadowDepth="0"
                                                    Color="#66005FB8" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>

                                    <!--  🟩 MOUSEOVER nur wenn NICHT selected: überschreibt Converter-Farbe  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True" />
                                            <Condition Property="IsSelected" Value="False" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Background" Value="#FFBAFF6A" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7A9E39" />
                                        <Setter Property="Foreground" Value="Black" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

        </ListBox>
        <Border
            x:Name="BRD_NachObenVerschieben"
            Grid.Row="2"
            Width="78"
            Height="auto"
            Margin="10,0,0,10"
            Padding="2,2,2,2"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderThickness="2,2,2,2"
            CornerRadius="2,2,2,2">
            <StackPanel
                Width="70"
                Height="auto"
                Orientation="Vertical">
                <Image
                    x:Name="image_Kopieren"
                    Width="70"
                    Height="70"
                    Source="{Binding SelectedBildchen.BName, Converter={StaticResource CLconverterStringZuKleinemImage}}"
                    Visibility="{Binding IsEnabled, Converter={StaticResource CLconverterVisiblityBoolian}, ElementName=RDBTN_BildNachOben}" />
                <RibbonButton
                    x:Name="RDBTN_BildNachOben"
                    Height="70"
                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteBildInsHauptVerzeichnisZuruckVerschiebenCommand, Mode=OneWay}"
                    Content="Button"
                    Label="In die Liste"
                    LargeImageSource="/Images/PfeilNachOben.png"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE" />
            </StackPanel>
        </Border>
        <Border
            x:Name="ViewedPhotoArea"
            Grid.Row="1"
            Margin="45,5,45,10"
            Padding="4"
            BorderBrush="#22000000"
            BorderThickness="0"
            ClipToBounds="True"
            Visibility="Visible">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="{Binding SelectedBildchen.BildFürLinks, Converter={StaticResource CLconverterColorBoolianMasterHintergrund}}" />
                    <Style.Triggers>
                        <!--  Alle Bilder verschoben → Rot  -->
                        <DataTrigger Binding="{Binding AlleBilderVerschoben}" Value="True">
                            <Setter Property="Background" Value="#FFE83030" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!--  Image Display  -->
            <ScrollViewer
                x:Name="scdd"
                HorizontalScrollBarVisibility="{Binding MyHorizontalScrollBarVisibility}"
                VerticalScrollBarVisibility="{Binding MyHorizontalScrollBarVisibility}">

                <Image
                    x:Name="imgCurrent"
                    Margin="4,4,4,4"
                    IsManipulationEnabled="True"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    RenderOptions.EdgeMode="Aliased"
                    SizeChanged="imgCurrent_SizeChanged"
                    Source="{Binding DisplayImage}"
                    Stretch="{Binding ImageStretch}"
                    UseLayoutRounding="False">
                    <Image.Effect>
                        <DropShadowEffect
                            BlurRadius="20"
                            Opacity="0.8"
                            ShadowDepth="0"
                            Color="Black" />
                    </Image.Effect>

                    <!--<Image.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding ScaleX}" ScaleY="{Binding ScaleX}" />
                    </Image.LayoutTransform>-->

                    <Image.Style>
                        <Style TargetType="{x:Type Image}">
                            <Style.Triggers>
                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="Opacity"
                                                From="0"
                                                To="1"
                                                Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>

                </Image>

            </ScrollViewer>
        </Border>
        <RibbonButton
            x:Name="RDBTN_BildNachRechts"
            Grid.Row="1"
            Width="52"
            Height="108"
            Margin="0,0,10,208"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
            Command="{Binding CommandExecuteBildNachRechtsCommand, Mode=OneWay}"
            KeyTip="+"
            Label="+1 Nach Rechts"
            LargeImageSource="/Images/PfeilNachRechts.png"
            MouseOverBackground="#FFB7F393"
            MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
            PressedBackground="#FFCACFFE" />
        <Border
            Grid.Row="1"
            Width="78"
            Height="122"
            Margin="0,10,10,0"
            Padding="2,2,2,2"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderThickness="2,2,2,2"
            CornerRadius="2,2,2,2">

            <StackPanel
                Width="70"
                Height="auto"
                Orientation="Vertical">
                <RibbonButton
                    x:Name="BTN_VerschieberRückgängigMachen"
                    Width="40"
                    Height="40"
                    Margin="0,0,0,4"
                    Background="{Binding IsEnabled, Converter={StaticResource CLconverterBrushesBoolian}, RelativeSource={RelativeSource Mode=Self}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    Command="{Binding CommandExecuteVerschiebenZurückCommand, Mode=OneWay}"
                    Foreground="Red"
                    Label="X"
                    LargeImageSource="/Images/Rueckwerts.png"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="#FF49AF0C"
                    PressedBackground="#FFCACFFE" />

                <Image
                    x:Name="image"
                    Width="70"
                    Height="70"
                    Source="{Binding BildchenVorher, Converter={StaticResource CLconverterStringZuKleinemImage}}" />
            </StackPanel>
        </Border>
        <Border
            x:Name="BRD_NachUntenVerschieben"
            Grid.Row="1"
            Width="78"
            Height="auto"
            Margin="0,0,10,10"
            Padding="2,2,2,2"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderThickness="2,2,2,2"
            CornerRadius="2,2,2,2">
            <StackPanel
                Width="70"
                Height="auto"
                MaxHeight="144"
