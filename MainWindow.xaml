<Window
    x:Class="TestImage.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Converters="clr-namespace:TestImage.Converters"
    xmlns:Converters1="clr-namespace:TestImageViewer.Converters"
    xmlns:bildersuche="clr-namespace:TestImage.Bildersuche"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:TestImage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="clr-namespace:System.Windows.Media;assembly=PresentationCore"
    xmlns:media1="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
    xmlns:svg1="clr-namespace:SVGImage.SVG;assembly=DotNetProjects.SVGImage"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="MainWindow"
    Width="800"
    Height="783"
    Background="#FFC9C6C6"
    Icon="/Sternchen.ico"
    PreviewKeyDown="Window_PreviewKeyDown"
    mc:Ignorable="d">
    <Window.Resources>

        <!--  Für die automatische Anzeige  -->
        <!--  Template für Bilder  -->
        <Converters1:ConverterAktivZuFarbe x:Key="ConverterAktivZuFarbe" />
        <!--
      <DataTemplate DataType="{x:Type media:BitmapSource}">
            <Image Source="{Binding}" Stretch="Uniform" />
        </DataTemplate>


        -->
        <Converters:ConverterFullPathToNameConverter x:Key="ConverterFullPathToNameConverter" />
        <!--  Template für Videos  -->
        <Converters:CLconverterCountBildchenFuerLinks x:Key="CLconverterCountBildchenFuerLinks" />
        <Converters:ConverterPositionZuViertel x:Key="ConverterPositionZuViertel" />
        <Converters:ConverterPositionZuFarbe x:Key="ConverterPositionZuFarbe" />
        <Converters:ConverterPositionZuDreiecke x:Key="ConverterPositionZuDreiecke" />
        <Converters:ConverterVisiblityBoolianInvertiert x:Key="ConverterVisiblityBoolianInvertiert" />

        <Converters:ConverterVerschobenSegment x:Key="VerschobenSegmentConverter" />

        <!--
        <DataTemplate DataType="{x:Type MediaElement}">
            <MediaElement
                LoadedBehavior="Play"
                Source="{Binding Source}"
                Stretch="Uniform"
                UnloadedBehavior="Stop" />
        </DataTemplate>-->
        <Converters:CLconverterBrushesBoolianG5 x:Key="CLconverterBrushesBoolianG5" />

        <!--  Animation für ScrollViewer.VerticalOffset  -->
        <Converters:CLconverterBrushesBoolianG2 x:Key="CLconverterBrushesBoolianG2" />
        <!--
        <Storyboard x:Key="ScrollToCenterStoryboard">
            <DoubleAnimation Storyboard.TargetName="PART_ScrollViewer"
                             Storyboard.TargetProperty="(ScrollViewerBehavior.VerticalOffset)"
                             Duration="0:0:0.4"
                             AccelerationRatio="0.3"
                             DecelerationRatio="0.3" />
        </Storyboard>
        -->
        <Converters:CLconverterBrushesBoolianG1 x:Key="CLconverterBrushesBoolianG1" />
        <Converters:CLconverterStringZuMB x:Key="CLconverterStringZuMB" />
        <local:CLconverterImageScallierung x:Key="CLconverterImageScallierung" />
        <local:CLconverterBrushesBoolian x:Key="CLconverterBrushesBoolian" />
        <local:CLconverterVisiblityBoolian x:Key="CLconverterVisiblityBoolian" />
        <local:CLconverterProgressbarIntPlusEins x:Key="CLconverterProgressbarIntPlusEins" />
        <local:BoolToBrushConverter x:Key="BoolToBrushConverter" />
        <local:CLconverterColorBoolianMasterHintergrund x:Key="CLconverterColorBoolianMasterHintergrund" />
        <local:CLconverterStringToString x:Key="CLconverterStringToString" />
        <local:CLconverterStringZuKleinemImage x:Key="CLconverterStringZuKleinemImage" />
        <local:CLconverterStringZuImage x:Key="CLconverterStringZuImage" />

        <!--  Wasserzeichen Textbox  -->
        <VisualBrush
            x:Key="WasserzeichenFilter"
            AlignmentX="Center"
            AlignmentY="Center"
            Stretch="None">
            <VisualBrush.Visual>
                <Label
                    Content="Filter Name"
                    FontStyle="Italic"
                    Foreground="Gray"
                    Opacity="0.5" />
            </VisualBrush.Visual>
        </VisualBrush>
        <Storyboard x:Key="Storyboard1">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.8000000" Value="1.071" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.8000000" Value="3.2" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.8000000" Value="1.239" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.8000000" Value="4.067" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="Storyboard2">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="1.204" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="3.467" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="1.077" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="3.467" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!--  Template für Bild oder Video  -->

        <DataTemplate DataType="{x:Type BitmapSource}">
            <Image Source="{Binding}" Stretch="Uniform" />
        </DataTemplate>
        <DataTemplate x:Key="MediaTemplate">
            <Grid>
                <!--  Bild  -->
                <Image
                    x:Name="ImageControl"
                    Source="{Binding DisplayImage}"
                    Stretch="Uniform"
                    Visibility="Visible" />

                <!--  Video  -->
                <MediaElement
                    x:Name="VideoControl"
                    LoadedBehavior="Play"
                    Source="{Binding DisplayImage}"
                    Stretch="Uniform"
                    UnloadedBehavior="Stop"
                    Visibility="Collapsed" />
            </Grid>

            <!--  Trigger für Bildformate  -->
            <DataTemplate.Triggers>
                <!--  Namespace für String  -->
                <DataTrigger Binding="{Binding}" Value="{x:Static sys:String.Empty}">
                    <Setter TargetName="ImageControl" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="VideoControl" Property="Visibility" Value="Collapsed" />
                </DataTrigger>

                <!--  Bild-Dateiendungen  -->
                <DataTrigger Binding="{Binding}" Value="*.jpg">
                    <Setter TargetName="ImageControl" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="*.png">
                    <Setter TargetName="ImageControl" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="*.bmp">
                    <Setter TargetName="ImageControl" Property="Visibility" Value="Visible" />
                </DataTrigger>

                <!--  Video-Dateiendungen  -->
                <DataTrigger Binding="{Binding}" Value="*.mp4">
                    <Setter TargetName="VideoControl" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="*.avi">
                    <Setter TargetName="VideoControl" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="*.wmv">
                    <Setter TargetName="VideoControl" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>





        <!--  Umrandeter, heller Button im Stil der Bildersuche-Vorlage  -->
        <Style x:Key="OutlineButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF2B2B2B" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border
                            x:Name="bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#FFDADADA"
                            BorderThickness="1"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF3F4F6" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFC4C4C4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE9EBEF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <Window.DataContext>
        <local:AufgabeViewModel />
    </Window.DataContext>
    <Window.InputBindings>
        <!--  Bild nach rechts  -->
        <KeyBinding
            Key="D"
            Command="{Binding CommandExecuteBildNachRechtsCommand, Mode=OneWay}"
            Modifiers="Ctrl" />

        <!--  Bild nach Links  -->
        <KeyBinding
            Key="A"
            Command="{Binding CommandExecuteBildLinksCommand, Mode=OneWay}"
            Modifiers="Ctrl" />

        <!--  Bild nach Unten  -->
        <KeyBinding
            Key="S"
            Command="{Binding CommandExecuteBildInsKeinFavVerzeichnisVerschiebenCommand}"
            Modifiers="Ctrl" />

        <!--  Bild nach Oben  -->
        <KeyBinding
            Key="W"
            Command="{Binding CommandExecuteBildInsHauptVerzeichnisZuruckVerschiebenCommand, Mode=OneWay}"
            Modifiers="Ctrl" />

        <!--  Fenster minimieren  -->
        <KeyBinding Key="Space" Command="{Binding CommandExecuteFensterMinimierenCommand, Mode=OneWay}" />

        <!--  Verschieben rückgängig machen  -->
        <KeyBinding
            Key="Z"
            Command="{Binding CommandExecuteVerschiebenZurückCommand, Mode=OneWay}"
            Modifiers="Ctrl" />

        <!--  Bild maximieren Toggle  -->
        <KeyBinding Key="F11" Command="{Binding CommandExecuteImageMaximierenToggleCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.Style>
            <Style TargetType="{x:Type Grid}">
                <Setter Property="Margin" Value="10,10,10,10" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsImageMaximiert}" Value="True">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="#FF111111" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />

            <!--  IMAGE  -->
            <RowDefinition Height="Auto" />
            <!--  StackPanel + ListBox1 + ListBox2  -->
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="2"
            Height="90"
            Margin="45,0,45,160"
            VerticalAlignment="Bottom"
            Orientation="Vertical"
            Visibility="{Binding IsObenMinimiert, Converter={StaticResource CLconverterVisiblityBoolian}}">
            <StackPanel Orientation="Horizontal">

                <!--  Erste Zeile: Position + Gesamt  -->
                <TextBlock Margin="0,0,0,2"><Run Text="Pos: " /><Run Text=" " /><Run Text="{Binding AufgabenView.CurrentPosition, Converter={StaticResource CLconverterProgressbarIntPlusEins}, Mode=OneWay}" /><Run Text=" " /><Run Text=" / " /><Run Text=" " /><Run Text="{Binding AufgabenView.Count, Mode=OneWay}" /><Run Text=" " /><Run Text="   (" /><Run Text=" " /><Run Text="{Binding CountBildchenFürLinks, Mode=OneWay}" /><Run Text=" " /><Run Text=" verschoben)" /></TextBlock>

                <!--  Zweite Zeile: Name  -->
                <TextBlock Margin="0,0,0,2"><Run Foreground="Gray" Text="  Name: " /><Run Text=" " /><Run Text="{Binding SelectedBildchen.BName, Converter={StaticResource ConverterFullPathToNameConverter}}" /></TextBlock>

                <!--  Dritte Zeile: weitere Metadaten  -->
                <TextBlock><Run Text="  " /><Run Text=" " /><Run Foreground="LightBlue" Text="{Binding Version}" /></TextBlock>

            </StackPanel>

            <ProgressBar
                Width="auto"
                Height="2"
                Maximum="{Binding AufgabenView.Count, Mode=OneWay}"
                Value="{Binding AufgabenView.CurrentPosition, Converter={StaticResource CLconverterProgressbarIntPlusEins}, Mode=OneWay}" />
            <ListBox
                x:Name="listBox"
                Height="70"
                local:HorizontalListBoxBehavior.CenterSelectedItem="True"
                IsSynchronizedWithCurrentItem="True"
                ItemsSource="{Binding AufgabenView}"
                ScrollViewer.HorizontalScrollBarVisibility="Visible"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectedBildchen}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:MeinBildchen}">
                        <StackPanel Width="auto" Orientation="Horizontal">
                            <TextBlock
                                Margin="2,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding BName}" />
                        </StackPanel>
                    </DataTemplate>

                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Blue" />
                                <Setter Property="Foreground" Value="Blue" />
                                <Setter Property="FontWeight" Value="DemiBold" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Background" Value="#FFE8E6E6" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3399FF" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                            </Trigger>

                            <DataTrigger Binding="{Binding BildFürLinks}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BildFürLinks}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>



                </ListBox.ItemContainerStyle>
            </ListBox>
        </StackPanel>
        <ListBox
            x:Name="Listbox_MiniaturBilder"
            Grid.Row="2"
            Height="138"
            Margin="93,0,25,10"
            VerticalAlignment="Bottom"
            d:ItemsSource="{d:SampleData ItemCount=4}"
            local:HorizontalListBoxBehavior.CenterSelectedItem="True"
            local:HorizontalListBoxBehavior.EnableHorizontalMouseWheel="True"
            IsSynchronizedWithCurrentItem="True"
            ItemsSource="{Binding AufgabenView}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectedItem="{Binding SelectedBildchen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling"
            Visibility="{Binding IsObenMinimiert, Converter={StaticResource CLconverterVisiblityBoolian}}">

            <!--  Hintergrundfarbe per Style, damit DataTrigger greifen kann  -->
            <ListBox.Style>
                <Style TargetType="{x:Type ListBox}">
                    <Setter Property="Background" Value="{Binding SelectedBildchen.BildFürLinks, Converter={StaticResource CLconverterColorBoolianMasterHintergrund}, FallbackValue={x:Static Brushes.Transparent}, TargetNullValue={x:Static Brushes.Transparent}}" />
                    <Style.Triggers>
                        <!--  Alle Bilder verschoben → Rot  -->
                        <DataTrigger Binding="{Binding AlleBilderVerschoben}" Value="True">
                            <Setter Property="Background" Value="#FFE83030" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>

            <!--  Kontextmenü  -->
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding CommandExecuteDateiImExplorerÖffnenCommand}" Header="Explorer öffnen" />
                </ContextMenu>
            </ListBox.ContextMenu>

            <!--  EventTrigger  -->
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding CommandExecuteKleinesBildGrossesBildLadenCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>

            <!--  Horizontaler ItemsPanel  -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <!--  ItemTemplate: neutral (Farbe steuern wir im Container-Template)  -->
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:MeinBildchen}">
                    <Border
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                        <Grid>
                            <Image
                                Width="80"
                                Height="80"
                                Margin="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{Binding BName, Converter={StaticResource CLconverterStringZuKleinemImage}}"
                                Stretch="Uniform" />
                            <!--  Badge: Bild wurde verschoben  -->
                            <Border
                                Width="18"
                                Height="18"
                                Margin="0,4,4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#DDCC2222"
                                CornerRadius="9"
                                Visibility="{Binding BildFürLinks, Converter={StaticResource CLconverterVisiblityBoolian}}">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="4"
                                        Opacity="0.6"
                                        ShadowDepth="1"
                                        Color="Black" />
                                </Border.Effect>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="9"
                                    Foreground="White"
                                    Text="&#xE10B;" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <!--  ContainerStyle: eigenes Template (kein Windows/Accent-Overlay)  -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <!--  Fokusrahmen aus  -->
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Setter Property="OverridesDefaultStyle" Value="True" />

                    <!--  Ausrichtung von der ListBox übernehmen  -->
                    <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
                    <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />

                    <!--  Basis-Rand  -->
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Padding" Value="2" />

                    <!--  Eigenes ControlTemplate  -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <!--  Default-Hintergrund JE ITEM = Converter (nur im Normalzustand sichtbar)  -->
                                <Border
                                    x:Name="Bd"
                                    Background="{Binding BildFürLinks, Converter={StaticResource CLconverterColorBoolianMasterHintergrund}, FallbackValue={x:Static Brushes.Transparent}, TargetNullValue={x:Static Brushes.Transparent}}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                    <ContentPresenter
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>

                                <ControlTemplate.Triggers>
                                    <!--  SELECTED: überschreibt Converter-Farbe  -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FF007ACC" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="DarkBlue" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect
                                                    BlurRadius="14"
                                                    Opacity="0.7"
                                                    ShadowDepth="0"
                                                    Color="#66005FB8" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>

                                    <!--  MOUSEOVER nur wenn NICHT selected: überschreibt Converter-Farbe  -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True" />
                                            <Condition Property="IsSelected" Value="False" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Background" Value="#FFBAFF6A" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7A9E39" />
                                        <Setter Property="Foreground" Value="Black" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

        </ListBox>
        <Border
            x:Name="BRD_NachObenVerschieben"
            Grid.Row="2"
            Width="78"
            Height="auto"
            Margin="10,0,0,10"
            Padding="2,2,2,2"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderThickness="2,2,2,2"
            CornerRadius="2,2,2,2"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <StackPanel
                Width="70"
                Height="auto"
                Orientation="Vertical">
                <Image
                    x:Name="image_Kopieren"
                    Width="70"
                    Height="70"
                    Source="{Binding SelectedBildchen.BName, Converter={StaticResource CLconverterStringZuKleinemImage}}"
                    Visibility="{Binding IsEnabled, Converter={StaticResource CLconverterVisiblityBoolian}, ElementName=RDBTN_BildNachOben}" />
                <!--  MouseOverBackground="#FFB7F393"  -->
                <RibbonButton
                    x:Name="RDBTN_BildNachOben"
                    Height="70"
                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteBildInsHauptVerzeichnisZuruckVerschiebenCommand, Mode=OneWay}"
                    Content="Button"
                    Label="In die Liste"
                    LargeImageSource="/Images/PfeilNachOben.png"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE">

                    <RibbonButton.MouseOverBackground>

                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">

                            <!--  Ziel: oben = klar gut, dominant  -->
                            <GradientStop Offset="0.0" Color="#FF8FE88F" />
                            <!--  sattes, positives Grün  -->
                            <GradientStop Offset="0.35" Color="#FFBFF0BF" />
                            <!--  weiches Übergangsgrün  -->

                            <!--  Übergang  -->
                            <GradientStop Offset="0.6" Color="#FFF6D880" />
                            <!--  Amber  -->

                            <!--  Abstieg: Problemzone unten, kompakt  -->
                            <GradientStop Offset="0.82" Color="#FFF0A070" />
                            <!--  warmes Orange  -->
                            <GradientStop Offset="1.0" Color="#FFD96666" />
                            <!--  gedämpftes Rot  -->

                        </LinearGradientBrush>

                    </RibbonButton.MouseOverBackground>

                </RibbonButton>
            </StackPanel>
        </Border>
        <Border
            x:Name="ViewedPhotoArea"
            Grid.Row="1"
            BorderBrush="#22000000"
            BorderThickness="0"
            ClipToBounds="True"
            Visibility="Visible">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Margin" Value="45,5,45,10" />
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="Background" Value="{Binding SelectedBildchen.BildFürLinks, Converter={StaticResource CLconverterColorBoolianMasterHintergrund}}" />
                    <Style.Triggers>
                        <!--  Alle Bilder verschoben → Rot  -->
                        <DataTrigger Binding="{Binding AlleBilderVerschoben}" Value="True">
                            <Setter Property="Background" Value="#FFE83030" />
                        </DataTrigger>
                        <!--  Bildmodus: Margins weg, volle Fläche, dunkler Hintergrund  -->
                        <DataTrigger Binding="{Binding IsImageMaximiert}" Value="True">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Grid.RowSpan" Value="3" />
                            <Setter Property="Grid.Row" Value="0" />
                            <Setter Property="Background" Value="#FF111111" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!--  Image Display + Hover-Zone unten (blendet Miniaturleiste ein)  -->
            <Grid>
                <ScrollViewer
                    x:Name="scdd"
                    local:FileDragDropHelper.IsFileDragDropEnabled="True"
                    AllowDrop="True"
                    DragEnter="scdd_DragEnter"
                    DragLeave="scdd_DragLeave"
                    Drop="scdd_Drop"
                    HorizontalScrollBarVisibility="{Binding MyHorizontalScrollBarVisibility}"
                    PreviewMouseWheel="Scdd_PreviewMouseWheel"
                    VerticalScrollBarVisibility="{Binding MyHorizontalScrollBarVisibility}">

                    <!--
                        Einzelbild direkt im ScrollViewer: meldet bei Stretch=None seine
                        Pixelgröße -> beide Bildlaufleisten funktionieren korrekt.
                    -->
                    <Image
                        x:Name="imgCurrent"
                        Margin="4,4,4,4"
                        IsManipulationEnabled="True"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        RenderOptions.EdgeMode="Aliased"
                        SizeChanged="imgCurrent_SizeChanged"
                        Source="{Binding DisplayImage}"
                        Stretch="{Binding ImageStretch}"
                        UseLayoutRounding="False">
                        <Image.RenderTransform>
                            <TranslateTransform x:Name="imgShakeTransform" />
                        </Image.RenderTransform>

                        <Image.Effect>
                            <DropShadowEffect
                                BlurRadius="20"
                                Opacity="0.8"
                                ShadowDepth="0"
                                Color="Black" />
                        </Image.Effect>
                    </Image>

                </ScrollViewer>

                <!--  Klickzone links: vorheriges Bild (nur im Vollbild-Modus)  -->
                <Button
                    Width="120"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Panel.ZIndex="10"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding CommandExecuteBildLinksCommand}"
                    Cursor="Arrow"
                    FocusVisualStyle="{x:Null}"
                    Visibility="{Binding IsImageMaximiert, Converter={StaticResource CLconverterVisiblityBoolian}}">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!--  Klickzone rechts: nächstes Bild (nur im Vollbild-Modus)  -->
                <Button
                    Width="120"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Panel.ZIndex="10"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding CommandExecuteBildNachRechtsCommand}"
                    Cursor="Arrow"
                    FocusVisualStyle="{x:Null}"
                    Visibility="{Binding IsImageMaximiert, Converter={StaticResource CLconverterVisiblityBoolian}}">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!--  Schwebende Filmstrip-Leiste: NUR im Vollbild-Modus, bei Hover im unteren Bereich  -->
                <ListBox
                    x:Name="Listbox_SchwebeMiniaturen"
                    Height="110"
                    VerticalAlignment="Bottom"
                    d:ItemsSource="{d:SampleData ItemCount=8}"
                    local:HorizontalListBoxBehavior.CenterSelectedItem="True"
                    local:HorizontalListBoxBehavior.EnableHorizontalMouseWheel="True"
                    IsSynchronizedWithCurrentItem="True"
                    ItemsSource="{Binding AufgabenView}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedBildchen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.VirtualizationMode="Recycling">

                    <!--  Moderne dünne Scrollleiste nur für diese ListBox  -->
                    <ListBox.Resources>
                        <Style TargetType="{x:Type ScrollBar}">
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="OverridesDefaultStyle" Value="True" />
                            <Style.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Height" Value="8" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                <Grid Height="8" Background="Transparent">
                                                    <!--  Track-Hintergrund: sehr dezent  -->
                                                    <Rectangle
                                                        Height="2"
                                                        VerticalAlignment="Center"
                                                        Fill="#33FFFFFF"
                                                        RadiusX="1"
                                                        RadiusY="1" />
                                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton
                                                                Command="ScrollBar.PageLeftCommand"
                                                                Focusable="False"
                                                                Opacity="0" />
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.Thumb>
                                                            <Thumb>
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                                        <Border
                                                                            x:Name="ThBd"
                                                                            Height="4"
                                                                            VerticalAlignment="Center"
                                                                            Background="#88FFFFFF"
                                                                            CornerRadius="2" />
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="ThBd" Property="Height" Value="6" />
                                                                                <Setter TargetName="ThBd" Property="Background" Value="#DDFFFFFF" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsDragging" Value="True">
                                                                                <Setter TargetName="ThBd" Property="Height" Value="8" />
                                                                                <Setter TargetName="ThBd" Property="Background" Value="White" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton
                                                                Command="ScrollBar.PageRightCommand"
                                                                Focusable="False"
                                                                Opacity="0" />
                                                        </Track.IncreaseRepeatButton>
                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Resources>

                    <ListBox.Style>
                        <Style TargetType="{x:Type ListBox}">
                            <Setter Property="Background" Value="#CC0A0A0A" />
                            <Setter Property="BorderBrush" Value="#66FFFFFF" />
                            <Setter Property="BorderThickness" Value="0,1,0,0" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Panel.ZIndex" Value="200" />
                            <Style.Triggers>
                                <!--  Vollbild + Hover in unterer Zone: einblenden  -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsImageMaximiert}" Value="True" />
                                        <Condition Binding="{Binding IsMouseOver, ElementName=BRD_HoverZoneUnten}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                                <!--  Maus direkt auf der Leiste: sichtbar bleiben  -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>

                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding CommandExecuteKleinesBildGrossesBildLadenCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>

                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding CommandExecuteDateiImExplorerÖffnenCommand}" Header="Explorer öffnen" />
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <!--  Kino-Karte: Bild vollständig sichtbar, Letterbox durch dunklen Hintergrund  -->
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:MeinBildchen}">
                            <Grid Width="100" Height="72">
                                <!--  Bild komplett sichtbar, kein Zuschnitt  -->
                                <Border ClipToBounds="True" CornerRadius="5">
                                    <Image Source="{Binding BName, Converter={StaticResource CLconverterStringZuKleinemImage}}" Stretch="Uniform" />
                                </Border>
                                <!--  Vignette unten (Kontrast für Stern-Icon)  -->
                                <Rectangle
                                    Height="28"
                                    VerticalAlignment="Bottom"
                                    RadiusX="5"
                                    RadiusY="5">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Offset="0" Color="#00000000" />
                                            <GradientStop Offset="1" Color="#AA000000" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <!--  Badge: Datei verschoben  -->
                                <Border
                                    Width="18"
                                    Height="18"
                                    Margin="0,4,4,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="#DDCC2222"
                                    CornerRadius="9"
                                    Visibility="{Binding BildFürLinks, Converter={StaticResource CLconverterVisiblityBoolian}}">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="4"
                                            Opacity="0.6"
                                            ShadowDepth="1"
                                            Color="Black" />
                                    </Border.Effect>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="9"
                                        Foreground="White"
                                        Text="&#xE10B;" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <!--  Container: orangefarbener Akzentbalken oben + Glow bei Auswahl  -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="OverridesDefaultStyle" Value="True" />
                            <Setter Property="Margin" Value="4,0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border
                                            x:Name="Bd"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="6">
                                            <Grid>
                                                <ContentPresenter />
                                                <!--  Akzentbalken oben: nur bei Auswahl  -->
                                                <Rectangle
                                                    x:Name="AkzentOben"
                                                    Height="3"
                                                    VerticalAlignment="Top"
                                                    Fill="#FFFF8C00"
                                                    RadiusX="3"
                                                    RadiusY="3"
                                                    Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!--  Ausgewählt: oranger Rahmen + Glow + Balken  -->
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFF8C00" />
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                <Setter TargetName="AkzentOben" Property="Visibility" Value="Visible" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect
                                                            BlurRadius="14"
                                                            Opacity="0.75"
                                                            ShadowDepth="0"
                                                            Color="#FFFF8C00" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <!--  Hover (nicht ausgewählt): heller Rahmen + leichtes Vergrössern  -->
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                    <Condition Property="IsSelected" Value="False" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#88FFFFFF" />
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05" />
                                                    </Setter.Value>
                                                </Setter>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                </ListBox>

                <!--  Hover-Zone unten: Maus hier rein -> Filmstrip kommt nach vorne  -->
                <Border
                    x:Name="BRD_HoverZoneUnten"
                    Height="150"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    IsHitTestVisible="{Binding IsImageMaximiert}" />

                <!--  Drop-Overlay: sichtbar wenn Datei über das Bild gezogen wird  -->
                <Border
                    x:Name="BRD_DropOverlay"
                    Panel.ZIndex="300"
                    Background="#CC111111"
                    BorderBrush="#88FFFFFF"
                    BorderThickness="2"
                    CornerRadius="8"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="48"
                            Foreground="#CCFFFFFF"
                            Text="&#xE896;" />
                        <TextBlock
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#EEFFFFFF"
                            Text="Bild hier ablegen" />
                        <TextBlock
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#88FFFFFF"
                            Text="Alle Bilder im selben Ordner werden geladen" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>


        <!--<RibbonButton
            x:Name="RDBTN_BildNachRechts"
            Grid.Row="1"
            Width="48"
            Height="155"
            Margin="0,0,10,167"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding CommandExecuteBildNachRechtsCommand}"
            Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
            Label="Weiter"
            LargeImageSource="/Images/PfeilNachRechts.png"
            MouseOverBackground="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
            MouseOverBorderBrush="Transparent"
            PressedBackground="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />-->


        <Grid
            Grid.Row="1"
            Width="54"
            Margin="0,137,10,167"
            HorizontalAlignment="Right"
            Background="Transparent"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">

            <!--  Klickfläche  -->
            <RibbonButton
                x:Name="RDBTN_BildNachRechts"
                Grid.Row="1"
                Margin="1,1,1,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                Command="{Binding CommandExecuteBildNachRechtsCommand, Mode=OneWay}"
                CornerRadius="8,8,8,8"
                KeyTip="STRG+D"
                MouseOverBackground="#FFB7F393"
                MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                PressedBackground="#FFCACFFE"
                ToolTip="Nächstes Bild (→)"
                ToolTipService.InitialShowDelay="20000" />

            <!--  Sichtbares Icon  -->
            <Image
                Width="38"
                Height="38"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Source="/Images/PfeilNachRechts.png">

                <Image.Style>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Opacity" Value="1" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=RDBTN_BildNachRechts}" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>

            </Image>
        </Grid>


        <Border
            Grid.Row="1"
            Width="78"
            Height="122"
            Margin="0,10,10,0"
            Padding="2,2,2,2"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderThickness="2,2,2,2"
            CornerRadius="2,2,2,2"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">

            <StackPanel
                Width="70"
                Height="auto"
                Orientation="Vertical">
                <RibbonButton
                    x:Name="BTN_VerschieberRückgängigMachen"
                    Width="40"
                    Height="40"
                    Margin="0,0,0,4"
                    Background="{Binding IsEnabled, Converter={StaticResource CLconverterBrushesBoolian}, RelativeSource={RelativeSource Mode=Self}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    Command="{Binding CommandExecuteVerschiebenZurückCommand, Mode=OneWay}"
                    Foreground="Red"
                    Label="X"
                    LargeImageSource="/Images/Rueckwerts.png"
                    MouseOverBackground="#FFB7F393"
                    MouseOverBorderBrush="#FF49AF0C"
                    PressedBackground="#FFCACFFE" />

                <Image
                    x:Name="image"
                    Width="70"
                    Height="70"
                    Source="{Binding BildchenVorher, Converter={StaticResource CLconverterStringZuKleinemImage}}" />
            </StackPanel>
        </Border>
        <Border
            x:Name="BRD_NachUntenVerschieben"
            Grid.Row="1"
            Width="78"
            Height="auto"
            MaxHeight="156"
            Margin="0,0,10,10"
            Padding="2,2,2,2"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            d:MaxHeight="200"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderThickness="2,2,2,2"
            CornerRadius="2,2,2,2"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <StackPanel
                Width="70"
                Height="auto"
                Orientation="Vertical">
                <Image
                    x:Name="image_Kopieren1"
                    Width="70"
                    Height="auto"
                    MaxHeight="70"
                    Margin="0,0,0,4"
                    Source="{Binding SelectedBildchen.BName, Converter={StaticResource CLconverterStringZuKleinemImage}}"
                    Visibility="{Binding IsEnabled, Converter={StaticResource CLconverterVisiblityBoolian}, ElementName=RDBTN_BildEKeinFav}" />
                <!--  Abbrechen Bilder Verschieben  -->


                <!--  MouseOverBackground="#FFB7F393"  -->
                <RibbonButton
                    x:Name="RDBTN_BildEKeinFav"
                    Width="70"
                    Height="70"
                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteBildInsKeinFavVerzeichnisVerschiebenCommand, Mode=OneWay}"
                    FontFamily="Segoe UI Symbol"
                    KeyTip="&#xE019;"
                    Label="Kein Fav"
                    LargeImageSource="/Images/PfeilNachUnten.png"
                    MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                    PressedBackground="#FFCACFFE">
                    <RibbonButton.MouseOverBackground>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">

                            <!--  verblasstes Grün: war mal wichtig  -->
                            <GradientStop Offset="0.0" Color="#FFB8F5B8" />

                            <!--  Übergang: staubiges Gelb / Amber  -->
                            <GradientStop Offset="0.45" Color="#FFF5D87A" />

                            <!--  Entscheidung kippt  -->
                            <GradientStop Offset="0.75" Color="#FFF0A35E" />

                            <!--  Ziel: unten = schlecht / ablegen  -->
                            <GradientStop Offset="1.0" Color="#FFE57373" />
                        </LinearGradientBrush>
                    </RibbonButton.MouseOverBackground>
                    <RibbonButton.ContextMenu>
                        <ContextMenu>
                            <MenuItem
                                Command="{Binding CommandExecuteAlleBilderInsKeinFavVerschiebenCommand, Mode=OneWay}"
                                Header="Alle Verschieben"
                                ToolTip="Dateien werden kopiert, dann gelöscht, Ab und zu Fehler beim Löschen der Datei" />
                            <!--<MenuItem Header="Aktion 2" />
                            <Separator/>
                            <MenuItem Header="Einstellungen" />-->

                            <MenuItem
                                Command="{Binding CommandExecuteBildInsKIFehlerVerschiebenCommand, Mode=OneWay}"
                                Header="Ins KI Fehler Verzeichnis Verschieben"
                                ToolTip="Selectierte Datei wird ins 'KI Fehler Verzeichnis' verschoben">
                                <MenuItem.Icon>
                                    <Image
                                        Width="20"
                                        Height="20"
                                        Source="/Images/KIFehler.png"
                                        Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>

                        </ContextMenu>
                    </RibbonButton.ContextMenu>
                </RibbonButton>

                <!--  Visibility="{Binding CommandExecuteAlleBilderInsKeinFavVerschiebenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}" />  -->
                <RibbonButton
                    x:Name="RBTN_AbbrechenNixFavVerschieben"
                    Width="40"
                    Height="40"
                    Margin="4,4,4,0"
                    d:Visibility="Visible"
                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                    Command="{Binding CommandExecuteAlleBilderInsKeinFavVerschiebenCancelCommand, Mode=OneWay}"
                    Foreground="Red"
                    LargeImageSource="/Images/Abbrechen.png"
                    MouseOverBackground="#FFB7F393"
                    PressedBackground="#FFCACFFE"
                    Visibility="{Binding CommandExecuteAlleBilderInsKeinFavVerschiebenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}" />
                <ProgressBar
                    Width="60"
                    Height="10"
                    Margin="4,4,4,0"
                    d:Visibility="Visible"
                    Visibility="{Binding CommandExecuteAlleBilderInsKeinFavVerschiebenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}, Mode=OneWay}"
                    Value="{Binding PercentageValueVerschieben}" />
            </StackPanel>
        </Border>

        <!--  Background="{Binding SelectedBildchen.BildFürLinks, Converter={StaticResource CLconverterColorBoolianMasterHintergrund}}"  -->


        <Grid
            Grid.Row="1"
            Width="54"
            Margin="10,172,0,139"
            HorizontalAlignment="Left"
            Background="Transparent"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">

            <RibbonButton
                x:Name="RDBTN_BildNachLinks"
                Height="auto"
                Margin="1,1,1,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
                Command="{Binding CommandExecuteBildLinksCommand, Mode=OneWay}"
                Content="Button"
                CornerRadius="8"
                KeyTip="-"
                MouseOverBackground="#FFB7F393"
                MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                PressedBackground="#FFCACFFE" />

            <!--  Sichtbares Icon  -->
            <Image
                Width="38"
                Height="38"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Source="{StaticResource ResourceKey=di_Ebene_1}">

                <Image.Style>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Opacity" Value="1" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=RDBTN_BildNachLinks}" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </Grid>
        <StackPanel
            Grid.Row="0"
            Height="26"
            MinWidth="24"
            Margin="0,0,10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">


            <TextBlock
                Margin="0,0,7,0"
                VerticalAlignment="Center"
                Background="#FFDCDADA"
                Text="{Binding SelectedBildchen.BName, Converter={StaticResource CLconverterStringZuMB}}" />


            <TextBlock
                x:Name="txtScale"
                Margin="0,0,7,0"
                VerticalAlignment="Center"
                Background="#FFDCDADA"
                Text="12" />
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Background="#FFDCDADA"><Run Text="{Binding OriginalImageWidth, Mode=OneWay, StringFormat=' \{0:D\}'}" /><Run Text=" x " /><Run Text="{Binding OriginalImageHeight, Mode=OneWay, StringFormat=' \{0:D\} '}" /></TextBlock>


            <TextBox
                x:Name="TXB_SuchenInFertige"
                Width="70"
                Height="26"
                Margin="2,0,2,0"
                VerticalContentAlignment="Center"
