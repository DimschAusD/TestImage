<Window
    x:Class="TestImage.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ansichten="clr-namespace:TestImage.Ansichten"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TestImage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="783"
    Background="#FFC9C6C6"
    Icon="/Sternchen.ico"
    PreviewKeyDown="Window_PreviewKeyDown"
    RenderOptions.ClearTypeHint="Enabled"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <Window.DataContext>
        <local:AufgabeViewModel />
    </Window.DataContext>

    <!--
        Fortschritt im Taskleisten-Symbol, für jeden langlaufenden Vorgang.

        Sitzt hier und nicht am Werkzeugfenster der Bildersuche: Das hat
        ShowInTaskbar="False" und damit gar kein Symbol. Ausserdem laufen die Vorgänge
        im ViewModel weiter, wenn das Werkzeugfenster zu ist – genau dann ist diese
        Anzeige die einzige, die man ohne Hinsehen bemerkt.

        Gebunden an dieselbe Fassade wie BRD_AufgabeFortschritt in der Normalansicht,
        damit Symbol und Leiste nicht auseinanderlaufen können.
    -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo
            x:Name="TBI_Fortschritt"
            ProgressValue="{Binding AufgabeFortschritt, Converter={StaticResource ConverterProzentZuAnteil}, Mode=OneWay}">
            <TaskbarItemInfo.ProgressState>
                <MultiBinding Converter="{StaticResource ConverterTaskleistenZustand}" Mode="OneWay">
                    <Binding Path="AufgabeLäuft" />
                    <Binding Path="AufgabeFortschritt" />
                </MultiBinding>
            </TaskbarItemInfo.ProgressState>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>
    <Window.InputBindings>
        <!--
            Strg+D/A/S/W sind entfallen. Die Navigation und das Verschieben laufen über
            die Pfeiltasten (Window_PreviewKeyDown), im Bildmodus zusätzlich über
            Einzelbuchstaben – Übersicht in beiden Ansichten mit F1.
        -->

        <!--  Fenster minimieren  -->
        <KeyBinding Key="Space" Command="{Binding CommandExecuteFensterMinimierenCommand, Mode=OneWay}" />

        <!--  Verschieben rückgängig machen  -->
        <KeyBinding
            Key="Z"
            Command="{Binding CommandExecuteVerschiebenZurückCommand, Mode=OneWay}"
            Modifiers="Ctrl" />

        <!--  Bild maximieren Toggle  -->
        <KeyBinding Key="F11" Command="{Binding CommandExecuteImageMaximierenToggleCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.Style>
            <Style TargetType="{x:Type Grid}">
                <Setter Property="Margin" Value="10,10,10,10" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsImageMaximiert}" Value="True">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="#FF111111" />
                    </DataTrigger>
                    <!--  Dubletten-Ansicht füllt das Fenster randlos aus.  -->
                    <DataTrigger Binding="{Binding IsDublettenAnsicht}" Value="True">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="#FFF6F7F9" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />

            <!--  IMAGE  -->
            <RowDefinition Height="Auto" />
            <!--  StackPanel + ListBox1 + ListBox2  -->
        </Grid.RowDefinitions>

        <!--  NORMALANSICHT (Ziel des schrittweisen Umzugs). Weicht dem Bildmodus und der Dubletten-Ansicht.  -->
        <ansichten:NormalAnsicht
            x:Name="VIEW_Normal"
            Grid.Row="0"
            Grid.RowSpan="3"
            Panel.ZIndex="40">
            <ansichten:NormalAnsicht.Style>
                <Style TargetType="{x:Type ansichten:NormalAnsicht}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsImageMaximiert}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDublettenAnsicht}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ansichten:NormalAnsicht.Style>
        </ansichten:NormalAnsicht>


        <!--  VOLLBILDANSICHT: eigenes Bild + Klickzonen + Filmstrip + Hover + Drop-Overlay. Nur im Bildmodus.  -->
        <ansichten:VollbildAnsicht
            x:Name="VIEW_Vollbild"
            Grid.Row="0"
            Grid.RowSpan="3"
            Panel.ZIndex="50"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource CLconverterVisiblityBoolian}}" />


        <!--  DUBLETTEN-ANSICHT: Byte-Duplikate in anderen Ordnern suchen und aufräumen.  -->
        <ansichten:DublettenAnsicht
            x:Name="VIEW_Dubletten"
            Grid.Row="0"
            Grid.RowSpan="3"
            Panel.ZIndex="60"
            Visibility="{Binding IsDublettenAnsicht, Converter={StaticResource CLconverterVisiblityBoolian}}" />


        <!--
            HIER STANDEN: STP_IndikatorCluster (Webcam/Mikrofon/Bildschirm),
            BTN_DublettenAnsicht und BTN_BildmodusToggle.

            Alle drei schwebten mit Panel.ZIndex="100" über den Ansichten, und ihre Plätze
            hingen an ausgerechneten Rändern von rechts: 136, 100 und 64. Wurde einer
            breiter, musste man die anderen von Hand nachschieben.

            Jetzt gehören sie den Ansichten selbst:

              Normalansicht    STP_KopfleisteRechts — Anzeigen, Bildmodus, Dubletten
              Vollbildansicht  STP_VollbildWerkzeuge — Anzeigen, Bildmodus (schwebend,
                               weil es dort keine Kopfleiste gibt)
              Dubletten        GRD_Kopf — Anzeigen

            Die drei Anzeigen stecken in Ansichten/IndikatorLeiste.xaml und sind damit
            nur einmal geschrieben. Der Bildmodus-Umschalter existiert zweimal, weil er
            in der hellen Kopfleiste und über dem Bild verschieden aussehen muss; beide
            hängen am selben Command, F11 ist unberührt.
        -->

        <!--<RibbonButton
            x:Name="RDBTN_BildNachRechts"
            Grid.Row="1"
            Width="52"
            Height="108"
            Margin="0,0,10,208"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
            Command="{Binding CommandExecuteBildNachRechtsCommand, Mode=OneWay}"
            KeyTip="STRG+D"
            Label="+1 Nach Rechts"
            LargeImageSource="/Images/PfeilNachRechts.png"
            MouseOverBackground="#FFB7F393"
            MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
            PressedBackground="#FFCACFFE" />-->


        <!--
            Tastenübersicht — liegt im Host, damit sie über beiden Ansichten erscheint:
            in der Normalansicht über den Knopf, im Bildmodus über F1.
        -->
        <Border
            x:Name="BRD_TastenHilfe"
            Grid.Row="0"
            Grid.RowSpan="3"
            Padding="26,20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="250"
            d:Visibility="Collapsed"
            Background="#F21A1A1A"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            IsHitTestVisible="False"
            Visibility="{Binding IsVollbildHilfeOffen, Converter={StaticResource CLconverterVisiblityBoolian}}">
            <StackPanel x:Name="STP_TastenHilfe">
                <TextBlock
                    x:Name="TXT_HilfeUeberschrift"
                    Margin="0,0,0,14"
                    FontFamily="Segoe UI"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="Tastensteuerung" />

                <Grid x:Name="GRD_TastenListe">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="COL_Taste" Width="Auto" />
                        <ColumnDefinition x:Name="COL_Bedeutung" Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--  11 Zeilen: eine je Tastenkürzel  -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="TXT_TasteLinksRechts"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,20,7"
                        FontFamily="Consolas"
                        FontSize="13"
                        Foreground="#FFFFC46B"
                        Text="← →" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,0,7"
                        FontSize="13"
                        Foreground="#FFE6E6E6"
                        Text="Vorheriges / nächstes Bild (verschobene werden übersprungen)" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,20,7"
                        FontFamily="Consolas"
                        FontSize="13"
                        Foreground="#FFFFC46B"
                        Text="↓" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,0,7"
                        FontSize="13"
                        Foreground="#FFE6E6E6"
                        Text="Bild nach kein_Fav verschieben" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,0,20,7"
                        FontFamily="Consolas"
                        FontSize="13"
                        Foreground="#FFFFC46B"
                        Text="Shift+↓" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,0,0,7"
                        FontSize="13"
                        Foreground="#FFE6E6E6"
                        Text="Bild in den Ordner „Besonders“" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,0,20,7"
                        FontFamily="Consolas"
                        FontSize="13"
                        Foreground="#FFFFC46B"
                        Text="↑" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,0,0,7"
                        FontSize="13"
                        Foreground="#FFE6E6E6"
                        Text="Bild zurück ins Hauptverzeichnis, sonst letzte Verschiebung rückgängig" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="0,0,20,7"
                        FontFamily="Consolas"
                        FontSize="13"
                        Foreground="#FFFFC46B"
                        Text="K" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="0,0,0,7"
                        FontSize="13"
                        Foreground="#FFE6E6E6"
                        Text="Bild in den KI-Fehler-Ordner   (nur Bildmodus)" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Margin="0,0,20,7"
                        FontFamily="Consolas"
                        FontSize="13"
                        Foreground="#FFFFC46B"
                        Text="S" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="1"
                        Margin="0,0,0,7"
                        FontSize="13"
                        Foreground="#FFE6E6E6"
                        Text="Bildgrösse umschalten   (nur Bildmodus)" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Margin="0,0,20,7"
                        FontFamily="Consolas"
                        FontSize="13"
                        Foreground="#FFFFC46B"
                        Text="E" />
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="1"
                        Margin="0,0,0,7"
                        FontSize="13"
                        Foreground="#FFE6E6E6"
                        Text="Datei im Explorer zeigen   (nur Bildmodus)" />

                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="0"
                        Margin="0,0,20,7"
                        FontFamily="Consolas"
                        FontSize="13"
                        Foreground="#FFFFC46B"
                        Text="R" />
                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="1"
                        Margin="0,0,0,7"
                        FontSize="13"
                        Foreground="#FFE6E6E6"
                        Text="Ordner neu einlesen   (nur Bildmodus)" />

                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="0"
                        Margin="0,0,20,7"
                        FontFamily="Consolas"
                        FontSize="13"
                        Foreground="#FFFFC46B"
                        Text="Strg+Z" />
                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="1"
                        Margin="0,0,0,7"
                        FontSize="13"
                        Foreground="#FFE6E6E6"
                        Text="Verschieben rückgängig" />

                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="0"
                        Margin="0,0,20,7"
                        FontFamily="Consolas"
                        FontSize="13"
                        Foreground="#FFFFC46B"
                        Text="F11" />
                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="1"
                        Margin="0,0,0,7"
                        FontSize="13"
                        Foreground="#FFE6E6E6"
                        Text="Bildmodus verlassen" />

                    <TextBlock
                        Grid.Row="10"
                        Grid.Column="0"
                        Margin="0,0,20,0"
                        FontFamily="Consolas"
                        FontSize="13"
                        Foreground="#FFFFC46B"
                        Text="F1 / Esc" />
                    <TextBlock
                        Grid.Row="10"
                        Grid.Column="1"
                        FontSize="13"
                        Foreground="#FFE6E6E6"
                        Text="Übersicht schliessen (F1 nur im Bildmodus)" />
                </Grid>

                <!--
                    Fassung der Anwendung, als Fussnote unter der Tastenliste.

                    Hier ist ihr Platz: Wer wissen will, was für ein Programm das ist und
                    welcher Stand läuft, schaut in die Hilfe — und um den Platz
                    konkurriert hier nichts. In der Statuszeile steht sie zusätzlich,
                    dort aber klein und grau fürs Nebenbei-Lesen.

                    Eigene Trennlinie darüber, damit sie nicht wie ein weiterer
                    Tastenbefehl gelesen wird.
                -->
                <Border
                    x:Name="BRD_HilfeFusstrenner"
                    Height="1"
                    Margin="0,16,0,10"
                    Background="#33FFFFFF" />

                <TextBlock
                    x:Name="TXT_HilfeVersion"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="#FF9AA0A6"
                    Text="{Binding Version}"
                    TextWrapping="Wrap"
                    d:Text="v2x.0.129.332 Beta 2026-07-18 (.NETCore net10.0)" />
            </StackPanel>
        </Border>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="VisualStateGroup">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="00:00:00">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="0.72" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="0.635" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="-12.6" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="-6.2" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Window>
