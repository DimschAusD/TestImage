                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#FF6B6B6B" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border
                                        x:Name="bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="#33000000"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                Margin="2,3,6,0"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="12"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="&#xE721;" />
                                            <TextBlock
                                                FontFamily="Segoe UI"
                                                FontSize="12"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="Index" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#11000000" />
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#55000000" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#22000000" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSuchleisteOffen}" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#22000000" />
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#55000000" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!--  Bildersuche: schlanke Zeile — als Popup unter dem Button  -->
            <Popup
                x:Name="POP_IndexSuchLeiste"
                AllowsTransparency="True"
                HorizontalOffset="0"
                IsOpen="{Binding IsSuchleisteOffen}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=BTN_IndexSuchleiste}"
                PopupAnimation="Fade"
                StaysOpen="False"
                VerticalOffset="6">
                <bildersuche:IndexSuchPanel Margin="12" />
            </Popup>

        </StackPanel>
        <Button
            x:Name="BTN_OrdnerÖffnen"
            Grid.Row="2"
            Width="25"
            Height="20"
            Margin="0,70,10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Command="{Binding CommandExecuteOrdnerDerAnwendungÖffnenCommand, Mode=OneWay}"
            Content="OÖ"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}" />

        <!--  „Liste": öffnet das Schnell-Listen-Popup (alle Miniaturen zum Finden)  -->
        <Button
            x:Name="BTN_BildListe"
            Grid.Row="2"
            Height="24"
            Margin="29,95,0,0"
            Padding="8,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Command="{Binding CommandExecuteBildListeToggleCommand}"
            Cursor="Hand"
            ToolTip="Alle Bilder als Liste – schnell zu einem Bild springen"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="12"
                    Text="&#xE8FD;" />
                <TextBlock VerticalAlignment="Center" Text="Liste" />
            </StackPanel>
        </Button>

        <!--  Schnell-Liste als Popup, rechtsbündig über der Miniaturleiste  -->
        <Popup
            x:Name="POP_BildListe"
            AllowsTransparency="True"
            IsOpen="{Binding IsBildListeOffen, Mode=TwoWay}"
            Placement="Custom"
            PlacementTarget="{Binding ElementName=Listbox_MiniaturBilder}"
            PopupAnimation="Fade"
            StaysOpen="False">
            <bildersuche:BildListePanel Margin="12" />
        </Popup>
        <Border
            Grid.Row="2"
            Width="34"
            Height="34"
            Margin="8,20,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            BorderBrush="#44000000"
            BorderThickness="0.6"
            CornerRadius="6"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="6"
                    Opacity="0.3"
                    ShadowDepth="1"
                    Color="Black" />
            </Border.Effect>
            <Grid>

                <!--  Links (Left)  -->
                <!--  Position — Windrad-Dreiecke  -->
                <Canvas
                    x:Name="CVS_PositionDreiecke"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ToolTip="Bildposition im Ordner (Viertel-Anzeige)">
                    <Canvas.Effect>
                        <DropShadowEffect
                            BlurRadius="3"
                            Opacity="0.6"
                            ShadowDepth="0"
                            Color="#FF25B2C4" />
                    </Canvas.Effect>
                    <!--  Dreieck 1: Links  -->
                    <Polygon x:Name="PLG_DreieckLinks" Points="10,10 0,20 0,0">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="0">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Dreieck 2: Oben  -->
                    <Polygon x:Name="PLG_DreieckOben" Points="10,10 0,0 20,0">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="1">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Dreieck 3: Rechts  -->
                    <Polygon x:Name="PLG_DreieckRechts" Points="10,10 20,0 20,20">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="2">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Dreieck 4: Unten  -->
                    <Polygon x:Name="PLG_DreieckUnten" Points="10,10 20,20 0,20">
                        <Polygon.Fill>
                            <MultiBinding Converter="{StaticResource ConverterPositionZuDreiecke}" ConverterParameter="3">
                                <Binding Path="AufgabenView.CurrentPosition" />
                                <Binding Path="AufgabenView.Count" />
                            </MultiBinding>
                        </Polygon.Fill>
                    </Polygon>
                    <!--  Trennlinien  -->
                    <Line
                        Stroke="#40000000"
                        StrokeThickness="0.6"
                        X1="0"
                        X2="20"
                        Y1="0"
                        Y2="20" />
                    <Line
                        Stroke="#40000000"
                        StrokeThickness="0.6"
                        X1="20"
                        X2="0"
                        Y1="0"
                        Y2="20" />
                </Canvas>

                <!--  Links (Left)  -->
                <Border
                    Margin="2,2,25,2"
                    d:Background="Gold"
                    CornerRadius="4,0,0,4">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="1">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Oben (Top)  -->
                <Border
                    Margin="2,2,2,25"
                    d:Background="Gold"
                    CornerRadius="4,4,0,0">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="2">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Rechts (Right)  -->
                <Border
                    Margin="25,2,2,2"
                    d:Background="Gold"
                    CornerRadius="0,4,4,0">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="3">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Unten (Bottom)  -->
                <Border
                    Margin="2,25,2,2"
                    d:Background="Gold"
                    CornerRadius="0,0,4,4">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource VerschobenSegmentConverter}" ConverterParameter="4">
                            <Binding Path="CountBildchenFürLinks" />
                            <Binding Path="AufgabenView.Count" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!--  Position — Windrad-Dreiecke  -->

            </Grid>
        </Border>


        <!--  Webcam- und Mikrofon-Indikatoren — nur maximierte Ansicht  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,7,136,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="100"
            Orientation="Horizontal"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource CLconverterVisiblityBoolian}}">

            <!--  Webcam-Indikator  -->
            <Border
                Width="22"
                Height="22"
                Margin="0,0,4,0"
                CornerRadius="4"
                ToolTip="Webcam — grün = wird gerade aufgenommen">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="#22000000" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWebcamAktiv}" Value="True">
                                <Setter Property="Background" Value="#3300C853" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Text" Value="&#xE714;" />
                            <Setter Property="Foreground" Value="#FF888888" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWebcamAktiv}" Value="True">
                                    <Setter Property="Foreground" Value="#FF00C853" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!--  Mikrofon-Indikator  -->
            <Border
                Width="22"
                Height="22"
                Margin="0,0,4,0"
                CornerRadius="4"
                ToolTip="Mikrofon — grün = wird gerade aufgenommen">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="#22000000" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMikrofonAktiv}" Value="True">
                                <Setter Property="Background" Value="#3300C853" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Text" Value="&#xE720;" />
                            <Setter Property="Foreground" Value="#FF888888" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMikrofonAktiv}" Value="True">
                                    <Setter Property="Foreground" Value="#FF00C853" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!--  Screen-Share-Indikator  -->
            <Border
                Width="22"
                Height="22"
                Margin="0,0,6,0"
                CornerRadius="4"
                ToolTip="Bildschirmaufnahme — grün = wird gerade geteilt">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="#22000000" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScreenShareAktiv}" Value="True">
                                <Setter Property="Background" Value="#3300C853" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Text" Value="&#xE7F4;" />
                            <Setter Property="Foreground" Value="#FF888888" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScreenShareAktiv}" Value="True">
                                    <Setter Property="Foreground" Value="#FF00C853" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

        </StackPanel>

        <!--  Schwebender Toggle-Button: Bildmodus umschalten (F11)  -->
        <Button
            x:Name="BTN_BildmodusToggle"
            Grid.Row="0"
            Width="28"
            Height="28"
            Margin="0,4,100,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="100"
            Command="{Binding CommandExecuteImageMaximierenToggleCommand}"
            Cursor="Hand"
            Focusable="False"
            FontFamily="Segoe MDL2 Assets"
            FontSize="14"
            ToolTip="Bildmodus umschalten (F11)">
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Content" Value="&#xE740;" />
                    <Setter Property="Opacity" Value="0.4" />
                    <Setter Property="Background" Value="#88000000" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border
                                    Padding="4"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9" />
                            <Setter Property="Background" Value="#CC007ACC" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsImageMaximiert}" Value="True">
                            <Setter Property="Content" Value="&#xE73F;" />
                            <Setter Property="Opacity" Value="0.6" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <!--<RibbonButton
            x:Name="RDBTN_BildNachRechts"
            Grid.Row="1"
            Width="52"
            Height="108"
            Margin="0,0,10,208"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
            Command="{Binding CommandExecuteBildNachRechtsCommand, Mode=OneWay}"
            KeyTip="STRG+D"
            Label="+1 Nach Rechts"
            LargeImageSource="/Images/PfeilNachRechts.png"
            MouseOverBackground="#FFB7F393"
            MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
            PressedBackground="#FFCACFFE" />-->


        <!--  Filter Breich  -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="VisualStateGroup">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="00:00:00">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="0.72" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="0.635" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="-12.6" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="-6.2" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Window>
