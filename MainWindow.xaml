<Window
    x:Class="TestImage.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ansichten="clr-namespace:TestImage.Ansichten"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TestImage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="783"
    Background="#FFC9C6C6"
    Icon="/Sternchen.ico"
    PreviewKeyDown="Window_PreviewKeyDown"
    mc:Ignorable="d">
    <Window.DataContext>
        <local:AufgabeViewModel />
    </Window.DataContext>
    <Window.InputBindings>
        <!--  Bild nach rechts  -->
        <KeyBinding
            Key="D"
            Command="{Binding CommandExecuteBildNachRechtsCommand, Mode=OneWay}"
            Modifiers="Ctrl" />

        <!--  Bild nach Links  -->
        <KeyBinding
            Key="A"
            Command="{Binding CommandExecuteBildLinksCommand, Mode=OneWay}"
            Modifiers="Ctrl" />

        <!--  Bild nach Unten  -->
        <KeyBinding
            Key="S"
            Command="{Binding CommandExecuteBildInsKeinFavVerzeichnisVerschiebenCommand}"
            Modifiers="Ctrl" />

        <!--  Bild nach Oben  -->
        <KeyBinding
            Key="W"
            Command="{Binding CommandExecuteBildInsHauptVerzeichnisZuruckVerschiebenCommand, Mode=OneWay}"
            Modifiers="Ctrl" />

        <!--  Fenster minimieren  -->
        <KeyBinding Key="Space" Command="{Binding CommandExecuteFensterMinimierenCommand, Mode=OneWay}" />

        <!--  Verschieben rückgängig machen  -->
        <KeyBinding
            Key="Z"
            Command="{Binding CommandExecuteVerschiebenZurückCommand, Mode=OneWay}"
            Modifiers="Ctrl" />

        <!--  Bild maximieren Toggle  -->
        <KeyBinding Key="F11" Command="{Binding CommandExecuteImageMaximierenToggleCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.Style>
            <Style TargetType="{x:Type Grid}">
                <Setter Property="Margin" Value="10,10,10,10" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsImageMaximiert}" Value="True">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="#FF111111" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />

            <!--  IMAGE  -->
            <RowDefinition Height="Auto" />
            <!--  StackPanel + ListBox1 + ListBox2  -->
        </Grid.RowDefinitions>

        <!--  NORMALANSICHT (Ziel des schrittweisen Umzugs). Nur wenn nicht maximiert.  -->
        <ansichten:NormalAnsicht
            x:Name="VIEW_Normal"
            Grid.Row="0"
            Grid.RowSpan="3"
            Panel.ZIndex="40"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}" />


        <!--  VOLLBILDANSICHT: eigenes Bild + Klickzonen + Filmstrip + Hover + Drop-Overlay. Nur im Bildmodus.  -->
        <ansichten:VollbildAnsicht
            x:Name="VIEW_Vollbild"
            Grid.Row="0"
            Grid.RowSpan="3"
            Panel.ZIndex="50"
            Visibility="{Binding IsImageMaximiert, Converter={StaticResource CLconverterVisiblityBoolian}}" />




        <!--  Host-Cluster: Webcam-/Mikrofon-/Screen-Share-Indikatoren, oben rechts neben dem Umschalt-Button, in BEIDEN Modi sichtbar.  -->
        <StackPanel
            x:Name="STP_IndikatorCluster"
            Grid.Row="0"
            Margin="0,7,136,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="100"
            Orientation="Horizontal">

            <!--  Webcam-Indikator  -->
            <Border
                Width="22"
                Height="22"
                Margin="0,0,4,0"
                CornerRadius="4"
                ToolTip="Webcam — grün = wird gerade aufgenommen">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="#22000000" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWebcamAktiv}" Value="True">
                                <Setter Property="Background" Value="#3300C853" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Text" Value="&#xE714;" />
                            <Setter Property="Foreground" Value="#FF888888" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWebcamAktiv}" Value="True">
                                    <Setter Property="Foreground" Value="#FF00C853" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!--  Mikrofon-Indikator  -->
            <Border
                Width="22"
                Height="22"
                Margin="0,0,4,0"
                CornerRadius="4"
                ToolTip="Mikrofon — grün = wird gerade aufgenommen">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="#22000000" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMikrofonAktiv}" Value="True">
                                <Setter Property="Background" Value="#3300C853" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Text" Value="&#xE720;" />
                            <Setter Property="Foreground" Value="#FF888888" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMikrofonAktiv}" Value="True">
                                    <Setter Property="Foreground" Value="#FF00C853" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!--  Screen-Share-Indikator  -->
            <Border
                Width="22"
                Height="22"
                Margin="0,0,6,0"
                CornerRadius="4"
                ToolTip="Bildschirmaufnahme — grün = wird gerade geteilt">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="#22000000" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScreenShareAktiv}" Value="True">
                                <Setter Property="Background" Value="#3300C853" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Text" Value="&#xE7F4;" />
                            <Setter Property="Foreground" Value="#FF888888" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScreenShareAktiv}" Value="True">
                                    <Setter Property="Foreground" Value="#FF00C853" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

        </StackPanel>

        <!--  Schwebender Toggle-Button: Bildmodus umschalten (F11)  -->
        <Button
            x:Name="BTN_BildmodusToggle"
            Grid.Row="0"
            Width="28"
            Height="28"
            Margin="0,4,100,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="100"
            Command="{Binding CommandExecuteImageMaximierenToggleCommand}"
            Cursor="Hand"
            Focusable="False"
            FontFamily="Segoe MDL2 Assets"
            FontSize="14"
            ToolTip="Bildmodus umschalten (F11)">
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Content" Value="&#xE740;" />
                    <Setter Property="Opacity" Value="0.4" />
                    <Setter Property="Background" Value="#88000000" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border
                                    Padding="4"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9" />
                            <Setter Property="Background" Value="#CC007ACC" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsImageMaximiert}" Value="True">
                            <Setter Property="Content" Value="&#xE73F;" />
                            <Setter Property="Opacity" Value="0.6" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <!--<RibbonButton
            x:Name="RDBTN_BildNachRechts"
            Grid.Row="1"
            Width="52"
            Height="108"
            Margin="0,0,10,208"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}"
            Command="{Binding CommandExecuteBildNachRechtsCommand, Mode=OneWay}"
            KeyTip="STRG+D"
            Label="+1 Nach Rechts"
            LargeImageSource="/Images/PfeilNachRechts.png"
            MouseOverBackground="#FFB7F393"
            MouseOverBorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
            PressedBackground="#FFCACFFE" />-->


        <!--  Filter Breich  -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="VisualStateGroup">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="00:00:00">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="0.72" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="0.635" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="-12.6" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                                <EasingDoubleKeyFrame KeyTime="00:00:01" Value="-6.2" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Window>
