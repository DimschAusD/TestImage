<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ALLE SYMBOLE DER ANWENDUNG, in einem Wörterbuch. Neue kommen hier hinein, nicht
        in eine zweite Datei: SVG-Konverter benennen den Schlüssel nach der Ebene, und
        Inkscape nennt sie immer „Ebene 1". Zwei solche Wörterbücher in MergedDictionaries
        melden keinen Fehler — bei doppelten Schlüsseln gewinnt das zuletzt eingebundene,
        und alle Symbole zeigen dieselbe Zeichnung.

        Zeichnungen statt PNG: ein paar hundert Byte je Symbol, scharf bei jeder
        Auflösung und Bildschirmskalierung. Alle Formen sind hier von Hand geschrieben,
        nicht konvertiert — damit ist auch die Herkunftsfrage erledigt.

        MASSSYSTEM: Jedes Symbol zeichnet in einem Feld von 512 x 512. Die Anzeigegrösse
        bestimmt allein das Element, das es benutzt.
    -->

    <!--  ===== Blätter-Pfeile: gefüllte Dreiecke =====  -->

    <DrawingImage x:Key="di_PfeilLinks">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FF101010" Geometry="M 384,64 L 128,256 L 384,448 Z" />
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="di_PfeilRechts">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FF101010" Geometry="M 128,64 L 384,256 L 128,448 Z" />
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="di_PfeilOben">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FF101010" Geometry="M 64,384 L 256,128 L 448,384 Z" />
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ORDNER-SYMBOLE

        Die Lasche links oben ist der Grund, warum gezeichnet und nicht als Schriftzeichen:
        Ohne sie liest sich die Form als Blatt, nicht als Ordner. Segoe UI Symbol und
        Segoe MDL2 Assets haben keinen Ordner mit Lasche.

        Gelb ist Absicht (Ordner-Konvention), trägt die Aussage aber NICHT allein — der
        Inhalt ist schwarz und bleibt ohne Farbsehen erkennbar. Die dunkle Kontur ist
        ebenso wenig Zierrat: Diese Knöpfe werden beim Überfahren hellgrün, und Gelb auf
        Hellgrün ist die am schlechtesten trennbare Paarung, die es gibt.

        Der Umriss steht nur einmal da und wird von beiden Symbolen benutzt — eine
        geänderte Ordnerform trifft damit automatisch alle.
    -->
    <PathGeometry x:Key="geo_OrdnerUmriss" Figures="M 40,132 L 196,132 L 240,186 L 472,186 L 472,438 L 40,438 Z" />

    <Pen
        x:Key="pen_OrdnerKontur"
        Brush="#FF5A4100"
        LineJoin="Round"
        Thickness="22" />

    <!--  Leerer Ordner — Grundlage für Knöpfe, die ihren eigenen Inhalt daraufsetzen  -->
    <DrawingImage x:Key="di_Ordner">
        <DrawingImage.Drawing>
            <GeometryDrawing
                Brush="#FFFFC83D"
                Geometry="{StaticResource geo_OrdnerUmriss}"
                Pen="{StaticResource pen_OrdnerKontur}" />
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  Ordner mit Pfeil heraus — für BTN_OrdnerEineEbeneHoch  -->
    <DrawingImage x:Key="di_OrdnerHoch">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing
                    Brush="#FFFFC83D"
                    Geometry="{StaticResource geo_OrdnerUmriss}"
                    Pen="{StaticResource pen_OrdnerKontur}" />
                <GeometryDrawing Brush="#FF101010" Geometry="M 256,196 L 334,330 L 286,330 L 286,430 L 226,430 L 226,330 L 178,330 Z">
                    <GeometryDrawing.Pen>
                        <Pen
                            Brush="#FF101010"
                            LineJoin="Round"
                            Thickness="4" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="di_PfeilUnten">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FF101010" Geometry="M 64,128 L 448,128 L 256,384 Z" />
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ===== Abbrechen: Kreuz =====

        Zwei gedrehte Rechtecke statt eines Polygons mit zwölf Punkten — so bleiben die
        Armbreite (92) und die abgerundeten Ecken (18) an einer Stelle änderbar.
    -->

    <DrawingImage x:Key="di_Abbrechen">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FFE04358">
                <GeometryDrawing.Pen>
                    <Pen Brush="#FF101010" Thickness="16" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <RectangleGeometry
                            RadiusX="18"
                            RadiusY="18"
                            Rect="210,72,92,368">
                            <RectangleGeometry.Transform>
                                <RotateTransform
                                    Angle="45"
                                    CenterX="256"
                                    CenterY="256" />
                            </RectangleGeometry.Transform>
                        </RectangleGeometry>
                        <RectangleGeometry
                            RadiusX="18"
                            RadiusY="18"
                            Rect="210,72,92,368">
                            <RectangleGeometry.Transform>
                                <RotateTransform
                                    Angle="-45"
                                    CenterX="256"
                                    CenterY="256" />
                            </RectangleGeometry.Transform>
                        </RectangleGeometry>
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  Zweite Fassung ohne Rand, kräftiges Orange — löst Abbrechenn.png ab  -->
    <DrawingImage x:Key="di_AbbrechenOrange">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FFF04A1E">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <RectangleGeometry
                            RadiusX="18"
                            RadiusY="18"
                            Rect="210,72,92,368">
                            <RectangleGeometry.Transform>
                                <RotateTransform
                                    Angle="45"
                                    CenterX="256"
                                    CenterY="256" />
                            </RectangleGeometry.Transform>
                        </RectangleGeometry>
                        <RectangleGeometry
                            RadiusX="18"
                            RadiusY="18"
                            Rect="210,72,92,368">
                            <RectangleGeometry.Transform>
                                <RotateTransform
                                    Angle="-45"
                                    CenterX="256"
                                    CenterY="256" />
                            </RectangleGeometry.Transform>
                        </RectangleGeometry>
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  ===== Gleich: zwei Balken =====  -->

    <DrawingImage x:Key="di_Gleich">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FF101010">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <RectangleGeometry
                            RadiusX="14"
                            RadiusY="14"
                            Rect="72,178,368,62" />
                        <RectangleGeometry
                            RadiusX="14"
                            RadiusY="14"
                            Rect="72,290,368,62" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ===== Ungefähr gleich: zwei Wellen =====

        Als Strich gezeichnet, nicht als Fläche: Eine Welle als Umriss zu beschreiben
        bräuchte die doppelte Punktzahl und müsste bei jeder Änderung der Strichstärke
        neu gerechnet werden.
    -->

    <DrawingImage x:Key="di_UngefaehrGleich">
        <DrawingImage.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen
                        Brush="#FF101010"
                        EndLineCap="Round"
                        StartLineCap="Round"
                        Thickness="52" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <PathGeometry Figures="M 78,196 C 148,110 214,282 284,196 C 330,138 380,182 434,164" />
                        <PathGeometry Figures="M 78,336 C 148,250 214,422 284,336 C 330,278 380,322 434,304" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ===== Treffer-Balken =====

        „Ein Gleicher" zeigt einen hohen Balken zwischen zwei niedrigen, „Viele Gleiche"
        vier Balken auf gleicher Höhe — dieselbe Bildsprache wie die abgelösten PNG.
    -->

    <!--
        Vier gleich hohe Balken zwischen zwei Querbalken, einer davon herausgehoben:
        „einer davon ist der Gleiche". Koordinaten und Farben stammen Wert für Wert aus
        EinGleicher.svg des Nutzers — es ist seine Zeichnung, nur in XAML notiert.

        Der schwarze Rand gehört dazu. Ohne ihn verschmelzen die Balken bei 30 Punkten
        Anzeigegrösse zu einer Fläche, und aus der Fundstelle wird ein Balkendiagramm.
    -->
    <DrawingImage x:Key="di_EinGleicher">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FF0046FF">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF000000" Thickness="3.9" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="35.88,51.09,439.01,24.97" />
                            <RectangleGeometry Rect="36.95,456.04,438.94,25.98" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF002AFF">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF000000" Thickness="4.3" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="52.38,246.81,64.69,199.6" />
                            <RectangleGeometry Rect="213.65,244.71,79.58,201.29" />
                            <RectangleGeometry Rect="320.24,245.26,72.21,199.36" />
                            <RectangleGeometry Rect="410.77,245.42,50.14,197.94" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF0038FF">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF000000" Thickness="4.38" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="128.86,88.17,72.26,195.12" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        Wie di_EinGleicher, aber mit ZWEI herausgehobenen Balken: „mehrere davon sind
        gleich". Genau daran hängt der Unterschied der beiden Zeichen — sind alle Balken
        gleich hoch, sagt das Bild gar nichts mehr.

        Koordinaten und Farben Wert für Wert aus VieleGleiche.svg des Nutzers.
    -->
    <DrawingImage x:Key="di_VieleGleiche">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FF0046FF">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF000000" Thickness="3.9" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="35.88,51.09,439.01,24.97" />
                            <RectangleGeometry Rect="36.95,456.04,438.94,25.98" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF002AFF">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF000000" Thickness="4.3" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="52.37,246.79,64.72,196.37" />
                            <RectangleGeometry Rect="213.63,244.69,79.62,198.07" />
                            <RectangleGeometry Rect="396.87,245.65,63.82,196.4" />
                            <RectangleGeometry Rect="310.44,89.84,72.25,196.14" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF0038FF">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF000000" Thickness="4.38" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="128.86,88.17,72.26,195.12" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ===== Rückgängig =====

        Bogen mit Pfeilspitze. Der Bogen ist ein Strich, die Spitze eine Fläche — beides
        in einer Zeichnung, damit sie sich gemeinsam skalieren.
    -->

    <DrawingImage x:Key="di_Rueckwerts">
        <DrawingImage.Drawing>
            <DrawingGroup>

                <!--
                    Gespiegelt, und das ist der Punkt: Dieselbe Form zeigt ungespiegelt
                    nach rechts und heisst dann „wiederholen". Rückgängig läuft gegen den
                    Uhrzeigersinn, die Spitze nach links.
                -->
                <DrawingGroup.Transform>
                    <ScaleTransform
                        CenterX="256"
                        CenterY="256"
                        ScaleX="-1" />
                </DrawingGroup.Transform>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen
                            Brush="#FF101010"
                            EndLineCap="Flat"
                            StartLineCap="Round"
                            Thickness="58" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 132,286 A 140,140 0 1 0 372,352" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF101010" Geometry="M 132,208 L 132,360 L 242,286 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ===== Skalieren =====

        Quadrat mit Doppelpfeil auf der Diagonalen — das übliche Zeichen fürs Anpassen
        der Grösse.
    -->

    <DrawingImage x:Key="di_Scallieren">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF101010" Thickness="40" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="80,80,352,352" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen
                            Brush="#FF101010"
                            EndLineCap="Flat"
                            StartLineCap="Flat"
                            Thickness="34" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 176,336 L 336,176" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF101010">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <PathGeometry Figures="M 140,372 L 140,252 L 260,372 Z" />
                            <PathGeometry Figures="M 372,140 L 372,260 L 252,140 Z" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  ===== Stern =====  -->

    <DrawingImage x:Key="di_Stern">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!--
                    Beide Sterne aus derselben Rechnung: fünf Zacken, Aussenradius 220
                    gegen Innenradius 92. Der orange Stern ist dieselbe Form auf 138/58
                    verkleinert.

                    Kleiner ginge auch, sieht dann aber aus wie ein Stern *in* einem
                    Stern. Bei diesem Verhältnis reichen die orangen Arme weit genug in
                    die schwarzen hinein, dass es als ein Stern mit Rand gelesen wird.
                -->
                <GeometryDrawing Brush="#FF101010" Geometry="M 256,48 L 310.1,193.6 L 465.2,200 L 343.5,296.4 L 385.3,446 L 256,360 L 126.7,446 L 168.5,296.4 L 46.8,200 L 201.9,193.6 Z" />
                <GeometryDrawing Brush="#FFF08A1E" Geometry="M 256,130 L 290.1,221.1 L 387.2,225.4 L 311.2,285.9 L 337.1,379.6 L 256,326 L 174.9,379.6 L 200.8,285.9 L 124.8,225.4 L 221.9,221.1 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
