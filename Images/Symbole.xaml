<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ALLE SYMBOLE DER ANWENDUNG, in einem Wörterbuch.

        WARUM EINE DATEI UND NICHT EINE JE SYMBOL:

        Der Inkscape-Export nennt seine Ebene „Ebene 1", und der Konverter macht daraus
        den Schlüssel — jede exportierte Datei bekommt also `Ebene_1` und `di_Ebene_1`.
        Bindet man zwei solche Wörterbücher in MergedDictionaries ein, meldet WPF keinen
        Fehler: Bei doppelten Schlüsseln gewinnt schlicht das zuletzt eingebundene. Alle
        Symbole zeigen dann dieselbe Zeichnung. Mit einer Datei kann das nicht passieren.

        WARUM ZEICHNUNGEN UND KEINE PNG:

        Die abgelösten PNG lagen als 2419 x 2419 im Projekt und wurden mit 16 bis 70
        Pixeln angezeigt — zusammen rund 2 MB für Formen, die aus drei bis zwölf Punkten
        bestehen. Hier sind es ein paar hundert Byte je Symbol, und sie bleiben bei jeder
        Auflösung und jeder Bildschirmskalierung scharf.

        ALLE FORMEN SIND HIER GESCHRIEBEN, nicht konvertiert: Dreieck, Kreuz,
        Gleichheitszeichen, Wellen, Balken. Damit ist auch die Herkunftsfrage erledigt.

        MASSSYSTEM: Jedes Symbol zeichnet in einem Feld von 512 x 512. Die Anzeigegrösse
        bestimmt allein das Element, das es benutzt.
    -->

    <!--  ===== Blätter-Pfeile: gefüllte Dreiecke =====  -->

    <DrawingImage x:Key="di_PfeilLinks">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FF101010" Geometry="M 384,64 L 128,256 L 384,448 Z" />
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="di_PfeilRechts">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FF101010" Geometry="M 128,64 L 384,256 L 128,448 Z" />
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="di_PfeilOben">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FF101010" Geometry="M 64,384 L 256,128 L 448,384 Z" />
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="di_PfeilUnten">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FF101010" Geometry="M 64,128 L 448,128 L 256,384 Z" />
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ===== Abbrechen: Kreuz =====

        Zwei gedrehte Rechtecke statt eines Polygons mit zwölf Punkten — so bleiben die
        Armbreite (92) und die abgerundeten Ecken (18) an einer Stelle änderbar.
    -->

    <DrawingImage x:Key="di_Abbrechen">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FFE04358">
                <GeometryDrawing.Pen>
                    <Pen Brush="#FF101010" Thickness="16" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <RectangleGeometry
                            RadiusX="18"
                            RadiusY="18"
                            Rect="210,72,92,368">
                            <RectangleGeometry.Transform>
                                <RotateTransform
                                    Angle="45"
                                    CenterX="256"
                                    CenterY="256" />
                            </RectangleGeometry.Transform>
                        </RectangleGeometry>
                        <RectangleGeometry
                            RadiusX="18"
                            RadiusY="18"
                            Rect="210,72,92,368">
                            <RectangleGeometry.Transform>
                                <RotateTransform
                                    Angle="-45"
                                    CenterX="256"
                                    CenterY="256" />
                            </RectangleGeometry.Transform>
                        </RectangleGeometry>
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  Zweite Fassung ohne Rand, kräftiges Orange — löst Abbrechenn.png ab  -->
    <DrawingImage x:Key="di_AbbrechenOrange">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FFF04A1E">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <RectangleGeometry
                            RadiusX="18"
                            RadiusY="18"
                            Rect="210,72,92,368">
                            <RectangleGeometry.Transform>
                                <RotateTransform
                                    Angle="45"
                                    CenterX="256"
                                    CenterY="256" />
                            </RectangleGeometry.Transform>
                        </RectangleGeometry>
                        <RectangleGeometry
                            RadiusX="18"
                            RadiusY="18"
                            Rect="210,72,92,368">
                            <RectangleGeometry.Transform>
                                <RotateTransform
                                    Angle="-45"
                                    CenterX="256"
                                    CenterY="256" />
                            </RectangleGeometry.Transform>
                        </RectangleGeometry>
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  ===== Gleich: zwei Balken =====  -->

    <DrawingImage x:Key="di_Gleich">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FF101010">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <RectangleGeometry
                            RadiusX="14"
                            RadiusY="14"
                            Rect="72,178,368,62" />
                        <RectangleGeometry
                            RadiusX="14"
                            RadiusY="14"
                            Rect="72,290,368,62" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ===== Ungefähr gleich: zwei Wellen =====

        Als Strich gezeichnet, nicht als Fläche: Eine Welle als Umriss zu beschreiben
        bräuchte die doppelte Punktzahl und müsste bei jeder Änderung der Strichstärke
        neu gerechnet werden.
    -->

    <DrawingImage x:Key="di_UngefaehrGleich">
        <DrawingImage.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen
                        Brush="#FF101010"
                        EndLineCap="Round"
                        StartLineCap="Round"
                        Thickness="52" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <PathGeometry Figures="M 78,196 C 148,110 214,282 284,196 C 330,138 380,182 434,164" />
                        <PathGeometry Figures="M 78,336 C 148,250 214,422 284,336 C 330,278 380,322 434,304" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ===== Treffer-Balken =====

        „Ein Gleicher" zeigt einen hohen Balken zwischen zwei niedrigen, „Viele Gleiche"
        vier Balken auf gleicher Höhe — dieselbe Bildsprache wie die abgelösten PNG.
    -->

    <DrawingImage x:Key="di_EinGleicher">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FF1544D6">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <RectangleGeometry Rect="72,60,368,26" />
                        <RectangleGeometry Rect="72,426,368,26" />
                        <RectangleGeometry Rect="118,300,80,126" />
                        <RectangleGeometry Rect="216,120,80,306" />
                        <RectangleGeometry Rect="314,340,80,86" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="di_VieleGleiche">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FF1544D6">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <RectangleGeometry Rect="72,60,368,26" />
                        <RectangleGeometry Rect="72,426,368,26" />
                        <RectangleGeometry Rect="104,120,68,306" />
                        <RectangleGeometry Rect="192,120,68,306" />
                        <RectangleGeometry Rect="280,120,68,306" />
                        <RectangleGeometry Rect="368,120,68,306" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ===== Rückgängig =====

        Bogen mit Pfeilspitze. Der Bogen ist ein Strich, die Spitze eine Fläche — beides
        in einer Zeichnung, damit sie sich gemeinsam skalieren.
    -->

    <DrawingImage x:Key="di_Rueckwerts">
        <DrawingImage.Drawing>
            <DrawingGroup>

                <!--
                    Gespiegelt, und das ist der Punkt: Dieselbe Form zeigt ungespiegelt
                    nach rechts und heisst dann „wiederholen". Rückgängig läuft gegen den
                    Uhrzeigersinn, die Spitze nach links.
                -->
                <DrawingGroup.Transform>
                    <ScaleTransform
                        CenterX="256"
                        CenterY="256"
                        ScaleX="-1" />
                </DrawingGroup.Transform>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen
                            Brush="#FF101010"
                            EndLineCap="Flat"
                            StartLineCap="Round"
                            Thickness="58" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 132,286 A 140,140 0 1 0 372,352" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF101010" Geometry="M 132,208 L 132,360 L 242,286 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ===== Skalieren =====

        Quadrat mit Doppelpfeil auf der Diagonalen — das übliche Zeichen fürs Anpassen
        der Grösse.
    -->

    <DrawingImage x:Key="di_Scallieren">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF101010" Thickness="40" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="80,80,352,352" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen
                            Brush="#FF101010"
                            EndLineCap="Flat"
                            StartLineCap="Flat"
                            Thickness="34" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 176,336 L 336,176" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF101010">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <PathGeometry Figures="M 140,372 L 140,252 L 260,372 Z" />
                            <PathGeometry Figures="M 372,140 L 372,260 L 252,140 Z" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  ===== Stern =====  -->

    <DrawingImage x:Key="di_Stern">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!--
                    Beide Sterne aus derselben Rechnung: fünf Zacken, Aussenradius 220
                    gegen Innenradius 92. Der orange Stern ist dieselbe Form auf 138/58
                    verkleinert.

                    Kleiner ginge auch, sieht dann aber aus wie ein Stern *in* einem
                    Stern. Bei diesem Verhältnis reichen die orangen Arme weit genug in
                    die schwarzen hinein, dass es als ein Stern mit Rand gelesen wird.
                -->
                <GeometryDrawing Brush="#FF101010" Geometry="M 256,48 L 310.1,193.6 L 465.2,200 L 343.5,296.4 L 385.3,446 L 256,360 L 126.7,446 L 168.5,296.4 L 46.8,200 L 201.9,193.6 Z" />
                <GeometryDrawing Brush="#FFF08A1E" Geometry="M 256,130 L 290.1,221.1 L 387.2,225.4 L 311.2,285.9 L 337.1,379.6 L 256,326 L 174.9,379.6 L 200.8,285.9 L 124.8,225.4 L 221.9,221.1 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
