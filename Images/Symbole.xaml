<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ALLE SYMBOLE DER ANWENDUNG, in einem Wörterbuch. Neue kommen hier hinein, nicht
        in eine zweite Datei: SVG-Konverter benennen den Schlüssel nach der Ebene, und
        Inkscape nennt sie immer „Ebene 1". Zwei solche Wörterbücher in MergedDictionaries
        melden keinen Fehler — bei doppelten Schlüsseln gewinnt das zuletzt eingebundene,
        und alle Symbole zeigen dieselbe Zeichnung.

        Zeichnungen statt PNG: ein paar hundert Byte je Symbol, scharf bei jeder
        Auflösung und Bildschirmskalierung. Alle Formen sind hier von Hand geschrieben,
        nicht konvertiert — damit ist auch die Herkunftsfrage erledigt.

        MASSSYSTEM: Jedes Symbol zeichnet in einem Feld von 512 x 512. Die Anzeigegrösse
        bestimmt allein das Element, das es benutzt.
    -->

    <!--  ===== Blätter-Pfeile: gefüllte Dreiecke =====  -->

    <DrawingImage x:Key="di_PfeilLinks">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FF101010" Geometry="M 384,64 L 128,256 L 384,448 Z" />
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="di_PfeilRechts">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FF101010" Geometry="M 128,64 L 384,256 L 128,448 Z" />
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="di_PfeilOben">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FF101010" Geometry="M 64,384 L 256,128 L 448,384 Z" />
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        Blätter-Pfeile fürs Vollbild: dasselbe Dreieck, aber mit weisser Kontur.

        DERZEIT NICHT VERWENDET: Die Vollbildansicht zeichnet den Pfeil inzwischen selbst
        aus zwei Path-Elementen, weil die Kontur dort beim Auftauchen aus den drei Spitzen
        zuläuft — eine Animation, die ein DrawingImage nicht leisten kann. Diese beiden
        Symbole bleiben als ruhige Fassung stehen, falls die Animation wieder entfällt.

        Im Vollbild liegt der Pfeil direkt auf dem Bild, und dessen Helligkeit ist nicht
        vorhersehbar: auf hellen Motiven trägt die dunkle Füllung, auf dunklen die weisse
        Kontur. Ein Paar aus Schwarz und Weiss ist gegen jeden Untergrund lesbar — derselbe
        Kniff, den der Windows-Fotoanzeiger benutzt.

        Die Kontur sitzt mittig auf dem Rand, die Zeichnung wird dadurch etwas grösser als
        512 x 512; das Dreieck erscheint bei gleicher Anzeigegrösse also minimal kleiner.
        LineJoin="Round" rundet die Spitze, sonst zieht der Gehrungsstoss dort einen Dorn.
    -->

    <DrawingImage x:Key="di_PfeilLinksKontur">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FF101010" Geometry="M 384,64 L 128,256 L 384,448 Z">
                <GeometryDrawing.Pen>
                    <Pen
                        Brush="#FFFFFFFF"
                        LineJoin="Round"
                        Thickness="30" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="di_PfeilRechtsKontur">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FF101010" Geometry="M 128,64 L 384,256 L 128,448 Z">
                <GeometryDrawing.Pen>
                    <Pen
                        Brush="#FFFFFFFF"
                        LineJoin="Round"
                        Thickness="30" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ORDNER-SYMBOLE

        Die Lasche links oben ist der Grund, warum gezeichnet und nicht als Schriftzeichen:
        Ohne sie liest sich die Form als Blatt, nicht als Ordner. Segoe UI Symbol und
        Segoe MDL2 Assets haben keinen Ordner mit Lasche.

        Gelb ist Absicht (Ordner-Konvention), trägt die Aussage aber NICHT allein — der
        Inhalt ist schwarz und bleibt ohne Farbsehen erkennbar. Die dunkle Kontur ist
        ebenso wenig Zierrat: Diese Knöpfe werden beim Überfahren hellgrün, und Gelb auf
        Hellgrün ist die am schlechtesten trennbare Paarung, die es gibt.

        Der Umriss steht nur einmal da und wird von beiden Symbolen benutzt — eine
        geänderte Ordnerform trifft damit automatisch alle.
    -->
    <PathGeometry x:Key="geo_OrdnerUmriss" Figures="M 40,132 L 196,132 L 240,186 L 472,186 L 472,438 L 40,438 Z" />

    <Pen
        x:Key="pen_OrdnerKontur"
        Brush="#FF5A4100"
        LineJoin="Round"
        Thickness="22" />

    <!--  Leerer Ordner — Grundlage für Knöpfe, die ihren eigenen Inhalt daraufsetzen  -->
    <DrawingImage x:Key="di_Ordner">
        <DrawingImage.Drawing>
            <GeometryDrawing
                Brush="#FFFFC83D"
                Geometry="{StaticResource geo_OrdnerUmriss}"
                Pen="{StaticResource pen_OrdnerKontur}" />
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  Ordner mit Pfeil heraus — für BTN_OrdnerEineEbeneHoch  -->
    <DrawingImage x:Key="di_OrdnerHoch">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing
                    Brush="#FFFFC83D"
                    Geometry="{StaticResource geo_OrdnerUmriss}"
                    Pen="{StaticResource pen_OrdnerKontur}" />
                <GeometryDrawing Brush="#FF101010" Geometry="M 256,196 L 334,330 L 286,330 L 286,430 L 226,430 L 226,330 L 178,330 Z">
                    <GeometryDrawing.Pen>
                        <Pen
                            Brush="#FF101010"
                            LineJoin="Round"
                            Thickness="4" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="di_PfeilUnten">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FF101010" Geometry="M 64,128 L 448,128 L 256,384 Z" />
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ===== Abbrechen: X im Kreis =====

        Gefüllter Kreis mit weissem X. Vorher waren es zwei gedrehte Balken in einer
        GeometryGroup — deren FillRule ist in WPF standardmässig EvenOdd, und wo sich
        die Balken überlagerten, blieb eine ausgestanzte Raute leer.

        Der Kreis trägt die Farbe mit viel Fläche: Rot (Abgleich über den ganzen Ordner)
        und Orange (Abgleich mit dem angezeigten Bild) bleiben auch bei 16 Pixeln
        unterscheidbar. Das X ist als Linie mit runden Enden gezogen, nicht als Fläche —
        Striche werden nicht nach FillRule gefüllt, es kann nichts ausgestanzt werden.
    -->

    <DrawingImage x:Key="di_Abbrechen">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFE04358">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry
                            Center="256,256"
                            RadiusX="236"
                            RadiusY="236" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen
                            Brush="White"
                            EndLineCap="Round"
                            StartLineCap="Round"
                            Thickness="56" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="176,176" EndPoint="336,336" />
                            <LineGeometry StartPoint="336,176" EndPoint="176,336" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  Orange Fassung, gleiche Form — löst Abbrechenn.png ab  -->
    <DrawingImage x:Key="di_AbbrechenOrange">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFF04A1E">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry
                            Center="256,256"
                            RadiusX="236"
                            RadiusY="236" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen
                            Brush="White"
                            EndLineCap="Round"
                            StartLineCap="Round"
                            Thickness="56" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="176,176" EndPoint="336,336" />
                            <LineGeometry StartPoint="336,176" EndPoint="176,336" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  ===== Gleich: zwei Balken =====  -->

    <DrawingImage x:Key="di_Gleich">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#FF101010">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <RectangleGeometry
                            RadiusX="14"
                            RadiusY="14"
                            Rect="72,178,368,62" />
                        <RectangleGeometry
                            RadiusX="14"
                            RadiusY="14"
                            Rect="72,290,368,62" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ===== Ungefähr gleich: zwei Wellen =====

        Als Strich gezeichnet, nicht als Fläche: Eine Welle als Umriss zu beschreiben
        bräuchte die doppelte Punktzahl und müsste bei jeder Änderung der Strichstärke
        neu gerechnet werden.
    -->

    <DrawingImage x:Key="di_UngefaehrGleich">
        <DrawingImage.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen
                        Brush="#FF101010"
                        EndLineCap="Round"
                        StartLineCap="Round"
                        Thickness="52" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <PathGeometry Figures="M 78,196 C 148,110 214,282 284,196 C 330,138 380,182 434,164" />
                        <PathGeometry Figures="M 78,336 C 148,250 214,422 284,336 C 330,278 380,322 434,304" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ===== Treffer-Balken =====

        „Ein Gleicher" zeigt einen hohen Balken zwischen zwei niedrigen, „Viele Gleiche"
        vier Balken auf gleicher Höhe — dieselbe Bildsprache wie die abgelösten PNG.
    -->

    <!--
        Vier gleich hohe Balken zwischen zwei Querbalken, einer davon herausgehoben:
        „einer davon ist der Gleiche". Koordinaten und Farben stammen Wert für Wert aus
        EinGleicher.svg des Nutzers — es ist seine Zeichnung, nur in XAML notiert.

        Der schwarze Rand gehört dazu. Ohne ihn verschmelzen die Balken bei 30 Punkten
        Anzeigegrösse zu einer Fläche, und aus der Fundstelle wird ein Balkendiagramm.
    -->
    <DrawingImage x:Key="di_EinGleicher">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FF0046FF">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF000000" Thickness="3.9" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="35.88,51.09,439.01,24.97" />
                            <RectangleGeometry Rect="36.95,456.04,438.94,25.98" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF002AFF">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF000000" Thickness="4.3" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="52.38,246.81,64.69,199.6" />
                            <RectangleGeometry Rect="213.65,244.71,79.58,201.29" />
                            <RectangleGeometry Rect="320.24,245.26,72.21,199.36" />
                            <RectangleGeometry Rect="410.77,245.42,50.14,197.94" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF0038FF">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF000000" Thickness="4.38" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="128.86,88.17,72.26,195.12" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        Wie di_EinGleicher, aber mit ZWEI herausgehobenen Balken: „mehrere davon sind
        gleich". Genau daran hängt der Unterschied der beiden Zeichen — sind alle Balken
        gleich hoch, sagt das Bild gar nichts mehr.

        Koordinaten und Farben Wert für Wert aus VieleGleiche.svg des Nutzers.
    -->
    <DrawingImage x:Key="di_VieleGleiche">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FF0046FF">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF000000" Thickness="3.9" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="35.88,51.09,439.01,24.97" />
                            <RectangleGeometry Rect="36.95,456.04,438.94,25.98" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF002AFF">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF000000" Thickness="4.3" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="52.37,246.79,64.72,196.37" />
                            <RectangleGeometry Rect="213.63,244.69,79.62,198.07" />
                            <RectangleGeometry Rect="396.87,245.65,63.82,196.4" />
                            <RectangleGeometry Rect="310.44,89.84,72.25,196.14" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF0038FF">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF000000" Thickness="4.38" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="128.86,88.17,72.26,195.12" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ===== Rückgängig =====

        Bogen mit Pfeilspitze. Der Bogen ist ein Strich, die Spitze eine Fläche — beides
        in einer Zeichnung, damit sie sich gemeinsam skalieren.
    -->

    <DrawingImage x:Key="di_Rueckwerts">
        <DrawingImage.Drawing>
            <DrawingGroup>

                <!--
                    Gespiegelt, und das ist der Punkt: Dieselbe Form zeigt ungespiegelt
                    nach rechts und heisst dann „wiederholen". Rückgängig läuft gegen den
                    Uhrzeigersinn, die Spitze nach links.
                -->
                <DrawingGroup.Transform>
                    <ScaleTransform
                        CenterX="256"
                        CenterY="256"
                        ScaleX="-1" />
                </DrawingGroup.Transform>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen
                            Brush="#FF101010"
                            EndLineCap="Flat"
                            StartLineCap="Round"
                            Thickness="58" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 132,286 A 140,140 0 1 0 372,352" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF101010" Geometry="M 132,208 L 132,360 L 242,286 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ===== Skalieren =====

        Quadrat mit Doppelpfeil auf der Diagonalen — das übliche Zeichen fürs Anpassen
        der Grösse.
    -->

    <DrawingImage x:Key="di_Scallieren">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF101010" Thickness="40" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="80,80,352,352" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen
                            Brush="#FF101010"
                            EndLineCap="Flat"
                            StartLineCap="Flat"
                            Thickness="34" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 176,336 L 336,176" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF101010">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <PathGeometry Figures="M 140,372 L 140,252 L 260,372 Z" />
                            <PathGeometry Figures="M 372,140 L 372,260 L 252,140 Z" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  ===== Stern =====  -->

    <DrawingImage x:Key="di_Stern">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!--
                    Beide Sterne aus derselben Rechnung: fünf Zacken, Aussenradius 220
                    gegen Innenradius 92. Der orange Stern ist dieselbe Form auf 138/58
                    verkleinert.

                    Kleiner ginge auch, sieht dann aber aus wie ein Stern *in* einem
                    Stern. Bei diesem Verhältnis reichen die orangen Arme weit genug in
                    die schwarzen hinein, dass es als ein Stern mit Rand gelesen wird.
                -->
                <GeometryDrawing Brush="#FF101010" Geometry="M 256,48 L 310.1,193.6 L 465.2,200 L 343.5,296.4 L 385.3,446 L 256,360 L 126.7,446 L 168.5,296.4 L 46.8,200 L 201.9,193.6 Z" />
                <GeometryDrawing Brush="#FFF08A1E" Geometry="M 256,130 L 290.1,221.1 L 387.2,225.4 L 311.2,285.9 L 337.1,379.6 L 256,326 L 174.9,379.6 L 200.8,285.9 L 124.8,225.4 L 221.9,221.1 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ===== Maus: Mausrad, linke und rechte Taste =====

        Hell (#FFE4E4E4) für den dunklen Grund des Erklärfelds in der Vollbildansicht,
        dieselbe Farbe wie dessen Text. Gebraucht woanders auf hellem Grund, bekäme es
        eine eigene dunkle Fassung mit eigenem Schlüssel.

        Gemeinsamer Körper: aussen 128..384 breit, oben ein Halbkreis um (256,192),
        unten einer um (256,360), Radius 128. Die Tastenfelder trennt eine Linie bei
        y = 236, die Tasten untereinander eine senkrechte bei x = 256. Beim Mausrad liegt
        die Trennlinie tiefer (277), damit oben Platz für den Doppelpfeil bleibt.

        Die durchsichtige Fläche über das ganze Feld hält die Grenzen aller drei
        Zeichnungen gleich — sonst bestimmten die Klickstriche die Grösse, und die
        drei Mäuse stünden neben Text verschieden gross und verschieden hoch.
    -->
    <Pen
        x:Key="pen_MausKontur"
        Brush="#FFE4E4E4"
        EndLineCap="Round"
        LineJoin="Round"
        StartLineCap="Round"
        Thickness="34" />

    <PathGeometry x:Key="geo_MausKörper" Figures="M 128,192 A 128,128 0 0 1 384,192 L 384,360 A 128,128 0 0 1 128,360 Z" />

    <DrawingImage x:Key="di_MausRad">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 512,0 L 512,512 L 0,512 Z" />
                <GeometryDrawing Geometry="{StaticResource geo_MausKörper}" Pen="{StaticResource pen_MausKontur}" />
                <GeometryDrawing Geometry="M 128,277 L 384,277" Pen="{StaticResource pen_MausKontur}" />
                <!--  Doppelpfeil: rollen geht in beide Richtungen  -->
                <GeometryDrawing Geometry="M 256,111 L 256,230 M 218,149 L 256,111 L 294,149 M 218,192 L 256,230 L 294,192" Pen="{StaticResource pen_MausKontur}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="di_MausLinks">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 512,0 L 512,512 L 0,512 Z" />
                <!--  Linke Taste gefüllt, darüber links drei Klickstriche  -->
                <GeometryDrawing Brush="#FFE4E4E4" Geometry="M 128,236 L 128,192 A 128,128 0 0 1 256,64 L 256,236 Z" />
                <GeometryDrawing Geometry="{StaticResource geo_MausKörper}" Pen="{StaticResource pen_MausKontur}" />
                <GeometryDrawing Geometry="M 128,236 L 384,236 M 256,64 L 256,236" Pen="{StaticResource pen_MausKontur}" />
                <GeometryDrawing Geometry="M 90,17 L 90,49 M 30,41 L 53,64 M 13,102 L 45,102" Pen="{StaticResource pen_MausKontur}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="di_MausRechts">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 512,0 L 512,512 L 0,512 Z" />
                <!--  Spiegelbild von di_MausLinks: rechte Taste gefüllt, Klickstriche rechts  -->
                <GeometryDrawing Brush="#FFE4E4E4" Geometry="M 384,236 L 384,192 A 128,128 0 0 0 256,64 L 256,236 Z" />
                <GeometryDrawing Geometry="{StaticResource geo_MausKörper}" Pen="{StaticResource pen_MausKontur}" />
                <GeometryDrawing Geometry="M 128,236 L 384,236 M 256,64 L 256,236" Pen="{StaticResource pen_MausKontur}" />
                <GeometryDrawing Geometry="M 422,17 L 422,49 M 482,41 L 459,64 M 499,102 L 467,102" Pen="{StaticResource pen_MausKontur}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
