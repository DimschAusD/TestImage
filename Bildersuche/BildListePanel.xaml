<UserControl
    x:Class="TestImage.Bildersuche.BildListePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TestImage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="630"
    IsVisibleChanged="UserControl_IsVisibleChanged"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:CLconverterVisiblityBoolian x:Key="CLconverterVisiblityBoolian" />

        <!--  Eine Kachel (ein BildListeItem)  -->
        <DataTemplate x:Key="KachelTemplate">
            <Button
                Margin="0,0,4,4"
                Command="{Binding DataContext.CommandExecuteZuBildSpringenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                CommandParameter="{Binding Bild}"
                Cursor="Hand"
                ToolTip="{Binding Bild.BName}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="rahmen"
                            Padding="2"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="8">
                            <Grid Width="104" Height="78">
                                <Border
                                    Background="#FF1A1A1A"
                                    BorderBrush="#FFDADADA"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    CornerRadius="6">
                                    <Image Source="{Binding Thumb}" Stretch="Uniform" />
                                </Border>
                                <!--  Badge: Bild wurde verschoben  -->
                                <Border
                                    Width="18"
                                    Height="18"
                                    Margin="0,4,4,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="#DDCC2222"
                                    CornerRadius="9"
                                    Visibility="{Binding Bild.BildFürLinks, Converter={StaticResource CLconverterVisiblityBoolian}}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="9"
                                        Foreground="White"
                                        Text="&#xE10B;" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rahmen" Property="BorderBrush" Value="#FF9DBEF0" />
                            </Trigger>
                            <!--  Aktuell gewähltes Bild markieren  -->
                            <DataTrigger Binding="{Binding IsAktuell}" Value="True">
                                <Setter TargetName="rahmen" Property="BorderBrush" Value="#FF007ACC" />
                                <Setter TargetName="rahmen" Property="Background" Value="#FFDDE6FA" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!--  Eine Zeile (IReadOnlyList&lt;BildListeItem&gt;)  -->
        <DataTemplate x:Key="ZeileTemplate">
            <ItemsControl ItemTemplate="{StaticResource KachelTemplate}" ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <Border
        x:Name="BRD_ListeRahmen"
        Background="#FFFFFFFF"
        BorderBrush="#FFE3E3E3"
        BorderThickness="1"
        CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="18"
                Opacity="0.22"
                ShadowDepth="2"
                Color="Black" />
        </Border.Effect>

        <StackPanel Margin="8" Orientation="Vertical">

            <!--  Kopfzeile  -->
            <TextBlock
                x:Name="TXT_ListeTitel"
                Margin="2,0,0,4"
                d:Text="1150 Bilder · zum gewünschten scrollen und anklicken"
                FontFamily="Segoe UI"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="#FF2B2B2B"
                Text="{Binding AufgabenView.Count, StringFormat={}{0} Bilder}" />

            <!--  Ladeindikator: Vorschaubilder werden im Hintergrund geladen  -->
            <ProgressBar
                x:Name="PGB_BildListeLaedt"
                Height="3"
                Margin="2,0,2,6"
                d:Visibility="Collapsed"
                IsIndeterminate="True"
                Visibility="{Binding BildListeLaedt, Converter={StaticResource CLconverterVisiblityBoolian}}" />

            <!--  Zeilenweise virtualisierte Liste (nur sichtbare Zeilen werden erzeugt)  -->
            <ListBox
                x:Name="LBX_BildListe"
                MaxHeight="440"
                Background="Transparent"
                BorderThickness="0"
                ItemTemplate="{StaticResource ZeileTemplate}"
                ItemsSource="{Binding BildListeZeilen}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding AktuelleZeile, Mode=TwoWay}"
                SelectionChanged="LBX_BildListe_SelectionChanged"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling"
                d:Visibility="Collapsed">

                <!--  Keine Zeilen-Markierung: Auswahl zeigen wir pro Kachel (IsAktuell)  -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!--  Nur im XAML-Designer sichtbar: Platzhalter-Raster (Laufzeit: ausgeblendet)  -->
            <StackPanel Visibility="Collapsed" d:Visibility="Visible">
                <StackPanel Orientation="Horizontal">
                    <Border Width="104" Height="78" Margin="0,0,4,4" Background="#FF2A2A2A" BorderBrush="#FFDADADA" BorderThickness="1" CornerRadius="6" />
                    <Border Width="104" Height="78" Margin="0,0,4,4" Background="#FF2A2A2A" BorderBrush="#FF007ACC" BorderThickness="2" CornerRadius="6" />
                    <Border Width="104" Height="78" Margin="0,0,4,4" Background="#FF2A2A2A" BorderBrush="#FFDADADA" BorderThickness="1" CornerRadius="6" />
                    <Border Width="104" Height="78" Margin="0,0,4,4" Background="#FF2A2A2A" BorderBrush="#FFDADADA" BorderThickness="1" CornerRadius="6" />
                    <Border Width="104" Height="78" Margin="0,0,4,4" Background="#FF2A2A2A" BorderBrush="#FFDADADA" BorderThickness="1" CornerRadius="6" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="104" Height="78" Margin="0,0,4,4" Background="#FF2A2A2A" BorderBrush="#FFDADADA" BorderThickness="1" CornerRadius="6" />
                    <Border Width="104" Height="78" Margin="0,0,4,4" Background="#FF2A2A2A" BorderBrush="#FFDADADA" BorderThickness="1" CornerRadius="6" />
                    <Border Width="104" Height="78" Margin="0,0,4,4" Background="#FF2A2A2A" BorderBrush="#FFDADADA" BorderThickness="1" CornerRadius="6" />
                    <Border Width="104" Height="78" Margin="0,0,4,4" Background="#FF2A2A2A" BorderBrush="#FFDADADA" BorderThickness="1" CornerRadius="6" />
                    <Border Width="104" Height="78" Margin="0,0,4,4" Background="#FF2A2A2A" BorderBrush="#FFDADADA" BorderThickness="1" CornerRadius="6" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="104" Height="78" Margin="0,0,4,4" Background="#FF2A2A2A" BorderBrush="#FFDADADA" BorderThickness="1" CornerRadius="6" />
                    <Border Width="104" Height="78" Margin="0,0,4,4" Background="#FF2A2A2A" BorderBrush="#FFDADADA" BorderThickness="1" CornerRadius="6" />
                    <Border Width="104" Height="78" Margin="0,0,4,4" Background="#FF2A2A2A" BorderBrush="#FFDADADA" BorderThickness="1" CornerRadius="6" />
                    <Border Width="104" Height="78" Margin="0,0,4,4" Background="#FF2A2A2A" BorderBrush="#FFDADADA" BorderThickness="1" CornerRadius="6" />
                    <Border Width="104" Height="78" Margin="0,0,4,4" Background="#FF2A2A2A" BorderBrush="#FFDADADA" BorderThickness="1" CornerRadius="6" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
