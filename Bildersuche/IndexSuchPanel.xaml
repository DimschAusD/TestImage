<UserControl
    x:Class="TestImage.Bildersuche.IndexSuchPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bs="clr-namespace:TestImage.Bildersuche"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TestImage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignWidth="1020"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:CLconverterVisiblityBoolian x:Key="CLconverterVisiblityBoolian" />
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF2B2B2B" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#FFDADADA"
                            BorderThickness="1"
                            CornerRadius="7"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF5F5F5" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFBABABA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFEBEBEB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Linke Hälfte eines geteilten Knopfes: gleiches Aussehen wie OutlineButtonStyle,
            aber ohne eigenen Rahmen und nur links abgerundet. Den Rahmen zieht die Klammer
            aussen herum, damit Knopf und Aufklappteil als ein Stück wirken.
        -->
        <Style
            x:Key="SplitHauptButtonStyle"
            BasedOn="{StaticResource OutlineButtonStyle}"
            TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6,0,0,6"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF5F5F5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFEBEBEB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        Rand durchsichtig: Das Panel sass früher in einem Popup und brauchte dort eine
        eigene Kante, um sich vom Fenster dahinter abzuheben. Im eigenen Fenster ist die
        Kante überflüssig und liegt als zweiter Rahmen direkt neben dem Fensterrahmen.
        
        Die Stärke bleibt bei 1, damit sich die Innenmasse nicht um einen Punkt verschieben.
    -->
    <Border
        x:Name="BRD_PanelRahmen"
        Background="#FFFFFFFF"
        BorderBrush="Transparent"
        BorderThickness="1"
        CornerRadius="10">

        <!--
            Linksbündig statt gedehnt: Sonst nehmen die Karten darunter die volle
            Fensterbreite an, während die Werkzeugleiste bei ihrer Wunschbreite stehen
            bleibt — die Karten ragten rechts über BRD_SchemaHilfe hinaus. So richtet
            sich der ganze Stapel nach dem breitesten Kind, und die rechte Kante
            stimmt bei jeder Fensterbreite.
        -->
        <StackPanel
            x:Name="STP_Inhalt"
            Margin="6"
            HorizontalAlignment="Left"
            Orientation="Vertical">

            <!--
                Die Griffleiste zum Verschieben ist entfallen: Sie diente dem Popup, das
                keine Titelleiste hatte. Das Werkzeugfenster verschiebt man an seiner
                eigenen Titelleiste.
            -->
            <StackPanel
                x:Name="STP_Werkzeugleiste"
                VerticalAlignment="Center"
                Orientation="Horizontal">

                <!--  Index-Button (umrandet)  -->
                <Button
                    x:Name="BTN_IndexOrdnerErstellen"
                    Command="{Binding CommandExecuteOrdnerIndexierenCommand}"
                    Style="{StaticResource OutlineButtonStyle}"
                    ToolTip="Ordner des gewählten Bildes indexieren (CLIP-Embeddings für Suche erstellen)">
                    <StackPanel x:Name="STP_IndexInhalt" Orientation="Horizontal">
                        <TextBlock
                            x:Name="TXT_IndexIcon"
                            Margin="0,1,1,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="13"
                            Text="&#xE8B7;" />
                        <TextBlock
                            x:Name="TXT_IndexPlusIcon"
                            Margin="0,0,7,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="8"
                            FontWeight="Bold"
                            Text="&#xE710;" />
                        <TextBlock
                            x:Name="TXT_IndexLabel"
                            VerticalAlignment="Center"
                            Text="Index" />
                    </StackPanel>
                </Button>

                <!--  Suchfeld: Eingabe + grauer Vorschlag links, Such-Button rechts  -->
                <Border
                    x:Name="BRD_Suchfeld"
                    Width="300"
                    Height="34"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center"
                    Background="#FFFFFFFF"
                    BorderBrush="#FFDADADA"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid x:Name="GRD_Suchfeld">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Eingabe + grauer Beispiel-/Autovervollständigungs-Vorschlag  -->
                        <Grid
                            x:Name="GRD_Eingabe"
                            Grid.Column="0"
                            Margin="10,0,4,0">

                            <!--  Ghost: getippter Teil transparent, Rest grau (Tab übernimmt)  -->
                            <TextBlock
                                x:Name="TXT_SucheGhost"
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe UI"
                                FontSize="14"
                                IsHitTestVisible="False"
                                TextTrimming="CharacterEllipsis"><Run Foreground="Transparent" Text="{Binding SucheText, Mode=OneWay}" /><Run Foreground="#FFC7C7C7" Text="{Binding SucheVorschlagRest, Mode=OneWay}" /></TextBlock>

                            <TextBox
                                x:Name="TXT_Suche"
                                Padding="0"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="Segoe UI"
                                FontSize="14"
                                Foreground="#FF2B2B2B"
                                PreviewKeyDown="TXT_Suche_PreviewKeyDown"
                                Text="{Binding SucheText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CommandExecuteFreitextSucheCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <TextBlock
                                x:Name="TXT_SuchePlatzhalter"
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe UI"
                                FontSize="14"
                                Foreground="#FFB0B0B0"
                                IsHitTestVisible="False"
                                Text="z. B. Steine am Strand">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SucheText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!--  Vorschlagsliste (Google-Style Autocomplete)  -->
                        <Popup
                            x:Name="POP_Vorschlaege"
                            AllowsTransparency="True"
                            IsOpen="{Binding VorschlaegeOffen}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=TXT_Suche}"
                            StaysOpen="False">
                            <Border
                                x:Name="BRD_Vorschlaege"
                                MinWidth="200"
                                Background="White"
                                BorderBrush="#FFD0D0D0"
                                BorderThickness="1"
                                CornerRadius="0,0,8,8">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="8"
                                        Opacity="0.15"
                                        ShadowDepth="2" />
                                </Border.Effect>
                                <ListBox
                                    x:Name="LBX_Vorschlaege"
                                    MaxHeight="260"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding SucheVorschlaege}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,6" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="FontFamily" Value="Segoe UI" />
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="Foreground" Value="#FF333333" />
                                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Vorschlag_Click" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FFEEF1FB" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>

                        <!--  Such-Button (Auslöser) – weicht dem Abbrechen-Spinner, solange gesucht wird  -->
                        <Button
                            x:Name="BTN_Suchen"
                            Grid.Column="1"
                            Width="36"
                            Command="{Binding CommandExecuteFreitextSucheCommand}"
                            Cursor="Hand"
                            ToolTip="Suchen"
                            Visibility="{Binding CommandExecuteFreitextSucheCommand.IsRunning, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="sb"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="0,7,7,0">
                                                    <TextBlock
                                                        x:Name="TXT_SuchLupe"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="15"
                                                        Foreground="#FF5C6BC0"
                                                        Text="&#xE721;" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="sb" Property="Background" Value="#FFEEF1FB" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="sb" Property="Background" Value="#FFDDE3F7" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!--
                            Läuft die Suche, sitzt hier der drehende Kreispfeil – klickbar zum
                            Abbrechen. Beim Überfahren wechselt er zum X, damit erkennbar ist,
                            dass der Klick abbricht und nicht neu sucht.
                        -->
                        <Button
                            x:Name="BTN_SucheAbbrechen"
                            Grid.Column="1"
                            Width="36"
                            d:Visibility="Visible"
                            Command="{Binding CommandExecuteFreitextSucheCancelCommand}"
                            Cursor="Hand"
                            ToolTip="Suche abbrechen"
                            Visibility="{Binding CommandExecuteFreitextSucheCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="ab"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="0,7,7,0">
                                                    <Grid x:Name="GRD_AbbrechenIkone">
                                                        <!--  Drehender Kreispfeil  -->
                                                        <TextBlock
                                                            x:Name="TXT_SuchSpinner"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="14"
                                                            Foreground="#FF5C6BC0"
                                                            RenderTransformOrigin="0.5,0.5"
                                                            Text="&#xE72C;">
                                                            <TextBlock.RenderTransform>
                                                                <RotateTransform Angle="0" />
                                                            </TextBlock.RenderTransform>
                                                        </TextBlock>

                                                        <!--  Nur bei Hover: Abbrechen-X  -->
                                                        <TextBlock
                                                            x:Name="TXT_AbbrechenX"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="12"
                                                            Foreground="#FFC62828"
                                                            Text="&#xE711;"
                                                            Visibility="Collapsed" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <!--  Dreht, solange die Suche läuft.  -->
                                                    <DataTrigger Binding="{Binding CommandExecuteFreitextSucheCommand.IsRunning}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="SB_SuchSpinner">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="TXT_SuchSpinner"
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                        From="0"
                                                                        To="360"
                                                                        Duration="0:0:0.9" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="SB_SuchSpinner" />
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>

                                                    <!--  Maus darüber: X statt Spinner, damit die Klickwirkung klar ist.  -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ab" Property="Background" Value="#FFFDECEC" />
                                                        <Setter TargetName="TXT_SuchSpinner" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="TXT_AbbrechenX" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="ab" Property="Background" Value="#FFF9D8D8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!--
                            Dünne Fortschrittslinie am unteren Rand des Suchfelds (Browser-Stil):
                            auch wahrnehmbar, wenn der Blick auf der Ergebnisliste liegt.
                            Marquee während Modell/Index, echter Balken beim Laden der Miniaturen.
                            Seitliches Margin hält sie innerhalb der abgerundeten Ecken.
                        -->
                        <ProgressBar
                            x:Name="PGB_SuchfeldLinie"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Height="2"
                            Margin="8,0,8,2"
                            VerticalAlignment="Bottom"
                            Panel.ZIndex="10"
                            d:Value="45"
                            d:Visibility="Visible"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FF5C6BC0"
                            IsIndeterminate="{Binding SuchfeldIndeterminate}"
                            Maximum="100"
                            Minimum="0"
                            Visibility="{Binding CommandExecuteFreitextSucheCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}}"
                            Value="{Binding SuchfeldFortschritt}" />
                    </Grid>
                </Border>

                <!--  Filter-Toggle: Regler + Chevron (öffnet das Popover)  -->
                <Button
                    x:Name="BTN_FilterToggle"
                    Command="{Binding CommandExecuteFilterPopoverToggleCommand}"
                    Style="{StaticResource OutlineButtonStyle}"
                    ToolTip="Filter, Tags und Werkzeuge einblenden">
                    <StackPanel x:Name="STP_FilterToggleInhalt" Orientation="Horizontal">
                        <TextBlock
                            x:Name="TXT_FilterIcon"
                            Margin="0,1,6,0"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Text="&#xE9E9;" />
                        <TextBlock
                            x:Name="TXT_FilterChevron"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            RenderTransformOrigin="0.5,0.5">
                            <TextBlock.Text>&#xE70D;</TextBlock.Text>
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="chevronRotate" Angle="0" />
                            </TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIndexPopoverOffen}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            To="180"
                                                            Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            To="0"
                                                            Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <TextBlock
                    x:Name="TXT_KiHinweis"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Cursor="Help"
                    FontSize="11"
                    Foreground="#FFBB8800"
                    Text="⚠ KI 80"
                    ToolTip="Die KI-Bilderkennung ist zu ca. 80 % fertig. Suchergebnisse, Filter und erkannte Begriffe können noch fehlerhaft oder unvollständig sein." />

                <!--  Wasserzeichen-Karte aufklappen – gebaut wie BTN_FilterToggle darüber  -->
                <Button
                    x:Name="BTN_WasserzeichenToggle"
                    Margin="8,0,0,0"
                    Command="{Binding CommandExecuteWasserzeichenToggleCommand}"
                    Style="{StaticResource OutlineButtonStyle}"
                    ToolTip="Wasserzeichen: Muster lernen und verwalten">
                    <StackPanel x:Name="STP_WasserzeichenToggleInhalt" Orientation="Horizontal">
                        <!--
                            Wassertropfen als Vektor statt als Zeichen aus Segoe MDL2 Assets:
                            Die Schrift hat keinen verlässlichen Tropfen, und ein geratener
                            Zeichencode erscheint im Zweifel als leeres Kästchen. Die Farbe
                            kommt vom Knopf, damit das Symbol dessen Zustände mitmacht.
                        -->
                        <Path
                            x:Name="PTH_WasserzeichenToggleIcon"
                            Width="11"
                            Height="14"
                            Margin="0,1,7,0"
                            VerticalAlignment="Center"
                            Data="M12,2.5 C12,2.5 4.5,11 4.5,15.5 C4.5,19.6 7.9,23 12,23 C16.1,23 19.5,19.6 19.5,15.5 C19.5,11 12,2.5 12,2.5 Z"
                            Stretch="Uniform"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                            StrokeLineJoin="Round"
                            StrokeThickness="1.3" />
                        <!--  Kürzer als „Wasserzeichen" – die Kopfleiste ist eng  -->
                        <!--<TextBlock x:Name="TXT_WasserzeichenToggleLabel" Text="Watermark" />-->
                        <TextBlock
                            x:Name="TXT_WasserzeichenChevron"
                            Margin="7,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            RenderTransformOrigin="0.5,0.5">
                            <TextBlock.Text>&#xE70D;</TextBlock.Text>
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="wasserzeichenChevronRotate" Angle="0" />
                            </TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWasserzeichenOffen}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            To="180"
                                                            Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            To="0"
                                                            Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <!--
                    Suchbereich für „Schema-ähnlich". Ein Schalter statt mehrerer Knöpfe —
                    sonst gäbe es je Bereich einen eigenen Befehl, Abbrechen-Knopf und
                    Fortschritt. Damit der Zustand nicht verborgen bleibt, steht die Anzahl
                    der betroffenen Ordner mit auf dem Schalter.
                -->
                <!--
                    Aufklappteil des Suchknopfes: ein schmaler Chevron direkt daneben, der
                    die drei Bereiche zeigt. Bewusst ein Menu und kein Popup — ein MenuItem
                    öffnet auf Linksklick und schliesst nach der Wahl von selbst, ganz ohne
                    Code-Behind. Ein RibbonSplitButton könnte dasselbe, brächte aber sein
                    eigenes Aussehen mit und passte nicht zu den Knöpfen ringsum.
                -->

                <Button
                    x:Name="BTN_ErweiterteSerie"
                    Margin="4,0,0,0"
                    Command="{Binding CommandExecuteErweiterteSerieSucheCommand}"
                    Style="{StaticResource OutlineButtonStyle}"
                    ToolTip="Kettensuche: folgt transitiv ähnlichen Bildern (A→B→C auch wenn A≠C)">
                    <StackPanel x:Name="STP_ErweiterteSerieInhalt" Orientation="Horizontal">
                        <TextBlock
                            x:Name="TXT_ErweiterteSerieIcon"
                            Margin="0,1,7,0"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="13"
                            Text="&#xE71B;" />
                        <TextBlock x:Name="TXT_ErweiterteSerieLabel" Text="Erw. Serie" />
                    </StackPanel>
                </Button>
                <!--
                    Geteilter Knopf: Suchen links, Bereichswahl rechts. Der Rahmen sitzt
                    aussen an dieser Klammer, die beiden Hälften haben keinen eigenen —
                    dadurch wirken sie als ein Stück statt als zwei Knöpfe nebeneinander.
                    Getrennt werden sie nur durch einen Haarstrich.
                -->
                <Border
                    x:Name="BRD_SchemaGeteilt"
                    Margin="4,0,0,0"
                    BorderBrush="#FFDADADA"
                    BorderThickness="1"
                    CornerRadius="7"
                    SnapsToDevicePixels="True">
                    <StackPanel x:Name="STP_SchemaGeteilt" Orientation="Horizontal">

                        <Button
                            x:Name="BTN_SchemaAehnlich"
                            Command="{Binding CommandExecuteSchemaAehnlichCommand}"
                            Style="{StaticResource SplitHauptButtonStyle}"
                            ToolTip="Schema-ähnliche Bilder zum gewählten Bild finden (Regler erscheint darunter nach der Suche)">
                            <StackPanel x:Name="STP_SchemaInhalt" Orientation="Horizontal">
                                <TextBlock
                                    x:Name="TXT_SchemaIcon"
                                    Margin="0,1,7,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="14"
                                    Text="&#xE8B3;" />
                                <!--  Bereich wandert in die Beschriftung, sobald er nicht der Einzelordner ist  -->
                                <TextBlock
                                    x:Name="TXT_SchemaLabel"
                                    d:Text="Schema-ähnlich · alle (12)"
                                    Text="{Binding SchemaKnopfText}" />
                            </StackPanel>
                        </Button>

                        <!--  Haarstrich statt Lücke: trennt die Hälften, hält sie zusammen  -->
                        <Border
                            x:Name="BRD_SchemaTrenner"
                            Width="1"
                            Margin="0,4"
                            Background="#FFDADADA" />

                        <Menu
                            x:Name="MNU_Suchbereich"
                            VerticalAlignment="Stretch"
                            Background="Transparent">
                            <MenuItem
                                x:Name="MNI_SuchbereichWurzel"
                                Height="32"
                                Padding="7,0"
                                Background="Transparent"
                                ToolTip="Wo „Schema-ähnlich“ sucht. Mit Unterordnern lässt die Ablagen wie kein_Fav aussen vor.">
                                <MenuItem.Header>
                                    <TextBlock
                                        x:Name="IC_SuchbereichChevron"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="10"
                                        Foreground="#FF2B2B2B"
                                        Text="&#xE70D;" />
                                </MenuItem.Header>

                                <MenuItem
                                    x:Name="MNI_BereichOrdner"
                                    Header="dieser Ordner"
                                    IsCheckable="True"
                                    IsChecked="{Binding BereichIstOrdner, Mode=TwoWay}" />
                                <MenuItem
                                    x:Name="MNI_BereichZweig"
                                    d:Header="mit Unterordnern (4)"
                                    Header="{Binding BereichZweigText}"
                                    IsCheckable="True"
                                    IsChecked="{Binding BereichIstZweig, Mode=TwoWay}" />
                                <MenuItem
                                    x:Name="MNI_BereichAlle"
                                    d:Header="alle Ordner (12)"
                                    Header="{Binding BereichAlleText}"
                                    IsCheckable="True"
                                    IsChecked="{Binding BereichIstAlle, Mode=TwoWay}" />

                                <Separator x:Name="SEP_Suchbereich" />

                                <!--
                                    Brücke zur Ordnerliste: Von hier aus ist sie erreichbar,
                                    ohne dass sie dauerhaft Platz kostet. Sie steht in den
                                    Einstellungen, weil sie zum Verwalten gehört, nicht zum
                                    Suchen — der Weg dorthin gehört aber hierher.
                                -->
                                <MenuItem
                                    x:Name="MNI_OrdnerVerwalten"
                                    d:Header="Ordner verwalten … (12)"
                                    Command="{Binding CommandExecuteIndexOrdnerZeigenCommand}"
                                    Header="{Binding OrdnerVerwaltenText}"
                                    ToolTip="Öffnet die Einstellungen bei der Liste der indizierten Ordner" />
                            </MenuItem>
                        </Menu>
                    </StackPanel>
                </Border>

                <!--
                    FS = „Fav-Sortierung". Ordnet den offenen Ordner so, dass die
                    wahrscheinlichen Ausschussbilder oben stehen — gelernt aus dem, was
                    dort liegt, gegen das, was im kein_Fav daneben liegt.
                    
                    Kurze Beschriftung mit Absicht: Der Knopf steht in einer Reihe mit
                    „Schema-ähnlich", und eine ausgeschriebene zweite Beschriftung würde
                    die Zeile sprengen. Die Bedeutung steht im ToolTip.
                    
                    Verschoben wird nichts — das Ergebnis landet in derselben Trefferliste
                    wie jede Suche und wird mit „Treffer übernehmen" angewandt.
                -->
                <!--
                    FS und die Marke „fertig sortiert" in einer Umrandung, nach demselben
                    Muster wie BRD_SchemaGeteilt daneben.
                    
                    Sie gehören zusammen: Die Marke ist keine allgemeine Einstellung,
                    sondern sagt FS, ob dieser Ordner ins gemeinsame Profil darf. Getrennt
                    stehend sähe sie aus wie ein Schalter für irgendetwas anderes.
                -->
                <!--
                    Baustellen-Markierung: FS ist erst zu rund 10 % fertig.
                    
                    Der graue Rand bleibt als Platzhalter stehen (BorderThickness 1,
                    Pinsel transparent), damit sich beim Entfernen der Markierung
                    nichts im Layout verschiebt. Darüber liegt RCT_FavBaustelle —
                    ein Border kann in WPF keine gestrichelte Linie, ein Rectangle
                    mit StrokeDashArray schon.
                -->
                <Grid x:Name="GRD_FavBaustelle" Margin="4,0,0,0">
                    <Border
                        x:Name="BRD_FavGeteilt"
                        Background="#0F2F80ED"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="7"
                        SnapsToDevicePixels="True">
                        <StackPanel x:Name="STP_FavGeteilt" Orientation="Horizontal">

                            <Button
                                x:Name="BTN_FavSortieren"
                                Command="{Binding CommandExecuteFavSortierenCommand}"
                                Style="{StaticResource SplitHauptButtonStyle}"
                                ToolTip="FS – Bilder nach Fav sortieren: Der Ordner wird nach deinen bisherigen Entscheidungen geordnet, wahrscheinlicher Ausschuss zuerst. Gelernt wird aus diesem Ordner und seinem kein_Fav. Verschoben wird nichts – der Regler darunter zieht die Grenze, „Treffer übernehmen“ wendet sie an.">
                                <StackPanel x:Name="STP_FavSortierenInhalt" Orientation="Horizontal">
                                    <TextBlock
                                        x:Name="IC_FavSortieren"
                                        Margin="0,1,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="13"
                                        Text="&#xE8CB;" />
                                    <TextBlock
                                        x:Name="TXT_FavSortieren"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="FS" />
                                </StackPanel>
                            </Button>

                            <!--  Haarstrich statt Lücke: trennt die Hälften, hält sie zusammen  -->
                            <Border
                                x:Name="BRD_FavTrenner"
                                Width="1"
                                Margin="0,4"
                                Background="#FFDADADA" />

                            <!--
                                Marke „fertig sortiert".
                                
                                Kein Beiwerk: Nur so markierte Ordner gehen ins gemeinsame
                                Profil ein. Gemessen liegt das gemeinsame Muster über alle
                                Ordner bei AUC 0,53 — Münzwurf —, über die gründlich
                                sortierten bei 0,66. Der Unterschied ist halbfertige Arbeit,
                                nicht das Verfahren: In einem unfertigen Ordner liegt
                                ungeprüfter Ausschuss zwischen den Behaltern und verdirbt
                                die gute Seite.
                            -->
                            <CheckBox
                                x:Name="CHK_OrdnerFertigSortiert"
                                Margin="9,0,10,0"
                                VerticalAlignment="Center"
                                Content="fertig sortiert"
                                FontSize="11"
                                Foreground="#FF555555"
                                IsChecked="{Binding OrdnerFertigSortiert, Mode=TwoWay}"
                                ToolTip="Ankreuzen, wenn in diesem Ordner alles geprüft ist – was noch daliegt, ist gut. Nur so markierte Ordner fliessen in das gemeinsame Profil ein, das bei einem neuen Künstler ohne eigene Historie aushilft." />

                            <!--
                                Baustellen-Zeichen: nur das Werkzeug, ohne Chip und ohne
                                Prozentzahl. Die Zeile hat rechts keine Reserve — ein
                                beschrifteter Chip schob BRD_SchemaHilfe aus dem Fenster.
                                Der Fortschritt steht im ToolTip.
                            -->
                            <TextBlock
                                x:Name="IC_FavBaustelle"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="11"
                                Foreground="#FF2F80ED"
                                Text="&#xE90F;"
                                ToolTip="Baustelle: Die Fav-Sortierung ist erst zu rund 10 % fertig. Ergebnisse sind noch nicht verlässlich." />
                        </StackPanel>
                    </Border>

                    <!--
                        Der gestrichelte Rahmen selbst. IsHitTestVisible=False, damit er
                        die Knöpfe darunter nicht abschirmt; Margin 1 hält den Strich
                        innerhalb des Grids, sonst wird die halbe Strichbreite gekappt.
                    -->
                    <Rectangle
                        x:Name="RCT_FavBaustelle"
                        Margin="1"
                        IsHitTestVisible="False"
                        RadiusX="6"
                        RadiusY="6"
                        Stroke="#FF2F80ED"
                        StrokeDashArray="4 3"
                        StrokeDashCap="Round"
                        StrokeThickness="1.4" />
                </Grid>

                <!--
                    Hilfe zur Schema-Suche. Bewusst kein Button, sondern ein Chip mit
                    Fragezeichen-Cursor: es gibt nichts zu klicken, nur zu lesen.
                    ShowDuration hochgesetzt, weil die 5-Sekunden-Vorgabe für einen
                    mehrzeiligen Ablauf zu kurz ist.
                -->
                <Border
                    x:Name="BRD_SchemaHilfe"
                    Width="22"
                    Height="22"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Background="#FFF3F4F6"
                    BorderBrush="#FFCBD5E1"
                    BorderThickness="1"
                    CornerRadius="11"
                    Cursor="Help"
                    ToolTipService.InitialShowDelay="200"
                    ToolTipService.ShowDuration="120000">
                    <TextBlock
                        x:Name="IC_SchemaHilfe"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="11"
                        Foreground="#FF64748B"
                        Text="&#xE897;" />
                    <Border.ToolTip>
                        <StackPanel x:Name="STP_SchemaHilfeTip" MaxWidth="400">
                            <TextBlock
                                x:Name="TXT_HilfeTitel"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#FF111827"
                                Text="Schema-ähnliche Bilder finden" />
                            <TextBlock
                                x:Name="TXT_HilfeEinleitung"
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="#FF374151"
                                Text="Nimmt das gewählte Bild als Vorlage und sucht im selben Ordner Bilder mit ähnlichem Aufbau und Motiv."
                                TextWrapping="Wrap" />

                            <TextBlock
                                x:Name="TXT_HilfeVoraussetzung"
                                Margin="0,8,0,0"
                                FontSize="11"
                                Foreground="Gray"
                                Text="Voraussetzung: Der Ordner muss indiziert sein – sonst bleibt der Knopf grau."
                                TextWrapping="Wrap" />

                            <TextBlock
                                x:Name="TXT_HilfeAblaufTitel"
                                Margin="0,10,0,0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#FF111827"
                                Text="Ablauf" />
                            <TextBlock
                                x:Name="TXT_HilfeAblauf"
                                Margin="0,3,0,0"
                                FontSize="12"
                                Foreground="#FF374151"
                                TextWrapping="Wrap">
                                <Run Text="1." />
                                <Run Text="Bild wählen, das als Vorlage dienen soll." />
                                <LineBreak />
                                <Run Text="2." />
                                <Run Text="„Schema-ähnlich“ klicken. Geladen wird alles ab 50 % – der breite Kandidatensatz." />
                                <LineBreak />
                                <Run Text="3." />
                                <Run Text="Mit dem Regler darunter eingrenzen. Er filtert sofort, ohne neu zu suchen." />
                                <LineBreak />
                                <Run Text="4." />
                                <Run Text="Passt die Auswahl, mit „Treffer übernehmen“ in die Bildliste holen." />
                            </TextBlock>

                            <TextBlock
                                x:Name="TXT_HilfeKalibriertTitel"
                                Margin="0,10,0,0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#FF111827"
                                Text="Häkchen „Kalibriert“" />
                            <TextBlock
                                x:Name="TXT_HilfeKalibriert"
                                Margin="0,3,0,0"
                                FontSize="12"
                                Foreground="#FF374151"
                                Text="Zieht die dicht beieinander liegenden Ähnlichkeitswerte auseinander, damit die Schwelle sauberer trennt. Es wirkt erst bei der nächsten Suche: Häkchen setzen, dann erneut klicken. Die Schwelle springt dabei auf den Standard des Modus (74 % roh, 80 % kalibriert), weil die Skala eine andere ist."
                                TextWrapping="Wrap" />

                            <TextBlock
                                x:Name="TXT_HilfeLueckeTitel"
                                Margin="0,10,0,0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#FF111827"
                                Text="Woran du den Erfolg abliest" />
                            <TextBlock
                                x:Name="TXT_HilfeLuecke"
                                Margin="0,3,0,0"
                                FontSize="12"
                                Foreground="#FF374151"
                                Text="Die Statuszeile nennt die „Lücke“: den Abstand zwischen dem letzten angezeigten Treffer und dem höchsten verworfenen Bild. Je grösser die Lücke, desto sicherer liegt die Schwelle zwischen Serie und Zufall. Mit dem Komponenten-Regler (0 bis 6) lohnt ein Durchgang – wird die Lücke wieder kleiner, wird schon echtes Signal weggeschnitten."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border.ToolTip>
                </Border>

            </StackPanel>

            <ProgressBar
                x:Name="PGB_FilterFortschritt"
                Height="3"
                Margin="0,4,0,0"
                IsIndeterminate="True"
                Visibility="{Binding FilterLaeuft, Converter={StaticResource CLconverterVisiblityBoolian}}" />

            <!--  Serien-Fortschritt mit echtem Balken + Abbrechen  -->
            <Grid
                x:Name="GRD_SerieFortschritt"
                Margin="0,6,0,0"
                Visibility="{Binding SerieSucheLaeuft, Converter={StaticResource CLconverterVisiblityBoolian}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    x:Name="PGB_SerieFortschritt"
                    Grid.Column="0"
                    Height="6"
                    VerticalAlignment="Center"
                    IsIndeterminate="{Binding SerieIndeterminate}"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding SerieFortschritt}" />
                <StackPanel
                    x:Name="STP_AbbrechenKnoepfe"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Orientation="Horizontal">
                    <Button
                        x:Name="BTN_ErweiterteSerieSucheAbbrechen"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        d:Visibility="Visible"
                        Command="{Binding CommandExecuteErweiterteSerieSucheCancelCommand}"
                        Content="&#xE711;"
                        Cursor="Hand"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Style="{StaticResource OutlineButtonStyle}"
                        ToolTip="Erweiterte Seriensuche abbrechen"
                        Visibility="{Binding CommandExecuteErweiterteSerieSucheCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}}" />
                    <Button
                        x:Name="BTN_DublettenAbbrechen"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        d:Visibility="Visible"
                        Command="{Binding CommandExecuteDublettenCancelCommand}"
                        Content="&#xE711;"
                        Cursor="Hand"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Style="{StaticResource OutlineButtonStyle}"
                        ToolTip="Dublettensuche abbrechen"
                        Visibility="{Binding CommandExecuteDublettenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}}" />
                    <Button
                        x:Name="BTN_SchemaAehnlichAbbrechen"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        d:Visibility="Visible"
                        Command="{Binding CommandExecuteSchemaAehnlichCancelCommand}"
                        Content="&#xE711;"
                        Cursor="Hand"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Style="{StaticResource OutlineButtonStyle}"
                        ToolTip="Schema-Ähnlichkeitssuche abbrechen"
                        Visibility="{Binding CommandExecuteSchemaAehnlichCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}}" />
                    <Button
                        x:Name="BTN_BegriffSucheAbbrechen"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        d:Visibility="Visible"
                        Command="{Binding CommandExecuteBegriffSucheCancelCommand}"
                        Content="&#xE711;"
                        Cursor="Hand"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Style="{StaticResource OutlineButtonStyle}"
                        ToolTip="Suche nach dem Begriff abbrechen"
                        Visibility="{Binding CommandExecuteBegriffSucheCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}}" />
                </StackPanel>
            </Grid>

            <!--  Such-Status steht jetzt rechts neben BTN_TrefferUebernehmen (weiter unten).  -->

            <!--  Ergebnis: erkannte Begriffe des gewählten Bildes – eigene Karte (wie die Einstellungen)  -->
            <Border
                x:Name="BRD_BegriffeKarte"
                Margin="2,10,2,2"
                Padding="14"
                Background="#FFFCFCFC"
                BorderBrush="#FFECECEC"
                BorderThickness="1"
                CornerRadius="10">
                <!--  Dezenter weicher Schatten, damit sich die Karte leicht heraushebt  -->
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="12"
                        Opacity="0.16"
                        ShadowDepth="1.5"
                        Color="Black" />
                </Border.Effect>
                <StackPanel x:Name="STP_BegriffeKarte">

                    <!--  Kopf mit Tag-Symbol: bildet das Paar zum „Tag-Schwelle"-Regler oben  -->
                    <StackPanel
                        x:Name="STP_BegriffeKopf"
                        Margin="0,0,0,6"
                        Orientation="Horizontal">
                        <TextBlock
                            x:Name="TXT_BegriffeKopfIcon"
                            Margin="0,1,6,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="#FF3B4A9C"
                            Text="&#xE8EC;" />
                        <TextBlock
                            x:Name="TXT_BegriffeKopfLabel"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#FF3B4A9C"
                            Text="Erkannte Begriffe" />
                    </StackPanel>

                    <DockPanel x:Name="DKP_BegriffeBereich" Margin="0,0,0,0">
                        <!--  Kleine Vorschau + Heatmap-Overlay  -->
                        <Grid
                            x:Name="GRD_Vorschau"
                            Width="85"
                            Height="85"
                            Margin="0,0,10,0"
                            d:Visibility="Visible"
                            DockPanel.Dock="Left"
                            Visibility="{Binding AnalyseBildVorschau, Converter={StaticResource CLconverterVisiblityBoolian}}">
                            <Border
                                x:Name="BRD_VorschauBild"
                                d:Background="#FFE0E6F5"
                                BorderBrush="#FFD3DAF5"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding AnalyseBildVorschau}" Stretch="Uniform" />
                                </Border.Background>
                            </Border>
                            <Border
                                x:Name="BRD_HeatmapOverlay"
                                ClipToBounds="True"
                                CornerRadius="6">
                                <Image
                                    x:Name="IMG_Heatmap"
                                    Opacity="0.7"
                                    Source="{Binding HeatmapOverlay}"
                                    Stretch="Uniform" />
                            </Border>
                        </Grid>

                        <ItemsControl
                            x:Name="IC_ErkannteBegriffe"
                            d:DataContext="{d:DesignInstance}"
                            ItemsSource="{Binding ErkannteBegriffe}">
                            <d:ItemsControl.Items>
                                <sys:String>Vogel 27 %</sys:String>
                                <sys:String>Sonnenblume 26 %</sys:String>
                                <sys:String>Gelb 26 %</sys:String>
                                <sys:String>Papagei 25 %</sys:String>
                                <sys:String>Baum 25 %</sys:String>
                                <sys:String>Nahaufnahme 25 %</sys:String>
                                <sys:String>Zitrone 25 %</sys:String>
                                <sys:String>Obst 25 %</sys:String>
                            </d:ItemsControl.Items>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,6,6"
                                        Padding="9,4"
                                        Background="#FFEEF1FB"
                                        BorderBrush="#FFD3DAF5"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="BegriffChip_MouseLeftButtonDown">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Click="BegriffChip_AlleAnzeigen" Header="Alle Bilder mit diesem Begriff" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <TextBlock
                                            FontFamily="Segoe UI"
                                            FontSize="12"
                                            Foreground="#FF3B4A9C"
                                            Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <!--  Anzahl erkannter Begriffe – unter den Chips  -->
                    <TextBlock
                        x:Name="TXT_AnalyseStatus"
                        Margin="0,8,0,0"
                        FontFamily="Segoe UI"
                        FontSize="12"
                        Foreground="#FF888888"
                        Text="{Binding AnalyseStatus}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AnalyseStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!--  Heatmap-Lade-Hinweis  -->
                    <StackPanel
                        x:Name="STP_HeatmapHinweis"
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding HeatmapLaeuft, Converter={StaticResource CLconverterVisiblityBoolian}}">
                        <TextBlock
                            x:Name="TXT_HeatmapSpinner"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="#FF5C6BC0"
                            RenderTransformOrigin="0.5,0.5"
                            Text="&#xE72C;">
                            <TextBlock.RenderTransform>
                                <RotateTransform />
                            </TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HeatmapLaeuft}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            RepeatBehavior="Forever"
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            From="0"
                                                            To="360"
                                                            Duration="0:0:1" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock
                            x:Name="TXT_HeatmapHinweisText"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="11"
                            Foreground="#FF888888"
                            Text="  Heatmap wird berechnet…" />
                    </StackPanel>

                    <!--  Tag-Schwelle: filtert genau die erkannten Begriffe oben (per Slider)  -->
                    <Grid x:Name="GRD_TagSchwelle" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            x:Name="STP_TagSchwelleLabel"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            ToolTip="Schwelle für die erkannten Begriffe – nur Begriffe ab diesem Score anzeigen.">
                            <TextBlock
                                x:Name="TXT_TagSchwelleIcon"
                                Margin="0,1,6,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="#FF3B4A9C"
                                Text="&#xE8EC;" />
                            <TextBlock
                                x:Name="TXT_TagSchwelleLabel"
                                FontFamily="Segoe UI"
                                FontSize="13"
                                Foreground="#FF555555"
                                Text="Tag-Schwelle" />
                        </StackPanel>
                        <Slider
                            x:Name="SLD_TagSchwelle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            d:Value="0.23"
                            LargeChange="0.05"
                            Maximum="1"
                            Minimum="0"
                            SmallChange="0.01"
                            Value="{Binding TagSchwelle, Mode=TwoWay}" />
                        <Border
                            x:Name="BRD_TagSchwelleWert"
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Background="#FFEEF1FB"
                            BorderBrush="#FFD3DAF5"
                            BorderThickness="1"
                            CornerRadius="9">
                            <TextBlock
                                x:Name="TXT_TagSchwelleWert"
                                MinWidth="30"
                                d:Text="23 %"
                                FontFamily="Segoe UI"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#FF3B4A9C"
                                Text="{Binding TagSchwelle, StringFormat=P0}"
                                TextAlignment="Center" />
                        </Border>
                        <Button
                            x:Name="BTN_TagSchwelleStandard"
                            Grid.Column="3"
                            Margin="6,0,0,0"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            Command="{Binding CommandExecuteTagSchwelleZuruecksetzenCommand}"
                            Content="&#xE845;"
                            Cursor="Hand"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Tag-Schwelle auf Standard (0,23) zurücksetzen" />
                    </Grid>

                </StackPanel>
            </Border>

            <!--  Einstellungen: aufklappbar über den Filter-Button  -->
            <Border
                x:Name="BRD_Einstellungen"
                Margin="0,10,0,0"
                Padding="14"
                Background="#FFFCFCFC"
                BorderBrush="#FFECECEC"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding IsIndexPopoverOffen, Converter={StaticResource CLconverterVisiblityBoolian}}">
                <StackPanel x:Name="STP_Einstellungen">

                    <!--  Kopfzeile: Anzahl + Ordner-Fortschritt  -->
                    <Grid x:Name="GRD_EinstellungenKopf">
                        <StackPanel
                            x:Name="STP_IndexAnzahl"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                x:Name="TXT_IndexAnzahlIcon"
                                Margin="0,1,8,0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="#FF6B6B6B"
                                Text="&#xE8FD;" />
                            <TextBlock
                                x:Name="TXT_IndexAnzahl"
                                FontFamily="Segoe UI"
                                FontSize="14"
                                Foreground="#FF2B2B2B"
                                Text="{Binding IndexAnzahlText}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="TXT_IndexOrdner"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#FF9A9A9A"
                            Text="{Binding IndexOrdnerText}" />
                    </Grid>


                    <!--  Filter nach: Kategorie + Wert  -->
                    <Grid x:Name="GRD_Filter" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="TXT_FilterLabel"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#FF555555"
                            Text="Filter nach" />
                        <ComboBox
                            x:Name="CBX_FilterKategorie"
                            Grid.Column="1"
                            Height="32"
                            VerticalContentAlignment="Center"
                            FontSize="13"
                            ItemsSource="{Binding FilterKategorien}"
                            SelectedItem="{Binding SelectedFilterKategorie, Mode=TwoWay}" />
                        <ComboBox
                            x:Name="CBX_FilterWert"
                            Grid.Column="3"
                            Height="32"
                            VerticalContentAlignment="Center"
                            FontSize="13"
                            ItemsSource="{Binding FilterWerte}"
                            SelectedItem="{Binding SelectedFilterWert, Mode=TwoWay}" />
                    </Grid>

                    <!--  Begriffe auf Deutsch statt Englisch  -->
                    <CheckBox
                        x:Name="CHK_BegriffeAufDeutsch"
                        Margin="0,14,0,0"
                        VerticalContentAlignment="Center"
                        Content="Begriffe auf Deutsch (de/eng)"
                        FontFamily="Segoe UI"
                        FontSize="13"
                        Foreground="#FF555555"
                        IsChecked="{Binding BegriffeAufDeutsch, Mode=TwoWay}" />


                    <!--  Trennlinie  -->
                    <Border
                        x:Name="BRD_Trennlinie"
                        Height="1"
                        Margin="0,16,0,14"
                        Background="#FFEAEAEA" />

                    <!--  Werkzeug-Buttons  -->
                    <StackPanel x:Name="STP_WerkzeugButtons" Orientation="Horizontal">
                        <Button
                            x:Name="BTN_Uebersicht"
                            Margin="0,0,10,0"
                            Command="{Binding CommandExecuteUebersichtCommand}"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Tag-Übersicht anzeigen">
                            <StackPanel x:Name="STP_UebersichtInhalt" Orientation="Horizontal">
                                <TextBlock
                                    x:Name="TXT_UebersichtIcon"
                                    Margin="0,1,7,0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13"
                                    Text="&#xE9D9;" />
                                <TextBlock x:Name="TXT_UebersichtLabel" Text="Übersicht" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="BTN_Dubletten"
                            Margin="0,0,10,0"
                            Command="{Binding CommandExecuteDublettenCommand}"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Dubletten finden (fast identische Bilder im Ordner)">
                            <StackPanel x:Name="STP_DublettenInhalt" Orientation="Horizontal">
                                <TextBlock
                                    x:Name="TXT_DublettenIcon"
                                    Margin="0,1,7,0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13"
                                    Text="&#xE8C8;" />
                                <TextBlock x:Name="TXT_DublettenLabel" Text="Dubletten" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="BTN_QueryBild"
                            Command="{Binding CommandExecuteQueryBildCommand}"
                            IsEnabled="False"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Query-Bild wählen und Ähnliche suchen">
                            <StackPanel x:Name="STP_QueryBildInhalt" Orientation="Horizontal">
                                <TextBlock
                                    x:Name="TXT_QueryBildIcon"
                                    Margin="0,1,7,0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13"
                                    Text="&#xE8B9;" />
                                <TextBlock x:Name="TXT_QueryBildLabel" Text="Query-Bild" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!--
                Verzeichnis der indizierten Ordner — alles dazu in einer eigenen
                Karte, damit erkennbar ist, was zusammengehört.
                
                Die ganze Karte ist zugleich Ablagefläche: Ein darauf gezogener
                Ordner wird samt Unterordnern nach Indexdateien durchsucht. Das
                Ziel sitzt bewusst hier und nicht an der Bilderzahl darüber —
                einen Ordner auf die Ordnerliste zu ziehen erklärt sich von selbst.
            -->
            <Border
                x:Name="BRD_IndexOrdnerKarte"
                Margin="2,10,2,2"
                Padding="14"
                d:Visibility="Visible"
                local:OrdnerDropHelper.Command="{Binding CommandExecuteIndexOrdnerAusDropCommand}"
                AllowDrop="True"
                BorderBrush="#FFECECEC"
                BorderThickness="1"
                CornerRadius="10"
                ToolTip="Ordner hierher ziehen: durchsucht ihn samt Unterordnern nach bereits indizierten Ordnern."
                Visibility="{Binding IsIndexOrdnerKarteOffen, Converter={StaticResource CLconverterVisiblityBoolian}}">

                <!--  Dezenter weicher Schatten, wie bei der Begriffe-Karte  -->
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="12"
                        Opacity="0.16"
                        ShadowDepth="1.5"
                        Color="Black" />
                </Border.Effect>

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FFFCFCFC" />
                        <Style.Triggers>
                            <!--  Beim Überfahren mit einem Ordner: Grund und Rand färben  -->
                            <Trigger Property="local:OrdnerDropHelper.IstZielAktiv" Value="True">
                                <Setter Property="Background" Value="#FFE8F2E0" />
                                <Setter Property="BorderBrush" Value="#FF8FB56A" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel x:Name="STP_IndexOrdnerKarte" Orientation="Vertical">

                    <!--  Titelzeile mit Schliessen rechts – die Karte lässt sich auch von Hand wegräumen  -->
                    <Grid x:Name="GRD_IndexOrdnerTitelzeile">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="COL_IndexOrdnerUeberschrift" Width="*" />
                            <ColumnDefinition x:Name="COL_IndexOrdnerSchliessen" Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="TXT_IndexOrdnerTitel"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#FF1F2937"
                            Text="Indizierte Ordner" />

                        <Button
                            x:Name="BTN_IndexOrdnerKarteSchliessen"
                            Grid.Column="1"
                            Padding="6,1"
                            VerticalAlignment="Center"
                            Command="{Binding CommandExecuteIndexOrdnerKarteSchliessenCommand}"
                            Cursor="Hand"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Karte ausblenden – wieder aufrufbar über „Ordner verwalten“ im Bereichsmenü">
                            <!--  E70E = Chevron nach oben: einklappen, nicht abbrechen. Das X wäre hier irreführend.  -->
                            <TextBlock x:Name="IC_IndexOrdnerKarteSchliessen" Text="&#xE70E;" />
                        </Button>
                    </Grid>

                    <TextBlock
                        x:Name="TXT_IndexOrdnerUntertitel"
                        Margin="0,2,0,0"
                        FontFamily="Segoe UI"
                        FontSize="11"
                        Foreground="Gray"
                        Text="Grundlage für die Suche über mehrere Ordner. Ordner hierher ziehen, um bereits indizierte nachzutragen."
                        TextWrapping="Wrap" />

                    <Grid x:Name="GRD_IndexOrdnerKopf" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="COL_IndexOrdnerTitel" Width="*" />
                            <ColumnDefinition x:Name="COL_IndexOrdnerAbbrechen" Width="Auto" />
                            <ColumnDefinition x:Name="COL_IndexOrdnerAuffrischen" Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="TXT_IndexOrdnerZusammenfassung"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            d:Text="12 Ordner · 8.430 Bilder · 1 fehlt"
                            FontFamily="Segoe UI"
                            FontSize="12"
                            Foreground="#FF6B6B6B"
                            Text="{Binding IndexOrdnerZusammenfassung}" />

                        <!--  Nur sichtbar, solange der abgelegte Ordnerbaum durchsucht wird  -->
                        <Button
                            x:Name="BTN_IndexOrdnerSucheAbbrechen"
                            Grid.Column="1"
                            Margin="0,0,4,0"
                            Padding="6,1"
                            VerticalAlignment="Center"
                            d:Visibility="Visible"
                            Command="{Binding CommandExecuteIndexOrdnerAusDropCancelCommand}"
                            Content="&#xE711;"
                            Cursor="Hand"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Suche nach indizierten Ordnern abbrechen"
                            Visibility="{Binding CommandExecuteIndexOrdnerAusDropCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}}" />

                        <Button
                            x:Name="BTN_IndexOrdnerAuffrischen"
                            Grid.Column="2"
                            Padding="6,1"
                            VerticalAlignment="Center"
                            Command="{Binding CommandExecuteIndexOrdnerAuffrischenCommand}"
                            Content="&#xE72C;"
                            Cursor="Hand"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Liste neu prüfen – erkennt Ordner, die inzwischen fehlen" />
                    </Grid>

                    <TextBlock
                        x:Name="TXT_IndexOrdnerHinweis"
                        Margin="0,4,0,0"
                        d:Text="7 indizierte Ordner gefunden, 3 neu aufgenommen."
                        FontFamily="Segoe UI"
                        FontSize="11"
                        Foreground="#FF6B7280"
                        Text="{Binding IndexOrdnerHinweis}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IndexOrdnerHinweis}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl
                        x:Name="IC_IndexOrdner"
                        MaxHeight="150"
                        Margin="0,6,0,0"
                        d:Visibility="Visible"
                        ItemsSource="{Binding IndexOrdnerListe}"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        Visibility="{Binding HatIndexOrdner, Converter={StaticResource CLconverterVisiblityBoolian}}">

                        <d:ItemsControl.ItemsSource>
                            <x:Array Type="{x:Type bs:IndexOrdnerEintrag}">
                                <bs:IndexOrdnerEintrag Bilder="1157" Pfad="C:\Beispiel\Bilder\Sammlung" />
                                <bs:IndexOrdnerEintrag Bilder="387" Pfad="C:\Beispiel\Bilder\Doppelt" />
                                <bs:IndexOrdnerEintrag
                                    Bilder="0"
                                    Existiert="False"
                                    Pfad="X:\Beispiel\Nicht_erreichbar" />
                            </x:Array>
                        </d:ItemsControl.ItemsSource>

                        <!--  Eigene Vorlage mit Bildlaufleiste: Die Liste kann lang werden.  -->
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="{x:Type ItemsControl}">
                                <ScrollViewer
                                    x:Name="SCV_IndexOrdner"
                                    CanContentScroll="True"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    x:Name="BRD_IndexOrdnerZeile"
                                    Margin="0,0,4,2"
                                    Padding="5,2"
                                    Background="White"
                                    BorderBrush="#FFECECEC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    ToolTip="{Binding Tooltip}">
                                    <Grid x:Name="GRD_IndexOrdnerZeile">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="COL_OrdnerIcon" Width="Auto" />
                                            <ColumnDefinition x:Name="COL_OrdnerName" Width="*" />
                                            <ColumnDefinition x:Name="COL_OrdnerInfo" Width="Auto" />
                                            <ColumnDefinition x:Name="COL_OrdnerEntfernen" Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            x:Name="IC_OrdnerZeile"
                                            Grid.Column="0"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="12"
                                            Foreground="#FF6B7280"
                                            Text="&#xE8B7;" />

                                        <TextBlock
                                            x:Name="TXT_OrdnerName"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe UI"
                                            FontSize="11"
                                            Text="{Binding Anzeigename}"
                                            TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FF1F2937" />
                                                    <Style.Triggers>
                                                        <!--  Fehlender Ordner: grau und durchgestrichen, nicht still verschwinden lassen  -->
                                                        <DataTrigger Binding="{Binding Existiert}" Value="False">
                                                            <Setter Property="Foreground" Value="#FF9A9A9A" />
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock
                                            x:Name="TXT_OrdnerInfo"
                                            Grid.Column="2"
                                            Margin="8,0,4,0"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe UI"
                                            FontSize="10"
                                            Foreground="Gray"
                                            Text="{Binding Beschreibung}" />

                                        <Button
                                            x:Name="BTN_IndexOrdnerEntfernen"
                                            Grid.Column="3"
                                            Padding="5,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.CommandExecuteIndexOrdnerEntfernenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Pfad}"
                                            Content="&#xE711;"
                                            Cursor="Hand"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="10"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            ToolTip="Diesen Ordner aus der Liste nehmen (die Indexdatei bleibt liegen)" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--
                Alles zur Texterkennung in einer Karte: einmal lesen, danach suchen.
                
                Sie steht hier und nicht in der Normalansicht, weil sie zum Suchen gehört
                — und die Treffer landen in derselben Ergebnisliste wie die Begriffssuche,
                samt „Treffer öffnen" und „In Liste übernehmen".
                
                Ohne Sprachpaket bleibt nur der Hinweis stehen; Knöpfe und Suchfeld sind
                dann über CanExecute gesperrt.
            -->
            <Border
                x:Name="BRD_OcrKarte"
                Margin="0,10,0,0"
                Padding="12,10,12,12"
                Background="#FFFCFCFC"
                BorderBrush="#FFECECEC"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel x:Name="STP_OcrKarte" Orientation="Vertical">

                    <!--
                        Titelzeile mit dem Einklapp-Knopf rechts. Sie bleibt immer stehen —
                        eingeklappt schrumpft die Karte auf diese eine Zeile, statt ganz zu
                        verschwinden. Sonst bräuchte es anderswo einen zweiten Knopf, um
                        sie wiederzufinden.
                    -->
                    <Grid x:Name="GRD_OcrKopf">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="COL_OcrTitel" Width="*" />
                            <ColumnDefinition x:Name="COL_OcrKnopf" Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="TXT_OcrTitel"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#FF1F2937"
                            Text="Text in Bildern" />

                        <!--
                            Das Zeichen dreht sich beim Umschalten: Der Pfeil zeigt immer
                            dorthin, wo der Inhalt hingeht. Gleiche Mechanik wie beim
                            Chevron von BTN_WasserzeichenToggle in der Kopfleiste.
                        -->
                        <Button
                            x:Name="BTN_OcrEinklappen"
                            Grid.Column="1"
                            Width="24"
                            Height="22"
                            Padding="0"
                            VerticalAlignment="Center"
                            Command="{Binding CommandExecuteOcrToggleCommand}"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Diese Karte ein- und ausklappen">
                            <TextBlock
                                x:Name="TXT_OcrChevron"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                RenderTransformOrigin="0.5,0.5"
                                Text="&#xE70D;">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="ocrChevronDrehung" Angle="0" />
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOcrOffen}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                To="180"
                                                                Duration="0:0:0.2" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                To="0"
                                                                Duration="0:0:0.2" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <!--  Alles unterhalb der Titelzeile klappt weg  -->
                    <StackPanel
                        x:Name="STP_OcrInhalt"
                        d:Visibility="Visible"
                        Orientation="Vertical"
                        Visibility="{Binding IsOcrOffen, Converter={StaticResource CLconverterVisiblityBoolian}}">

                        <TextBlock
                            x:Name="TXT_OcrUntertitel"
                            Margin="0,2,0,0"
                            FontFamily="Segoe UI"
                            FontSize="11"
                            Foreground="Gray"
                            Text="Den Ordner einmal durchlesen — danach lässt sich nach Text suchen, der auf den Bildern steht. Der Text wird neben die Bilder gelegt und wandert mit ihnen mit."
                            TextWrapping="Wrap" />

                        <!--  Warnung, solange der Text unverschlüsselt abgelegt wird  -->
                        <TextBlock
                            x:Name="TXT_OcrKlartextHinweis"
                            Margin="0,6,0,0"
                            FontFamily="Segoe UI"
                            FontSize="11"
                            Foreground="#FFB45309"
                            Text="Der erkannte Text liegt im Klartext in .bildocr.json. Bei Bildschirmfotos mit Kennwörtern steht er danach ein zweites Mal lesbar auf der Platte."
                            TextWrapping="Wrap" />

                        <!--
                            Lesen und Abbrechen. Der Abbrechen-Knopf steht nur da, solange
                            gelesen wird — ein dauerhaft sichtbarer, meist gesperrter Knopf
                            nähme Platz, ohne je etwas zu sagen.
                        -->
                        <StackPanel
                            x:Name="STP_OcrLesenReihe"
                            Margin="0,10,0,0"
                            Orientation="Horizontal">
                            <Button
                                x:Name="BTN_OcrOrdnerLesen"
                                Command="{Binding CommandExecuteOcrOrdnerLesenCommand}"
                                Content="Ordner lesen"
                                Style="{StaticResource OutlineButtonStyle}"
                                ToolTip="Alle Bilder dieses Ordners einmal durch die Texterkennung schicken. Schon gelesene werden übersprungen." />

                            <Button
                                x:Name="BTN_OcrAbbrechen"
                                Margin="6,0,0,0"
                                d:Visibility="Visible"
                                Command="{Binding CommandExecuteOcrOrdnerLesenCancelCommand}"
                                Content="Abbrechen"
                                Foreground="#FFB03030"
                                Style="{StaticResource OutlineButtonStyle}"
                                ToolTip="Das Lesen anhalten — was bis hierher erkannt wurde, bleibt gespeichert, und ein neuer Lauf macht dort weiter"
                                Visibility="{Binding OcrLaeuft, Converter={StaticResource CLconverterVisiblityBoolian}}" />
                        </StackPanel>

                        <!--
                            Balken und Zahlen erscheinen zusammen mit dem Lauf. Die Zahlen
                            stehen in OcrStatus darunter: Stückzahl, Prozent, Restzeit und
                            Tempo — dieselben vier Angaben wie bei den übrigen Läufen.
                        -->
                        <ProgressBar
                            x:Name="PGB_OcrFortschritt"
                            Height="6"
                            Margin="0,8,0,0"
                            d:Value="40"
                            d:Visibility="Visible"
                            Maximum="{Binding OcrFortschrittMax}"
                            Visibility="{Binding OcrLaeuft, Converter={StaticResource CLconverterVisiblityBoolian}}"
                            Value="{Binding OcrFortschritt}" />

                        <!--  Suchfeld: Enter sucht, damit man nicht zum Knopf greifen muss  -->
                        <StackPanel
                            x:Name="STP_OcrSucheReihe"
                            Margin="0,10,0,0"
                            Orientation="Horizontal">
                            <TextBox
                                x:Name="TXB_OcrSuche"
                                Width="180"
                                Height="26"
                                VerticalContentAlignment="Center"
                                FontSize="12"
                                Text="{Binding OcrSuchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CommandExecuteOcrSuchenCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <Button
                                x:Name="BTN_OcrSuchen"
                                Margin="6,0,0,0"
                                Command="{Binding CommandExecuteOcrSuchenCommand}"
                                Content="Im Text suchen"
                                Style="{StaticResource OutlineButtonStyle}"
                                ToolTip="Die Zeichenfolge im gelesenen Text suchen. Gross- und Kleinschreibung spielt keine Rolle." />
                        </StackPanel>

                        <TextBlock
                            x:Name="TXT_OcrStatus"
                            Margin="0,8,0,0"
                            d:Text="42 Bilder gelesen."
                            FontFamily="Segoe UI"
                            FontSize="11"
                            Foreground="#FF888888"
                            Text="{Binding OcrStatus}"
                            TextWrapping="Wrap" />

                        <!--
                            Der erkannte Text des Bildes, das gerade zu sehen ist. Er
                            wechselt beim Durchklicken der Trefferliste mit — so sieht
                            man zum Fund auch gleich, was sonst noch auf dem Bild steht.
                            
                            Als TextBox und nicht als TextBlock: nur so lässt sich der
                            Text markieren und herauskopieren, und genau dafür liest man
                            ihn meistens.
                        -->
                        <Border
                            x:Name="BRD_OcrVolltext"
                            Margin="0,12,0,0"
                            Padding="10,8,10,10"
                            Background="#FFFFFFFF"
                            BorderBrush="#FFECECEC"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel x:Name="STP_OcrVolltext" Orientation="Vertical">
                                <TextBlock
                                    x:Name="TXT_OcrVolltextTitel"
                                    FontFamily="Segoe UI"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#FF1F2937"
                                    Text="Erkannter Text im angezeigten Bild" />

                                <TextBlock
                                    x:Name="TXT_OcrVolltextKopf"
                                    Margin="0,2,0,0"
                                    d:Text="HeavyO.jpg — 142 Zeichen"
                                    FontFamily="Segoe UI"
                                    FontSize="11"
                                    Foreground="Gray"
                                    Text="{Binding OcrVolltextKopf}"
                                    TextWrapping="Wrap" />

                                <TextBox
                                    x:Name="TXB_OcrVolltext"
                                    MinHeight="46"
                                    MaxHeight="180"
                                    Margin="0,8,0,0"
                                    Padding="6,4"
                                    d:Text="Der erkannte Text steht hier."
                                    Background="#FFFAFAFA"
                                    BorderBrush="#FFE5E7EB"
                                    BorderThickness="1"
                                    FontFamily="Segoe UI"
                                    FontSize="12"
                                    IsReadOnly="True"
                                    Text="{Binding OcrVolltext, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--
                Alles zum Wasserzeichen in einer Karte: Lernen, Zustand, gelernte Muster.
                Klappt über BTN_WasserzeichenToggle auf – gleiche Mechanik wie die
                Einstellungen darüber, deshalb auch als eigene Karte neben ihnen und
                nicht mehr darin.
            -->
            <Border
                x:Name="BRD_WasserzeichenKarte"
                Margin="0,10,0,0"
                Padding="12,10,12,12"
                d:Visibility="Visible"
                Background="#FFFCFCFC"
                BorderBrush="#FFECECEC"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding IsWasserzeichenOffen, Converter={StaticResource CLconverterVisiblityBoolian}}">
                <StackPanel x:Name="STP_WasserzeichenKarte" Orientation="Vertical">

                    <TextBlock
                        x:Name="TXT_WasserzeichenTitel"
                        FontFamily="Segoe UI"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#FF1F2937"
                        Text="Wasserzeichen" />

                    <TextBlock
                        x:Name="TXT_WasserzeichenUntertitel"
                        Margin="0,2,0,0"
                        FontFamily="Segoe UI"
                        FontSize="11"
                        Foreground="Gray"
                        Text="Muster einmalig aus einem Beispielordner lernen – danach prüft jedes Indexieren mit."
                        TextWrapping="Wrap" />

                    <!--  Solange nichts gelernt ist, bleibt die Erkennung auf Metadaten beschränkt.  -->
                    <TextBlock
                        x:Name="TXT_WasserzeichenKeinMuster"
                        Margin="0,6,0,0"
                        d:Visibility="Collapsed"
                        FontFamily="Segoe UI"
                        FontSize="11"
                        Foreground="#FFB45309"
                        Text="Noch kein Muster gelernt – es wird nur nach Metadaten gesucht."
                        TextWrapping="Wrap"
                        Visibility="{Binding WasserzeichenMaskeVorhanden, Converter={StaticResource ConverterVisiblityBoolianInvertiert}}" />

                    <!--
                        Befund zum gerade gewählten Bild. Bisher stand er nur im ToolTip
                        des kleinen Abzeichens auf der Miniatur — dort findet man ihn nur,
                        wenn man weiss, dass es ihn gibt.
                    -->
                    <Border
                        x:Name="BRD_WasserzeichenBefund"
                        Margin="0,10,0,0"
                        Padding="8,6"
                        BorderBrush="#FFE3E3E3"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFFAFAFA" />
                                <Style.Triggers>
                                    <!--  Trägt das Bild eine Markierung, hebt sich der Kasten ab  -->
                                    <DataTrigger Binding="{Binding WasserzeichenBefundIstTreffer}" Value="True">
                                        <Setter Property="Background" Value="#FFFDF6E3" />
                                        <Setter Property="BorderBrush" Value="#FFE0C07A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid x:Name="GRD_WasserzeichenBefund">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="COL_BefundBild" Width="Auto" />
                                <ColumnDefinition x:Name="COL_BefundText" Width="*" />
                                <ColumnDefinition x:Name="COL_BefundHilfe" Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--
                                Das Muster, das am besten passte – sagt mehr als sein Name.
                                96 Punkte ist die Eigengrösse der Maske; grösser gezeigt
                                würde es nur unschärfer, ohne mehr zu verraten.
                            -->
                            <Border
                                x:Name="BRD_BefundMusterBild"
                                Grid.Column="0"
                                Width="96"
                                Height="96"
                                Margin="0,0,10,0"
                                VerticalAlignment="Top"
                                d:Visibility="Visible"
                                BorderBrush="#FFCBD5E1"
                                BorderThickness="1"
                                Visibility="{Binding WasserzeichenBefundHatBild, Converter={StaticResource CLconverterVisiblityBoolian}}">
                                <Image
                                    x:Name="IMG_BefundMuster"
                                    d:Source="/Images/HeavyO.jpg"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="{Binding WasserzeichenBefundBild}"
                                    Stretch="Uniform" />
                            </Border>

                            <StackPanel
                                x:Name="STP_WasserzeichenBefund"
                                Grid.Column="1"
                                Orientation="Vertical">

                                <TextBlock
                                    x:Name="TXT_WasserzeichenBefundDatei"
                                    d:Text="2B - NieR_Automata …jpg"
                                    FontFamily="Segoe UI"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#FF1F2937"
                                    Text="{Binding WasserzeichenBefundDatei}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    x:Name="TXT_WasserzeichenBefundText"
                                    Margin="0,2,0,0"
                                    d:Text="Wasserzeichen erkannt – deutlich über der Schwelle."
                                    FontFamily="Segoe UI"
                                    FontSize="11"
                                    Foreground="#FF555555"
                                    Text="{Binding WasserzeichenBefundText}"
                                    TextWrapping="Wrap" />

                                <!--
                                    Beim Treffer nennt diese Zeile das gefundene Zeichen und
                                    steht so kräftig da wie der Dateiname. Ohne Treffer nennt
                                    sie nur das ähnlichste Muster — grau und normal gesetzt,
                                    damit sie nicht als Fund gelesen wird.
                                -->
                                <TextBlock
                                    x:Name="TXT_WasserzeichenBefundMuster"
                                    Margin="0,3,0,0"
                                    d:Text="anilvlai · oben rechts"
                                    FontFamily="Segoe UI"
                                    FontSize="11"
                                    Text="{Binding WasserzeichenBefundMuster}"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Setter Property="Foreground" Value="Gray" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WasserzeichenBefundIstSichtbarerTreffer}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="#FF1F2937" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!--  Zahl immer mit der Schwelle daneben: 23 % klingt nach wenig, ist aber viel  -->
                                <TextBlock
                                    x:Name="TXT_WasserzeichenBefundWert"
                                    d:Text="Übereinstimmung 23 % · Schwelle 10 %"
                                    FontFamily="Segoe UI"
                                    FontSize="10"
                                    Foreground="Gray"
                                    Text="{Binding WasserzeichenBefundWert}" />

                                <TextBlock
                                    x:Name="TXT_WasserzeichenBefundMetadaten"
                                    Margin="0,3,0,0"
                                    d:Text="Autor: AnilvlAi"
                                    FontFamily="Segoe UI"
                                    FontSize="10"
                                    Foreground="#FF6B7280"
                                    Text="{Binding WasserzeichenBefundMetadaten}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!--  Erklärung rechts: die Zahlen sind ohne Einordnung wenig wert  -->
                            <Border
                                x:Name="BRD_BefundHilfe"
                                Grid.Column="2"
                                Width="18"
                                Height="18"
                                Margin="8,0,0,0"
                                VerticalAlignment="Top"
                                Background="#FFEFEFEF"
                                BorderBrush="#FFCBD5E1"
                                BorderThickness="1"
                                CornerRadius="9"
                                Cursor="Help"
                                ToolTipService.ShowDuration="60000">
                                <Border.ToolTip>
                                    <ToolTip x:Name="TTP_BefundHilfe">
                                        <StackPanel x:Name="STP_BefundHilfe" MaxWidth="420">
                                            <TextBlock
                                                x:Name="TXT_WzHilfeTitel"
                                                Margin="0,0,0,6"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="Wasserzeichen-Befund" />

                                            <TextBlock
                                                x:Name="TXT_WzHilfeBild"
                                                FontSize="11"
                                                Text="Links das gelernte Muster: der Mittelwert vieler Beispielbilder, gewichtet nach Beständigkeit. Was dort klar zu sehen ist, blieb über alle Beispiele gleich — das ist der feste Teil des Zeichens. Verwaschene Stellen wechselten, etwa ein Künstlername."
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                x:Name="TXT_WzHilfeWert"
                                                Margin="0,6,0,0"
                                                FontSize="11"
                                                Text="Die Übereinstimmung ist keine Wahrscheinlichkeit, sondern ein Ähnlichkeitsmass, und nur im Verhältnis zur Schwelle daneben zu lesen. Jedes Muster hat seine eigene: Sie wird beim Lernen an den eigenen Beispielen eingemessen, weil ein bildfüllendes Zeichen ein Vielfaches dessen erreicht, was ein Banner in der Ecke erreicht. Unter 6 % geht sie nie — so tief liegt das Rauschen unmarkierter Bilder (−7 bis 5 %). Muster aus der Zeit vor dieser Messung benutzen ersatzweise 10 %. Ein Wert klar über der Schwelle ist ein deutlicher Treffer, auch wenn die Prozentzahl klein aussieht."
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                x:Name="TXT_WzHilfeStelle"
                                                Margin="0,6,0,0"
                                                FontSize="11"
                                                Text="Hinter dem Musternamen steht die Stelle im Bild, an der gesucht wurde — Mitte oder eine der vier Ecken. Ein Muster findet nur dort, wo es gelernt wurde."
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                x:Name="TXT_WzHilfeMetadaten"
                                                Margin="0,6,0,0"
                                                FontSize="11"
                                                Text="Metadaten-Markierungen stehen im Dateikopf — Autor, Copyright, XMP, C2PA. Die gibt es auch ohne sichtbares Zeichen; das sind die unsichtbaren Wasserzeichen."
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                x:Name="TXT_WzHilfeLernen"
                                                Margin="0,6,0,0"
                                                FontSize="11"
                                                Text="Zum Lernen genügen rund 20 Bilder – sie müssen aber alle dasselbe Zeichen an derselben Stelle tragen, und keines darf ohne Zeichen dabei sein. Mehr Bilder machen das Muster nicht besser: Es ist ein Mittelwert, und ein Ordner mit tausenden Bildern verschiedener Zeichentypen mittelt sich zu einer leeren Fläche. Unter 5 Bildern wird nichts gelernt; ab 12 wird zusätzlich geprüft, ob zweierlei Zeichen im Ordner stecken."
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                x:Name="TXT_WzHilfeWann"
                                                Margin="0,6,0,0"
                                                FontSize="11"
                                                Foreground="Gray"
                                                Text="Geprüft wird am Ende des Indexierens. Neue Muster wirken erst, wenn der Ordner erneut indexiert wurde."
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>

                                <TextBlock
                                    x:Name="TXT_BefundHilfeZeichen"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#FF6B7280"
                                    Text="?" />
                            </Border>
                        </Grid>
                    </Border>

                    <!--
                        Wo sitzt das Zeichen? Die Reihenfolge muss zu WasserzeichenBereich
                        passen — gebunden wird der Index, damit kein Konverter nötig ist.
                    -->
                    <Grid x:Name="GRD_WasserzeichenBereich" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="COL_WzBereichLabel" Width="Auto" />
                            <ColumnDefinition x:Name="COL_WzBereichWahl" Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="TXT_WzBereichLabel"
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="11"
                            Foreground="Gray"
                            Text="Zeichen sitzt" />

                        <ComboBox
                            x:Name="CBX_WasserzeichenBereich"
                            Grid.Column="1"
                            Height="26"
                            MinWidth="150"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            FontSize="12"
                            SelectedIndex="{Binding WasserzeichenLernBereich, Mode=TwoWay}"
                            ToolTip="Stelle im Bild, an der das Zeichen liegt. Wird im Muster gespeichert und beim Prüfen wieder verwendet. „Alle Bereiche“ lernt Mitte und alle vier Ecken durch und behält die stärkste — das dauert entsprechend fünfmal so lange.">
                            <ComboBoxItem x:Name="CBI_WzAlle" Content="alle Bereiche (selbst finden)" />
                            <ComboBoxItem x:Name="CBI_WzMitte" Content="in der Mitte" />
                            <ComboBoxItem x:Name="CBI_WzObenLinks" Content="oben links" />
                            <ComboBoxItem x:Name="CBI_WzObenRechts" Content="oben rechts" />
                            <ComboBoxItem x:Name="CBI_WzUntenLinks" Content="unten links" />
                            <ComboBoxItem x:Name="CBI_WzUntenRechts" Content="unten rechts" />
                        </ComboBox>
                    </Grid>

                    <Grid x:Name="GRD_WasserzeichenLernen" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="COL_WzButton" Width="Auto" />
                            <ColumnDefinition x:Name="COL_WzAbbrechen" Width="Auto" />
                            <ColumnDefinition x:Name="COL_WzStatus" Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="BTN_WasserzeichenMaskeLernen"
                            Grid.Column="0"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Command="{Binding CommandExecuteWasserzeichenMaskeLernenCommand}"
                            Cursor="Hand"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Muster aus einem Beispielordner lernen – mindestens 5 Bilder, am besten rund 20, alle mit Wasserzeichen desselben Anbieters. Mehr Bilder machen das Muster kaum besser, dauern aber länger; bei über 20 kommt deshalb eine Rückfrage. Ab 12 Bildern wird geprüft, ob der Ordner zwei verschiedene Zeichen enthält; bestätigt sich das, werden zwei Muster daraus.">
                            <StackPanel x:Name="STP_WzLernenInhalt" Orientation="Horizontal">
                                <TextBlock
                                    x:Name="IC_WzLernen"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="12"
                                    Text="&#xE72E;" />
                                <TextBlock x:Name="TXT_WzLernen" Text="Wasserzeichen-Muster lernen" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="BTN_WasserzeichenLernenAbbrechen"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            d:Visibility="Visible"
                            Command="{Binding CommandExecuteWasserzeichenMaskeLernenCancelCommand}"
                            Content="&#xE711;"
                            Cursor="Hand"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Lernen abbrechen"
                            Visibility="{Binding CommandExecuteWasserzeichenMaskeLernenCommand.IsRunning, Converter={StaticResource CLconverterVisiblityBoolian}}" />

                        <TextBlock
                            x:Name="TXT_WasserzeichenStatus"
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            d:Text="Muster aus 32 Bildern gelernt."
                            FontFamily="Segoe UI"
                            FontSize="11"
                            Foreground="Gray"
                            Text="{Binding WasserzeichenStatus}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!--
                        Gelernte Muster. Mehrere sind der Normalfall — ein Anbieter
                        verwendet oft verschiedene Zeichentypen, und jeder braucht ein
                        eigenes Muster. Der Ordnername wird beim Lernen zum Musternamen.
                    -->
                    <!--
                        Anzahl im Kopf: Bei vielen gelernten Mustern sagt die Zahl mehr
                        als die angeschnittene Liste darunter.
                    -->
                    <TextBlock
                        x:Name="TXT_MusterAnzahl"
                        Margin="0,10,0,0"
                        d:Text="12 Muster"
                        FontFamily="Segoe UI"
                        FontSize="11"
                        Foreground="Gray"
                        Text="{Binding WasserzeichenMuster.Count, StringFormat={}{0} Muster}"
                        Visibility="{Binding WasserzeichenMaskeVorhanden, Converter={StaticResource CLconverterVisiblityBoolian}}" />

                    <ItemsControl
                        x:Name="IC_WasserzeichenMuster"
                        MaxHeight="152"
                        Margin="0,4,0,0"
                        ItemsSource="{Binding WasserzeichenMuster}"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">

                        <!--
                            Eigene Vorlage mit Bildlaufleiste statt der leeren Standardvorlage.
                            Zwei Gründe: Die Liste kann auf hunderte Muster anwachsen und würde
                            sonst die Karte beliebig lang machen — und erst mit dieser Vorlage
                            greift die Virtualisierung, es entstehen also nur die sichtbaren
                            Zeilen statt aller.
                        -->
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="{x:Type ItemsControl}">
                                <ScrollViewer
                                    x:Name="SCV_MusterListe"
                                    CanContentScroll="True"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <d:ItemsControl.ItemsSource>
                            <x:Array Type="{x:Type bs:WasserzeichenMusterEintrag}">
                                <bs:WasserzeichenMusterEintrag
                                    Grundmenge="32"
                                    MusterName="DeviantArt-Logo"
                                    SchwelleProzent="16"
                                    StabilProzent="49"
                                    Staerke="7.4" />
                                <bs:WasserzeichenMusterEintrag
                                    Grundmenge="11"
                                    MusterName="DeviantArt-Balken"
                                    SchwelleProzent="11"
                                    StabilProzent="51"
                                    Staerke="2.9" />
                            </x:Array>
                        </d:ItemsControl.ItemsSource>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    x:Name="BRD_MusterZeile"
                                    Margin="0,0,4,2"
                                    Padding="5,2"
                                    Background="White"
                                    BorderBrush="#FFCBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="6">

                                    <!--  ToolTip mit grosser Musteransicht statt nur Text  -->
                                    <Border.ToolTip>
                                        <ToolTip x:Name="TTP_Muster">
                                            <StackPanel x:Name="STP_MusterTooltip" Orientation="Vertical">
                                                <Border
                                                    x:Name="BRD_MusterGross"
                                                    Width="128"
                                                    Height="128"
                                                    Margin="0,0,0,6"
                                                    HorizontalAlignment="Left"
                                                    BorderBrush="#FFCBD5E1"
                                                    BorderThickness="1">
                                                    <!--
                                                        NearestNeighbor beim Vergrössern: Das Muster ist 96 Punkte
                                                        breit, weichgezeichnet verschmiert gerade die feine Struktur,
                                                        auf die es hier ankommt.
                                                    -->
                                                    <Image
                                                        x:Name="IMG_MusterGross"
                                                        d:Source="/Images/HeavyO.jpg"
                                                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                        Source="{Binding Vorschau}"
                                                        Stretch="Uniform" />
                                                </Border>
                                                <TextBlock
                                                    x:Name="TXT_MusterTooltip"
                                                    MaxWidth="260"
                                                    FontFamily="Segoe UI"
                                                    FontSize="11"
                                                    Text="{Binding Tooltip}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ToolTip>
                                    </Border.ToolTip>

                                    <Grid x:Name="GRD_MusterZeile">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="COL_MusterIcon" Width="Auto" />
                                            <ColumnDefinition x:Name="COL_MusterName" Width="*" />
                                            <ColumnDefinition x:Name="COL_MusterInfo" Width="Auto" />
                                            <ColumnDefinition x:Name="COL_MusterEntfernen" Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            Das gelernte Muster selbst statt eines Sinnbilds: In jeder Zeile
                                            stünde sonst dasselbe Zeichen, das nichts unterscheidet.
                                        -->
                                        <Border
                                            x:Name="BRD_MusterKlein"
                                            Grid.Column="0"
                                            Width="18"
                                            Height="18"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            BorderBrush="#FFCBD5E1"
                                            BorderThickness="1">
                                            <Image
                                                x:Name="IMG_MusterKlein"
                                                d:Source="/Images/HeavyO.jpg"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                Source="{Binding Vorschau}"
                                                Stretch="Uniform" />
                                        </Border>

                                        <TextBlock
                                            x:Name="TXT_MusterName"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe UI"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="#FF1F2937"
                                            Text="{Binding MusterName}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            x:Name="TXT_MusterInfo"
                                            Grid.Column="2"
                                            Margin="8,0,4,0"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe UI"
                                            FontSize="10"
                                            Foreground="Gray"
                                            Text="{Binding Beschreibung}" />

                                        <Button
                                            x:Name="BTN_MusterEntfernen"
                                            Grid.Column="3"
                                            Padding="5,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.CommandExecuteWasserzeichenMusterEntfernenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding MusterName}"
                                            Content="&#xE711;"
                                            Cursor="Hand"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="10"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            ToolTip="Dieses Muster entfernen" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  CLIP lädt: Warte-Symbol (dreht sich)  -->
            <StackPanel
                x:Name="STP_ClipLaedt"
                Margin="2,10,2,0"
                Orientation="Horizontal"
                Visibility="{Binding ClipLaedt, Converter={StaticResource CLconverterVisiblityBoolian}}">
                <TextBlock
                    x:Name="TXT_ClipSpinner"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Foreground="#FF5C6BC0"
                    RenderTransformOrigin="0.5,0.5"
                    Text="&#xE72C;">
                    <TextBlock.RenderTransform>
                        <RotateTransform Angle="0" />
                    </TextBlock.RenderTransform>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ClipLaedt}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="SB_ClipSpin">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    RepeatBehavior="Forever"
                                                    Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                                                    From="0"
                                                    To="360"
                                                    Duration="0:0:0.9" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="SB_ClipSpin" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock
                    x:Name="TXT_ClipLaedtText"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="12"
                    Foreground="#FF555555"
                    Text="Lade KI-Modell… (einmalig, dauert einen Moment)" />
            </StackPanel>

            <!--  Indexier-Fortschritt  -->
            <StackPanel x:Name="STP_IndexFortschritt" Margin="2,10,2,0">
                <TextBlock
                    x:Name="TXT_IndexFortschrittText"
                    FontFamily="Segoe UI"
                    FontSize="12"
                    Foreground="#FF555555"
                    Text="{Binding IndexFortschrittText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IndexFortschrittText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid
                    x:Name="GRD_IndexFortschritt"
                    Margin="0,6,0,0"
                    Visibility="{Binding IndexLaeuft, Converter={StaticResource CLconverterVisiblityBoolian}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar
                        x:Name="PGB_IndexFortschritt"
                        Grid.Column="0"
                        Height="5"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Minimum="0"
                        Value="{Binding IndexFortschritt}" />
                    <Button
                        x:Name="BTN_IndexAbbrechen"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Command="{Binding CommandExecuteOrdnerIndexierenCancelCommand}"
                        Content="&#xE711;"
                        Cursor="Hand"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Style="{StaticResource OutlineButtonStyle}"
                        ToolTip="Indexierung abbrechen" />
                </Grid>
            </StackPanel>

            <!--
                Schwelle der „Schema-ähnlich"-Suche (Bild→Bild) – eigener Rahmen, außerhalb
                der Einstellungen. Erscheint, sobald „Schema-ähnlich" Treffer geliefert hat.
            -->
            <!--
                Mindest-Ähnlichkeit der Freitext-/Standardtreffer. Gehört zum Suchfeld,
                nicht in die allgemeinen Einstellungen: RenderSuchErgebnisse filtert damit
                genau diese Treffer. Gegenstück zu BRD_SchemaSchwelle — sichtbar ist immer
                der Slider, der die aktuelle Trefferart auch wirklich filtert.
            -->
            <Border
                x:Name="BRD_MindestSchwelle"
                Margin="2,10,2,0"
                Padding="10"
                d:Visibility="Visible"
                Background="#FFFCFCFC"
                BorderBrush="#FFE3E3E3"
                BorderThickness="1"
                CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <!--
                                Kein Treffersatz vorhanden: nichts zu filtern. Bewusst am
                                Cache und nicht an SuchErgebnisse.Count — sonst blendet der
                                Slider sich selbst aus, sobald er alles wegfiltert, und
                                liesse sich nicht mehr zurückziehen.
                            -->
                            <DataTrigger Binding="{Binding HatTrefferCache}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <!--  Schema-Treffer: dort filtert BRD_SchemaSchwelle.  -->
                            <DataTrigger Binding="{Binding ErgebnisseSindSchemaAehnlich}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid x:Name="GRD_MindestAehnlichkeit">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        x:Name="STP_MindestLabel"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        ToolTip="Nur Treffer der Freitext-Suche über dieser Ähnlichkeit zeigen">
                        <TextBlock
                            x:Name="TXT_MindestIcon"
                            Margin="0,1,6,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="#FF555555"
                            Text="&#xE721;" />
                        <TextBlock
                            x:Name="TXT_MindestLabel"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#FF555555"
                            Text="Mindest-Ähnl." />
                    </StackPanel>
                    <Slider
                        x:Name="SLD_MindestAehnlichkeit"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        LargeChange="5"
                        Maximum="60"
                        Minimum="0"
                        SmallChange="1"
                        Value="{Binding MindestAehnlichkeit, Mode=TwoWay}" />
                    <Border
                        x:Name="BRD_MindestWert"
                        Grid.Column="2"
                        Margin="10,0,0,0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Background="#FFF0F0F0"
                        BorderBrush="#FFDADADA"
                        BorderThickness="1"
                        CornerRadius="9">
                        <TextBlock
                            x:Name="TXT_MindestWert"
                            MinWidth="34"
                            d:Text="23 %"
                            FontFamily="Segoe UI"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#FF555555"
                            Text="{Binding MindestAehnlichkeit, StringFormat={}{0:F0} %}"
                            TextAlignment="Center" />
                    </Border>
                    <Button
                        x:Name="BTN_MindestSchwelleStandard"
                        Grid.Column="3"
                        Margin="6,0,0,0"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Command="{Binding CommandExecuteMindestSchwelleZuruecksetzenCommand}"
                        Content="&#xE845;"
                        Cursor="Hand"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="11"
                        Style="{StaticResource OutlineButtonStyle}"
                        ToolTip="Mindest-Ähnlichkeit auf Standard (23 %) zurücksetzen" />
                </Grid>
            </Border>

            <Border
                x:Name="BRD_SchemaSchwelle"
                Margin="2,10,2,0"
                Padding="10"
                d:Visibility="Visible"
                Background="#FFFCFCFC"
                BorderBrush="#FFE3E3E3"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding ErgebnisseSindSchemaAehnlich, Converter={StaticResource CLconverterVisiblityBoolian}}">
                <Grid x:Name="GRD_SchemaAehnlichkeit">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="ROW_SchemaSchwelle" Height="Auto" />
                        <RowDefinition x:Name="ROW_SchemaKalibrierung" Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        x:Name="STP_SchemaSchwelleLabel"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        ToolTip="Schwelle der Schema-ähnlich-Suche (Bild als Anfrage). Höher = strenger, weniger Treffer.">
                        <TextBlock
                            x:Name="TXT_SchemaSchwelleIcon"
                            Margin="0,1,6,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="#FF555555"
                            Text="&#xE8B3;" />
                        <TextBlock
                            x:Name="TXT_SchemaSchwelleLabel"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#FF555555"
                            Text="Schema-Ähnl." />
                    </StackPanel>
                    <Slider
                        x:Name="SLD_SchemaAehnlichkeit"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        LargeChange="5"
                        Maximum="100"
                        Minimum="50"
                        SmallChange="1"
                        Value="{Binding SchemaAehnlichkeitProzent, Mode=TwoWay}" />
                    <Border
                        x:Name="BRD_SchemaSchwelleWert"
                        Grid.Column="2"
                        Margin="10,0,0,0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Background="#FFF0F0F0"
                        BorderBrush="#FFDADADA"
                        BorderThickness="1"
                        CornerRadius="9">
                        <TextBlock
                            x:Name="TXT_SchemaSchwelleWert"
                            MinWidth="34"
                            d:Text="74 %"
                            FontFamily="Segoe UI"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#FF555555"
                            Text="{Binding SchemaAehnlichkeitProzent, StringFormat={}{0:F0} %}"
                            TextAlignment="Center" />
                    </Border>
                    <Button
                        x:Name="BTN_SchemaSchwelleStandard"
                        Grid.Column="3"
                        Margin="6,0,0,0"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Command="{Binding CommandExecuteSchemaSchwelleZuruecksetzenCommand}"
                        Content="&#xE845;"
                        Cursor="Hand"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="11"
                        Style="{StaticResource OutlineButtonStyle}"
                        ToolTip="Schema-Ähnlichkeit auf den Standardwert des aktuellen Modus zurücksetzen" />

                    <!--
                        Embedding-Kalibrierung: Mittelvektor abziehen und die stärksten
                        Hauptkomponenten herausprojizieren. Spreizt die eng beieinander
                        liegenden CLIP-Ähnlichkeiten und macht die Schwelle trennschärfer.
                        Achtung: andere Skala — Schwelle gilt nur je Modus.
                    -->
                    <Grid
                        x:Name="GRD_SchemaKalibrierung"
                        Grid.Row="1"
                        Grid.ColumnSpan="4"
                        Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="COL_KalibrierSchalter" Width="Auto" />
                            <ColumnDefinition x:Name="COL_KalibrierRegler" Width="*" />
                            <ColumnDefinition x:Name="COL_KalibrierWert" Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox
                            x:Name="CHK_SchemaKalibrierung"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="12"
                            Foreground="#FF555555"
                            IsChecked="{Binding SchemaKalibrierungAktiv, Mode=TwoWay}"
                            ToolTip="Embeddings vor dem Vergleich zentrieren und die stärksten Hauptkomponenten entfernen. Danach erneut suchen.">
                            <TextBlock x:Name="TXT_KalibrierLabel" Text="Kalibriert" />
                        </CheckBox>

                        <StackPanel
                            x:Name="STP_KalibrierKomponenten"
                            Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding SchemaKalibrierungAktiv}"
                            Orientation="Horizontal">
                            <TextBlock
                                x:Name="TXT_KomponentenLabel"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe UI"
                                FontSize="11"
                                Foreground="Gray"
                                Text="entfernte Komponenten" />
                            <Slider
                                x:Name="SLD_KalibrierKomponenten"
                                Width="90"
                                VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                LargeChange="1"
                                Maximum="6"
                                Minimum="0"
                                SmallChange="1"
                                TickFrequency="1"
                                ToolTip="0 = nur zentrieren. 3 ist ein guter Ausgangswert; zu viele entfernen echtes Signal."
                                Value="{Binding SchemaKalibrierungKomponenten, Mode=TwoWay}" />
                        </StackPanel>

                        <Border
                            x:Name="BRD_KalibrierWert"
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Background="#FFF0F0F0"
                            BorderBrush="#FFDADADA"
                            BorderThickness="1"
                            CornerRadius="9"
                            IsEnabled="{Binding SchemaKalibrierungAktiv}">
                            <TextBlock
                                x:Name="TXT_KalibrierKomponentenWert"
                                MinWidth="34"
                                d:Text="3 PC"
                                FontFamily="Segoe UI"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#FF555555"
                                Text="{Binding SchemaKalibrierungKomponenten, StringFormat={}{0:F0} PC}"
                                TextAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!--  Suchergebnisse: klickbare Miniaturen  -->
            <StackPanel x:Name="STP_SuchErgebnisse" Margin="2,4,2,2">
                <!--
                    Treffer in die Bilderliste übernehmen, rechts daneben die Suchmeldung.
                    Grid statt StackPanel, damit die Meldung den Restplatz bekommt und bei
                    langem Text mit Auslassungspunkten endet statt abgeschnitten zu werden.
                -->
                <Grid x:Name="GRD_TrefferUebernehmenLeiste">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SucheStatus}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="COL_TrefferUebernehmen" Width="Auto" />
                        <ColumnDefinition x:Name="COL_TrefferStatus" Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Zeile 1 nimmt den Wort-Hinweis auf und misst 0, solange er leer ist  -->
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="ROW_TrefferLeiste" Height="Auto" />
                        <RowDefinition x:Name="ROW_TrefferWortHinweis" Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button
                        x:Name="BTN_TrefferUebernehmen"
                        Grid.Row="0"
                        Grid.Column="0"
                        Height="30"
                        Command="{Binding CommandExecuteTrefferUebernehmenCommand}"
                        Style="{StaticResource OutlineButtonStyle}"
                        ToolTip="Die Suchtreffer in die Bilderliste übernehmen (Wiederherstellen: Alle neu einlesen)">
                        <StackPanel x:Name="STP_TrefferUebernehmenInhalt" Orientation="Horizontal">
                            <TextBlock
                                x:Name="TXT_TrefferUebernehmenIcon"
                                Margin="0,1,7,0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="13"
                                Text="&#xE71C;" />
                            <TextBlock x:Name="TXT_TrefferUebernehmenLabel" Text="In Liste übernehmen" />
                        </StackPanel>
                    </Button>

                    <TextBlock
                        x:Name="TXT_SucheStatus"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="10,0,2,0"
                        VerticalAlignment="Center"
                        d:Text="14 schema-ähnliche Bilder (≥ 70 %, niedrigster 71 %)."
                        FontFamily="Segoe UI"
                        FontSize="12"
                        Foreground="#FF888888"
                        Text="{Binding SucheStatus}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding SucheStatus}" />

                    <!--
                        Wörter, die der Übersetzer nicht kannte — eigene Zeile über die
                        ganze Breite, nicht angehängt an die Statuszeile darüber.
                        
                        Zwei Gründe: Die Statuszeile kürzt mit Auslassungspunkten, und
                        ausgerechnet der Hinweis stünde am Ende, also würde er als Erstes
                        abgeschnitten. Und er ist wichtiger als der Rest — wer nichts
                        findet, erfährt hier, ob das Bild fehlte oder das Wort.
                        
                        Die Wörter selbst kräftig und grösser: In einer durchgehend grauen
                        Zeile in Kleinschrift gehen sie unter.
                    -->
                    <TextBlock
                        x:Name="TXT_SuchWortHinweis"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,6,2,0"
                        d:Visibility="Visible"
                        FontFamily="Segoe UI"
                        FontSize="12"
                        Foreground="#FF7A4E00"
                        TextWrapping="Wrap"><Run FontSize="12" Text="Nicht übersetzt: " /><Run
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#FFB45309"
                            Text="{Binding SuchWortHinweisWoerter, Mode=OneWay}" /><Run FontSize="12" Text="{Binding SuchWortHinweisText, Mode=OneWay}" />
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SuchWortHinweisWoerter}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SuchWortHinweisWoerter}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ScrollViewer
                    x:Name="SCV_SuchErgebnisse"
                    MaxHeight="260"
                    Margin="0,8,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        x:Name="IC_SuchErgebnisse"
                        d:DataContext="{d:DesignInstance}"
                        ItemsSource="{Binding SuchErgebnisse}">
                        <!--
                            Nach einem Ordnerwechsel per Drop wurden die Treffer verworfen.
                            Die rosa Fläche zeigt das auch dann noch, wenn die Suchleiste
                            erst später wieder aufgeklappt wird. MinHeight ist nötig, weil
                            das ItemsControl ohne Einträge sonst keine sichtbare Fläche hat.
                            Verschwindet beim nächsten Suchlauf (LeereTrefferCache).
                        -->
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SuchErgebnisseVeraltet}" Value="True">
                                        <Setter Property="Background" Value="#FFF9D7E3" />
                                        <Setter Property="MinHeight" Value="64" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <d:ItemsControl.Items>
                            <Border
                                Width="104"
                                Height="78"
                                Margin="0,0,6,6"
                                Background="#FFE0E0E0"
                                BorderBrush="#FFDADADA"
                                BorderThickness="1"
                                CornerRadius="6" />
                            <Border
                                Width="104"
                                Height="78"
                                Margin="0,0,6,6"
                                Background="#FFE8E8E8"
                                BorderBrush="#FFDADADA"
                                BorderThickness="1"
                                CornerRadius="6" />
                            <Border
                                Width="104"
                                Height="78"
                                Margin="0,0,6,6"
                                Background="#FFE0E0E0"
                                BorderBrush="#FFDADADA"
                                BorderThickness="1"
                                CornerRadius="6" />
                            <Border
                                Width="104"
                                Height="78"
                                Margin="0,0,6,6"
                                Background="#FFE8E8E8"
                                BorderBrush="#FFDADADA"
                                BorderThickness="1"
                                CornerRadius="6" />
                            <Border
                                Width="104"
                                Height="78"
                                Margin="0,0,6,6"
                                Background="#FFE0E0E0"
                                BorderBrush="#FFDADADA"
                                BorderThickness="1"
                                CornerRadius="6" />
                            <Border
                                Width="104"
                                Height="78"
                                Margin="0,0,6,6"
                                Background="#FFE8E8E8"
                                BorderBrush="#FFDADADA"
                                BorderThickness="1"
                                CornerRadius="6" />
                        </d:ItemsControl.Items>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="0,0,6,6"
                                    Command="{Binding DataContext.CommandExecuteTrefferOeffnenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Path}"
                                    Cursor="Hand"
                                    ToolTip="{Binding DateiName}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Width="104" Height="78">
                                                <Border
                                                    Background="#FF1A1A1A"
                                                    BorderBrush="#FFDADADA"
                                                    BorderThickness="1"
                                                    ClipToBounds="True"
                                                    CornerRadius="6">
                                                    <Image Source="{Binding Thumb}" Stretch="Uniform" />
                                                </Border>
                                                <Border
                                                    Margin="0,0,4,4"
                                                    Padding="4,1"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Background="#CC000000"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        FontFamily="Segoe UI"
                                                        FontSize="10"
                                                        Foreground="White"
                                                        Text="{Binding ProzentText}" />
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
