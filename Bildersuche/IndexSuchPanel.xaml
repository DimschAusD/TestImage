<UserControl
    x:Class="TestImage.Bildersuche.IndexSuchPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TestImage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Width="855"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:CLconverterVisiblityBoolian x:Key="CLconverterVisiblityBoolian" />
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF2B2B2B" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#FFDADADA"
                            BorderThickness="1"
                            CornerRadius="7"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF5F5F5" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFBABABA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFEBEBEB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border
        x:Name="BRD_PanelRahmen"
        Background="#FFFFFFFF"
        BorderBrush="#FFE3E3E3"
        BorderThickness="1"
        CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="18"
                Opacity="0.22"
                ShadowDepth="2"
                Color="Black" />
        </Border.Effect>
        <StackPanel x:Name="STP_Inhalt" Margin="6" Orientation="Vertical">

            <!--  Griffleiste: Panel mit der Maus verschieben  -->
            <Border
                x:Name="BRD_Griffleiste"
                Height="18"
                Margin="0,0,0,4"
                Background="#FFF3F3F3"
                CornerRadius="6"
                Cursor="SizeAll"
                MouseLeftButtonDown="Griffleiste_MouseLeftButtonDown"
                MouseLeftButtonUp="Griffleiste_MouseLeftButtonUp"
                MouseMove="Griffleiste_MouseMove"
                ToolTip="Zum Verschieben ziehen">
                <TextBlock
                    x:Name="TXT_GriffIcon"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="10"
                    Foreground="#FFAAAAAA"
                    Text="&#xE76F;" />
            </Border>

            <StackPanel x:Name="STP_Werkzeugleiste" VerticalAlignment="Center" Orientation="Horizontal">

                <!--  Index-Button (umrandet)  -->
                <Button
                    x:Name="BTN_IndexOrdnerErstellen"
                    Command="{Binding CommandExecuteOrdnerIndexierenCommand}"
                    Style="{StaticResource OutlineButtonStyle}"
                    ToolTip="Ordner des gewählten Bildes indexieren (CLIP-Embeddings für Suche erstellen)">
                    <StackPanel x:Name="STP_IndexInhalt" Orientation="Horizontal">
                        <TextBlock
                            x:Name="TXT_IndexIcon"
                            Margin="0,1,1,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="13"
                            Text="&#xE8B7;" />
                        <TextBlock
                            x:Name="TXT_IndexPlusIcon"
                            Margin="0,0,7,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="8"
                            FontWeight="Bold"
                            Text="&#xE710;" />
                        <TextBlock x:Name="TXT_IndexLabel" VerticalAlignment="Center" Text="Index" />
                    </StackPanel>
                </Button>

                <!--  Suchfeld: Eingabe + grauer Vorschlag links, Such-Button rechts  -->
                <Border
                    x:Name="BRD_Suchfeld"
                    Width="300"
                    Height="34"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center"
                    Background="#FFFFFFFF"
                    BorderBrush="#FFDADADA"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid x:Name="GRD_Suchfeld">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Eingabe + grauer Beispiel-/Autovervollständigungs-Vorschlag  -->
                        <Grid x:Name="GRD_Eingabe" Grid.Column="0" Margin="10,0,4,0">

                            <!--  Ghost: getippter Teil transparent, Rest grau (Tab übernimmt)  -->
                            <TextBlock
                                x:Name="TXT_SucheGhost"
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe UI"
                                FontSize="14"
                                IsHitTestVisible="False"
                                TextTrimming="CharacterEllipsis"><Run Foreground="Transparent" Text="{Binding SucheText, Mode=OneWay}" /><Run Foreground="#FFC7C7C7" Text="{Binding SucheVorschlagRest, Mode=OneWay}" /></TextBlock>

                            <TextBox
                                x:Name="TXT_Suche"
                                Padding="0"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="Segoe UI"
                                FontSize="14"
                                Foreground="#FF2B2B2B"
                                PreviewKeyDown="TXT_Suche_PreviewKeyDown"
                                Text="{Binding SucheText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CommandExecuteFreitextSucheCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <TextBlock
                                x:Name="TXT_SuchePlatzhalter"
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe UI"
                                FontSize="14"
                                Foreground="#FFB0B0B0"
                                IsHitTestVisible="False"
                                Text="z. B. Mädchen am Strand">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SucheText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!--  Vorschlagsliste (Google-Style Autocomplete)  -->
                        <Popup
                            x:Name="POP_Vorschlaege"
                            AllowsTransparency="True"
                            IsOpen="{Binding VorschlaegeOffen}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=TXT_Suche}"
                            StaysOpen="False">
                            <Border
                                x:Name="BRD_Vorschlaege"
                                MinWidth="200"
                                Background="White"
                                BorderBrush="#FFD0D0D0"
                                BorderThickness="1"
                                CornerRadius="0,0,8,8">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="8"
                                        Opacity="0.15"
                                        ShadowDepth="2" />
                                </Border.Effect>
                                <ListBox
                                    x:Name="LBX_Vorschlaege"
                                    MaxHeight="260"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding SucheVorschlaege}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,6" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="FontFamily" Value="Segoe UI" />
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="Foreground" Value="#FF333333" />
                                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Vorschlag_Click" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FFEEF1FB" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>

                        <!--  Such-Button (Auslöser)  -->
                        <Button
                            x:Name="BTN_Suchen"
                            Grid.Column="1"
                            Width="36"
                            Command="{Binding CommandExecuteFreitextSucheCommand}"
                            Cursor="Hand"
                            ToolTip="Suchen">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="sb"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="0,7,7,0">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="15"
                                                        Foreground="#FF5C6BC0"
                                                        Text="&#xE721;" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="sb" Property="Background" Value="#FFEEF1FB" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="sb" Property="Background" Value="#FFDDE3F7" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!--  Filter-Toggle: Regler + Chevron (öffnet das Popover)  -->
                <Button
                    x:Name="BTN_FilterToggle"
                    Command="{Binding CommandExecuteFilterPopoverToggleCommand}"
                    Style="{StaticResource OutlineButtonStyle}"
                    ToolTip="Filter, Tags und Werkzeuge einblenden">
                    <StackPanel x:Name="STP_FilterToggleInhalt" Orientation="Horizontal">
                        <TextBlock
                            x:Name="TXT_FilterIcon"
                            Margin="0,1,6,0"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Text="&#xE9E9;" />
                        <TextBlock
                            x:Name="TXT_FilterChevron"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            RenderTransformOrigin="0.5,0.5">
                            <TextBlock.Text>&#xE70D;</TextBlock.Text>
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="chevronRotate" Angle="0" />
                            </TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIndexPopoverOffen}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            To="180"
                                                            Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            To="0"
                                                            Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <TextBlock
                    x:Name="TXT_KiHinweis"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Cursor="Help"
                    FontSize="11"
                    Foreground="#FFBB8800"
                    Text="⚠ KI"
                    ToolTip="Die KI-Bilderkennung ist zu ca. 70 % fertig. Suchergebnisse, Filter und erkannte Begriffe können noch fehlerhaft oder unvollständig sein." />

                <Button
                    x:Name="BTN_SerieSuche"
                    Margin="8,0,0,0"
                    Command="{Binding CommandExecuteSerieSucheCommand}"
                    Style="{StaticResource OutlineButtonStyle}"
                    ToolTip="Visuell ähnliche Bilder zum ausgewählten Bild finden (Serie)">
                    <StackPanel x:Name="STP_SerieInhalt" Orientation="Horizontal">
                        <TextBlock
                            x:Name="TXT_SerieIcon"
                            Margin="0,1,7,0"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="13"
                            Text="&#xE8C8;" />
                        <TextBlock x:Name="TXT_SerieLabel" Text="Serie" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="BTN_ErweiterteSerie"
                    Margin="4,0,0,0"
                    Command="{Binding CommandExecuteErweiterteSerieSucheCommand}"
                    Style="{StaticResource OutlineButtonStyle}"
                    ToolTip="Kettensuche: folgt transitiv ähnlichen Bildern (A→B→C auch wenn A≠C)">
                    <StackPanel x:Name="STP_ErweiterteSerieInhalt" Orientation="Horizontal">
                        <TextBlock
                            x:Name="TXT_ErweiterteSerieIcon"
                            Margin="0,1,7,0"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="13"
                            Text="&#xE71B;" />
                        <TextBlock x:Name="TXT_ErweiterteSerieLabel" Text="Erw. Serie" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="BTN_SchemaAehnlich"
                    Margin="4,0,0,0"
                    Command="{Binding CommandExecuteSchemaAehnlichCommand}"
                    Style="{StaticResource OutlineButtonStyle}"
                    ToolTip="Schema-ähnliche Bilder zum gewählten Bild finden (Schwelle unter Einstellungen)">
                    <StackPanel x:Name="STP_SchemaInhalt" Orientation="Horizontal">
                        <TextBlock
                            x:Name="TXT_SchemaIcon"
                            Margin="0,1,7,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Text="&#xE8B3;" />
                        <TextBlock x:Name="TXT_SchemaLabel" Text="Schema-ähnlich" />
                    </StackPanel>
                </Button>

            </StackPanel>

            <ProgressBar
                x:Name="PGB_FilterFortschritt"
                Height="3"
                Margin="0,4,0,0"
                IsIndeterminate="True"
                Visibility="{Binding FilterLaeuft, Converter={StaticResource CLconverterVisiblityBoolian}}" />

            <!--  Serien-Fortschritt mit echtem Balken + Abbrechen  -->
            <Grid
                x:Name="GRD_SerieFortschritt"
                Margin="0,6,0,0"
                Visibility="{Binding SerieSucheLaeuft, Converter={StaticResource CLconverterVisiblityBoolian}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    x:Name="PGB_SerieFortschritt"
                    Grid.Column="0"
                    Height="6"
                    VerticalAlignment="Center"
                    IsIndeterminate="{Binding SerieIndeterminate}"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding SerieFortschritt}" />
                <StackPanel
                    x:Name="STP_AbbrechenKnoepfe"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Orientation="Horizontal">
                    <Button
                        x:Name="BTN_SerieSucheAbbrechen"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Command="{Binding CommandExecuteSerieSucheCancelCommand}"
                        Content="&#xE711;"
                        Cursor="Hand"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Style="{StaticResource OutlineButtonStyle}"
                        ToolTip="Seriensuche abbrechen" />
                    <Button
                        x:Name="BTN_ErweiterteSerieSucheAbbrechen"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Command="{Binding CommandExecuteErweiterteSerieSucheCancelCommand}"
                        Content="&#xE711;"
                        Cursor="Hand"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Style="{StaticResource OutlineButtonStyle}"
                        ToolTip="Erweiterte Seriensuche abbrechen" />
                    <Button
                        x:Name="BTN_DublettenAbbrechen"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Command="{Binding CommandExecuteDublettenCancelCommand}"
                        Content="&#xE711;"
                        Cursor="Hand"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Style="{StaticResource OutlineButtonStyle}"
                        ToolTip="Dublettensuche abbrechen" />
                    <Button
                        x:Name="BTN_SchemaAehnlichAbbrechen"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Command="{Binding CommandExecuteSchemaAehnlichCancelCommand}"
                        Content="&#xE711;"
                        Cursor="Hand"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Style="{StaticResource OutlineButtonStyle}"
                        ToolTip="Schema-Ähnlichkeitssuche abbrechen" />
                </StackPanel>
            </Grid>

            <!--  Such-Status (z. B. „Keine Treffer…") – nah an der Serien-Suche  -->
            <TextBlock
                x:Name="TXT_SucheStatus"
                Margin="2,8,2,0"
                FontFamily="Segoe UI"
                FontSize="12"
                Foreground="#FF888888"
                Text="{Binding SucheStatus}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SucheStatus}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!--  Ergebnis: erkannte Begriffe des gewählten Bildes – eigene Karte (wie die Einstellungen)  -->
            <Border
                x:Name="BRD_BegriffeKarte"
                Margin="2,10,2,2"
                Padding="14"
                Background="#FFFCFCFC"
                BorderBrush="#FFECECEC"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel x:Name="STP_BegriffeKarte">

                    <!--  Kopf mit Tag-Symbol: bildet das Paar zum „Tag-Schwelle"-Regler oben  -->
                    <StackPanel
                        x:Name="STP_BegriffeKopf"
                        Margin="0,0,0,6"
                        Orientation="Horizontal">
                        <TextBlock
                            x:Name="TXT_BegriffeKopfIcon"
                            Margin="0,1,6,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="#FF3B4A9C"
                            Text="&#xE8EC;" />
                        <TextBlock
                            x:Name="TXT_BegriffeKopfLabel"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#FF3B4A9C"
                            Text="Erkannte Begriffe" />
                    </StackPanel>

                    <DockPanel x:Name="DKP_BegriffeBereich" Margin="0,0,0,0">
                        <!--  Kleine Vorschau + Heatmap-Overlay  -->
                        <Grid
                            x:Name="GRD_Vorschau"
                            Width="64"
                            Height="64"
                            Margin="0,0,10,0"
                            d:Visibility="Visible"
                            DockPanel.Dock="Left"
                            Visibility="{Binding AnalyseBildVorschau, Converter={StaticResource CLconverterVisiblityBoolian}}">
                            <Border
                                x:Name="BRD_VorschauBild"
                                d:Background="#FFE0E6F5"
                                BorderBrush="#FFD3DAF5"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding AnalyseBildVorschau}" Stretch="Uniform" />
                                </Border.Background>
                            </Border>
                            <Border
                                x:Name="BRD_HeatmapOverlay"
                                ClipToBounds="True"
                                CornerRadius="6">
                                <Image
                                    x:Name="IMG_Heatmap"
                                    Opacity="0.7"
                                    Source="{Binding HeatmapOverlay}"
                                    Stretch="Uniform" />
                            </Border>
                        </Grid>

                        <ItemsControl
                            x:Name="IC_ErkannteBegriffe"
                            d:DataContext="{d:DesignInstance}"
                            ItemsSource="{Binding ErkannteBegriffe}">
                            <d:ItemsControl.Items>
                                <sys:String>Vogel 27 %</sys:String>
                                <sys:String>Sonnenblume 26 %</sys:String>
                                <sys:String>Gelb 26 %</sys:String>
                                <sys:String>Papagei 25 %</sys:String>
                                <sys:String>Baum 25 %</sys:String>
                                <sys:String>Nahaufnahme 25 %</sys:String>
                                <sys:String>Zitrone 25 %</sys:String>
                                <sys:String>Obst 25 %</sys:String>
                            </d:ItemsControl.Items>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,6,6"
                                        Padding="9,4"
                                        Background="#FFEEF1FB"
                                        BorderBrush="#FFD3DAF5"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="BegriffChip_MouseLeftButtonDown">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Click="BegriffChip_AlleAnzeigen" Header="Alle Bilder mit diesem Begriff" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <TextBlock
                                            FontFamily="Segoe UI"
                                            FontSize="12"
                                            Foreground="#FF3B4A9C"
                                            Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <!--  Anzahl erkannter Begriffe – unter den Chips  -->
                    <TextBlock
                        x:Name="TXT_AnalyseStatus"
                        Margin="0,8,0,0"
                        FontFamily="Segoe UI"
                        FontSize="12"
                        Foreground="#FF888888"
                        Text="{Binding AnalyseStatus}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AnalyseStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!--  Heatmap-Lade-Hinweis  -->
                    <StackPanel
                        x:Name="STP_HeatmapHinweis"
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding HeatmapLaeuft, Converter={StaticResource CLconverterVisiblityBoolian}}">
                        <TextBlock
                            x:Name="TXT_HeatmapSpinner"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="#FF5C6BC0"
                            RenderTransformOrigin="0.5,0.5"
                            Text="&#xE72C;">
                            <TextBlock.RenderTransform>
                                <RotateTransform />
                            </TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HeatmapLaeuft}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            RepeatBehavior="Forever"
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            From="0"
                                                            To="360"
                                                            Duration="0:0:1" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock
                            x:Name="TXT_HeatmapHinweisText"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="11"
                            Foreground="#FF888888"
                            Text="  Heatmap wird berechnet…" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <!--  Einstellungen: aufklappbar über den Filter-Button  -->
            <Border
                x:Name="BRD_Einstellungen"
                Margin="0,10,0,0"
                Padding="14"
                Background="#FFFCFCFC"
                BorderBrush="#FFECECEC"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding IsIndexPopoverOffen, Converter={StaticResource CLconverterVisiblityBoolian}}">
                <StackPanel x:Name="STP_Einstellungen">

                    <!--  Kopfzeile: Anzahl + Ordner-Fortschritt  -->
                    <Grid x:Name="GRD_EinstellungenKopf">
                        <StackPanel x:Name="STP_IndexAnzahl" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                x:Name="TXT_IndexAnzahlIcon"
                                Margin="0,1,8,0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="#FF6B6B6B"
                                Text="&#xE8FD;" />
                            <TextBlock
                                x:Name="TXT_IndexAnzahl"
                                FontFamily="Segoe UI"
                                FontSize="14"
                                Foreground="#FF2B2B2B"
                                Text="{Binding IndexAnzahlText}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="TXT_IndexOrdner"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#FF9A9A9A"
                            Text="{Binding IndexOrdnerText}" />
                    </Grid>

                    <!--  Filter nach: Kategorie + Wert  -->
                    <Grid x:Name="GRD_Filter" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="TXT_FilterLabel"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#FF555555"
                            Text="Filter nach" />
                        <ComboBox
                            x:Name="CBX_FilterKategorie"
                            Grid.Column="1"
                            Height="32"
                            VerticalContentAlignment="Center"
                            FontSize="13"
                            ItemsSource="{Binding FilterKategorien}"
                            SelectedItem="{Binding SelectedFilterKategorie, Mode=TwoWay}" />
                        <ComboBox
                            x:Name="CBX_FilterWert"
                            Grid.Column="3"
                            Height="32"
                            VerticalContentAlignment="Center"
                            FontSize="13"
                            ItemsSource="{Binding FilterWerte}"
                            SelectedItem="{Binding SelectedFilterWert, Mode=TwoWay}" />
                    </Grid>

                    <!--  Tag-Schwelle  -->
                    <Grid x:Name="GRD_TagSchwelle" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            x:Name="STP_TagSchwelleLabel"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            ToolTip="Schwelle für die erkannten Begriffe unten – nur Begriffe ab diesem Score anzeigen.">
                            <TextBlock
                                x:Name="TXT_TagSchwelleIcon"
                                Margin="0,1,6,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="#FF3B4A9C"
                                Text="&#xE8EC;" />
                            <TextBlock
                                x:Name="TXT_TagSchwelleLabel"
                                FontFamily="Segoe UI"
                                FontSize="13"
                                Foreground="#FF555555"
                                Text="Tag-Schwelle" />
                        </StackPanel>
                        <Slider
                            x:Name="SLD_TagSchwelle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            LargeChange="0.05"
                            Maximum="1"
                            Minimum="0"
                            SmallChange="0.01"
                            Value="{Binding TagSchwelle, Mode=TwoWay}" />
                        <TextBlock
                            x:Name="TXT_TagSchwelleWert"
                            Grid.Column="2"
                            Width="40"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#FF2B2B2B"
                            Text="{Binding TagSchwelle, StringFormat=F2}"
                            TextAlignment="Right" />
                    </Grid>

                    <!--  Mindest-Ähnlichkeit der Suchtreffer  -->
                    <Grid x:Name="GRD_MindestAehnlichkeit" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="TXT_MindestLabel"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#FF555555"
                            Text="Mindest-Ähnl."
                            ToolTip="Nur Suchtreffer über dieser Ähnlichkeit zeigen" />
                        <Slider
                            x:Name="SLD_MindestAehnlichkeit"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            LargeChange="5"
                            Maximum="60"
                            Minimum="0"
                            SmallChange="1"
                            Value="{Binding MindestAehnlichkeit, Mode=TwoWay}" />
                        <TextBlock
                            x:Name="TXT_MindestWert"
                            Grid.Column="2"
                            Width="40"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#FF2B2B2B"
                            Text="{Binding MindestAehnlichkeit, StringFormat={}{0:F0} %}"
                            TextAlignment="Right" />
                    </Grid>

                    <!--  Schwelle der „Schema-ähnlich"-Suche (Bild→Bild, höherer Bereich).
                          Erst bedienbar, nachdem „Schema-ähnlich" Treffer geliefert hat.  -->
                    <Grid x:Name="GRD_SchemaAehnlichkeit" Margin="0,14,0,0" IsEnabled="{Binding ErgebnisseSindSchemaAehnlich}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            x:Name="STP_SchemaSchwelleLabel"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            ToolTip="Schwelle der Schema-ähnlich-Suche (Bild als Anfrage). Höher = strenger, weniger Treffer.">
                            <TextBlock
                                x:Name="TXT_SchemaSchwelleIcon"
                                Margin="0,1,6,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="#FF555555"
                                Text="&#xE8B3;" />
                            <TextBlock
                                x:Name="TXT_SchemaSchwelleLabel"
                                FontFamily="Segoe UI"
                                FontSize="13"
                                Foreground="#FF555555"
                                Text="Schema-Ähnl." />
                        </StackPanel>
                        <Slider
                            x:Name="SLD_SchemaAehnlichkeit"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            LargeChange="5"
                            Maximum="100"
                            Minimum="50"
                            SmallChange="1"
                            Value="{Binding SchemaAehnlichkeitProzent, Mode=TwoWay}" />
                        <TextBlock
                            x:Name="TXT_SchemaSchwelleWert"
                            Grid.Column="2"
                            Width="40"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#FF2B2B2B"
                            Text="{Binding SchemaAehnlichkeitProzent, StringFormat={}{0:F0} %}"
                            TextAlignment="Right" />
                    </Grid>

                    <!--  Begriffe auf Deutsch statt Englisch  -->
                    <CheckBox
                        x:Name="CHK_BegriffeAufDeutsch"
                        Margin="0,14,0,0"
                        VerticalContentAlignment="Center"
                        Content="Begriffe auf Deutsch (de/eng)"
                        FontFamily="Segoe UI"
                        FontSize="13"
                        Foreground="#FF555555"
                        IsChecked="{Binding BegriffeAufDeutsch, Mode=TwoWay}" />

                    <!--  Trennlinie  -->
                    <Border
                        x:Name="BRD_Trennlinie"
                        Height="1"
                        Margin="0,16,0,14"
                        Background="#FFEAEAEA" />

                    <!--  Werkzeug-Buttons  -->
                    <StackPanel x:Name="STP_WerkzeugButtons" Orientation="Horizontal">
                        <Button
                            x:Name="BTN_Uebersicht"
                            Margin="0,0,10,0"
                            Command="{Binding CommandExecuteUebersichtCommand}"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Tag-Übersicht anzeigen">
                            <StackPanel x:Name="STP_UebersichtInhalt" Orientation="Horizontal">
                                <TextBlock
                                    x:Name="TXT_UebersichtIcon"
                                    Margin="0,1,7,0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13"
                                    Text="&#xE9D9;" />
                                <TextBlock x:Name="TXT_UebersichtLabel" Text="Übersicht" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="BTN_Dubletten"
                            Margin="0,0,10,0"
                            Command="{Binding CommandExecuteDublettenCommand}"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Dubletten finden (fast identische Bilder im Ordner)">
                            <StackPanel x:Name="STP_DublettenInhalt" Orientation="Horizontal">
                                <TextBlock
                                    x:Name="TXT_DublettenIcon"
                                    Margin="0,1,7,0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13"
                                    Text="&#xE8C8;" />
                                <TextBlock x:Name="TXT_DublettenLabel" Text="Dubletten" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="BTN_QueryBild"
                            Command="{Binding CommandExecuteQueryBildCommand}"
                            IsEnabled="False"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Query-Bild wählen und Ähnliche suchen">
                            <StackPanel x:Name="STP_QueryBildInhalt" Orientation="Horizontal">
                                <TextBlock
                                    x:Name="TXT_QueryBildIcon"
                                    Margin="0,1,7,0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13"
                                    Text="&#xE8B9;" />
                                <TextBlock x:Name="TXT_QueryBildLabel" Text="Query-Bild" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!--  CLIP lädt: Warte-Symbol (dreht sich)  -->
            <StackPanel
                x:Name="STP_ClipLaedt"
                Margin="2,10,2,0"
                Orientation="Horizontal"
                Visibility="{Binding ClipLaedt, Converter={StaticResource CLconverterVisiblityBoolian}}">
                <TextBlock
                    x:Name="TXT_ClipSpinner"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Foreground="#FF5C6BC0"
                    RenderTransformOrigin="0.5,0.5"
                    Text="&#xE72C;">
                    <TextBlock.RenderTransform>
                        <RotateTransform Angle="0" />
                    </TextBlock.RenderTransform>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ClipLaedt}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="SB_ClipSpin">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    RepeatBehavior="Forever"
                                                    Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                                                    From="0"
                                                    To="360"
                                                    Duration="0:0:0.9" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="SB_ClipSpin" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock
                    x:Name="TXT_ClipLaedtText"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="12"
                    Foreground="#FF555555"
                    Text="Lade KI-Modell… (einmalig, dauert einen Moment)" />
            </StackPanel>

            <!--  Indexier-Fortschritt  -->
            <StackPanel x:Name="STP_IndexFortschritt" Margin="2,10,2,0">
                <TextBlock
                    x:Name="TXT_IndexFortschrittText"
                    FontFamily="Segoe UI"
                    FontSize="12"
                    Foreground="#FF555555"
                    Text="{Binding IndexFortschrittText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IndexFortschrittText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ProgressBar
                    x:Name="PGB_IndexFortschritt"
                    Height="5"
                    Margin="0,6,0,0"
                    Maximum="100"
                    Minimum="0"
                    Visibility="{Binding IndexLaeuft, Converter={StaticResource CLconverterVisiblityBoolian}}"
                    Value="{Binding IndexFortschritt}" />
            </StackPanel>

            <!--  Suchergebnisse: klickbare Miniaturen  -->
            <StackPanel x:Name="STP_SuchErgebnisse" Margin="2,4,2,2">
                <!--  Treffer in die Bilderliste übernehmen  -->
                <StackPanel x:Name="STP_TrefferUebernehmenLeiste" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SucheStatus}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button
                        x:Name="BTN_TrefferUebernehmen"
                        Height="30"
                        Command="{Binding CommandExecuteTrefferUebernehmenCommand}"
                        Style="{StaticResource OutlineButtonStyle}"
                        ToolTip="Die Suchtreffer in die Bilderliste übernehmen (Wiederherstellen: Alle neu einlesen)">
                        <StackPanel x:Name="STP_TrefferUebernehmenInhalt" Orientation="Horizontal">
                            <TextBlock
                                x:Name="TXT_TrefferUebernehmenIcon"
                                Margin="0,1,7,0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="13"
                                Text="&#xE71C;" />
                            <TextBlock x:Name="TXT_TrefferUebernehmenLabel" Text="In Liste übernehmen" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer
                    x:Name="SCV_SuchErgebnisse"
                    MaxHeight="260"
                    Margin="0,8,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        x:Name="IC_SuchErgebnisse"
                        d:DataContext="{d:DesignInstance}"
                        ItemsSource="{Binding SuchErgebnisse}">
                        <d:ItemsControl.Items>
                            <Border
                                Width="104"
                                Height="78"
                                Margin="0,0,6,6"
                                Background="#FFE0E0E0"
                                BorderBrush="#FFDADADA"
                                BorderThickness="1"
                                CornerRadius="6" />
                            <Border
                                Width="104"
                                Height="78"
                                Margin="0,0,6,6"
                                Background="#FFE8E8E8"
                                BorderBrush="#FFDADADA"
                                BorderThickness="1"
                                CornerRadius="6" />
                            <Border
                                Width="104"
                                Height="78"
                                Margin="0,0,6,6"
                                Background="#FFE0E0E0"
                                BorderBrush="#FFDADADA"
                                BorderThickness="1"
                                CornerRadius="6" />
                            <Border
                                Width="104"
                                Height="78"
                                Margin="0,0,6,6"
                                Background="#FFE8E8E8"
                                BorderBrush="#FFDADADA"
                                BorderThickness="1"
                                CornerRadius="6" />
                            <Border
                                Width="104"
                                Height="78"
                                Margin="0,0,6,6"
                                Background="#FFE0E0E0"
                                BorderBrush="#FFDADADA"
                                BorderThickness="1"
                                CornerRadius="6" />
                            <Border
                                Width="104"
                                Height="78"
                                Margin="0,0,6,6"
                                Background="#FFE8E8E8"
                                BorderBrush="#FFDADADA"
                                BorderThickness="1"
                                CornerRadius="6" />
                        </d:ItemsControl.Items>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="0,0,6,6"
                                    Command="{Binding DataContext.CommandExecuteTrefferOeffnenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Path}"
                                    Cursor="Hand"
                                    ToolTip="{Binding DateiName}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Width="104" Height="78">
                                                <Border
                                                    Background="#FF1A1A1A"
                                                    BorderBrush="#FFDADADA"
                                                    BorderThickness="1"
                                                    ClipToBounds="True"
                                                    CornerRadius="6">
                                                    <Image Source="{Binding Thumb}" Stretch="Uniform" />
                                                </Border>
                                                <Border
                                                    Margin="0,0,4,4"
                                                    Padding="4,1"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Background="#CC000000"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        FontFamily="Segoe UI"
                                                        FontSize="10"
                                                        Foreground="White"
                                                        Text="{Binding ProzentText}" />
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
