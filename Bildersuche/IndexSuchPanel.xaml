<UserControl
    x:Class="TestImage.Bildersuche.IndexSuchPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TestImage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:CLconverterVisiblityBoolian x:Key="CLconverterVisiblityBoolian" />
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF2B2B2B" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#FFDADADA"
                            BorderThickness="1"
                            CornerRadius="7"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF5F5F5" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFBABABA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFEBEBEB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border
        Background="#FFFFFFFF"
        BorderBrush="#FFE3E3E3"
        BorderThickness="1"
        CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="18"
                Opacity="0.22"
                ShadowDepth="2"
                Color="Black" />
        </Border.Effect>
        <StackPanel Margin="6" Orientation="Vertical">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                <!--  Index-Button (umrandet)  -->
                <Button
                    x:Name="BTN_IndexOrdnerErstellen"
                    Command="{Binding CommandExecuteOrdnerIndexierenCommand}"
                    Style="{StaticResource OutlineButtonStyle}"
                    ToolTip="Ordner des gewählten Bildes indexieren (CLIP-Embeddings für Suche erstellen)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,1,1,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="13"
                            Text="&#xE8B7;" />
                        <TextBlock
                            Margin="0,0,7,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="8"
                            FontWeight="Bold"
                            Text="&#xE710;" />
                        <TextBlock VerticalAlignment="Center" Text="Index" />
                    </StackPanel>
                </Button>

                <!--  Suchfeld: Eingabe + grauer Vorschlag links, Such-Button rechts  -->
                <Border
                    Width="300"
                    Height="34"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center"
                    Background="#FFFFFFFF"
                    BorderBrush="#FFDADADA"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Eingabe + grauer Beispiel-/Autovervollständigungs-Vorschlag  -->
                        <Grid Grid.Column="0" Margin="10,0,4,0">

                            <!--  Ghost: getippter Teil transparent, Rest grau (Tab übernimmt)  -->
                            <TextBlock
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe UI"
                                FontSize="14"
                                IsHitTestVisible="False"
                                TextTrimming="CharacterEllipsis"><Run Foreground="Transparent" Text="{Binding SucheText, Mode=OneWay}" /><Run Foreground="#FFC7C7C7" Text="{Binding SucheVorschlagRest, Mode=OneWay}" /></TextBlock>

                            <TextBox
                                x:Name="TXT_Suche"
                                Padding="0"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="Segoe UI"
                                FontSize="14"
                                Foreground="#FF2B2B2B"
                                PreviewKeyDown="TXT_Suche_PreviewKeyDown"
                                Text="{Binding SucheText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CommandExecuteFreitextSucheCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <TextBlock
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe UI"
                                FontSize="14"
                                Foreground="#FFB0B0B0"
                                IsHitTestVisible="False"
                                Text="z. B. Mädchen am Strand">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SucheText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!--  Such-Button (Auslöser)  -->
                        <Button
                            x:Name="BTN_Suchen"
                            Grid.Column="1"
                            Width="36"
                            Command="{Binding CommandExecuteFreitextSucheCommand}"
                            Cursor="Hand"
                            ToolTip="Suchen">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="sb"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="0,7,7,0">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="15"
                                                        Foreground="#FF5C6BC0"
                                                        Text="&#xE721;" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="sb" Property="Background" Value="#FFEEF1FB" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="sb" Property="Background" Value="#FFDDE3F7" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!--  Filter-Toggle: Regler + Chevron (öffnet das Popover)  -->
                <Button
                    x:Name="BTN_FilterToggle"
                    Command="{Binding CommandExecuteFilterPopoverToggleCommand}"
                    Style="{StaticResource OutlineButtonStyle}"
                    ToolTip="Filter, Tags und Werkzeuge einblenden">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,1,6,0"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Text="&#xE9E9;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            RenderTransformOrigin="0.5,0.5">
                            <TextBlock.Text>&#xE70D;</TextBlock.Text>
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="chevronRotate" Angle="0" />
                            </TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIndexPopoverOffen}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            To="180"
                                                            Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            To="0"
                                                            Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

            </StackPanel>

            <!--  Einstellungen: aufklappbar über den Filter-Button  -->
            <Border
                Margin="0,10,0,0"
                Padding="14"
                Background="#FFFCFCFC"
                BorderBrush="#FFECECEC"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding IsIndexPopoverOffen, Converter={StaticResource CLconverterVisiblityBoolian}}">
                <StackPanel>

                    <!--  Kopfzeile: Anzahl + Ordner-Fortschritt  -->
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,1,8,0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="#FF6B6B6B"
                                Text="&#xE8FD;" />
                            <TextBlock
                                FontFamily="Segoe UI"
                                FontSize="14"
                                Foreground="#FF2B2B2B"
                                Text="{Binding IndexAnzahlText}" />
                        </StackPanel>
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#FF9A9A9A"
                            Text="{Binding IndexOrdnerText}" />
                    </Grid>

                    <!--  Filter nach: Kategorie + Wert  -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#FF555555"
                            Text="Filter nach" />
                        <ComboBox
                            x:Name="CBX_FilterKategorie"
                            Grid.Column="1"
                            Height="32"
                            VerticalContentAlignment="Center"
                            FontSize="13"
                            ItemsSource="{Binding FilterKategorien}"
                            SelectedItem="{Binding SelectedFilterKategorie, Mode=TwoWay}" />
                        <ComboBox
                            x:Name="CBX_FilterWert"
                            Grid.Column="3"
                            Height="32"
                            VerticalContentAlignment="Center"
                            FontSize="13"
                            ItemsSource="{Binding FilterWerte}"
                            SelectedItem="{Binding SelectedFilterWert, Mode=TwoWay}" />
                    </Grid>

                    <!--  Tag-Schwelle  -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#FF555555"
                            Text="Tag-Schwelle" />
                        <Slider
                            x:Name="SLD_TagSchwelle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            LargeChange="0.05"
                            Maximum="1"
                            Minimum="0"
                            SmallChange="0.01"
                            Value="{Binding TagSchwelle, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Column="2"
                            Width="40"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#FF2B2B2B"
                            Text="{Binding TagSchwelle, StringFormat=F2}"
                            TextAlignment="Right" />
                    </Grid>

                    <!--  Mindest-Ähnlichkeit der Suchtreffer  -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#FF555555"
                            Text="Mindest-Ähnl."
                            ToolTip="Nur Suchtreffer über dieser Ähnlichkeit zeigen" />
                        <Slider
                            x:Name="SLD_MindestAehnlichkeit"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            LargeChange="5"
                            Maximum="60"
                            Minimum="0"
                            SmallChange="1"
                            Value="{Binding MindestAehnlichkeit, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Column="2"
                            Width="40"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="#FF2B2B2B"
                            Text="{Binding MindestAehnlichkeit, StringFormat={}{0:F0} %}"
                            TextAlignment="Right" />
                    </Grid>

                    <!--  Begriffe auf Deutsch statt Englisch  -->
                    <CheckBox
                        x:Name="CHK_BegriffeAufDeutsch"
                        Margin="0,14,0,0"
                        VerticalContentAlignment="Center"
                        Content="Begriffe auf Deutsch (de/eng)"
                        FontFamily="Segoe UI"
                        FontSize="13"
                        Foreground="#FF555555"
                        IsChecked="{Binding BegriffeAufDeutsch, Mode=TwoWay}" />

                    <!--  Trennlinie  -->
                    <Border
                        Height="1"
                        Margin="0,16,0,14"
                        Background="#FFEAEAEA" />

                    <!--  Werkzeug-Buttons  -->
                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="BTN_Uebersicht"
                            Margin="0,0,10,0"
                            Command="{Binding CommandExecuteUebersichtCommand}"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Tag-Übersicht anzeigen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,1,7,0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13"
                                    Text="&#xE9D9;" />
                                <TextBlock Text="Übersicht" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="BTN_Dubletten"
                            Margin="0,0,10,0"
                            Command="{Binding CommandExecuteDublettenCommand}"
                            IsEnabled="False"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Dubletten finden">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,1,7,0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13"
                                    Text="&#xE8C8;" />
                                <TextBlock Text="Dubletten" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="BTN_QueryBild"
                            Command="{Binding CommandExecuteQueryBildCommand}"
                            IsEnabled="False"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Query-Bild wählen und Ähnliche suchen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,1,7,0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13"
                                    Text="&#xE8B9;" />
                                <TextBlock Text="Query-Bild" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!--  CLIP lädt: Warte-Symbol (dreht sich)  -->
            <StackPanel
                Margin="2,10,2,0"
                Orientation="Horizontal"
                Visibility="{Binding ClipLaedt, Converter={StaticResource CLconverterVisiblityBoolian}}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Foreground="#FF5C6BC0"
                    RenderTransformOrigin="0.5,0.5"
                    Text="&#xE72C;">
                    <TextBlock.RenderTransform>
                        <RotateTransform Angle="0" />
                    </TextBlock.RenderTransform>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ClipLaedt}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="SB_ClipSpin">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    RepeatBehavior="Forever"
                                                    Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                                                    From="0"
                                                    To="360"
                                                    Duration="0:0:0.9" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="SB_ClipSpin" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="12"
                    Foreground="#FF555555"
                    Text="Lade KI-Modell… (einmalig, dauert einen Moment)" />
            </StackPanel>

            <!--  Indexier-Fortschritt  -->
            <StackPanel Margin="2,10,2,0">
                <TextBlock
                    FontFamily="Segoe UI"
                    FontSize="12"
                    Foreground="#FF555555"
                    Text="{Binding IndexFortschrittText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IndexFortschrittText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ProgressBar
                    x:Name="PGB_IndexFortschritt"
                    Height="5"
                    Margin="0,6,0,0"
                    Maximum="100"
                    Minimum="0"
                    Visibility="{Binding IndexLaeuft, Converter={StaticResource CLconverterVisiblityBoolian}}"
                    Value="{Binding IndexFortschritt}" />
            </StackPanel>

            <!--  Ergebnis: erkannte Begriffe des gewählten Bildes  -->
            <StackPanel Margin="2,10,2,2">
                <TextBlock
                    FontFamily="Segoe UI"
                    FontSize="12"
                    Foreground="#FF888888"
                    Text="{Binding AnalyseStatus}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AnalyseStatus}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <DockPanel Margin="0,8,0,0">
                    <!--  Kleine Vorschau + Heatmap-Overlay  -->
                    <Grid
                        Width="64"
                        Height="64"
                        Margin="0,0,10,0"
                        DockPanel.Dock="Left"
                        Visibility="{Binding AnalyseBildVorschau, Converter={StaticResource CLconverterVisiblityBoolian}}">
                        <Border
                            BorderBrush="#FFD3DAF5"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding AnalyseBildVorschau}" Stretch="Uniform" />
                            </Border.Background>
                        </Border>
                        <Border ClipToBounds="True" CornerRadius="6">
                            <Image
                                Opacity="0.7"
                                Source="{Binding HeatmapOverlay}"
                                Stretch="Uniform" />
                        </Border>
                    </Grid>

                    <ItemsControl x:Name="IC_ErkannteBegriffe" ItemsSource="{Binding ErkannteBegriffe}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,6,6"
                                    Padding="9,4"
                                    Background="#FFEEF1FB"
                                    BorderBrush="#FFD3DAF5"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="BegriffChip_MouseLeftButtonDown">
                                    <TextBlock
                                        FontFamily="Segoe UI"
                                        FontSize="12"
                                        Foreground="#FF3B4A9C"
                                        Text="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <!--  Heatmap-Lade-Hinweis  -->
                <StackPanel
                    Margin="0,4,0,0"
                    Orientation="Horizontal"
                    Visibility="{Binding HeatmapLaeuft, Converter={StaticResource CLconverterVisiblityBoolian}}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Foreground="#FF5C6BC0"
                        RenderTransformOrigin="0.5,0.5"
                        Text="&#xE72C;">
                        <TextBlock.RenderTransform>
                            <RotateTransform />
                        </TextBlock.RenderTransform>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HeatmapLaeuft}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        RepeatBehavior="Forever"
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        From="0"
                                                        To="360"
                                                        Duration="0:0:1" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI"
                        FontSize="11"
                        Foreground="#FF888888"
                        Text="  Heatmap wird berechnet…" />
                </StackPanel>
            </StackPanel>

            <!--  Suchergebnisse: klickbare Miniaturen  -->
            <StackPanel Margin="2,4,2,2">
                <TextBlock
                    FontFamily="Segoe UI"
                    FontSize="12"
                    Foreground="#FF888888"
                    Text="{Binding SucheStatus}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SucheStatus}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!--  Treffer in die Bilderliste übernehmen  -->
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SucheStatus}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button
                        x:Name="BTN_TrefferUebernehmen"
                        Height="30"
                        Command="{Binding CommandExecuteTrefferUebernehmenCommand}"
                        Style="{StaticResource OutlineButtonStyle}"
                        ToolTip="Die Suchtreffer in die Bilderliste übernehmen (Wiederherstellen: Alle neu einlesen)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,1,7,0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="13"
                                Text="&#xE71C;" />
                            <TextBlock Text="In Liste übernehmen" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer
                    x:Name="SCV_SuchErgebnisse"
                    MaxHeight="260"
                    Margin="0,8,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="IC_SuchErgebnisse" ItemsSource="{Binding SuchErgebnisse}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="0,0,6,6"
                                    Command="{Binding DataContext.CommandExecuteTrefferOeffnenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Path}"
                                    Cursor="Hand"
                                    ToolTip="{Binding DateiName}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Width="104" Height="78">
                                                <Border
                                                    Background="#FF1A1A1A"
                                                    BorderBrush="#FFDADADA"
                                                    BorderThickness="1"
                                                    ClipToBounds="True"
                                                    CornerRadius="6">
                                                    <Image Source="{Binding Thumb}" Stretch="Uniform" />
                                                </Border>
                                                <Border
                                                    Margin="0,0,4,4"
                                                    Padding="4,1"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Background="#CC000000"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        FontFamily="Segoe UI"
                                                        FontSize="10"
                                                        Foreground="White"
                                                        Text="{Binding ProzentText}" />
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
